// Telling a story (DESIGN.md section 11; lib/capture.ts, lib/sittings.ts, lib/derive.ts). A story is a project: a
// named piece of work under a job, or a side project. The owner tells it in an interview, one question at a time, and
// the studio writes its four parts and its facts from the answers afterwards. The interviewer says only fixed words: no
// model is asked while the owner talks and no slow work is made, so the next line comes back with the answer, and
// nothing waits or spins. The owner's answer is sent and kept exactly as typed: never trimmed.
//
// On an open job in Experience, "Tell a story from this job" opens a one-field form in place (`StoryStart`): the piece
// of work's name, Add and Cancel. Add makes the project and starts its first sitting. An open project shows one plain
// action (`TellLine`): "Tell this project" when nothing is told yet, "Carry on telling it" while a sitting is open or
// some questions remain, and "Told on <date>" with a way to read it once all 14 are answered or closed. Under its facts
// one quiet line (`StoryLine`) says when the story was written from what was told, or that it is being written. The
// sitting is its own screen (`TellScreen`, /record/tell/:id, so a reload lands on it): the conversation, one field and
// Send, "I don't know" and "Stop for now"; once it has ended, the closing line and what the owner said under each
// question, each answer with Delete, which asks first.
use Page, Section, Title, SectionHead, Line, StrongLine, QuietLine, FailLine, Indented, Action, MainAction, DangerAction, GoTo, Actions, InPlaceForm, FieldLabel, WorkLine, statusWord, look, lookText, lookLeading, lookTight from "./look.contract"
use WorkItem, usualWords, inHand, workStatus, workPlace, workUsual from "./activity.contract"

// Where the telling of one project stands (GET /projects/:id/sitting). sitting: the open sitting, else the latest (""
// for none). settled: the questions answered or closed, of total. lastOn: when any of its sittings was last touched,
// in words ("19 Nov 2026"). said: it holds an answer that is not only "I don't know". deriveStatus: '' | queued | running | done | failed, and deriveNote, what was left out or
// why it failed. toldOn: the day of the latest answer the story was written from ("" before it was written).
shape Telling
  loaded: bool
  project: string
  open: bool
  sitting: string
  settled: number
  total: number
  lastOn: string
  said: bool
  deriveStatus: string
  deriveNote: string
  toldOn: string

// One turn of a sitting, in order. mine: the owner's answer; else the interviewer's line. step: opening | reminder |
// question | follow-up | closing | answer. shown: the words as the screen draws them (app.ts, `drawn`; see OwnWords).
shape SittingTurn
  id: string
  mine: bool
  step: string
  text: string
  shown: string

// One of the owner's answers in "What you said": the sitting it is in, its words as stored, and the follow-up it
// answers ("" for an answer to the question itself). more: the follow-up answers deleting it takes with it. shown: as
// the screen draws it.
shape SaidAnswer
  id: string
  sitting: string
  text: string
  shown: string
  followUp: string
  more: number

// A question of the list with the owner's answers to it, from every sitting about the same project.
shape SaidGroup
  key: string
  question: string
  answers: SaidAnswer[]

// One sitting (GET /sittings/:id). project: the project it is about, and name, what it is called. due: a question
// waits for the owner's answer. position: the waiting question's place in the list (1 to total; 0 when none waits), and
// part: its part of the story in words ("Context"). closing: the closing line, once it has ended. gone: the sitting is
// no longer in the record. answers: how many answers this sitting holds (what deleting it removes).
shape Sitting
  loaded: bool
  gone: bool
  id: string
  project: string
  name: string
  open: bool
  due: bool
  position: number
  part: string
  total: number
  closing: string
  answers: number
  turns: SittingTurn[]
  said: SaidGroup[]

// The reply to a start, an answer, a stop or a delete: the refusal in words ("" when done), the sitting started or
// resumed, and whether the sitting has ended. stale: the question answered was no longer waiting (a second send, a
// second tab); the screen reads the sitting again and keeps the draft.
shape TellReply
  ok: bool
  error: string
  sitting: string
  ended: bool
  stale: bool

// Every question answered or closed, with no sitting open.
fn isTold(t: Telling): bool = not t.open and t.total > 0 and t.settled >= t.total
// The one action on an open project, in words.
fn tellLabel(t: Telling): string = t.open or t.settled > 0 ? "Carry on telling it" : "Tell this project"
// The words "I don't know" sends: exactly these, which close the question for good (lib/capture.ts, isDontKnow).
fn dontKnowText(): string = "I don't know"
fn saidId(key: string): string = key == "" ? "other" : key
// What Delete asks, about one answer and about the whole sitting. Neither promises what is asked next.
fn answerAsk(a: SaidAnswer): string = a.more > 0 ? "Delete this answer and what you added to it? This cannot be undone." : "Delete this answer? This cannot be undone."
fn sittingAsk(n: number): string = n == 0 ? "Delete this sitting? It holds no answer. This cannot be undone." : `Delete this sitting and the ${n == 1 ? "answer" : `${n} answers`} you gave in it? This cannot be undone.`
// The action that writes the story from the answers: first, again, or after a failure.
fn storyAgainLabel(t: Telling, state: string): string = state == "failed" ? "Try again" : t.toldOn != "" ? "Write it again from what you said" : "Write it from what you said"
// The quiet line under the conversation: the part of the story, and the question's place in the list.
fn positionLine(s: Sitting): string = `${s.part} · question ${s.position} of ${s.total}`

members App
  // The project open in Experience, if any: where its telling stands, read while it is open.
  derive tellOf = openKey.startsWith("project:") ? openKey.slice(8) : ""
  resource telling = loadTelling(tellOf) when tellOf != "" as shape Telling else empty()
  // The sitting shown (/record/tell/:id), read when it opens and after each answer, stop or delete.
  derive sittingShown = topName == "tell" ? top(nav).params.id : ""
  resource sitting = loadSitting(sittingShown) when sittingShown != "" as shape Sitting else empty()
  // The interviewer turn the screen shows as waiting: the answer is sent for it, and refused if it no longer waits.
  derive tellTurn = sitting.due ? (match sitting.turns.at(-1) { case some(t) => t.id, case none => "" }) : ""
  mutation tellStarted as shape TellReply then afterTellStart
  // A story named under a job: the project is made and its first sitting starts, so the record is read again too.
  mutation storyTold as shape TellReply refreshes tree, activity then afterStoryTold
  // Write it again from what you said: slow work, so the activity list is read again at once.
  mutation storyAsked as shape TellReply refreshes telling, activity
  // An answer or a stop can end a sitting, which queues its story to be written.
  mutation tellAnswered as shape TellReply refreshes sitting, activity then afterTellAnswer
  mutation tellStopped as shape TellReply refreshes sitting, activity
  mutation tellDeleted as shape TellReply refreshes sitting then afterTellDelete
  // A whole sitting deleted: it is gone, so the screen goes back to its project, which reads its telling again.
  mutation sittingDeleted as shape TellReply then afterSittingDelete
  // The answer being written, kept across a reload, and the sitting it is for. What was last sent, so the field is
  // cleared only when the answer sent is still what it holds.
  state tellDraft = "" persist
  state tellDraftFor = "" persist
  derive tellField = tellDraftFor == sittingShown ? tellDraft : ""
  state tellSending = ""
  // The last thing tried (start | story | again | answer | stop | delete), so one refusal is said where it was made; the
  // job or project a start was asked on; the answer whose deletion is being asked about.
  state tellAct = ""
  state tellOn = ""
  state tellAsking = ""
  // Whether the deletion of the whole sitting shown is being asked about, and where Experience shows its project, to go
  // back to once it is deleted.
  state sittingAsked = false
  state sittingBack = ""
  derive sittingDeleteOk = match sittingDeleted { case some(r) => r.ok, case none => false }
  derive tellStartError = tellAct != "start" or pending(tellStarted) ? "" : match tellStarted { case some(r) => r.error, case none => "" }
  derive storyError = tellAct != "story" or pending(storyTold) ? "" : match storyTold { case some(r) => r.error, case none => "" }
  derive againError = tellAct != "again" or pending(storyAsked) ? "" : match storyAsked { case some(r) => r.error, case none => "" }
  derive tellAnswerOk = match tellAnswered { case some(r) => r.ok, case none => false }
  derive tellAnswerEnded = match tellAnswered { case some(r) => r.ended, case none => false }
  derive tellDeleteOk = match tellDeleted { case some(r) => r.ok, case none => false }
  derive tellError = tellAct == "answer" and not pending(tellAnswered) ? (match tellAnswered { case some(r) => r.error, case none => "" }) : tellAct == "stop" and not pending(tellStopped) ? (match tellStopped { case some(r) => r.error, case none => "" }) : tellAct == "delete" and not pending(tellDeleted) ? (match tellDeleted { case some(r) => r.error, case none => "" }) : tellAct == "delete-sitting" and not pending(sittingDeleted) ? (match sittingDeleted { case some(r) => r.error, case none => "" }) : ""

  // From Experience: start a sitting on a project, or go back to the one open, and open it.
  action tellIt(id: string)
    tellAct = "start"
    tellOn = `project:${id}`
    send tellStarted = startTelling(id)
  // From a job in Experience: a new story, named, and its first sitting.
  action tellStory(roleId: string, title: string)
    if not pending(storyTold)
      tellAct = "story"
      tellOn = `role:${roleId}`
      send storyTold = tellStory(roleId, title.trim())
  action afterStoryTold
    match storyTold
      case some(r)
        if r.ok
          adding = ""
          tellDraft = ""
          tellDraftFor = r.sitting
          tellAct = ""
          tellAsking = ""
          sittingAsked = false
          nav = push(nav, path("tell", r.sitting))
      case none
        tellAct = tellAct
  action writeStoryAgain(id: string)
    tellAct = "again"
    tellOn = `project:${id}`
    send storyAsked = deriveStory(id)
  action afterTellStart
    match tellStarted
      case some(r)
        if r.ok
          if r.sitting != tellDraftFor
            tellDraft = ""
            tellDraftFor = r.sitting
          tellAct = ""
          tellAsking = ""
          sittingAsked = false
          nav = push(nav, path("tell", r.sitting))
      case none
        tellAct = tellAct
  // While an answer is on its way the field takes no typing (it is read-only too), so nothing typed then can join the
  // text already sent and be sent a second time.
  action editTell(v: string)
    if not pending(tellAnswered)
      tellDraft = v
      tellDraftFor = sittingShown
  // Send takes the field as typed; an empty one is refused by the server, in words.
  action sendTell
    if not pending(tellAnswered)
      tellAct = "answer"
      tellSending = tellField
      send tellAnswered = answerSitting(sittingShown, tellTurn, tellField)
  action tellDontKnow
    if not pending(tellAnswered)
      tellAct = "answer"
      tellSending = dontKnowText()
      send tellAnswered = answerSitting(sittingShown, tellTurn, dontKnowText())
  // The next line is on the screen as soon as the sitting is read again; the field is ready for the next answer.
  action afterTellAnswer
    if tellAnswerOk and tellField == tellSending
      tellDraft = ""
    if not tellAnswerEnded
      focus("tell-answer")
  action stopTell
    if not pending(tellStopped)
      tellAct = "stop"
      tellAsking = ""
      send tellStopped = stopSitting(sittingShown)
  action askTellDelete(id: string)
    tellAct = ""
    tellAsking = id
    sittingAsked = false
  action keepTellAnswer
    tellAsking = ""
  action removeTellAnswer(inSitting: string, id: string)
    tellAct = "delete"
    send tellDeleted = deleteAnswer(inSitting, id)
  action afterTellDelete
    if tellDeleteOk
      tellAsking = ""
  action askSittingDelete(back: string)
    tellAct = ""
    tellAsking = ""
    sittingAsked = true
    sittingBack = back
  action keepSitting
    sittingAsked = false
  action removeSitting
    if not pending(sittingDeleted)
      tellAct = "delete-sitting"
      send sittingDeleted = deleteSitting(sittingShown)
  // Back to the project in place of the deleted sitting, so Back never returns to it.
  action afterSittingDelete
    if sittingDeleteOk
      sittingAsked = false
      tellAct = ""
      nav = replace(nav, sittingBack)
  action pullSitting
    refresh sitting

// The one action on an open project in Experience. Drawn once where it stands is known for this project.
component TellLine
  props
    telling: Telling
    id: string
    error: string
    busy: bool
    tell: action
  view
    if telling.loaded and telling.project == id
      column gap=lookTight() align-items="start" testId="tell"
        if isTold(telling)
          Line(text=`Told on ${telling.lastOn}`, testId="tell-told")
          GoTo(label="Read it", href=path("tell", telling.sitting), testId="tell-read")
        else
          Action(label=tellLabel(telling), press=tell(id), disabled=busy, keys="", testId="tell-start")
        if error != ""
          FailLine(text=error, testId="tell-start-error")

// On an open job: "Tell a story from this job", which opens a one-field form in place. The form keeps its draft itself;
// Add makes the project and opens its first sitting, and a refusal is said under the field with the draft kept.
component StoryStart
  props
    roleId: string
    open: bool
    error: string
    busy: bool
    start: action
    save: action
    cancel: action
  state title = ""
  action editTitle(v: string)
    title = v
  action submit
    save(roleId, title)
  view
    if open
      InPlaceForm(label="Tell a story from this job", testId="story-form")
        FieldLabel(label="Name the piece of work in a few words.")
          input value=title input=editTitle submit=submit placeholder="Merged three deploy systems into one" aria-label="Name the piece of work in a few words." autocomplete="off" autofocus=true aria-invalid=(error != "") testId="story-title"
        if error != ""
          FailLine(text=error, testId="story-error")
        Actions(testId="story-actions")
          MainAction(label="Add", press=submit, disabled=busy, keys="", testId="story-add")
          Action(label="Cancel", press=cancel, disabled=false, keys="", testId="story-cancel")
    else
      Action(label="Tell a story from this job", press=start(`story:${roleId}`), disabled=false, keys="", testId="story-start")

// Under an open project's facts: one quiet line once its story was written from what was told, with the way to read the
// answers; while it waits or is being written, one line in the Activity style, with no spinner; a failure says why.
// Whenever something was said and no writing waits or runs, the story can be written (again) from it.
component StoryLine
  props
    telling: Telling
    id: string
    work: WorkItem[]
    error: string
    busy: bool
    again: action
  derive state = workStatus(work, "derive-story", id, telling.deriveStatus)
  view
    if telling.loaded and telling.project == id and telling.sitting != ""
      column gap=lookTight() align-items="start" testId="story"
        if inHand(state)
          WorkLine(word=statusWord("work", state), place=workPlace(work, "derive-story", id), text=`Writing the story from what you said. Usually ${usualWords(workUsual(work, "derive-story", id))}.`, testId="story-work")
        else
          if state == "failed"
            FailLine(text=`The story couldn’t be written. ${telling.deriveNote}`, testId="story-failed")
          else if telling.toldOn != ""
            QuietLine(text=`Written from what you told on ${telling.toldOn}.`, testId="story-written")
            if telling.deriveNote != ""
              QuietLine(text=telling.deriveNote, testId="story-note")
          Actions(testId="story-actions")
            if telling.toldOn != ""
              GoTo(label="Read what you said", href=path("tell", telling.sitting), testId="story-read")
            if telling.said
              Action(label=storyAgainLabel(telling, state), press=again(id), disabled=busy, keys="", testId="story-again")
        if error != ""
          FailLine(text=error, testId="story-again-error")

// One sitting. While it is open: the conversation in order (the interviewer's lines in the light weight, the owner's
// answers in the heavy weight and stepped in, kept as typed), one quiet line with the question's place, the field and
// its three actions. Once it has ended: the closing line, and what the owner said under each question.
component TellScreen
  props
    sitting: Sitting
    failed: bool
    draft: string
    sending: bool
    stopping: bool
    deleting: bool
    error: string
    asking: string
    // The deletion of the whole sitting is being asked about; one is in flight.
    sittingAsked: bool
    removingSitting: bool
    edit: action
    send: action
    dontKnow: action
    stop: action
    askDelete: action
    keep: action
    remove: action
    askSitting: action
    keepSitting: action
    removeSitting: action
    retry: action
  view
    Page(testId="tell-page")
      if not sitting.loaded
        Section(testId="tell-wait")
          Title(text="Telling", testId="tell-title")
          if sitting.gone
            Line(text="This interview is no longer in your record.", testId="tell-gone")
            GoTo(label="Back to Experience", href=path("bank"), testId="tell-back")
          else if failed
            FailLine(text="This interview couldn’t be loaded. Try again.", testId="tell-load-error")
            Action(label="Try again", press=retry, disabled=false, keys="", testId="tell-retry")
          else
            QuietLine(text="Loading…", testId="tell-loading")
      else
        Section(testId="tell-top")
          GoTo(label="Back to Experience", href=path("project", sitting.project), testId="tell-back")
          Title(text=sitting.name, testId="tell-title")
        if sitting.open
          Section(testId="tell-talk")
            for t, i in sitting.turns key=t.id
              if t.mine
                Indented(testId=`tell-turn-${i}-mine`)
                  OwnWords(text=t.shown, strong=true, testId=`tell-turn-${i}`)
              else
                Line(text=t.text, testId=`tell-turn-${i}`)
          Section(testId="tell-answer-row")
            if sitting.position > 0
              QuietLine(text=positionLine(sitting), testId="tell-position")
            if error != ""
              FailLine(text=error, testId="tell-error")
            // Read-only while an answer is on its way, so words typed meanwhile never join the text already sent.
            // About six lines to start, for talking at length; it grows with the text up to most of the window.
            textarea id="tell-answer" value=draft input=edit readonly=sending field-sizing="content" min-height="10em" max-height="70vh" aria-label="Your answer" placeholder="Your answer, in your own words" testId="tell-answer"
            Actions(testId="tell-actions")
              MainAction(label="Send", press=send, disabled=sending, keys="", testId="tell-send")
              Action(label="I don’t know", press=dontKnow, disabled=sending, keys="", testId="tell-dont-know")
              Action(label="Stop for now", press=stop, disabled=(sending or stopping), keys="", testId="tell-stop")
        else
          Section(testId="tell-end")
            Line(text=sitting.closing, testId="tell-closing")
            if error != ""
              FailLine(text=error, testId="tell-error")
          Section(testId="tell-said")
            SectionHead(text="What you said", testId="tell-said-head")
            if sitting.said.length == 0
              QuietLine(text="Nothing yet.", testId="tell-said-none")
            for g in sitting.said key=saidId(g.key)
              column gap=lookTight() testId=`tell-said-${saidId(g.key)}`
                QuietLine(text=g.question, testId=`tell-q-${saidId(g.key)}`)
                for a, n in g.answers key=a.id
                  column gap=lookTight()
                    if a.followUp != ""
                      QuietLine(text=a.followUp, testId=`tell-a-${saidId(g.key)}-${n}-follow`)
                    OwnWords(text=a.shown, strong=false, testId=`tell-a-${saidId(g.key)}-${n}`)
                    if asking == a.id
                      column gap=lookTight() role="alert"
                        StrongLine(text=answerAsk(a), testId="tell-delete-ask")
                        Actions(testId="tell-delete-actions")
                          DangerAction(label="Delete the answer", press=remove(a.sitting, a.id), disabled=deleting, testId="tell-delete-yes")
                          Action(label="Keep it", press=keep, disabled=false, keys="", testId="tell-delete-no")
                    else
                      DangerAction(label="Delete", press=askDelete(a.id), disabled=deleting, testId=`tell-a-${saidId(g.key)}-${n}-delete`)
            if sittingAsked
              column gap=lookTight() role="alert"
                StrongLine(text=sittingAsk(sitting.answers), testId="tell-delete-sitting-ask")
                Actions(testId="tell-delete-sitting-actions")
                  DangerAction(label="Delete the sitting", press=removeSitting, disabled=removingSitting, testId="tell-delete-sitting-yes")
                  Action(label="Keep it", press=keepSitting, disabled=false, keys="", testId="tell-delete-sitting-no")
            else
              DangerAction(label="Delete this sitting", press=askSitting(path("project", sitting.project)), disabled=removingSitting, testId="tell-delete-sitting")
            GoTo(label="Back to Experience", href=path("project", sitting.project), testId="tell-back-end")

// The owner's own words on this screen: every line break kept, and every space the browser would otherwise fold away
// (a space at a line's start, the second and later spaces of a run, a tab) already drawn by app.ts as a no-break space
// (`drawn`). So it is set pre-line, where no space hangs past a wrapped line and out of its box (which pre-wrap does at
// the largest text size). Only the drawn copy changes; the stored text is never changed. The sizes, weights and colour
// are the look's, as `Prose` sets them (look.contract), which other screens keep using unchanged.
component OwnWords
  props
    text: string
    strong: bool
    testId: string
  view
    text text font-size=lookText() font-weight=(strong ? look().strong : 400) line-height=lookLeading() color="look.ink" white-space="pre-line" overflow-wrap="break-word" testId=testId
