// The Cloudflare Worker for the private studio at https://studio.eggers.dev: it checks the Access sign-in on every
// request, serves the studio's built screens (dist/) and forwards /api/... to the app's server, which runs in a
// Cloudflare Container that this Worker owns (or, as a fallback, on the owner's machine through a tunnel).
// Deploy with `bun studio/tools/deploy.ts` from the repository root, never with a bare `wrangler deploy`: the deploy
// command builds the screens for this origin first.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eggers-studio",
  "main": "worker/index.ts",
  // 2025-11-17 or later gives the Durable Object ctx.exports, which the outbound intercept needs.
  "compatibility_date": "2026-10-15",

  // Served only at https://studio.eggers.dev, a custom domain of this Worker that a Cloudflare Access application
  // protects. The workers.dev address and preview URLs are off: Access does not cover them.
  // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
  // The second entry is a route for every path on the host. Cloudflare runs a route before a custom domain, so a
  // route that another Worker holds on this host would take the traffic. This Worker holds that route itself.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "studio.eggers.dev", "custom_domain": true },
    { "pattern": "studio.eggers.dev/*", "zone_name": "eggers.dev" }
  ],

  // The built screens. The Worker runs first for every path, files too, so nothing is served before its own
  // Access check. html_handling "none" makes the binding a plain file lookup; the Worker itself applies the rule
  // Exact's static host serves pages by (worker/studio.ts).
  // https://developers.cloudflare.com/workers/static-assets/binding/
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // Where /api/... goes: "container" (the server in the container below) or "tunnel" (the server on the owner's
  // machine, through SERVER). Change it here and deploy to fall back to the Mac.
  "vars": { "STUDIO_BACKEND": "container" },

  // The container that runs the app's server and worker (cloud/Dockerfile, built from the repository root). Its
  // Durable Object, StudioContainer, starts it with the image, size and settings (worker/backend.ts): instance
  // standard-1 (1/2 vCPU, 4 GiB memory, 8 GB disk). The durable_object scheduling policy is the current one; the
  // "default" policy is deprecated, and with it max_instances. Only one instance exists: the Worker reaches the
  // container through the one Durable Object named "studio".
  // https://developers.cloudflare.com/containers/configuration/scheduling-policy/
  "containers": [
    {
      "class_name": "StudioContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../cloud/Dockerfile", "build_context": ".." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "STUDIO", "class_name": "StudioContainer" }]
  },
  // The Durable Object class, with SQLite storage (the declarative form of a migration).
  // https://developers.cloudflare.com/containers/configuration/wrangler/
  "exports": {
    "StudioContainer": { "type": "durable-object", "storage": "sqlite" }
  },

  // The private bucket that holds the backups of the studio's data. Nothing else reads it: the container reaches it
  // only through this Worker's backup gateway (worker/backups.ts). Create it once with
  // `wrangler r2 bucket create eggers-studio-data`.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "eggers-studio-data" }],

  // The fallback: the API server on the owner's machine, reached through a private Cloudflare Tunnel
  // (tools/live.ts runs it). The tunnel has no public hostname; only this binding reaches it.
  // https://developers.cloudflare.com/workers-vpc/
  "vpc_services": [{ "binding": "SERVER", "service_id": "01a1e57c-488b-77c2-ac21-8db64302c409", "remote": true }],

  // The Worker's and the container's logs in the dashboard (the keeper's restore and backup lines are there).
  "observability": { "enabled": true },

  // Secrets, set with `wrangler secret put <NAME>` and never written in this file:
  //   ACCESS_TEAM_DOMAIN  the Access team's host name, such as <team>.cloudflareaccess.com
  //   ACCESS_AUD          the Access application's audience (AUD) tag
  //   GH_TOKEN            optional: a GitHub token for the container's gh and git (GitHub sources)
  // Without the first two, the Worker answers every request with 503 and serves nothing.
  // Settings passed to the container when set (as secrets, or as vars for a deploy): EGG_ALLOW_EMPTY=1 (start with
  // no data when the bucket holds no backup yet), EGG_ALLOW_SHRINK=1 (allow a much smaller backup), EGG_CODEX_OPUS,
  // EGG_CODEX_SONNET, EGG_CODEX_HAIKU (the Codex models), EGG_QUIET_MS and EGG_MAX_WAIT_MS (backup timing).
}
