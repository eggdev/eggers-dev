{
  "name": "@eggers/career-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false && wrangler types --check worker-configuration.d.ts",
    "types": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply eggers-career-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply eggers-career-studio --remote",
    "deploy": "vite build && wrangler deploy --config dist/eggers_career_studio/wrangler.json"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
