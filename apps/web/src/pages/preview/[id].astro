---
import type { PublicSiteContent } from '@repo/content'
import SitePage from '@web/components/SitePage.astro'
import { loadPreviewContent } from '@web/content'

const id = Astro.params.id
if (!id) return Astro.redirect('/', 302)

let content: PublicSiteContent
try {
  content = await loadPreviewContent(id)
} catch {
  return Astro.redirect('/404', 302)
}
---

<SitePage content={content} preview />
