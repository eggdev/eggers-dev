---
import '@fontsource-variable/mona-sans/wght.css'
import { makePublicResume } from '@repo/content'
import { loadPublishedContent } from '@web/content'

const resume = makePublicResume((await loadPublishedContent()).resume)
const experiences = resume.experience
const skills = resume.skills
const education = resume.education
const title = resume.profile.name ? `${resume.profile.name} — Résumé` : 'Résumé'
const description = [resume.profile.headline, resume.profile.summary].filter(Boolean).join('. ')
const canonical = new URL('/resume', Astro.site)
const serializedResume = JSON.stringify(resume).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {resume.profile.name && <meta name="author" content={resume.profile.name} />}
    <meta name="theme-color" content="#f2f4f7" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <nav class="actions" aria-label="Résumé actions">
      <a href="/">Back to eggers.dev</a>
      <button type="button" data-export>Export PDF</button>
    </nav>

    <main class:list={['sheet', `sheet--${resume.density}`]} id="resume">
      <header class="resume-header">
        {resume.profile.name && <h1>{resume.profile.name}</h1>}
        {resume.profile.headline && <p class="headline">{resume.profile.headline}</p>}
        {
          (resume.profile.location || resume.profile.email || resume.profile.links.length > 0) && (
            <p class="contact">
              {resume.profile.location && <span>{resume.profile.location}</span>}
              {resume.profile.email && (
                <span><a href={`mailto:${resume.profile.email}`}>{resume.profile.email}</a></span>
              )}
              {resume.profile.links.map((link) => (
                <span><a href={link.href}>{link.label}</a></span>
              ))}
            </p>
          )
        }
        {resume.profile.summary && <p class="summary">{resume.profile.summary}</p>}
      </header>

      {
        experiences.length > 0 && (
          <section>
            <h2><span>Experience</span></h2>
            <div class="entries">
              {experiences.map((entry) => (
                <article class:list={['entry', entry.bullets.length === 0 && 'entry--brief']}>
                  {(entry.role || entry.organization || entry.location || entry.period) && (
                    <div class="entry__head">
                      {(entry.role || entry.organization || entry.location) && (
                        <h3>
                          {entry.role}
                          {entry.organization && (
                            <span class:list={[!entry.role && 'organization--only']}>
                              {entry.organization}
                            </span>
                          )}
                          {entry.location && (
                            <span
                              class:list={[
                                !entry.role && !entry.organization && 'organization--only',
                              ]}
                            >
                              {entry.location}
                            </span>
                          )}
                        </h3>
                      )}
                      {entry.period && <p class="dates">{entry.period}</p>}
                    </div>
                  )}
                  {entry.note && <p class="note">{entry.note}</p>}
                  {entry.bullets.length > 0 && (
                    <ul>
                      {entry.bullets.map((bullet) => <li>{bullet.text}</li>)}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        skills.length > 0 && (
          <section>
            <h2><span>Skills</span></h2>
            <dl>
              {skills.map((row) => (
                <div class="row">
                  {row.label && <dt>{row.label}</dt>}
                  {row.value && <dd>{row.value}</dd>}
                  {row.trailing && <dd class="dates">{row.trailing}</dd>}
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        education.length > 0 && (
          <section>
            <h2><span>Education</span></h2>
            <dl>
              {education.map((row) => (
                <div class="row">
                  {row.label && <dt>{row.label}</dt>}
                  {row.value && <dd>{row.value}</dd>}
                  {row.trailing && <dd class="dates">{row.trailing}</dd>}
                </div>
              ))}
            </dl>
          </section>
        )
      }

    </main>

    <script id="resume-export-data" type="application/json" set:html={serializedResume} />
    <script>
      const exportButton = document.querySelector<HTMLButtonElement>('[data-export]')
      const resumeData = document.querySelector<HTMLScriptElement>('#resume-export-data')

      exportButton?.addEventListener('click', async () => {
        if (!resumeData?.textContent) return
        exportButton.disabled = true
        exportButton.textContent = 'Exporting…'
        try {
          const { downloadResumePdf } = await import('@repo/content/resume-pdf')
          await downloadResumePdf(JSON.parse(resumeData.textContent))
        } catch (error) {
          console.error('Could not export résumé PDF', error)
          exportButton.textContent = 'Export failed — retry'
          return
        } finally {
          exportButton.disabled = false
        }
        exportButton.textContent = 'Export PDF'
      })
    </script>
  </body>
</html>

<style>
  @page {
    size: letter;
    margin: 0;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-width: 320px;
    background: #eef1f5;
    color-scheme: light;
  }

  :global(body) {
    margin: 0;
    color: #29313d;
    font-family:
      'Mona Sans Variable', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
      sans-serif;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  :global(button) {
    font: inherit;
  }

  :global(:focus-visible) {
    outline: 2px solid #2867b2;
    outline-offset: 3px;
  }

  .actions {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    width: min(8.5in, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0.8rem 0;
    background: color-mix(in srgb, #eef1f5 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .actions a,
  .actions button {
    border: 0;
    background: transparent;
    color: #455163;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .actions button {
    border: 1px solid #b9c3d0;
    border-radius: 6px;
    padding: 0.45rem 0.7rem;
    background: #fff;
    color: #245b9d;
  }

  .sheet {
    --body-size: 9.7px;
    --body-leading: 1.42;
    --section-gap: 12px;
    --entry-gap: 10px;
    width: 8.5in;
    min-height: 11in;
    margin: 0 auto 2rem;
    padding: 0.54in 0.7in 0.48in;
    overflow: hidden;
    border: 1px solid #d8dde5;
    background: #fff;
    color: #29313d;
    font-size: var(--body-size);
    line-height: var(--body-leading);
  }

  .sheet--comfortable {
    --body-size: 10.1px;
    --body-leading: 1.48;
    --section-gap: 14px;
    --entry-gap: 12px;
  }

  .sheet--tight {
    --body-size: 9.25px;
    --body-leading: 1.36;
    --section-gap: 10px;
    --entry-gap: 8px;
  }

  .resume-header h1,
  h2,
  h3,
  p,
  ul,
  dl,
  dd {
    margin: 0;
  }

  .resume-header h1 {
    color: #151b24;
    font-size: 27px;
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .headline {
    margin-top: 3px;
    color: #245b9d;
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.005em;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    margin-top: 7px;
    color: #5c6675;
    font-size: 9px;
  }

  .contact span:not(:last-child)::after {
    margin: 0 0.55em;
    color: #a6afbb;
    content: '·';
    font-weight: 700;
  }

  .contact a {
    text-decoration: none;
  }

  .summary {
    max-width: 67em;
    margin-top: 12px;
    color: #333c49;
    font-size: calc(var(--body-size) + 0.25px);
    line-height: 1.48;
  }

  section {
    margin-top: var(--section-gap);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    color: #245b9d;
    font-size: 10px;
    font-weight: 760;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  h2::after {
    flex: 1;
    height: 1px;
    background: #dbe0e7;
    content: '';
  }

  .entry {
    margin-bottom: var(--entry-gap);
    break-inside: avoid;
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .entry--brief {
    margin-bottom: 4px;
  }

  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    color: #151b24;
    font-size: calc(var(--body-size) + 0.7px);
    font-weight: 680;
    line-height: 1.25;
  }

  h3 span {
    color: #5c6675;
    font-weight: 450;
  }

  h3 span::before {
    margin: 0 0.5em;
    color: #c5ccd5;
    content: '·';
    font-weight: 700;
  }

  h3 span.organization--only::before {
    display: none;
  }

  .entry--brief h3 {
    font-size: calc(var(--body-size) + 0.1px);
    font-weight: 570;
  }

  .dates {
    flex: none;
    color: #5c6675;
    font-size: calc(var(--body-size) - 0.55px);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .note {
    margin-top: 1px;
    color: #657080;
    font-size: calc(var(--body-size) - 0.4px);
  }

  ul {
    margin-top: 4px;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    margin-bottom: 2.4px;
    padding-left: 13px;
  }

  li::before {
    position: absolute;
    top: 0.62em;
    left: 1px;
    width: 5px;
    height: 1.5px;
    background: #4878b0;
    content: '';
  }

  .row {
    display: flex;
    gap: 12px;
    margin-bottom: 3px;
  }

  .row:last-child {
    margin-bottom: 0;
  }

  .row dt {
    flex: 0 0 88px;
    color: #151b24;
    font-size: calc(var(--body-size) - 0.15px);
    font-weight: 680;
  }

  .row dd:not(.dates) {
    flex: 1;
  }

  .row dd.dates {
    margin-left: auto;
  }

  @media (max-width: 8.75in) {
    .sheet {
      width: calc(100% - 2rem);
      height: auto;
      min-height: 0;
      padding: clamp(1.5rem, 7vw, 0.54in);
      overflow: visible;
    }

    .contact {
      gap: 0.2rem 0;
    }
  }

  @media print {
    :global(html),
    :global(body) {
      width: 8.5in;
      height: 11in;
      background: #fff;
    }

    .actions {
      display: none;
    }

    .sheet {
      width: 8.5in;
      height: 11in;
      min-height: 11in;
      margin: 0;
      border: 0;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
    }
  }
</style>
