---
import type { PublicSiteContent } from '@repo/content'
import About from '@web/components/About.astro'
import Contact from '@web/components/Contact.astro'
import Footer from '@web/components/Footer.astro'
import HowIWork from '@web/components/HowIWork.astro'
import Rail from '@web/components/Rail.astro'
import Strip from '@web/components/Strip.astro'
import Substrate from '@web/components/Substrate.astro'
import WorkStories from '@web/components/WorkStories.astro'
import BaseLayout from '@web/layouts/BaseLayout.astro'

interface Props {
  content: PublicSiteContent
  preview?: boolean
}

const { content, preview = false } = Astro.props
---

<BaseLayout content={content} noindex={preview}>
  {preview && <div class="fixed right-3 top-3 z-[500] rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">Unpublished preview</div>}
  <Substrate />
  <div class="shell">
    <Rail identity={content.identity} navigation={content.navigation} />
    <main id="main" class="content">
      <Strip identity={content.identity} />
      <WorkStories entries={content.work.stories} />
      <HowIWork process={content.process} />
      <About about={content.about} />
      <Contact contact={content.contact} identity={content.identity} />
      <Footer footer={content.footer} />
    </main>
  </div>
</BaseLayout>
