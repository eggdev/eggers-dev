---
import type { PublicSiteContent } from '@repo/content'

interface Props {
  entries: PublicSiteContent['work']['stories']
}

const { entries } = Astro.props
---

<section id="work" class="section stories">
  {
    entries.map((e) => (
      <article class="story-entry">
        <div class="story-entry__meta">
          <h2 class="story-entry__title">{e.title}</h2>
          <p class="story-entry__role">{e.role}</p>
          <p class="story-entry__period tabular">{e.period}</p>
        </div>
        <div class="story-entry__body">
          <p class="story-entry__opening">{e.opening}</p>
          <p class="story-entry__detail">{e.detail}</p>
          <ul class="story-entry__links">
            {e.links.map((l) => (
              <li>
                <a class="link-arrow" href={l.href} target="_blank" rel="noopener">
                  {l.label}
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M5 11L11 5M11 5H6M11 5V10"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</section>

<style>
  .stories {
    display: grid;
  }
  .story-entry {
    display: grid;
    gap: clamp(1rem, 0.4rem + 2vw, 2.5rem);
    padding-block: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
    border-top: 1px solid var(--hairline);
    transition: border-color var(--dur-mid) var(--ease-out-quart);
  }
  .story-entry:hover {
    border-top-color: var(--accent);
  }
  @media (min-width: 52rem) {
    .story-entry {
      grid-template-columns: minmax(12rem, 0.34fr) 1fr;
    }
  }
  .story-entry__title {
    font-size: var(--text-xl);
    font-weight: var(--w-bold);
    letter-spacing: -0.02em;
  }
  .story-entry__role {
    margin-top: 0.6rem;
    color: var(--ink);
    font-weight: var(--w-medium);
    font-size: var(--text-sm);
  }
  .story-entry__period {
    margin-top: 0.2rem;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  .story-entry__opening {
    max-width: 60ch;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }
  .story-entry__detail {
    margin-top: var(--space-3);
    max-width: 60ch;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }
  .story-entry__links {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    font-size: var(--text-sm);
  }
</style>
