{
  "name": "eggers-dev",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/sitemap": "^3.7.3",
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@effect/sql": "^0.52.1",
    "@effect/sql-d1": "^0.50.0",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@nx/oxlint": "^23.2.1",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.2",
    "jose": "^6.2.12",
    "lefthook": "^2.1.9",
    "nx": "^23.2.1",
    "oxlint": "^1.83.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nx run-many -t dev --all --parallel=3",
    "dev:web": "nx dev web",
    "dev:studio": "nx dev studio",
    "dev:home": "nx dev home",
    "build": "nx run-many -t build --all",
    "check": "nx run-many -t check --all",
    "test": "nx run-many -t test --all",
    "test:e2e": "playwright test",
    "lint": "nx run-many -t lint --all && oxlint playwright.config.ts vitest.config.ts tools e2e && bun run lint:imports",
    "lint:imports": "bun tools/check-imports.ts",
    "format": "biome format --write .",
    "lint:fix": "biome check --write . && oxlint --fix . && bun run lint:imports",
    "deploy:web": "nx deploy web",
    "deploy:studio": "nx deploy studio",
    "deploy:home": "nx deploy home",
    "affected": "nx affected -t lint,check,test,build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@nx/oxlint": "catalog:",
    "@playwright/test": "catalog:",
    "lefthook": "catalog:",
    "nx": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
