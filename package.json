{
  "name": "eggers-dev",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "eve": "0.78.0",
    "ai": "7.0.139",
    "effect": "4.0.4",
    "@electric-sql/pglite": "0.5.9",
    "postgres": "3.4.9",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.56.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "diff": "9.0.0",
    "cheerio": "1.2.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/diff": "8.0.0",
    "nx": "23.3.0",
    "@biomejs/biome": "2.5.15",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.0",
    "tsx": "4.23.15",
    "@fontsource-variable/geist": "5.3.0"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "nx run-many -t dev --projects=studio,web --parallel=2",
    "dev:studio": "nx dev studio",
    "dev:web": "nx dev web",
    "eve:login": "codex login",
    "build": "nx run-many -t build --projects=web,studio --parallel=1",
    "check": "tsc --noEmit -p tsconfig.json && nx run-many -t check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx tools/migrate.ts",
    "import:browser": "tsx tools/import-browser.ts",
    "import:trueup": "tsx tools/import-trueup.ts",
    "format": "biome format --write .",
    "build:eve": "bun run --cwd apps/studio build:eve"
  },
  "devDependencies": {
    "nx": "catalog:",
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/diff": "catalog:",
    "vitest": "catalog:",
    "@playwright/test": "catalog:",
    "tsx": "catalog:"
  }
}
