{
  "name": "eggers-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "studio",
    "home"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:studio": "bun run --cwd studio dev",
    "dev:home": "bun run --cwd home dev",
    "build": "astro build",
    "build:studio": "bun run --cwd studio build",
    "build:home": "bun run --cwd home build",
    "preview": "astro preview",
    "test": "bun test",
    "check": "astro check && bun run --cwd studio check && bun run --cwd home check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deploy": "astro build && wrangler deploy",
    "deploy:studio": "bun run --cwd studio deploy",
    "deploy:home": "bun run --cwd home deploy",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@react-pdf/renderer": "^4.9.0",
    "astro": "^7.1.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.4.16",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.98.0"
  }
}
