test "a resume with no record of which facts each line uses says so once, and shows no fact references"
  size 1280x900
  at "/job/1/resume"
  request POST "/jobs/1/result" {"title": "Staff Engineer", "company": "Nimbus Yard", "place": "Remote", "verdict": "A fair fit.", "requirements": [{"text": "Rail scheduling", "need": "must", "coverage": "strong", "evidence": "The yard scheduler.", "roles": []}, {"text": "Kafka in production", "need": "must", "coverage": "none", "evidence": "Nothing in the record."}], "resume": "# Ada Example\nada@example.com\n\n## Summary\nEngineer who builds rail schedulers.\n\n## Experience\n### Staff Engineer, Lanternfly Rail\nApr 2022 – Jun 2024\n- Built the rail yard scheduler that runs 300 trains a day.\n- Cut planning from 3 hours to 20 minutes for 900 crews.\n- Ran the incident reviews.\n- Mentor two engineers.\n- Cut costs for [number] depots.\n\n### Engineer, Ostrander Freight\n- Moved the freight board to the cloud.\n\n## Skills\nGo\n\n## Awards\nWon a prize, 2018 – 2019"}
  reload
