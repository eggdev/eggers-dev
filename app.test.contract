// Stories. From here P-006, The new booking page, is a story of R-07 with its Action written from what was told;
// P-007, The clinic rota, has nothing written yet. Job J-003 has not been sent.
test "stories opens from Record's second line; a story with a part is listed under its job, opens beside the list, and its spoken story is asked for and appears with its time"
  size 1280x800
  at "/record"
  clock data
  clock settle
  tap "sub-stories"
  clock data
  clock settle
  clock data
  expect text "sub-current" == "Stories"
  expect tree has "stories-beside"
  expect text "stories-group-role:7-head" == "Staff Engineer at Brightwater Health"
  expect text "story-6" == "The new booking page"
  expect text "story-6-sub" == "No spoken story yet · Not practised yet"
  expect tree missing "story-7"
  expect text "story-none" == "Open a story on the left. It opens here, set to be read aloud, and the list stays."
  tap "story-6"
  clock data
  clock settle
  clock data
  expect state topName == "story"
  expect text "story-title" == "The new booking page"
  expect text "story-job" == "Staff Engineer at Brightwater Health"
  expect text "story-parts-first-action" == "I built the booking page for the clinics and set up its rota myself."
  expect text "story-parts-first-context" == "Not written yet."
  expect text "story-write" == "Write the spoken story"
  // Deleting the second sitting queued the story to be written again from what is left: the spoken story waits for it.
  tap "story-write"
  clock data
  expect text "story-error" == "The story is being written from what you said. Ask again when it is done."
  request POST "/test/work" {"kind": "derive-story", "id": 6, "to": "done"}
  tap "story-write"
  clock data
  expect tree missing "story-error"
  expect text "story-work-status" == "Waiting"
  expect text "story-work" == "Writing the spoken story. Usually a few minutes."
  request POST "/test/spoken" {"project": 6, "text": "The clinics took bookings by phone.\n\nI built the booking page for the clinics and set up its rota myself.\n\nI learned to ask the clinics first."}
  // Work waited, so the activity list is asked for within 10 seconds; the story is written, so it loads again.
  clock +10000
  clock data
  clock +1
  clock data
  expect tree missing "story-work"
  expect text "story-text-0" == "The clinics took bookings by phone."
  expect text "story-text-1" == "I built the booking page for the clinics and set up its rota myself."
  expect text "story-time" == "About 10 s when spoken."
  expect text "story-write" == "Write it again"
  expect text "story-parts-action" == "I built the booking page for the clinics and set up its rota myself."
  expect text "story-6-sub" == "10 s · Not practised yet"
  reload
  clock data
  clock settle
  clock data
  expect text "story-title" == "The new booking page"
  expect text "story-time" == "About 10 s when spoken."

