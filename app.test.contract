test "projects are suggested for a role on request; one is kept, one edited then kept with its result, and one is not a project"
  size 1280x800
  request POST "/facts" {"roleId": 4, "text": "Wrote the platform team's on-call guide."}
  request POST "/facts" {"roleId": 4, "text": "Cut the cloud bill by 31%."}
  request POST "/facts" {"roleId": 4, "text": "Interviewed 40 platform candidates."}
  request POST "/facts" {"roleId": 4, "text": "Hired 3 platform engineers."}
  clock data
  tap "nav-record"
  clock settle
  clock data
  tap "role-4"
  clock settle
  clock data
  expect text "suggest" == "Suggest projects"
  tap "suggest"
  clock data
  expect text "suggestions-work-status" == "Waiting"
  request POST "/test/work" {"kind": "propose-projects", "id": 4, "to": "running", "stage": "Grouping the facts into projects"}
  request POST "/test/proposals" {"roleId": 4, "projects": [{"title": "Platform reviews", "facts": ["fact:7", "fact:10"], "result": ""}, {"title": "Cloud move", "facts": ["fact:6", "fact:11"], "result": "fact:6"}, {"title": "Hiring round", "facts": ["fact:12", "fact:13"], "result": ""}, {"title": "Invented", "facts": ["fact:9999", "fact:7"], "result": ""}]}
  request POST "/test/work" {"kind": "propose-projects", "id": 4, "to": "done", "note": "3 projects suggested"}
  reload
  clock data
  clock settle
  expect text "proposal-1-title" == "Platform reviews"
  expect text "proposal-2-result" == "What came of it, if you agree: F-0006, Moved 40 services in two quarters."
  expect tree missing "proposal-4"
  tap "nav-home"
  clock settle
  clock data
  // Home's item opens the role in Record, with its data.
  tap "home-item-proposals:4"
  clock settle
  expect text "home-go" == "See the suggestions"
  tap "home-go"
