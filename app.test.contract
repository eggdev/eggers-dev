// Run by `test` or `verify` against server.ts on one database, empty at the start and shared by
// every test in order: the first finds nothing that needs the person, the second leaves a source and no facts,
// the third two facts. No worker runs, so a source stays waiting; proposed facts are seeded through the API as
// the worker would write them. The app opens at Home.
test "on an empty database home has one item: start the record with a job, in Experience"
  clock data
  expect state nav.tab == "home"
  expect text "home-title" == "Home"
  expect tree missing "home-empty"
  expect text "home-count" == "1 thing needs you"
  expect text "home-focus-text" == "Your record is empty. Add your first job, then tell a story from it."
  expect text "home-go" == "Go to Experience"
  tap "home-go"
  clock data
  clock settle
  clock data
  expect state nav.tab == "bank"
  expect text "nav-current" == "Record"
  expect text "sub-current" == "Experience"
  expect text "bank-empty-text" == "Your record starts with a job."
  expect tree has "bank-add"

test "with nothing waiting or running, an open screen asks for nothing again until it is opened again"
  clock data
  expect state activity.busy == false
  tap "nav-jobs"
  clock settle
  clock data
  // From here every request to the server fails: one asked in the next minute would show as a failed load.
  fail fetch "http://127.0.0.1:8787"
  clock +60000
  clock data
  expect state jobsError == ""
  expect state activityError == ""
  // Opening the list again asks for it again, and that request is the one that fails.
  tap "nav-home"
  clock settle
  tap "nav-jobs"
  clock settle
  clock data
  expect state jobsError == "The studio can’t be reached right now. Try again in a moment."
  pass fetch "http://127.0.0.1:8787"
  tap "nav-home"
  clock settle
  tap "nav-jobs"
  clock settle
  clock +1
  clock data
  expect state jobsError == ""
  expect state activityError == ""

test "a source is added from Sources, waits to be read, refuses a repeat repository in words, and is deleted after asking"
  clock data
  tap "nav-record"
  clock settle
  clock data
  // An empty record starts with a job; sources stay on their own screen.
  expect text "bank-empty-text" == "Your record starts with a job."
  expect text "bank-add" == "Add a job"
  tap "sub-sources"
  clock settle
  clock data
  tap "sources-add"
  clock settle
  expect state nav.tab == "bank"
  expect text "sub-current" == "Sources"
  expect disabled "add-save"
  expect text "add-hint" == "Paste some text to add it."
  type "add-title" "Resume 2024"
  type "add-text" "Staff Engineer at Acme, 2021 to now. Built the billing export service."
  expect text "add-hint" == "What you add is read, and what is found in it goes into your record."
  tap "add-save"
  clock data
  clock settle
  expect state lib.items.0 .title == "Resume 2024"
  expect state lib.items.0 .status == "queued"
  tap "add-source"
  clock settle
  tap "kind-repo"
  expect text "add-hint" == "Enter the repository’s path to add it."
  type "add-repo" "/srv/code/billing"
  expect text "add-hint" == "Enter the name or email your commits use."
  type "add-author" "ada"
  tap "add-save"
  clock data
  clock settle
  expect state lib.items.0 .title == "billing"
  tap "add-source"
  clock settle
  type "add-repo" "/srv/code/billing"
  tap "add-save"
  clock data
  expect text "add-error" == "That repository is already a source. Read it again from its page."
  fail fetch "http://127.0.0.1:87"
  type "add-repo" "/srv/code/web"
  tap "add-save"
  clock data
  expect text "add-error" == "The studio can’t be reached right now. Try again in a moment."
  expect text "add-repo" == "/srv/code/web"
  pass fetch "http://127.0.0.1:87"
  tap "add-cancel"
  clock settle
  tap "discard-edits-confirm"
  clock settle
  tap "source-1"
  clock settle
  expect text "source-title" == "Resume 2024"
  expect text "source-status" == "Read in turn, one source at a time. Usually a few minutes each."
  expect text "source-status-status" == "Waiting"
  expect disabled "source-read"
  expect text "source-hint" == "It can be read again once this reading finishes."
  tap "source-delete"
  clock settle
  tap "remove-source-confirm"
  clock settle
  clock data
  expect state lib.items.length == 1
  expect tree missing "source-1"
  reload
  expect state author == "ada"

test "facts are in the record with no review step; a role shows its reference and dates; one fact is edited with its story, and one is deleted only after asking"
  size 1280x800
  clock data
  tap "nav-record"
  clock settle
  clock data
  expect tree has "bank-add"
  request POST "/roles" {"company": "Acme", "title": "Staff Engineer", "start": "2021-03", "end": ""}
  request POST "/facts" {"roleId": 1, "kind": "project", "text": "Built the billing export service.", "detail": "Finance closed the month by hand. Designed and built the export in Go.", "skills": "Go, Postgres", "evidence": "a1b2c3 billing/export.go"}
  request POST "/facts" {"roleId": 1, "kind": "accomplishment", "text": "Cut checkout latency.", "metric": "900 ms to 210 ms", "evidence": "resume bullet"}
  request POST "/facts" {"kind": "skill", "text": "TypeScript"}
  // Nothing is polled while no work runs: written elsewhere, the facts show once the screen is opened again.
  reload
  clock data
  expect state tree.facts.length == 3
  expect tree missing "bank-add"
  expect text "bank-count" == "1 role · 0 projects · 0 side projects · 3 facts"
  expect text "role-1-ref" == "R-01"
  expect text "role-1" == "Staff Engineer"
  expect text "role-1-sub" == "Acme · Mar 2021–Present · 2 facts"
  tap "role-1"
  clock settle
  clock data
  expect text "pane-ref" == "R-01"
  expect text "pane-title" == "Staff Engineer"
  expect text "role-company" == "Acme"
  expect tree missing "role-company-mark"
  expect text "role-type" == "Not recorded"
  expect text "in-day-1" == "Day to day at Acme · 2 facts"
  // How the work counts for a job: its employment type and whether it reached users.
  tap "pane-edit"
  clock settle
  type "edit-employment" "employee"
  type "edit-reach" "live"
  tap "edit-save"
  clock data
  clock settle
  expect text "role-type" == "Employee"
  expect tree missing "role-type-mark"
  expect text "role-reach" == "In production"
  tap "in-day-1"
  clock settle
  tap "in-fact-1"
  clock settle
  clock data
  expect text "pane-title" == "Built the billing export service."
  expect text "pane-ref" == "F-0001"
  // The record is taken as the owner gave it: no line says where a fact was read from.
  expect tree missing "fact-from"
  expect text "fact-detail-text" == "Finance closed the month by hand. Designed and built the export in Go."
  expect text "crumb-role-1" == "Staff Engineer, Acme"
  expect text "crumb-day-1" == "Day to day at Acme"
  expect text "fact-skills" == "Go, Postgres"
  tap "fact-2"
  clock settle
  clock data
  expect text "pane-sub" == "900 ms to 210 ms · Accomplishment"
  expect tree missing "fact-detail-text"
  tap "pane-edit"
  clock settle
  expect text "edit-text" == "Cut checkout latency."
  type "edit-text" "Cut checkout p95 latency by rewriting the cart query."
  type "edit-story" "Checkout timed out on large carts. Found the N+1 query and replaced it."
  tap "edit-save"
  clock data
  clock settle
  expect text "pane-title" == "Cut checkout p95 latency by rewriting the cart query."
  expect text "fact-detail-text" == "Checkout timed out on large carts. Found the N+1 query and replaced it."
  expect text "pane-sub" == "900 ms to 210 ms · Accomplishment"
  tap "pane-close"
  clock settle
  tap "fact-3"
  clock settle
  clock data
  expect text "crumb-general" == "General"
  tap "pane-delete"
  expect text "delete-ask" == "Delete F-0003? It is removed from your record and stays out when its source is read again. This cannot be undone."
  tap "delete-yes"
  clock data
  clock settle
  expect state tree.facts.length == 2
  expect tree missing "fact-3"

test "the profile is asked for, shows as being written, then shows the document with what is worth adding, and says when the bank has moved on"
  clock data
  tap "nav-record"
  tap "sub-profile"
  clock data
  expect tree has "profile-write"
  tap "profile-write"
  clock data
  expect text "profile-writing" == "Writing your profile from 2 facts. Usually a few minutes."
  expect text "profile-writing-status" == "Waiting"
  request POST "/profile/save" {"body": "# Professional profile\n\n## Summary\n\nI build billing systems.", "gaps": ["What did the billing export replace, and who used it?"]}
  // While work waits, the activity list is asked for every 10 seconds; the profile's writing has ended, so it loads again.
  clock +10000
  clock data
  expect tree has "profile-body"
  expect text "gap-0" == "What did the billing export replace, and who used it?"
  expect state profile.stale == false
  expect enabled "profile-rewrite"
  request POST "/facts" {"roleId": 1, "kind": "responsibility", "text": "Ran the on-call rotation."}
  reload
  clock data
  expect state profile.stale == true
  tap "sub-direction"
  clock settle
  clock data
  type "direction-text" "## Target tracks\n- A. Forward-deployed engineer\n\n## Fit test for a job listing\n1. Does it include mentoring?"
  tap "direction-save"
  clock data
  clock settle
  expect state notes.body == "## Target tracks\n- A. Forward-deployed engineer\n\n## Fit test for a job listing\n1. Does it include mentoring?"
  expect tree missing "direction-save"

test "a picked file is uploaded and waits to be read; a type that can't be read is refused in words and the sheet stays open"
  clock data
  tap "nav-record"
  tap "sub-sources"
  tap "add-source"
  clock settle
  tap "kind-file"
  expect disabled "add-save"
  expect text "add-hint" == "Choose a file to add it."
  tap "add-choose"
  pick "add-pick" "fixtures/notes.zip"
  expect text "add-picked" == "notes.zip"
  tap "add-save"
  clock data
  expect text "add-error" == "That zip isn’t a LinkedIn data export. Unzip it and add the files inside."
  tap "add-choose"
  pick "add-pick" "fixtures/resume.txt"
  expect text "add-picked" == "resume.txt"
  expect tree missing "add-error"
  tap "add-save"
  clock data
  clock settle
  expect state lib.items.0 .kind == "file"
  expect state lib.items.0 .status == "queued"
  expect tree missing "add-save"

test "a LinkedIn export zip becomes one text source; GitHub repositories are searched, ticked and added, and one already added can't be ticked again"
  clock data
  tap "nav-record"
  tap "sub-sources"
  tap "add-source"
  clock settle
  tap "kind-file"
  tap "add-choose"
  pick "add-pick" "fixtures/linkedin.zip"
  tap "add-save"
  clock data
  clock settle
  expect state lib.items.0 .title == "LinkedIn export"
  expect state lib.items.0 .kind == "text"
  tap "add-source"
  clock settle
  tap "kind-github"
  clock data
  expect text "hub-who" == "Signed in to GitHub as ada. Only your own commits are read."
  expect disabled "add-save"
  expect text "add-hint" == "Tick the repositories worth reading."
  type "hub-search" "bill"
  expect tree missing "repo-ada/ledger"
  tap "repo-acme/billing-export"
  type "hub-search" ""
  tap "repo-ada/ledger"
  expect state chosen.length == 2
  expect text "hub-who" == "2 repositories chosen."
  tap "add-save"
  clock data
  clock settle
  expect state lib.items.0 .kind == "github"
  expect state lib.items.1 .kind == "github"
  tap "add-source"
  clock settle
  clock data
  expect disabled "repo-ada/ledger"
  expect tree missing "repo-ada/dotfiles"
  tap "hub-extra"
  expect enabled "repo-ada/dotfiles"
  type "hub-search" "zzz"
  expect text "hub-none" == "No repository matches “zzz”."


test "a posting is added and waits to be read; once read it is ranked by fit and shows each requirement's support, the resume written for it and what changed"
  clock data
  tap "nav-jobs"
  clock data
  tap "jobs-add"
  clock settle
  expect disabled "job-save"
  expect text "job-hint" == "Paste the posting or its link to add it."
  type "job-text" "Staff engineer wanted."
  tap "job-save"
  clock data
  expect text "job-error" == "That is too short to be a job posting. Paste the whole thing."
  type "job-text" "Staff Engineer, Billing at Globex. You will lead a small team building our billing platform in Go and Postgres. Requirements: five or more years building backend systems; experience leading engineers; Go in production. Nice to have: experience with Kafka."
  tap "job-save"
  clock data
  clock settle
  expect state jobs.items.0 .status == "queued"
  expect text "job-1-status" == "New"
  // A job being read says so in one slow-work line, with no spinner.
  tap "job-1"
  clock settle
  clock data
  expect text "job-status-status" == "Waiting"
  expect text "job-status" == "Waiting to be read against your record. Reading usually takes a few minutes."
  expect text "job-title-status" == "New"
  expect tree missing "job-loading"
  expect tree missing "job-balance"
  tap "job-back"
  clock settle
  request POST "/jobs/1/result" {"title": "Staff Engineer, Billing", "company": "Globex", "place": "Remote", "verdict": "A strong fit on leadership and Go.", "requirements": [{"text": "Experience leading engineers", "need": "must", "coverage": "strong", "evidence": "Led five engineers on the billing export at Acme.", "roles": ["role:1"]}, {"text": "Go in production", "need": "must", "coverage": "partial", "evidence": "Go is shown on one project.", "roles": ["role:1"]}, {"text": "Experience with Kafka", "need": "nice", "coverage": "none", "evidence": "Nothing in the bank shows Kafka."}], "strengths": ["Led the billing export team."], "risks": ["No Kafka."], "changes": ["Moved the billing export to the top, since the posting centres on billing."], "gaps": ["Have you run Kafka or another queue in production?"], "terms": ["Go", "Kafka"], "knockouts": [{"question": "Are you authorised to work in the US?", "answer": "unknown", "note": "The bank doesn’t say."}], "resume": "# Ada Example\n\n## Summary\n\nStaff engineer who builds billing systems in Go."}
  // The reading ended: the next look at the activity list (every 10 seconds while work waits) loads the list again.
  clock +10000
  clock data
  expect text "job-1-ref" == "J-001"
  expect text "job-1-span" == "Added today · Fit 64"
  expect text "job-1-status" == "Ready"
  tap "job-1"
  clock settle
  clock data
  expect text "job-title" == "Staff Engineer, Billing at Globex"
  expect text "job-title-ref" == "J-001"
  expect text "job-title-span" == "Added today · Fit 64"
  expect text "job-title-status" == "Ready"
  expect text "job-balance" == "2 of 3 requirements answered · 1 open"
  expect text "job-need-0" == "Experience leading engineers"
  expect text "job-need-0-class" == "Required · answered"
  expect text "job-need-0-evidence" == "Led five engineers on the billing export at Acme."
  expect text "job-need-2-class" == "Preferred · open"
  expect tree missing "job-status"
  expect text "job-verdict" == "A strong fit on leadership and Go."
  // What to look at on the resume is worked out when the questions are next checked (here, by Home's list).
  request GET "/queue"
  reload
  clock data
  expect text "job-flags-head" == "What to look at"
  expect text "job-flag-0" == "The resume lists no job under Experience, and your record has jobs."
  expect text "job-weighed" == "Read against your record. Production work and recent work count for more; set each role’s kind of work under Experience."
  expect text "job-terms-in" == "Go"
  expect text "job-terms-missing" == "Kafka"
  type "job-outcome" "interviewed"
  clock data
  expect state job.outcome == "interviewed"
  type "job-outcome-note" "Two rounds."
  type "job-outcome-note" key "Enter"
  clock data
  expect state job.outcomeNote == "Two rounds."
  type "job-contact" "Sam, my old manager, is a director there"
  type "job-contact" key "Enter"
  clock data
  expect state job.contact == "Sam, my old manager, is a director there"
  tap "job-edit-resume"
  clock settle
  type "resume-text" "# Ada Example\n\n## Summary\n\nStaff engineer who leads billing teams and builds in Go."
  tap "resume-save"
  clock data
  clock settle
  expect state job.resume == "# Ada Example\n\n## Summary\n\nStaff engineer who leads billing teams and builds in Go."
  expect tree missing "resume-save"
  tap "job-write-again"
  tap "replace-edits-confirm"
  clock data
  expect state job.resumeStatus == "queued"
  expect text "job-resume-writing" == "Writing this resume again and having it reviewed. Usually a few minutes. The one you can read now is the last version."
  expect text "job-resume-writing-status" == "Waiting"
  expect text "job-title-status" == "Sent"
  expect disabled "job-write-again"
  tap "job-resume"
  clock settle
  // The resume as the screen (rule 7): written (A), then edited (B). A note on the whole resume is in its block.
  expect text "resume-for" == "V‑001‑B. Written for J‑001, Staff Engineer, Billing at Globex, from your record."
  expect text "note-whole-0" == "Failed check The resume lists no job under Experience, and your record has jobs."
  expect tree has "resume-body"
  expect text "change-0" == "Moved the billing export to the top, since the posting centres on billing."

test "the watchlist takes a company by its job-board link, refuses a link it can't place and a repeat, and removes one; the job list shows what became of a job"
  clock data
  tap "nav-jobs"
  clock data
  expect text "stage-saved-label" == "Saved 0"
  expect text "stage-active-label" == "Active 1"
  tap "stage-saved"
  expect tree missing "job-1"
  expect text "jobs-none" == "Nothing saved. Add a posting, or read one from Found."
  tap "stage-active"
  expect tree has "job-1"
  expect text "job-line-1" == "Remote · You know someone there"
  expect text "job-1-status" == "Sent"
  expect text "stage-note" == "Applied and interviewing. After 14 days with nothing heard, a job is Quiet and moves to Done."
  type "status-1" "rejected"
  clock data
  expect text "stage-done-label" == "Done 1"
  expect text "jobs-none" == "Nothing in progress. A job moves here when you mark it Applied."
  type "job-search" "zzz"
  expect text "jobs-none" == "No job here matches “zzz”."
  type "job-search" ""
  tap "stage-found"
  expect text "leads-note" == "Add companies to your watchlist and their open jobs are found and scored for you."
  tap "open-companies"
  clock settle
  clock data
  expect disabled "companies-check"
  type "company-link" "https://example.com/careers"
  tap "company-add"
  clock data
  expect text "company-error" == "Paste a link to the company’s job board on Greenhouse, Lever or Ashby (boards.greenhouse.io, jobs.lever.co or jobs.ashbyhq.com)."
  type "company-link" "https://jobs.ashbyhq.com/globex"
  tap "company-add"
  clock data
  expect state companies.items.0 .name == "Globex"
  expect state companyLink == ""
  type "company-link" "https://jobs.ashbyhq.com/globex"
  tap "company-add"
  clock data
  expect text "company-error" == "That company is already on your watchlist."
  expect enabled "companies-check"
  tap "company-remove-1"
  clock settle
  tap "remove-company-confirm"
  clock settle
  clock data
  expect state companies.items.length == 0


