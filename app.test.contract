  clock settle
  expect state nav.tab == "publicPage"
  expect text "nav-current" == "System"
  expect text "sub-current" == "Public page"
  expect tree has "public-text"
  tap "sub-backups"
  clock data
  clock settle
  expect state nav.tab == "publicPage"
  expect text "sub-current" == "Backups and sign-in"
  expect text "system-absent" == "Backups and sign-in work only in the deployed studio."
  tap "sub-public"
  clock data
  clock settle
  expect tree has "public-text"
  tap "nav-record"
  clock settle
  expect tree missing "sub-public"
  tap "nav-system"
  clock settle
  expect text "sub-current" == "Public page"

test "the main line goes to each of the six places and marks the current one"
