  clock settle
  clock data
  expect tree has "home-item-skill:quillqueue"
  tap "nav-record"
  clock settle
  clock data
  tap "skill-quillqueue-not-confident"
  clock +8001
  clock data
  clock settle
  clock data
  expect state skillsList.groups.0.skills.0 .question == false
  tap "nav-home"
  clock settle
  clock data
  expect tree missing "home-item-skill:quillqueue"

test "the review carries a mark only while one is held: a saved mark, and one undone, stay as they are"
  at "/record/skills"
  clock data
  tap "skill-quillqueue-confident"
  clock +8001
  clock data
  clock settle
  clock data
  // Saved more than 8 seconds before the review: the review leaves it as it is.
  tap "skill-zephyrdb-not-confident"
  clock +9000
  clock data
  clock settle
  clock data
  expect tree missing "skills-held"
  tap "skills-review"
  clock data
  clock settle
  clock data
  expect tree missing "skills-error"
  expect state skillsList.newCount == 0
  expect state skillsList.groups.0.skills.0 .name == "Zephyrdb"
  expect state skillsList.groups.0.skills.0 .mark == "not-confident"
  // Undone before the review: the stored mark stays.
  tap "skill-zephyrdb-confident"
  expect text "skills-held" == "Marked Zephyrdb as Confident."
  tap "skills-undo"
  tap "skills-review"
  clock data
  clock settle
  clock data
  expect state skillsList.groups.0.skills.0 .mark == "not-confident"
  // Held when the review is made: it goes with the review, once.
  tap "skill-zephyrdb-confident"
  tap "skills-review"
  clock data
  clock settle
  clock data
  expect tree missing "skills-held"
  expect state skillsList.groups.0.skills.0 .mark == "confident"

