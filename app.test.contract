  tap "nav-record"
  clock data
  clock settle
  expect text "role-1-overlap-3" == "Overlaps R-03, Engineer, Initech. Both say Present."
  tap "role-1"
  clock data
  clock settle
  expect text "role-overlap-3" == "Overlaps R-03, Engineer, Initech. Both say Present."
  tap "role-overlap-3-go"
  clock data
  clock settle
  expect state nav.tab == "home"

test "activity opens from the main line; a posting being read is a row with its stage and status word, and no spinner; a failed one says why, is tried again, and is dismissed"
  request POST "/jobs" {"url": "https://jobs.example.com/initech/platform-engineer", "posting": ""}
  request POST "/test/work" {"kind": "read-posting", "id": 2, "to": "running", "stage": "Fetching the posting"}
  clock data
  tap "nav-activity"
  clock settle
  // Opening a screen asks for the activity list again, a moment after it shows.
  clock +1
  clock data
  expect text "nav-current" == "Activity"
  expect state activity.busy == true
  expect text "work-read-posting-2" == "Reading the posting for J-002"
  expect text "work-read-posting-2-status" == "Running"
  expect text "work-read-posting-2-stage" == "Fetching the posting"
  expect text "work-read-posting-2-usual" == "Usually a few minutes"
  expect tree missing "work-read-posting-2-place"
  expect tree missing "activity-loading"
  // A source added earlier still waits for the worker: Waiting, always with its place.
  expect text "work-read-source-2-status" == "Waiting"
  expect tree has "work-read-source-2-place"
  // The reading fails: the next look at the list (every 10 seconds while work waits) shows it, in red, with why.
  request POST "/test/work" {"kind": "read-posting", "id": 2, "to": "failed", "note": "The page asked for a sign-in."}
  clock +10000
  clock data
  expect text "work-read-posting-2-status" == "Failed"
  expect text "work-read-posting-2-reason" == "The page asked for a sign-in."
  expect text "work-read-posting-2-retry" == "Try again"
  tap "work-read-posting-2-retry"
  clock data
  expect text "work-read-posting-2-status" == "Waiting"
  expect tree has "work-read-posting-2-place"
  expect tree missing "work-read-posting-2-retry"
  request POST "/test/work" {"kind": "read-posting", "id": 2, "to": "failed", "note": "The page asked for a sign-in."}
  clock +10000
  clock data
  tap "work-read-posting-2-dismiss"
  clock data
  expect tree missing "work-read-posting-2"
  // The job's own page says the same thing: its reading failed.
  tap "nav-jobs"
  clock settle
  clock data
  tap "job-2"
  clock settle
  clock data
  expect text "job-status" == "Reading failed. The page asked for a sign-in."

test "home says what finished since the owner was here, once, and not after a reload"
  clock data
  reload
  clock data
  expect tree missing "home-digest"
  request POST "/test/work" {"kind": "read-posting", "id": 2, "to": "running"}
  request POST "/test/work" {"kind": "read-posting", "id": 2, "to": "done"}
  // Work still waits, so the activity list is asked for again within 10 seconds, and the finished reading is announced.
  clock +10000
  clock data
  clock +1
  clock data
  expect text "home-digest-head" == "Since you were here"
  expect text "home-digest-0" == "The posting for J-002 was read."
  tap "nav-activity"
  clock settle
  clock +1
  clock data
  expect text "activity-digest" == "Since you were here: the posting for J-002 was read."
  expect state activity.done.0 .subject == "2"
  expect state activity.done.0 .status == "done"
  reload
  clock data
  expect tree missing "activity-digest"
  tap "nav-home"
  clock settle
  clock data
  expect tree missing "home-digest"

test "a job page's status word changes from Waiting to Reading when its reading starts, with no navigation"
  request POST "/jobs" {"url": "https://jobs.example.com/hooli/platform-lead", "posting": ""}
  clock data
  tap "nav-jobs"
  clock settle
  clock data
  tap "job-3"
  clock settle
  clock +1
  clock data
  expect text "job-status-status" == "Waiting"
  expect text "job-title-status" == "New"
  request POST "/test/work" {"kind": "read-posting", "id": 3, "to": "running", "stage": "Fetching the posting"}
  // Work waits, so the activity list is asked for within 10 seconds; the reading has started, so the job loads again.
  clock +10000
  clock data
  clock +1
  clock data
  expect text "job-status-status" == "Running"
  expect text "job-status" == "Fetching the posting. Usually a few minutes."
  expect text "job-title-status" == "Reading"

test "with the resume open, its PDF appears once the resume is written and printed, with no navigation"
  at "/job/3/resume"
  request POST "/test/work" {"kind": "read-posting", "id": 3, "to": "done"}
  request POST "/test/work" {"kind": "write-resume", "id": 3, "to": "running", "stage": "Printing the PDF and checking it"}
  clock +10000
  clock data
  clock +1
  clock data
  expect text "resume-writing-status" == "Running"
  expect text "resume-writing" == "Writing this resume again. Printing the PDF and checking it. Usually a few minutes. This is the last version."
  expect tree missing "resume-pdf"
  request POST "/test/work" {"kind": "write-resume", "id": 3, "to": "done", "resume": "# Ada Example\n\n## Summary\n\nStaff engineer who builds platforms."}
  clock +10000
  clock data
  clock +1
  clock data
  expect tree missing "resume-writing"
  expect text "resume-pdf" == "Get the PDF"

test "when the activity list can't be had, the last answer stands and is asked for again; after three failures one line says so"
  clock data
  expect state activity.busy == true
  fail fetch "http://127.0.0.1:8787/activity"
  clock +10000
  clock data
  clock +1
  clock data
  // The last answer stands: work is still in hand, so the list is still asked for.
  expect state activity.busy == true
  expect state activityFails == 1
  expect tree missing "studio-down-line"
  clock +30000
  clock data
  clock +1
  clock data
  expect state activityFails == 2
  expect tree missing "studio-down-line"
  clock +30000
  clock data
  clock +1
  clock data
  expect state activityFails == 3
  expect text "studio-down-line" == "The studio can’t be reached right now. It will try again."
  expect state activity.busy == true
  pass fetch "http://127.0.0.1:8787/activity"
  clock +60000
  clock data
  clock +1
  clock data
  expect state activityFails == 0
  expect tree missing "studio-down-line"

// The record as a tree. From here the record holds roles R-01 to R-03 (Acme, Northwind, Initech), F-0001, F-0002 and
// F-0004 in Acme's Day to day and F-0005 in General; what these tests add is numbered after them.
test "a role, a project in it, a fact in that project, a Day to day fact and a side project are each added by a form, and each lands in its place with its reference, marked Just added"
  size 1280x800
  clock data
  tap "nav-record"
  clock settle
  clock data
  tap "add-roles"
  clock settle
  type "new-first" "Head of Platform"
  tap "new-save"
  clock data
  expect text "new-error" == "Write the role as title at employer, such as Director of Engineering at Harborlight Systems."
  expect text "new-first" == "Head of Platform"
  // A line that says "at" twice is not split by a guess: the title and the employer are asked apart.
  type "new-first" "Head of Data at Scale at Acme"
  tap "new-save"
  clock data
  expect text "new-error" == "This says “at” more than once, so the studio cannot tell the title from the employer. Write them in their own fields."
  expect text "new-title" == "Head of Data at Scale at Acme"
  expect tree missing "new-first"
  tap "new-cancel"
  clock settle
  tap "add-roles"
  clock settle
  type "new-first" "Head of Platform at Fernway"
  type "new-when" "Mar 2023 – now"
  tap "new-save"
  clock data
  clock settle
  expect text "role-4-ref" == "R-04"
  expect text "role-4-sub-mark" == "Just added"
  expect text "pane-title" == "Head of Platform"
  expect text "pane-sub-mark" == "Just added"
  expect text "in-none-projects" == "No project yet. Add a project."
  tap "add-in-role-4"
  clock settle
  expect tree missing "pane-sub-mark"
  type "new-first" "Moved every service to one cloud"
  type "new-result" "One bill and one on-call rota."
  tap "new-save"
  clock data
  clock settle
  expect text "project-1-ref" == "P-001"
  expect text "project-1-sub-mark" == "Just added"
  expect text "pane-title" == "Moved every service to one cloud"
  expect text "crumb-role-4" == "Head of Platform, Fernway"
  tap "add-in-project-1"
  clock settle
  type "new-first" "Moved 40 services in two quarters."
  tap "new-save"
  clock data
  clock settle
  expect text "fact-6-ref" == "F-0006"
  expect text "fact-6-sub-mark" == "Just added"
  expect text "crumb-project-1" == "Moved every service to one cloud"
  tap "crumb-role-4"
  clock settle
  tap "in-day-4"
  clock settle
  tap "add-in-day-4"
  clock settle
  type "new-first" "Ran the weekly platform review."
  tap "new-save"
  clock data
  clock settle
  expect text "fact-7-sub-mark" == "Just added"
  expect text "crumb-day-4" == "Day to day at Fernway"
  tap "pane-close"
  clock settle
  tap "add-sides"
  clock settle
  type "new-first" "Built tidewater"
  type "new-when" "2015–2019"
  tap "new-save"
  clock data
  clock settle
  expect text "project-2-ref" == "P-002"
  expect text "project-2-sub" == "Side project · 2015–2019 · 0 facts"
  expect text "project-2-sub-mark" == "Just added"
  expect text "pane-title" == "Built tidewater"
  expect text "bank-count" == "4 roles · 1 project · 1 side project · 6 facts"

test "the three views show the same items, and a project added from the Projects view with a new role creates the role"
  size 1280x800
  clock data
