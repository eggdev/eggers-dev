test "the review is recorded; a skill the record gains after it shows first under its own head, and Home and the list agree"
  at "/record/skills"
  clock data
  tap "skills-review"
  clock data
  clock settle
  clock data
  expect state skillsList.reviewed == true
  expect state skillsList.newCount == 0
  expect tree missing "skills-error"
  // The review only makes the Skills lines of unsent resumes due; the worker writes them about 2 minutes later.
  expect text "skills-due" == "Resumes that are not sent get the new list in about 2 minutes."
  request POST "/facts" {"roleId": 1, "text": "Queued the invented jobs.", "skills": "Quillqueue"}
  reload
  clock data
  expect state skillsList.newCount == 1
  expect state skillsList.groups.0.id == "new"
