// Rule 7, stage 3a: on a resume the owner edited, what the studio would write is a suggestion, never a change. A title
// that differs from the record, and a Skills line the reviewed list words otherwise, each drawn in place: the old words
// struck, the new words after them, Keep and Reject under the line, and Undo after either.
test "an edited resume's suggestions: the job's page counts them, and the title and the Skills line are drawn struck and added"
  size 1280x900
  at "/job/1"
  request POST "/jobs/1/result" {"title": "Staff Engineer", "company": "Nimbus Yard", "place": "Remote", "verdict": "A fair fit.", "requirements": [], "resume": "# Ada Example\nada@example.com\n\n## Experience\n### Staff Engineer, Lanternfly Rail\nApr 2022 – Jun 2024\n- Built the rail yard scheduler that runs 300 trains a day.\n\n## Skills\nGo"}
  request POST "/facts" {"text": "Ported the invented ledger to Cobolt.", "skills": "Cobolt"}
  request POST "/skills" {"marks": [{"name": "Cobolt", "mark": "not-confident"}]}
  request POST "/test/edited" {"job": 1, "resume": "# Ada Example\nada@example.com\n\n## Experience\n### Lead Engineer, Lanternfly Rail\nApr 2022 – Jun 2024\n- Built the rail yard scheduler that runs 300 trains a day.\n\n## Skills\nGo, Cobolt", "skills": true}
  reload
  clock data
  clock settle
  expect text "job-resume-suggests" == "The studio suggests 2 changes to this resume."
  tap "job-resume"
  clock data
  clock settle
  // The heading: "Lead" struck, "Staff" added, the rest as it is; the reason beside it as a Suggestion note.
  expect text "line-4-0" == "Lead"
  expect text "line-4-1" == "Staff"
  expect text "line-4-2" == " Engineer, Lanternfly Rail"
  expect text "line-4" == "removed: Lead added: Staff Engineer, Lanternfly Rail"
  expect tree has "sug-4-keep"
  expect tree has "sug-4-reject"
  // Its reason comes first among the line's notes, and the title check it answers is not said again.
  expect text "note-4-0" == "Suggestion Your record gives the title as “Staff Engineer”."
  // The Skills line: the skill the owner marked not confident is struck, and nothing is added.
  expect text "line-9-1" == ", Cobolt"
  expect tree has "sug-9-keep"
  expect text "notes-9" == "Suggestion You marked Cobolt as not confident."

