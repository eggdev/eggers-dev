test "talk starts empty, sends what is written and shows a reply being written, and starts over after asking"
  clock data
  tap "nav-talk"
  clock settle
  expect disabled "talk-send"
  type "talk-composer" "I led the checkout rewrite at Acme."
  tap "talk-send"
  clock data
  clock settle
  expect state talk.messages.length == 2
  expect state talk.messages.0 .body == "I led the checkout rewrite at Acme."
  expect state talk.busy == true
  expect text "talk-composer" == ""
  expect disabled "talk-send"
  expect text "talk-1-who" == "You"
  expect text "talk-1" == "I led the checkout rewrite at Acme."
  expect text "talk-2-who" == "Studio"
  expect text "talk-2-status" == "Waiting"
  expect text "talk-2" == "Writing a reply. It appears here when it is done."
  tap "talk-clear"
  clock settle
  tap "clear-talk-confirm"
  clock settle
  clock data
  expect state talk.messages.length == 0

