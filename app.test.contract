test "home shows a question about two current jobs; an answer waits 8 seconds and can be undone, a bad month is refused in words, and a snooze hides an item"
  request POST "/roles" {"company": "Northwind", "title": "Engineering Manager", "start": "2022-01", "end": ""}
  // Home reads its list when it opens, and does not poll: open it again.
  reload
  clock data
  expect text "home-focus-text" == "Your record says you are at both Staff Engineer at Acme and Engineering Manager at Northwind now. A reader will ask if you hold two jobs. Which is right?"
  expect tree has "home-item-two-current:1:2"
  expect text "home-choice-0" == "Staff Engineer at Acme has ended: give its end date"
  tap "home-choice-0"
  expect tree has "home-value"
  expect disabled "home-save"
  type "home-value" "2023-13"
  tap "home-save"
  expect text "home-held" == "Answered: Staff Engineer at Acme has ended: give its end date (2023-13)."
  expect tree missing "home-item-two-current:1:2"
  tap "home-undo"
  expect tree missing "home-held"
  expect text "home-focus-text" == "Your record says you are at both Staff Engineer at Acme and Engineering Manager at Northwind now. A reader will ask if you hold two jobs. Which is right?"
  expect text "home-value" == "2023-13"
  clock +9000
  clock data
  expect tree has "home-item-two-current:1:2"
  tap "home-save"
  clock +8000
  clock data
  expect text "home-error" == "Give the end date as a year and a month, like 2023-06."
  expect text "home-value" == "2023-13"
  expect tree has "home-item-two-current:1:2"
  tap "home-choice-2"
  type "home-value" "The Northwind role is evenings only, beside the Acme job."
  tap "home-save"
  expect text "home-held" == "Answered: Both are current: write one line that says how they relate (The Northwind role is evenings only, beside the Acme job.)."
  clock +8000
  clock data
  expect tree missing "home-held"
  expect tree missing "home-item-two-current:1:2"
  expect tree missing "home-error"
  type "app" key "s"
  expect text "home-held" == "Snoozed until tomorrow."
  clock +8000
  clock data
  expect state homeList.snoozed == 1

test "two roles that both say Present carry the overlap marker, which leads to Home"
  request POST "/roles" {"company": "Initech", "title": "Engineer", "start": "2023-02", "end": ""}
  clock data
  clock +5000
  clock data
  tap "nav-record"
  clock data
  clock settle
  expect text "role-1-overlap-3" == "Overlaps R-03, Engineer, Initech. Both say Present."
  tap "role-1"
  clock data
  clock settle
  expect text "role-overlap-3" == "Overlaps R-03, Engineer, Initech. Both say Present."
  tap "role-overlap-3-go"
  clock data
  clock settle
  expect state nav.tab == "home"
