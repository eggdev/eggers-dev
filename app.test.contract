// Rule 7, stage 3b: a bullet's new opening, made by code after the owner's Save: a duty opener as the owner's own
// verb, and the tense the job needs. Each drawn in place like any other suggestion, and kept or rejected.
test "a bullet's new opening and its tense are suggested after a Save; one is kept and one rejected"
  size 1280x900
  at "/job/1/resume"
  request POST "/test/edited" {"job": 1, "resume": "# Ada Example\nada@example.com\n\n## Experience\n### Staff Engineer, Lanternfly Rail\nApr 2022 – Jun 2024\n- Responsible for building the rail yard scheduler that runs 300 trains a day.\n- Lead the weekly incident review.\n\n## Skills\nGo"}
  reload
  clock data
  clock settle
  expect text "line-6-0" == "Responsible for building"
  expect text "line-6-1" == "Built"
  expect text "note-6-0" == "Suggestion Opens with what you did: “Built”, in place of “Responsible for building”."
  expect text "line-7-0" == "Lead"
  expect text "line-7-1" == "Led"
  expect text "note-7-0" == "Suggestion Past tense for a job that has ended."
  tap "sug-6-keep"
  clock data
  clock settle
  expect text "line-6" == "Built the rail yard scheduler that runs 300 trains a day."
  expect text "sug-6-text" == "Kept. The suggested words are in."
  tap "sug-7-reject"
  clock data
  clock settle
  expect text "line-7" == "Lead the weekly incident review."
  expect text "sug-7-text" == "Rejected. Your words stay."

// Telling a story (telling.contract). From here R-07 (Staff Engineer, Brightwater Health) has no story yet, and no
// sitting has been held, so its first story's sittings are 1 and 2 and the turns are numbered from 1 in the order they
// are said. The clock is fixed while the story is told, so the day it was told reads the same on every run. The
// interviewer's words are the fixed ones of lib/capture.ts; the answers are in the first person and name no habit, so a
// follow-up comes only where a test asks for one. No worker runs: the stand-in writes the story as the worker would.
test "a job's story is named in place and told: each answer brings the next question at once with its part, and I don't know closes a question for good"
  size 1280x800
  at "/record/role/7"
  request POST "/test/clock" {"now": 1794830400000}
  clock data
  clock settle
  clock data
  expect tree missing "tell-start"
  expect text "story-start" == "Tell a story from this job"
  tap "story-start"
  clock settle
  tap "story-add"
  clock data
  expect text "story-error" == "Name the piece of work in a few words."
  tap "story-cancel"
  clock settle
  expect tree missing "story-form"
  tap "story-start"
  clock settle
  type "story-title" "The new booking page"
  tap "story-add"
  clock data
  clock settle
  clock data
  expect state topName == "tell"
  expect text "tell-title" == "The new booking page"
  expect text "tell-turn-0" == "These questions are a fixed list. They come one at a time, about this one piece of work. Your answers are kept word for word. Afterwards the studio writes the story’s four parts and its facts from them, and you can change what it writes."
  expect text "tell-turn-1" == "Tell me about this project and your part in it."
  expect text "tell-position" == "Context · question 1 of 14"
  type "tell-answer" "I built the booking page for the clinics in my first year."
  tap "tell-send"
  clock data
  expect text "tell-turn-2" == "I built the booking page for the clinics in my first year."
  expect text "tell-turn-3" == "Take me back to the start. What was happening just before you got involved?"
  expect text "tell-position" == "Context · question 2 of 14"
  expect text "tell-answer" == ""
  expect text "tell-dont-know" == "I don’t know"
  tap "tell-dont-know"
  clock data
  expect text "tell-turn-4" == "I don't know"
  expect text "tell-turn-5" == "What did you do yourself on this?"
  expect text "tell-position" == "Action · question 3 of 14"
  expect tree missing "tell-error"
  // Closed for good: the next sitting does not ask it again, and goes on from the question after it.
  tap "tell-stop"
  clock data
  tap "tell-back-end"
  clock data
  clock settle
  clock data
  expect text "pane-title" == "The new booking page"
  expect text "tell-start" == "Carry on telling it"
  tap "tell-start"
  clock data
  clock settle
  clock data
  expect text "tell-turn-1" == "We carry on with the piece of work you named: “The new booking page”"
  expect text "tell-turn-2" == "What did you do yourself on this?"
  expect text "tell-position" == "Action · question 3 of 14"

test "a refused send keeps the draft; a question answered elsewhere is refused in words and the sitting shows as it stands; spaces and line breaks show as typed"
  size 1280x800
  at "/record/tell/2"
  clock data
  type "tell-answer" "?"
  tap "tell-send"
  clock data
  expect text "tell-error" == "The answer has no words in it. If you do not know, say \"I don't know\"."
  expect text "tell-answer" == "?"
  type "tell-answer" ""
  tap "tell-send"
  clock data
  expect text "tell-error" == "The answer is empty."
  // Turn 10 is the question this screen shows; a second tab answers it first.
  request POST "/sittings/2/answer" {"text": "I wrote the plan.", "turn": "10"}
  type "tell-answer" "I set up the booking rota."
  tap "tell-send"
  clock data
  expect text "tell-error" == "That question was already answered. Here is where the sitting stands."
  expect text "tell-answer" == "I set up the booking rota."
  expect text "tell-turn-3" == "I wrote the plan."
  expect text "tell-turn-4" == "Picture a normal week in the middle of it. What were you working on?"
  expect text "tell-position" == "Action · question 4 of 14"
  type "tell-answer" "  I set up the booking rota  myself.\n\nI wrote its first runbook."
  tap "tell-send"
  clock data
  expect tree missing "tell-error"
  expect text "tell-turn-5" == "  I set up the booking rota  myself.\n\nI wrote its first runbook."
  expect text "tell-turn-6" == "Tell me about a point where you had to choose between options."
  tap "tell-stop"
  clock data
  expect text "tell-closing" == "We will stop here for now. Your answers are saved word for word, and the next sitting starts with the questions not yet answered."
  expect tree missing "tell-answer"
  expect tree missing "tell-position"
  expect text "tell-said-head" == "What you said"
  expect text "tell-q-normal-week" == "Picture a normal week in the middle of it. What were you working on?"
  expect text "tell-a-normal-week-0" == "  I set up the booking rota  myself.\n\nI wrote its first runbook."
  expect text "tell-a-before-0" == "I don't know"
  tap "tell-back-end"
  clock data
  clock settle
  clock data
  expect text "pane-title" == "The new booking page"
  expect text "tell-start" == "Carry on telling it"
  // The sitting ended with something said: the story waits to be written, in one line in the Activity style.
  expect text "story-work-status" == "Waiting"
  expect text "story-work" == "Writing the story from what you said. Usually a few minutes."

test "the story is written from what was said: the stand-in model's parts and fact appear with no navigation, and the fact's pane shows what the owner said"
  size 1280x800
  at "/record/tell/2"
  clock data
  tap "tell-back-end"
  clock data
  clock settle
  clock data
  expect tree missing "story-written"
  // The second fact holds a number the owner never said: it is left out, and the line under the facts says so.
  request POST "/test/derive" {"sitting": 2, "result": {"context": "", "action": "I built the booking page for the clinics and set up its rota myself.", "result": "", "learning": "", "facts": [{"text": "Built the booking page for the clinics.", "detail": "", "metric": "", "baseline": "", "team": "", "own_part": "", "skills": [], "kind": "accomplishment", "quotes": [{"turn": 3, "quote": "I built the booking page for the clinics"}]}, {"text": "Cut booking time from 9 days to 2.", "detail": "", "metric": "9 days to 2", "baseline": "", "team": "", "own_part": "", "skills": [], "kind": "accomplishment", "quotes": [{"turn": 3, "quote": "built the booking page"}]}]}}
  // Work waited, so the activity list is asked for within 10 seconds; the story is written, so the project loads again.
  clock +10000
  clock data
  clock +1
  clock data
  expect text "part-action" == "I built the booking page for the clinics and set up its rota myself."
  expect text "part-context-add" == "Add the context"
  expect tree missing "story-work"
  expect text "story-written" == "Written from what you told on 16 Nov 2026."
  expect text "story-note" == "1 fact was left out: it held a number you did not say."
  expect text "story-read" == "Read what you said"
  expect text "story-again" == "Write it again from what you said"
  tap "Built the booking page for the clinics."
  clock data
  clock settle
  clock data
  expect text "pane-title" == "Built the booking page for the clinics."
  expect text "fact-said-0" == "“I built the booking page for the clinics”"
  request POST "/test/clock" {"now": 0}

