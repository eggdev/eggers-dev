  expect text "nav-current" == "Activity"
  expect text "activity-title" == "Activity"
  tap "nav-system"
  clock settle
  expect state nav.tab == "publicPage"
  expect text "nav-current" == "System"
  tap "nav-home"
  clock settle
  expect state nav.tab == "home"
  expect text "nav-current" == "Home"
