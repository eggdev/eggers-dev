// Next to last, since it empties the record every test before it shares; only the first run on the emptied record comes
// after it. Earlier tests leave work waiting with no worker to take it; /test/idle sets it aside, as a start of a new
// record is refused while any waits.
test "a new record is started only once the phrase is typed; Experience is then empty, and a kept job is still listed and waits to be read again"
  at "/record"
  request POST "/facts" {"kind": "accomplishment", "text": "Ran the invented night market."}
  request POST "/test/idle" {}
  reload
  clock data
  expect tree missing "bank-empty-text"
  tap "nav-system"
  clock data
  clock settle
  tap "sub-backups"
  clock data
  clock settle
  expect text "system-absent" == "Backups and sign-in work only in the deployed studio."
  expect text "system-new-record-head" == "Start a new record"
  tap "system-new-record"
  clock settle
  expect text "new-record-title" == "Start a new record?"
  expect disabled "new-record-confirm"
  type "new-record-phrase" "start a new"
  expect disabled "new-record-confirm"
  type "new-record-phrase" "start a new record"
  expect enabled "new-record-confirm"
  tap "new-record-confirm"
  clock data
  clock settle
  clock data
  expect tree has "system-new-record-result"
  tap "nav-jobs"
  clock data
  clock settle
  tap "stage-saved"
  expect tree has "job-1"
  tap "job-1"
  clock data
  clock settle
  expect text "job-status" == "Reading failed. Your record was started again, so this posting has not been read against it. Read it again once your record has facts."
  expect tree missing "job-resume"
  tap "nav-record"
  clock data
  clock settle
  expect text "bank-empty-text" == "Your record starts with a job."

// After the new record: the first run. Home and Experience say how to start, and a job asks for its first story.
test "on the emptied record a job is added from the first-run state, and Home then asks for its first story"
  size 1280x800
  clock data
  tap "nav-home"
  clock settle
  clock data
  expect text "home-focus-text" == "Your record is empty. Add your first job, then tell a story from it."
  tap "home-go"
  clock settle
  clock data
  expect text "bank-empty-text" == "Your record starts with a job."
  expect text "bank-empty-more" == "Under each job you tell one story at a time, and the studio writes the record from what you say."
  tap "bank-add"
  clock settle
  expect tree missing "bank-add"
  type "new-first" "Analyst at Corbel Yard"
  type "new-when" "Mar 2023 – now"
  tap "new-save"
  clock data
  clock settle
  clock data
  expect text "pane-title" == "Analyst"
  expect text "story-start" == "Tell a story from this job"
  tap "nav-home"
  clock settle
  clock data
  expect text "home-focus-text" == "Tell a story from Analyst at Corbel Yard."
  expect text "home-go" == "Open the job"
  tap "home-go"
  clock settle
  clock data
  expect state nav.tab == "bank"
  expect text "nav-current" == "Record"
  expect text "sub-current" == "Experience"
  expect state tree.loaded == true
  expect text "pane-title" == "Analyst"
  expect text "story-start" == "Tell a story from this job"
  reload
  clock data
  clock settle
  clock data
  expect state nav.tab == "bank"
  expect text "pane-title" == "Analyst"
