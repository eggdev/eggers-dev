// The new look (DESIGN.md): a typeset record. Two type sizes, two weights, one ink, one paper, two greys,
// hairline rules and white space; no box, card, fill, shadow, pill or rounded container.
//
// This file is the one place the look's open values are kept (DESIGN.md section 3): `look()` below. Every
// component here reads its sizes, weights and spaces from it, and a screen drawn in the new look uses only
// these components, so a screen never sets a size, weight or colour itself. To try another value, change it
// in `look()`: every new-look screen follows. The colours are tokens in app.tamber (`look.ink`, `look.paper`,
// `look.grey`, `look.line`), because a colour in Exact is a token with its light and dark values.

// The window, from the platform: only its size is read.
shape Viewport
  width: number
  height: number

// One look, as the lab writes it (DESIGN.md section 3). Sizes in px are written in rem where they are drawn,
// so the browser's text size setting still applies.
shape Look
  // How a record is drawn: "catalogue" (stacked fields) or "ledger" (one row, columns).
  record: string
  // Where a reference number shows: "gutter", "inline" or "hidden".
  refs: string
  // The size of `text`, in px (15 to 18).
  textSize: number
  // The size of `title` divided by the size of `text` (1.5 to 2).
  ratio: number
  // The heavy weight; the light one is 400 (500 to 700).
  strong: number
  // The line height of `text` (1.35 to 1.65).
  leading: number
  // The width of the main column, in rem (32 to 44).
  measure: number
  // The width of the notes column, in rem (12 to 20).
  margin: number
  // The space between rows, in px (6 to 20).
  rowGap: number
  // The space between sections, in px (28 to 72).
  sectionGap: number
  // The thickness of a rule, in px (0.5 to 2).
  ruleWeight: number
  // The most margin notes beside one line (0 to 3).
  notes: number

// The look in use: DESIGN.md's defaults.
fn look(): Look = Look(record="catalogue", refs="gutter", textSize=16, ratio=1.75, strong=600, leading=1.5, measure=38, margin=16, rowGap=12, sectionGap=48, ruleWeight=1, notes=2)

// What the components draw with, worked out from `look()`. Nothing else sets a size, weight or space.
fn lookText(): string = `${look().textSize / 16}rem`
fn lookTitle(): string = `${look().textSize * look().ratio / 16}rem`
fn lookLeading(): string = `${look().leading}`
// A title is set a little tighter than running text (tighter clips Geist at the largest text size).
fn lookTitleLeading(): string = `${look().leading - 0.1}`
fn lookMeasure(): string = `${look().measure}rem`
fn lookMargin(): string = `${look().margin}rem`
// The width of a page with a notes column: the main column, the notes column, and a gutter between them and at
// each side (the gutter's px written in rem at the browser's usual 16px). The main line spans this width too, as
// the lab draws it: its hairline and System end where the notes column ends.
fn lookWideMeasure(): string = `${look().measure + look().margin + 3 * lookGutter() / 16}rem`
fn lookRule(): string = `${look().ruleWeight}px`
// The space between a section's head and its rule, and between the lines of one item: half a row's.
fn lookTight(): number = look().rowGap / 2
// The side gutter of a page: a row's space and a third, so a phone keeps a margin of about 16px.
fn lookGutter(): number = look().rowGap + look().rowGap / 3
// The width of a line's number (1 to 9): one and a half figures of text.
fn lookNumberWidth(): string = `${look().textSize * 1.5 / 16}rem`
// The width a reference number takes in the gutter: five figures of text.
fn lookRefWidth(): string = `${look().textSize * 5 / 16}rem`
// Under this width (px) the margin notes move under the main column, and two columns become one.
fn lookNarrow(): number = 640

// The status words (DESIGN.md section 5). A word outside this list is a defect, so the type refuses one. Every old
// state maps here and nowhere else. A job's state is one key (jobs.contract's `jobPhase` picks it): queued and found
// (a posting found on the watchlist) are New; running is Reading; done (read, its resume not ready to send) is Read;
// writing (its resume being written) is Writing; ready (its resume passes the PDF's check) is Ready; applied and
// interviewed are Sent; no-response and quiet (no reply 14 days after it was sent) are Quiet; rejected, offer and
// closed are Closed; failed (the reading) and write-failed (the resume) are Failed.
// A job: New, Reading, Read, Writing, Ready, Sent, Quiet, Closed, Failed. A fact or role: Confirmed, Unsure.
// A question: Open, Answered, Snoozed. Slow work: Waiting, Running, Done, Failed. The public page: Draft, Live, Offline.
fn statusWord(kind: string, old: string): enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Confirmed", "Unsure", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline"> = kind == "job" ? (old == "queued" or old == "found" ? "New" : old == "running" ? "Reading" : old == "done" ? "Read" : old == "writing" ? "Writing" : old == "ready" ? "Ready" : old == "applied" or old == "interviewed" ? "Sent" : old == "no-response" or old == "quiet" ? "Quiet" : old == "rejected" or old == "offer" or old == "closed" ? "Closed" : old == "failed" or old == "write-failed" ? "Failed" : "New") : kind == "fact" or kind == "role" ? (old == "unsure" ? "Unsure" : "Confirmed") : kind == "question" ? (old == "answered" ? "Answered" : old == "snoozed" ? "Snoozed" : "Open") : kind == "work" ? (old == "running" ? "Running" : old == "done" ? "Done" : old == "failed" ? "Failed" : "Waiting") : kind == "public" ? (old == "live" ? "Live" : old == "offline" ? "Offline" : "Draft") : "Open"

// A page: one column, flush left, at most `measure` wide, with a side gutter. Its children are its sections.
component Page
  props
    testId: string
  slot
  view
    column max-width=lookMeasure() padding-left=lookGutter() padding-right=lookGutter() padding-top=lookGutter() padding-bottom=look().sectionGap
      gap=look().sectionGap align-items="stretch" color="look.ink" font-family="'Geist', system-ui" testId=testId
      children

// A section of a page: its rows, a row's space apart, no wider than the main column (on a `WidePage` too).
component Section
  props
    testId: string
  slot
  view
    column gap=look().rowGap max-width=lookMeasure() testId=testId
      children

// A page with a notes column (`WithNote` rows, a document with notes beside it): as wide as the main column, a
// gutter and the notes column. Its ordinary sections keep to the main column's width.
component WidePage
  props
    testId: string
  slot
  view
    column max-width=lookWideMeasure() padding-left=lookGutter() padding-right=lookGutter() padding-top=lookGutter() padding-bottom=look().sectionGap
      gap=look().sectionGap align-items="stretch" color="look.ink" font-family="'Geist', system-ui" testId=testId
      children

// A section whose rows carry margin notes: it spans the notes column too, so its head's rule does.
component WideSection
  props
    testId: string
  slot
  view
    column gap=look().rowGap testId=testId
      children

// The page's title: the larger of the two sizes, in the heavy weight (as the lab sets it).
component Title
  props
    text: string
    testId: string
  view
    text text role="heading" aria-level=1 font-size=lookTitle() font-weight=look().strong line-height=lookTitleLeading() color="look.ink" hyphens="auto" overflow-wrap="break-word" testId=testId

// A section's head: text size, the heavy weight, a hairline under it.
component SectionHead
  props
    text: string
    testId: string
  view
    text text role="heading" aria-level=2 font-size=lookText() font-weight=look().strong line-height=lookLeading() color="look.ink"
      padding-bottom=lookTight() border-bottom-width=lookRule() border-bottom-style="solid" border-bottom-color="look.line" testId=testId

// A rule on its own, between rows.
component Rule
  view
    hr border-top-width=lookRule() color="look.line" margin=0

// A plain line of text.
component Line
  props
    text: string
    testId: string
  view
    text text font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" testId=testId

// A line in the heavy weight: the one item in focus, or a finding that is serious.
component StrongLine
  props
    text: string
    testId: string
  view
    text text font-size=lookText() font-weight=look().strong line-height=lookLeading() color="look.ink" testId=testId

// A secondary line, in grey: where something came from, what it holds up, a hint.
component QuietLine
  props
    text: string
    testId: string
  view
    text text font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=testId

// Running text kept as written: its line breaks stay (a posting, a message). `strong` sets it in the heavy weight.
component Prose
  props
    text: string
    strong: bool
    testId: string
  view
    text text font-size=lookText() font-weight=(strong ? look().strong : 400) line-height=lookLeading() color="look.ink" white-space="pre-wrap" overflow-wrap="break-word" testId=testId

// A failure, in red: what was refused and why, in the words it was refused in.
component FailLine
  props
    text: string
    testId: string
  view
    text text role="alert" font-size=lookText() font-weight=400 line-height=lookLeading() color="-exact-system-red" testId=testId

// A line indented under the line before it: a finding's items, a note moved under its line on a narrow window.
component Indented
  props
    testId: string
  slot
  view
    column padding-left=lookGutter() gap=lookTight() testId=testId
      children

// A status: one word from the fixed list, in grey unless it needs the owner; Failed in red (DESIGN.md rule 3).
component Status
  props
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Confirmed", "Unsure", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    needsYou: bool
    testId: string
  view
    text word font-size=lookText() font-weight=400 line-height=lookLeading() white-space="nowrap" color=(word == "Failed" ? "-exact-system-red" : needsYou ? "look.ink" : "look.grey") testId=testId

// A reference number (F-0142, J-023): tabular figures, in grey; nothing when the look hides references.
component Ref
  props
    code: string
    testId: string
  view
    if look().refs != "hidden"
      text code font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" white-space="nowrap" color="look.grey" testId=testId

// A record's line with its reference number placed as the look says: in a gutter of its own to the left,
// inline before the line, or not at all. `refId` is the reference number's own testId.
component RefRow
  props
    code: string
    refId: string
    testId: string
  slot
  view
    if look().refs == "gutter"
      row align-items="baseline" testId=testId
        column width=lookRefWidth() flex-shrink=0
          Ref(code=code, testId=refId)
        column flex=1 min-width=0 gap=lookTight()
          children
    else if look().refs == "inline"
      row align-items="baseline" gap=lookTight() testId=testId
        Ref(code=code, testId=refId)
        column flex=1 min-width=0 gap=lookTight()
          children
    else
      column gap=lookTight() testId=testId
        children

// The parts of a record's second line, joined as DESIGN.md writes them: "2019–2023 · 48 facts".
fn joinDot(parts: string[]): string = parts.filter(p => p != "").join(" · ")

// A record's second line: its dates and extent, then its status word (DESIGN.md rule 4: reference, name, dates,
// extent, status, provenance). `showWord` false leaves the status out where the data holds none.
component RecordMeta
  props
    span: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Confirmed", "Unsure", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    // Where it waits, after a Waiting ("2 ahead"); "" for none.
    place: string
    needsYou: bool
    testId: string
  view
    row align-items="baseline" flex-wrap="wrap" column-gap="0.3em"
      if span != ""
        text span font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-span`
      if span != "" and showWord
        text "·" aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      if showWord
        row align-items="baseline" flex-wrap="wrap"
          Status(word=word, needsYou=needsYou, testId=`${testId}-status`)
          if place != ""
            text `, ${place}` font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=`${testId}-place`

// A record in a list or at the head of its page, drawn as the look says (`look().record`). Catalogue: the name;
// then dates, extent and status on one line; then the provenance (DESIGN.md, three lines, not six). Ledger, on a
// wide window: one row, the parts in aligned columns, the provenance under the name. `href` makes the name a link
// to the record's own page ("" draws it as text); `strong` sets it in the heavy weight, for a record that heads
// the records under it. `code` "" is a row with no reference number. Extra lines (a marker, a note) go in the slot,
// under the record. testIds: the link or name is `testId`, the reference `testId-ref`, the second line
// `testId-span` and `testId-status`, the provenance `testId-from`.
component Record
  props
    code: string
    name: string
    href: string
    strong: bool
    dates: string
    extent: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Confirmed", "Unsure", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    place: string
    provenance: string
    wide: bool
    testId: string
  slot
  view
    if look().record == "ledger" and wide
      RefRow(code=code, refId=`${testId}-ref`, testId=`${testId}-record`)
        row align-items="baseline" gap=lookGutter()
          column flex=1 min-width=0 gap=lookTight()
            RecordName(name=name, href=href, strong=strong, testId=testId)
            if provenance != ""
              QuietLine(text=provenance, testId=`${testId}-from`)
          text joinDot([dates, extent]) width=lookRefWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-span`
          column width=lookRefWidth() flex-shrink=0
            if showWord
              Status(word=word, needsYou=false, testId=`${testId}-status`)
        children
    else if code == "" or (not wide and look().refs != "hidden")
      // A narrow window gives the reference number a line of its own above the name: a gutter would take a fifth
      // of a phone's width, and most of it at the largest text size (DESIGN.md section 3, found in the lab).
      column gap=lookTight() testId=`${testId}-record`
        if code != ""
          Ref(code=code, testId=`${testId}-ref`)
        RecordName(name=name, href=href, strong=strong, testId=testId)
        RecordMeta(span=joinDot([dates, extent]), word=word, showWord=showWord, place=place, needsYou=false, testId=testId)
        if provenance != ""
          QuietLine(text=provenance, testId=`${testId}-from`)
        children
    else
      RefRow(code=code, refId=`${testId}-ref`, testId=`${testId}-record`)
        RecordName(name=name, href=href, strong=strong, testId=testId)
        RecordMeta(span=joinDot([dates, extent]), word=word, showWord=showWord, place=place, needsYou=false, testId=testId)
        if provenance != ""
          QuietLine(text=provenance, testId=`${testId}-from`)
        children

// A list of records (jobs, found postings, companies): each record is several lines, so records stand twice a
// row's space apart, and the lines of one record half a row's.
component RecordList
  props
    testId: string
  slot
  view
    column gap=(look().rowGap * 2) testId=testId
      children

// A record's name: a link to its page, or plain text; heavy for a record that heads others.
component RecordName
  props
    name: string
    href: string
    strong: bool
    testId: string
  view
    if href != ""
      link href=href align-self="flex-start" testId=testId
        text name font-size=lookText() font-weight=(strong ? look().strong : 400) line-height=lookLeading() color="look.ink"
    else
      text name font-size=lookText() font-weight=(strong ? look().strong : 400) line-height=lookLeading() color="look.ink" testId=testId

// A record at the head of its own page: the reference number, the name as the page's title, then the record's
// second line and its provenance. testIds as Record's.
component RecordHead
  props
    code: string
    name: string
    dates: string
    extent: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Confirmed", "Unsure", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    place: string
    provenance: string
    testId: string
  slot
  view
    column gap=lookTight() testId=`${testId}-record`
      if code != ""
        Ref(code=code, testId=`${testId}-ref`)
      Title(text=name, testId=testId)
      RecordMeta(span=joinDot([dates, extent]), word=word, showWord=showWord, place=place, needsYou=false, testId=testId)
      if provenance != ""
        QuietLine(text=provenance, testId=`${testId}-from`)
      children

// A label over its value: a fact's role, a source's address. The value carries the testId.
component Labelled
  props
    label: string
    value: string
    testId: string
  view
    column
      text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      text value font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A label over a control the platform draws (a text field, a text area, a select). The control names itself
// for a screen reader by its own `aria-label`; this label is for the eye.
component FieldLabel
  props
    label: string
  slot
  view
    column gap=lookTight() align-items="stretch" max-width=lookMeasure()
      text label aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      children

// A search field, drawn by the platform.
component SearchField
  props
    value: string
    label: string
    hint: string
    change: action
    testId: string
  view
    input type="search" value=value input=change placeholder=hint aria-label=label autocapitalize="none" autocomplete="off" max-width=lookMeasure() testId=testId

// A choice among a few words (the kind of a source): one line of words, the chosen one in the heavy weight.
component Choices
  props
    label: string
  slot
  view
    row role="radiogroup" aria-label=label flex-wrap="wrap" column-gap=lookGutter() align-items="baseline"
      children

component ChoiceWord
  props
    label: string
    chosen: bool
    press: action
    testId: string
  view
    button role="radio" aria-checked=chosen press=press text-align="start" testId=testId
      HeavyWidth(label=label)
        text label font-size=lookText() font-weight=(chosen ? look().strong : 400) line-height=lookLeading() color="look.ink" testId=`${testId}-label`

// A word that is set heavy when it is the current one keeps the heavy word's width always, so the words beside it
// do not move: an unseen heavy copy under it, of no height, holds the width. Its slot is the word as shown.
component HeavyWidth
  props
    label: string
  slot
  view
    column align-items="start"
      children
      text label aria-hidden=true font-size=lookText() font-weight=look().strong line-height=lookLeading() height=0 overflow="hidden" visibility="hidden"

// A line with a box to tick, drawn by the platform, and a grey line under it ("" for none).
component CheckLine
  props
    label: string
    detail: string
    checked: bool
    disabled: bool
    change: action
    testId: string
  view
    row align-items="baseline" gap=lookTight()
      input type="checkbox" checked=checked disabled=disabled change=change aria-label=label flex-shrink=0 testId=testId
      column flex=1 min-width=0
        text label font-size=lookText() font-weight=400 line-height=lookLeading() color=(disabled ? "look.grey" : "look.ink") overflow-wrap="break-word"
        if detail != ""
          text detail font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" overflow-wrap="break-word"

// A link that opens outside the studio (a sign-in page, a posting), in a new tab.
component OutLink
  props
    label: string
    href: string
    testId: string
  view
    link href=href target="_blank" align-self="flex-start" overflow-wrap="break-word" testId=testId
      text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink"

// Slow work in one line (DESIGN.md rule 8): its status word (Waiting with its place, "2 ahead"), then what is
// happening and how long it usually takes.
component WorkLine
  props
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Confirmed", "Unsure", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    place: string
    text: string
    testId: string
  view
    row align-items="baseline" flex-wrap="wrap" column-gap="0.3em"
      row align-items="baseline" flex-wrap="wrap"
        Status(word=word, needsYou=false, testId=`${testId}-status`)
        if place != ""
          text `, ${place}` font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=`${testId}-place`
      text "·" aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      text text font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" testId=testId

// The main line: the places of the studio as plain words, flush left, with a hairline under it and no fill. It is
// the root's tab bar drawn by the app (`appearance="none"`), so each place keeps its own stack. Its tabs are
// `NavTab`s; the last, System, is pushed to the far end.
component MainLine
  props
    testId: string
  slot
  view
    row flex-shrink=0 background-color="look.paper" testId=testId
      // As the lab draws it: the line spans the page with its notes column, from where the text starts to where
      // the notes column ends, and its hairline ends there too, with System at that end.
      row flex=1 max-width=lookWideMeasure() padding-left=lookGutter() padding-right=lookGutter()
        // The tabs are the tablist's own children: the host finds each tab's panel through them.
        // The host's tab bar draws a line above itself; this bar has its one hairline below.
        row role="tablist" appearance="none" aria-label="Places" flex=1 flex-wrap="wrap" column-gap=lookGutter() align-items="baseline"
          border-top-width=0 border-bottom-width=lookRule() border-bottom-style="solid" border-bottom-color="look.line" background-color="look.paper"
          padding-top=lookTight() padding-bottom=lookTight()
          children

// One place on the main line: the current one in the heavy weight; `quiet` sets it in grey (System) unless current.
// Its label's testId is "nav-current" while it is the current place, so a test can read which one is marked.
component NavTab
  props
    label: string
    current: bool
    quiet: bool
    far: bool
    controls: string
    press: action
    testId: string
  view
    button role="tab" appearance="none" aria-selected=current aria-controls=controls press=press
      margin-left=(far ? "auto" : 0) padding-top=lookTight() padding-bottom=lookTight() padding-left=0 padding-right=0 text-align="start" testId=testId
      HeavyWidth(label=label)
        text label font-size=lookText() font-weight=(current ? look().strong : 400) line-height=lookLeading()
          color=(quiet and not current ? "look.grey" : "look.ink") testId=(current ? "nav-current" : `${testId}-label`)

// The band that holds the second line, under the main line, lined up with the page's column.
component SubBar
  props
    testId: string
  slot
  view
    column flex-shrink=0 max-width=lookMeasure() padding-left=lookGutter() padding-right=lookGutter() padding-top=look().rowGap background-color="look.paper" testId=testId
      children

// The second line, under the main one on a place that holds several screens (Record, System).
component SubLine
  props
    label: string
  slot
  view
    nav aria-label=label
      row flex-wrap="wrap" column-gap=lookGutter() align-items="baseline"
        children

// One screen on the second line: the current one in the heavy weight, marked for a screen reader. Its label's
// testId is "sub-current" while it is the current screen.
component SubLink
  props
    label: string
    current: bool
    press: action
    testId: string
  view
    button press=press aria-current=(current ? "page" : "false") text-align="start" testId=testId
      HeavyWidth(label=label)
        text label font-size=lookText() font-weight=(current ? look().strong : 400) line-height=lookLeading() color="look.ink"
          testId=(current ? "sub-current" : `${testId}-label`)

// A numbered line (1, 2, 3 …): the number in a narrow column of its own, in tabular figures, then the line.
component Numbered
  props
    n: number
  slot
  view
    row align-items="baseline"
      text `${n}` aria-hidden=true width=lookNumberWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey"
      column flex=1 min-width=0 gap=lookTight()
        children

// A list item (the profile's lists): an en dash in the number's column, then the line.
component Bulleted
  props
    testId: string
  slot
  view
    row align-items="baseline" testId=testId
      text "–" aria-hidden=true width=lookNumberWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      column flex=1 min-width=0 gap=lookTight()
        children

// A label beside a control the platform draws, on one line (a job's outcome in a list): the label in grey.
component InlineField
  props
    label: string
  slot
  view
    row align-items="baseline" flex-wrap="wrap" column-gap=lookTight() row-gap=lookTight()
      text label aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      children

// A one-line text field, drawn by the platform, with its label for a screen reader and a hint while empty.
component ValueField
  props
    value: string
    label: string
    hint: string
    change: action
    submit: action
    testId: string
  view
    input value=value input=change submit=submit placeholder=hint aria-label=label autocomplete="off" max-width=lookMeasure() testId=testId

// A line of actions side by side (Save, Cancel), a gutter apart, wrapping on a narrow window.
component Actions
  props
    testId: string
  slot
  view
    row flex-wrap="wrap" column-gap=lookGutter() row-gap=lookTight() align-items="baseline" testId=testId
      children

// An action: the platform's plain text button. `keys` is its one-key shortcut ("" for none).
component Action
  props
    label: string
    press: action
    disabled: bool
    keys: string
    testId: string
  view
    button press=press disabled=disabled aria-keyshortcuts=keys text-align="start" testId=testId
      text label font-size=lookText() font-weight=400 line-height=lookLeading()

// The main action of a screen: the same button, in the heavy weight.
component MainAction
  props
    label: string
    press: action
    disabled: bool
    keys: string
    testId: string
  view
    button press=press disabled=disabled aria-keyshortcuts=keys text-align="start" testId=testId
      text label font-size=lookText() font-weight=look().strong line-height=lookLeading()

// A destructive action: red. The screen asks before it does what it says.
component DangerAction
  props
    label: string
    press: action
    disabled: bool
    testId: string
  view
    button press=press disabled=disabled text-align="start" accent-color="-exact-system-red" testId=testId
      text label font-size=lookText() font-weight=400 line-height=lookLeading() color="-exact-system-red"

// A link to another screen (or a file to save), as a plain action: in ink, like the actions beside it, since the
// look keeps no accent colour (DESIGN.md section 3).
component GoTo
  props
    label: string
    href: string
    testId: string
  view
    link href=href align-self="flex-start" testId=testId
      text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink"

// A row with a margin note: the main column, and beside it, `margin` wide, its notes. Under 640px the notes
// move under the main column, indented. The caller puts the note in a `Note` after the main content, and passes
// `wide` (the root reads the window: `viewport.width >= lookNarrow()`), since only the root reads the window.
component WithNote
  props
    wide: bool
    testId: string
  slot
  view
    if wide
      row align-items="start" gap=lookGutter() testId=testId
        children
    else
      column gap=lookTight() testId=testId
        children

// The parts of a `WithNote`: its main column, then its note.
component Main
  slot
  view
    column flex=1 min-width=0 max-width=lookMeasure() gap=lookTight()
      children

// A column of notes in the margin (a resume's flags): `margin` wide beside the main column on a wide window; on a
// narrow one it is drawn where the caller puts it, indented.
component Aside
  props
    wide: bool
    label: string
    testId: string
  slot
  view
    column role="complementary" aria-label=label width=(wide ? lookMargin() : "auto") flex-shrink=0 padding-left=(wide ? 0 : lookGutter()) gap=look().rowGap testId=testId
      children

component Note
  props
    wide: bool
    text: string
    testId: string
  view
    column width=(wide ? lookMargin() : "auto") flex-shrink=0 padding-left=(wide ? 0 : lookGutter())
      text text font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=testId
