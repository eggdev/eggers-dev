// The look (DESIGN.md sections 1 to 6): the Linear system. A near-black page, Geist, one indigo accent, compact
// density. Depth is a lighter fill and one outline: a card is one step lighter than the page, a control or a tag one
// step lighter than the card, a hovered row one step lighter again. Status is a word in a tag; the one main action
// of a screen is the platform's filled button.
//
// This file is the one place the look's open values are kept (DESIGN.md section 3): `look()` (the text size, the
// measure and the gaps) and `scale()` (the other type sizes, the radii, the card padding and the widths of the
// shell). Every component here reads its sizes, weights and spaces from them, and a screen uses only these
// components, so a screen never sets a size, weight or colour itself. To try another value, change it there:
// every screen follows. The colours are tokens in app.tamber (`look.paper`, `look.card`, `look.raised`,
// `look.hover`, `look.line`, `look.ink`, `look.grey`, `look.faint`, `look.link`, `look.green`, `look.amber`,
// `look.red`), each with one value, since the look is dark only.

// The window, from the platform: only its size is read.
shape Viewport
  width: number
  height: number

// One look, as the lab writes it (DESIGN.md section 3). Sizes in px are written in rem where they are drawn,
// so the browser's text size setting still applies.
shape Look
  // How a record is drawn: "catalogue" (stacked fields) or "ledger" (one row, columns).
  record: string
  // Where a reference number shows: "gutter", "inline" or "hidden".
  refs: string
  // The size of `text`, in px (15 to 18).
  textSize: number
  // The size of `title` divided by the size of `text` (1.5 to 2).
  ratio: number
  // The heavy weight; the light one is 400 (500 to 700).
  strong: number
  // The line height of `text` (1.35 to 1.65).
  leading: number
  // The width of the main column, in rem (32 to 44).
  measure: number
  // The width of the notes column, in rem (12 to 20).
  margin: number
  // The space between rows, in px (6 to 20).
  rowGap: number
  // The space between sections, in px (28 to 72).
  sectionGap: number
  // The thickness of a rule, in px (0.5 to 2).
  ruleWeight: number
  // The most margin notes beside one line (0 to 3).
  notes: number

// The look in use: DESIGN.md's defaults.
fn look(): Look = Look(record="catalogue", refs="gutter", textSize=14, ratio=1.43, strong=600, leading=1.5, measure=42, margin=18, rowGap=12, sectionGap=24, ruleWeight=1, notes=2)

// The rest of DESIGN.md section 3: the type sizes beside `text` and `title` (look()'s), the radii, the card's padding
// and the widths of the shell. Sizes and spaces in px at the browser's usual 16px; each is drawn in rem.
shape Scale
  // The one thing a page is about (a name, one number): 28px, the heavy weight.
  display: number
  // A card's title, a record's name: 16px, the medium weight.
  lead: number
  // A label, secondary detail: 13px.
  small: number
  // A tag, a count, a table's column head: 11px, the medium weight.
  caption: number
  // The medium weight (a label, a control, a lead); the heavy one is look().strong, the light one 400.
  medium: number
  // Line heights: the display size, a title, and a lead, a small line or a caption (`text` has look().leading).
  displayLeading: number
  titleLeading: number
  smallLeading: number
  // The page's side inset: 16px on a narrow window, 24px from `wideFrom` (the shell adds the difference).
  inset: number
  insetWide: number
  // The side inset of an action of the app's own (Action), in px: it stays the same at every text size, so the
  // label's longest word keeps its room in a narrow column when the text is set large.
  actionInset: number
  // A card's padding, and the space inside a group (a label and its field, a title and its line).
  cardPad: number
  inner: number
  // Radii: a key cap, a control or a row, a card, a sheet.
  keyRadius: number
  controlRadius: number
  cardRadius: number
  sheetRadius: number
  // Widths in rem: the sidebar and the rail. From `wideFrom` px wide the sidebar and the rail show.
  sidebar: number
  rail: number
  wideFrom: number

fn scale(): Scale = Scale(display=28, lead=16, small=13, caption=11, medium=500, displayLeading=1.35, titleLeading=1.3, smallLeading=1.4, inset=16, insetWide=24, actionInset=10, cardPad=16, inner=6, keyRadius=4, controlRadius=6, cardRadius=8, sheetRadius=12, sidebar=11.5, rail=20, wideFrom=1040)

// The sizes as drawn, in rem, so the browser's text size setting still applies.
fn lookDisplay(): string = `${scale().display / 16}rem`
fn lookLead(): string = `${scale().lead / 16}rem`
fn lookSmall(): string = `${scale().small / 16}rem`
fn lookCaption(): string = `${scale().caption / 16}rem`
fn lookCardPad(): string = `min(${scale().cardPad / 16}rem, 24px)`
fn lookInner(): string = `${scale().inner / 16}rem`
fn lookSidebar(): string = `${scale().sidebar}rem`
fn lookRail(): string = `${scale().rail}rem`
// The page's side inset, `inset`. From `wideFrom` px wide the shell adds the rest of `insetWide` (lookShellInset) on the
// page area's left, beside the sidebar, so every screen moves in by the same amount, also those that set their own
// padding from `lookGutter()`.
fn lookInset(): string = `min(${scale().inset / 16}rem, 24px)`
fn lookShellInset(): string = `${(scale().insetWide - scale().inset) / 16}rem`
// Whether the sidebar and the rail show, for the root, which reads the window.
fn lookWide(width: number): bool = width >= scale().wideFrom

// The Experience screen's own values, as the owner chose them in its lab (lab/experience-keeper.json, DESIGN.md
// "Experience"): the view /record opens in, how many facts a group shows before "Show all", how far each level of the
// tree steps in (rem), and the window width (px) from which an opened item is drawn beside the list.
shape ExperienceLook
  firstView: string
  factsShown: number
  indent: number
  besideFrom: number

fn experienceLook(): ExperienceLook = ExperienceLook(firstView="roles", factsShown=6, indent=1.5, besideFrom=1040)
// A text set to be read aloud (the spoken story, DESIGN.md section 12): the `text` size, with looser leading and a
// narrower column than running text, so the eye finds the next line while the voice runs on. leading: line height;
// measure: the column's width, in rem; paragraphGap: the space between paragraphs, in rows.
shape ReadingLook
  leading: number
  measure: number
  paragraphGap: number

fn readingLook(): ReadingLook = ReadingLook(leading=1.7, measure=34, paragraphGap=1.5)

// From this width an opened item is drawn beside the list; under it, under its own row.
fn lookBeside(): number = experienceLook().besideFrom
// How far a row of the tree steps in at a level (0 for the top).
fn lookStep(level: number): string = `${level * experienceLook().indent}rem`

// What the components draw with, worked out from `look()`. Nothing else sets a size, weight or space.
fn lookText(): string = `${look().textSize / 16}rem`
fn lookTitle(): string = `${look().textSize * look().ratio / 16}rem`
fn lookLeading(): string = `${look().leading}`
// The line heights of DESIGN.md section 3: a title 1.3, the display size 1.35, a lead, a small line and a caption 1.4.
fn lookTitleLeading(): string = `${scale().titleLeading}`
fn lookDisplayLeading(): string = `${scale().displayLeading}`
fn lookSmallLeading(): string = `${scale().smallLeading}`
fn lookMeasure(): string = `${look().measure}rem`
fn lookMargin(): string = `${look().margin}rem`
// The width of a page with a notes column: the main column, the notes column, and a gutter between them and at
// each side (the gutter's px written in rem at the browser's usual 16px). The main line spans this width too, as
// the lab drew it.
fn lookWideMeasure(): string = `${look().measure + look().margin + 3 * lookGutter() / 16}rem`
fn lookRule(): string = `${look().ruleWeight}px`
// The space between a section's head and its rule, and between the lines of one item: half a row's.
fn lookTight(): number = look().rowGap / 2
// The side gutter of a page: a row's space and a third, so a phone keeps a margin of about 16px.
fn lookGutter(): number = look().rowGap + look().rowGap / 3
// The width of a line's number (1 to 9): one and a half figures of text.
fn lookNumberWidth(): string = `${look().textSize * 1.5 / 16}rem`
// The width of a field's name beside its value ("Employment type"): nine figures of text.
fn lookLabelWidth(): string = `${look().textSize * 9 / 16}rem`
// The width a reference number takes in the gutter: five figures of text.
fn lookRefWidth(): string = `${look().textSize * 5 / 16}rem`
// Under this width (px) the margin notes move under the main column, and two columns become one.
fn lookNarrow(): number = 640

// The resume as the screen (rule 7), as the owner chose it in the lab (lab/resume-keeper.json): `cite` "gutter" sets each
// line's fact references in a column to its left, "none" leaves them out (the role references and the notes stay);
// `maxNotes` notes beside one line before "N more". The widths are look()'s measure and margin, the space look()'s rowGap.
shape ResumeLook
  cite: string
  maxNotes: number
fn resumeLook(): ResumeLook = ResumeLook(cite="gutter", maxNotes=2)
// The gutter of a resume's rows: the fact references and the role references, narrower on a phone.
fn resumeGutter(wide: bool): string = wide ? `${look().textSize * 5.25 / 16}rem` : `${look().textSize * 4.6 / 16}rem`
// The resume screen's page: the gutter, the resume column, the notes column and the space between them.
fn resumeWidth(): string = `${look().textSize * 5.25 / 16 + look().measure + look().margin + 2}rem`

// The status words (DESIGN.md section 5). A word outside this list is a defect, so the type refuses one. Every old
// state maps here and nowhere else. A job's state is one key (jobs.contract's `jobPhase` picks it): queued and found
// (a posting found on the watchlist) are New; running is Reading; done (read, its resume not ready to send) is Read;
// writing (its resume being written) is Writing; ready (its resume passes the PDF's check) is Ready; applied and
// interviewed are Sent; no-response and quiet (no reply 14 days after it was sent) are Quiet; rejected, offer and
// closed are Closed; failed (the reading) and write-failed (the resume) are Failed.
// A job: New, Reading, Read, Writing, Ready, Sent, Quiet, Closed, Failed.
// A question: Open, Answered, Snoozed. Slow work: Waiting, Running, Done, Failed. The public page: Draft, Live, Offline.
fn statusWord(kind: string, old: string): enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline"> = kind == "job" ? (old == "queued" or old == "found" ? "New" : old == "running" ? "Reading" : old == "done" ? "Read" : old == "writing" ? "Writing" : old == "ready" ? "Ready" : old == "applied" or old == "interviewed" ? "Sent" : old == "no-response" or old == "quiet" ? "Quiet" : old == "rejected" or old == "offer" or old == "closed" ? "Closed" : old == "failed" or old == "write-failed" ? "Failed" : "New") : kind == "question" ? (old == "answered" ? "Answered" : old == "snoozed" ? "Snoozed" : "Open") : kind == "work" ? (old == "running" ? "Running" : old == "done" ? "Done" : old == "failed" ? "Failed" : "Waiting") : kind == "public" ? (old == "live" ? "Live" : old == "offline" ? "Offline" : "Draft") : "Open"

// A page: one column, flush left, at most `measure` wide, with the page's inset (lookInset). Its children are its
// sections, a section's gap apart.
component Page
  props
    testId: string
  slot
  view
    column max-width=lookMeasure() padding-left=lookInset() padding-right=lookInset() padding-top=lookInset() padding-bottom=look().sectionGap
      gap=look().sectionGap align-items="stretch" color="look.ink" font-family="'Geist', system-ui" testId=testId
      children

// A section of a page: its rows, a row's space apart, no wider than the main column (on a `WidePage` too).
component Section
  props
    testId: string
  slot
  view
    column gap=look().rowGap max-width=lookMeasure() testId=testId
      children

// A page with a notes column (`WithNote` rows, a document with notes beside it): as wide as the main column, a
// gutter and the notes column. Its ordinary sections keep to the main column's width.
component WidePage
  props
    testId: string
  slot
  view
    column max-width=lookWideMeasure() padding-left=lookInset() padding-right=lookInset() padding-top=lookInset() padding-bottom=look().sectionGap
      gap=look().sectionGap align-items="stretch" color="look.ink" font-family="'Geist', system-ui" testId=testId
      children

// A section whose rows carry margin notes: it spans the notes column too.
component WideSection
  props
    testId: string
  slot
  view
    column gap=look().rowGap testId=testId
      children

// ---------- Cards, the rail and folded text (DESIGN.md section 4) ----------

// A card: a group of things that belong together. One step lighter than the page (`look.card`), one 1px outline,
// an 8px radius, 1rem of padding, and its rows 0.75rem apart. Its first row is usually a `CardHead`. Cards do not
// nest: a card holds rows, never another card (nor a `Record`, which is drawn as a card).
component Card
  props
    testId: string
  slot
  view
    column min-width=0 gap=look().rowGap padding=lookCardPad() background-color="look.card" border-width="1px" border-style="solid" border-color="look.line"
      border-radius=scale().cardRadius color="look.ink" testId=testId
      children

// A card's head: its title in the `lead` size (a heading, for a screen reader), an optional line under it in `small`
// grey that says what the card's text is for (rule 12: "Resumes and messages start from these"; "" for none), and at
// its right at most one control, in the slot. testIds: the title is `testId`, the line `testId-note`.
component CardHead
  props
    title: string
    note: string
    testId: string
  slot
  view
    row align-items="flex-start" column-gap=look().rowGap min-width=0
      column flex=1 min-width=0 gap="0.125rem"
        text title role="heading" aria-level=2 font-size=lookLead() font-weight=scale().medium line-height=lookSmallLeading() color="look.ink" overflow-wrap="break-word" testId=testId
        if note != ""
          text note font-size=lookSmall() font-weight=400 line-height=lookSmallLeading() color="look.grey" overflow-wrap="break-word" testId=`${testId}-note`
      row flex-shrink=0 align-items="center" gap="0.5rem"
        children

// A page with a rail (DESIGN.md section 4, Rail): as `Page`, and wide enough for the main column, the gap and the rail
// when `wide` (the root reads the window: `lookWide(viewport.width)`). Its children are a `Columns`, and any section
// above it (the page's title) or under it.
component RailPage
  props
    wide: bool
    testId: string
  slot
  view
    column max-width=(wide ? `${look().measure + scale().rail + look().sectionGap / 16}rem` : lookMeasure()) padding-left=lookInset() padding-right=lookInset() padding-top=lookInset() padding-bottom=look().sectionGap
      gap=look().sectionGap align-items="stretch" color="look.ink" font-family="'Geist', system-ui" testId=testId
      children

// The main column and the rail beside it: side by side, a section's gap apart, when `wide`; one over the other
// otherwise, the rail after the main column. The caller puts a `MainColumn`, then a `Rail`.
component Columns
  props
    wide: bool
    testId: string
  slot
  view
    column flex-direction=(wide ? "row" : "column") align-items=(wide ? "flex-start" : "stretch") gap=look().sectionGap min-width=0 testId=testId
      children

// The main column of a `Columns`: what the page is about, its sections a section's gap apart, at most `measure` wide.
component MainColumn
  props
    testId: string
  slot
  view
    column flex=1 min-width=0 max-width=lookMeasure() gap=look().sectionGap testId=testId
      children

// The rail of a `Columns`: what the owner can add or answer. 20rem wide beside the main column when `wide`; the whole
// width under it otherwise. `label` names it for a screen reader.
component Rail
  props
    wide: bool
    label: string
    testId: string
  slot
  view
    column role="complementary" aria-label=label width=(wide ? lookRail() : "auto") flex-shrink=0 min-width=0 gap=look().sectionGap testId=testId
      children

// Long text folded (DESIGN.md section 4, Folded text): its first `lines` lines, then one control that opens the rest,
// `more` ("Read more"), and closes it again, `less` ("Show less"). The text keeps its line breaks. The control shows
// only when the text may be longer than `lines` lines (more line breaks than that, or more than 80 characters a line).
// It is a real button that says whether the text is open. testIds: the text is `testId`, the control `testId-toggle`.
component Folded
  props
    text: string
    lines: number
    more: string
    less: string
    testId: string
  state open = false
  action toggle
    open = not open
  view
    column gap=lookInner() align-items="stretch" max-width=lookMeasure()
      text text id=`${testId}-text` line-clamp=(open ? 0 : lines) overflow=(open ? "visible" : "hidden") font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" white-space="pre-wrap" overflow-wrap="break-word" testId=testId
      if text.split("\n").length > lines or text.length > lines * 80
        button press=toggle aria-expanded=open aria-controls=`${testId}-text` align-self="flex-start" testId=`${testId}-toggle`
          text (open ? less : more) font-size=lookSmall() font-weight=scale().medium line-height=lookSmallLeading() color="look.link"

// A whole document folded behind its opening (DESIGN.md section 4, Folded text): closed, `preview` (its first part)
// in its first `lines` lines and one control, `more`; open, the document itself, the slot, set as its caller sets it,
// and the control says `less`. `folds` false (the document is no more than its opening) shows the slot alone, with no
// control. The control is a real button that says whether the document is open. testIds: the frame is `testId`, the
// opening `testId-preview`, the control `testId-toggle`.
component FoldedBlock
  props
    preview: string
    lines: number
    more: string
    less: string
    folds: bool
    testId: string
  slot
  state open = false
  action toggle
    open = not open
  view
    column gap=lookInner() align-items="stretch" min-width=0 max-width=lookMeasure() testId=testId
      if folds and not open
        text preview id=`${testId}-text` line-clamp=lines overflow="hidden" font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" white-space="pre-wrap" testId=`${testId}-preview`
      else
        column id=`${testId}-text` gap=look().rowGap min-width=0
          children
      if folds
        button press=toggle aria-expanded=open aria-controls=`${testId}-text` align-self="flex-start" testId=`${testId}-toggle`
          text (open ? less : more) font-size=lookSmall() font-weight=scale().medium line-height=lookSmallLeading() color="look.link"

// The owner's own words behind a line of the record (DESIGN.md section 4, Your words): a small control, `label`
// ("Your words"), that opens the passage the line was taken from, quoted, on a well one step lighter than what it
// sits on, with one grey line under it saying when it was said (`said`, "" for none). Closed at the start. A line with
// no words shows nothing (`quote` ""). testIds: the control is `testId`, the passage `testId-quote`, the date
// `testId-when`.
component Words
  props
    label: string
    quote: string
    said: string
    testId: string
  state open = false
  action toggle
    open = not open
  view
    if quote != ""
      column gap=lookInner() align-items="stretch" min-width=0
        button press=toggle aria-expanded=open aria-controls=`${testId}-passage` align-self="flex-start" testId=testId
          text label font-size=lookSmall() font-weight=scale().medium line-height=lookSmallLeading() color="look.grey"
        if open
          column id=`${testId}-passage` gap="0.25rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem"
            background-color="look.raised" border-radius=scale().controlRadius min-width=0
            text `“${quote}”` font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" white-space="pre-wrap" overflow-wrap="break-word" testId=`${testId}-quote`
            if said != ""
              text said font-size=lookSmall() font-weight=400 line-height=lookSmallLeading() color="look.grey" testId=`${testId}-when`

// The page's title: the `title` size, heavy, set a little tight (DESIGN.md section 3). It is the size of a section
// heading, not a display size (L5).
component Title
  props
    text: string
    testId: string
  view
    text text role="heading" aria-level=1 font-size=lookTitle() font-weight=look().strong line-height=lookTitleLeading() letter-spacing="-0.01em" color="look.ink" hyphens="auto" overflow-wrap="break-word" testId=testId

// The one thing a page is about (a person's name, one number): the `display` size, heavy, set tight. `level` makes it a
// heading at that level (1 when it names the page); 0 leaves it plain text.
component Display
  props
    text: string
    level: number
    testId: string
  view
    if level > 0
      text text role="heading" aria-level=level font-size=lookDisplay() font-weight=look().strong line-height=lookDisplayLeading() letter-spacing="-0.02em" color="look.ink" overflow-wrap="break-word" testId=testId
    else
      text text font-size=lookDisplay() font-weight=look().strong line-height=lookDisplayLeading() letter-spacing="-0.02em" color="look.ink" font-variant-numeric="tabular-nums" overflow-wrap="break-word" testId=testId

// A section's head: the `lead` size in the medium weight, with no rule under it; the section's own space sets it
// apart (DESIGN.md L2: fewer rules, more space).
component SectionHead
  props
    text: string
    testId: string
  view
    text text role="heading" aria-level=2 min-width=0 max-width="100%" font-size=lookLead() font-weight=look().strong line-height=lookSmallLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A card's title or a record's name, not a heading: the `lead` size, the medium weight.
component Lead
  props
    text: string
    testId: string
  view
    text text font-size=lookLead() font-weight=scale().medium line-height=lookSmallLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A line in the medium weight: a name inside a section (a project in the told document).
component MediumLine
  props
    text: string
    testId: string
  view
    text text font-size=lookText() font-weight=scale().medium line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A label or a secondary detail: the `small` size, in grey.
component Small
  props
    text: string
    testId: string
  view
    text text font-size=lookSmall() font-weight=400 line-height=lookSmallLeading() color="look.grey" overflow-wrap="break-word" testId=testId

// A count or a column's head: the `caption` size, the medium weight, in the faint grey, tabular figures.
component Caption
  props
    text: string
    testId: string
  view
    text text font-size=lookCaption() font-weight=scale().medium line-height=lookSmallLeading() color="look.faint" font-variant-numeric="tabular-nums" testId=testId

// A rule on its own, between rows: 1px, in the outline's colour. Space parts most things; a rule is for the few
// places where space alone does not.
component Rule
  view
    hr border-top-width=lookRule() color="look.line" margin=0

// A plain line of text.
component Line
  props
    text: string
    testId: string
  view
    text text min-width=0 max-width="100%" font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" testId=testId

// A line in the heavy weight: the one item in focus, or a finding that is serious.
component StrongLine
  props
    text: string
    testId: string
  view
    text text font-size=lookText() font-weight=look().strong line-height=lookLeading() color="look.ink" testId=testId

// A secondary line, in grey: where something came from, what it holds up, a hint.
component QuietLine
  props
    text: string
    testId: string
  view
    text text font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" overflow-wrap="break-word" testId=testId

// Running text kept as written: its line breaks stay (a posting, a message). `strong` sets it in the heavy weight.
component Prose
  props
    text: string
    strong: bool
    testId: string
  view
    text text font-size=lookText() font-weight=(strong ? look().strong : 400) line-height=lookLeading() color="look.ink" white-space="pre-line" overflow-wrap="break-word" testId=testId

// A paragraph to be read aloud, and its place in the text ("0" for the first).
shape ReadParagraph
  id: string
  text: string

// Paragraphs to be read aloud (readingLook): each kept as written, its line breaks too.
component ReadAloud
  props
    paragraphs: ReadParagraph[]
    testId: string
  view
    column gap=(look().rowGap * readingLook().paragraphGap) max-width=`${readingLook().measure}rem` testId=testId
      for p in paragraphs key=p.id
        text p.text font-size=lookText() font-weight=400 line-height=`${readingLook().leading}` color="look.ink" white-space="pre-line" overflow-wrap="break-word" testId=`${testId}-${p.id}`

// A failure, in red: what was refused and why, in the words it was refused in.
component FailLine
  props
    text: string
    testId: string
  view
    text text role="alert" font-size=lookText() font-weight=400 line-height=lookLeading() color="look.red" overflow-wrap="break-word" testId=testId

// A line indented under the line before it: a finding's items, a note moved under its line on a narrow window.
component Indented
  props
    testId: string
  slot
  view
    column padding-left=lookGutter() gap=lookTight() testId=testId
      children

// A tag (DESIGN.md section 4): one word or a count, in the `caption` size, fully round, on the `raised` fill. `tone`
// "green", "amber" or "red" colours its word when it says one of those states (always a word, L4); "grey" and "ink"
// otherwise ("ink" for one that needs the owner). The testId is on the word, so a test reads the word alone.
component Tag
  props
    text: string
    tone: enum<"grey", "ink", "green", "amber", "red">
    testId: string
  view
    row flex-shrink=0 align-self="baseline" align-items="baseline" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.0625rem" padding-bottom="0.0625rem" border-radius="999px" background-color="look.raised"
      text text font-size=lookCaption() font-weight=scale().medium line-height=lookSmallLeading() white-space="nowrap" font-variant-numeric="tabular-nums"
        color=(tone == "green" ? "look.green" : tone == "amber" ? "look.amber" : tone == "red" ? "look.red" : tone == "ink" ? "look.ink" : "look.grey") testId=testId // no-tells: each colour is an app.tamber token; the tone's name matches the word

// The tone of a status word (DESIGN.md section 5): Ready and Done green, Quiet and Open amber, Failed red, the rest
// grey; a grey word that needs the owner is in ink.
fn statusTone(word: string, needsYou: bool): enum<"grey", "ink", "green", "amber", "red"> = word == "Failed" ? "red" : word == "Ready" or word == "Done" ? "green" : word == "Quiet" or word == "Open" ? "amber" : needsYou ? "ink" : "grey"

// A status: one word from the fixed list, as a tag (DESIGN.md section 5, L7).
component Status
  props
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    needsYou: bool
    testId: string
  view
    Tag(text=word, tone=statusTone(word, needsYou), testId=testId)

// A reference number (F-0142, J-023), the accession number of DESIGN.md section 4: the `small` size, tabular
// figures, in the faint grey; nothing when the look hides references.
component Ref
  props
    code: string
    testId: string
  view
    if look().refs != "hidden"
      text code font-size=lookSmall() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" white-space="nowrap" color="look.faint" testId=testId

// A record's line with its reference number placed as the look says: in a gutter of its own to the left,
// inline before the line, or not at all. `refId` is the reference number's own testId.
component RefRow
  props
    code: string
    refId: string
    testId: string
  slot
  view
    if look().refs == "gutter"
      row align-items="baseline" testId=testId
        column width=lookRefWidth() flex-shrink=0
          Ref(code=code, testId=refId)
        column flex=1 min-width=0 gap=lookTight()
          children
    else if look().refs == "inline"
      row align-items="baseline" gap=lookTight() testId=testId
        Ref(code=code, testId=refId)
        column flex=1 min-width=0 gap=lookTight()
          children
    else
      column gap=lookTight() testId=testId
        children

// The parts of a record's second line, joined as DESIGN.md writes them: "2019–2023 · 48 facts".
fn joinDot(parts: string[]): string = parts.filter(p => p != "").join(" · ")

// A record's second line: its dates and extent in grey, then its status as a tag, a gap apart (DESIGN.md L6:
// reference, name, dates, extent, status). `showWord` false leaves the status out where the data holds none.
component RecordMeta
  props
    span: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    // Where it waits, after a Waiting ("2 ahead"); "" for none.
    place: string
    needsYou: bool
    testId: string
  view
    row align-items="baseline" flex-wrap="wrap" column-gap="0.5rem" row-gap=lookTight()
      if span != ""
        text span font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-span`
      if showWord
        row align-items="baseline" flex-wrap="wrap"
          Status(word=word, needsYou=needsYou, testId=`${testId}-status`)
          if place != ""
            text `, ${place}` font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=`${testId}-place`

// A record in a list, drawn as a card of its own (DESIGN.md section 4, Card), and inside it as the look says
// (`look().record`). Catalogue: the name;
// then dates, extent and status on one line; then, for a job, where its posting was found (DESIGN.md: three lines,
// not six; the owner's own record has no such line). Ledger, on a wide window: one row, the parts in aligned columns,
// that line under the name. `href` makes the name a link
// to the record's own page ("" draws it as text); `strong` sets it in the heavy weight, for a record that heads
// the records under it. `code` "" is a row with no reference number. Extra lines (a marker, a note) go in the slot,
// under the record. testIds: the link or name is `testId`, the reference `testId-ref`, the second line
// `testId-span` and `testId-status`, the provenance `testId-from`.
component Record
  props
    code: string
    name: string
    href: string
    strong: bool
    dates: string
    extent: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    place: string
    provenance: string
    wide: bool
    testId: string
  slot
  view
    column min-width=0 padding-left=lookCardPad() padding-right=lookCardPad() padding-top=look().rowGap padding-bottom=look().rowGap
      background-color="look.card" border-width="1px" border-style="solid" border-color="look.line" border-radius=scale().cardRadius
      RecordBody(code=code, name=name, href=href, strong=strong, dates=dates, extent=extent, word=word, showWord=showWord, place=place, provenance=provenance, wide=wide, testId=testId)
        children

// What a `Record` card holds, laid out as the look says. Its props and testIds are Record's.
component RecordBody
  props
    code: string
    name: string
    href: string
    strong: bool
    dates: string
    extent: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    place: string
    provenance: string
    wide: bool
    testId: string
  slot
  view
    if look().record == "ledger" and wide
      RefRow(code=code, refId=`${testId}-ref`, testId=`${testId}-record`)
        row align-items="baseline" gap=lookGutter()
          column flex=1 min-width=0 gap=lookTight()
            RecordName(name=name, href=href, strong=strong, testId=testId)
            if provenance != ""
              QuietLine(text=provenance, testId=`${testId}-from`)
          text joinDot([dates, extent]) width=lookRefWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-span`
          column width=lookRefWidth() flex-shrink=0
            if showWord
              Status(word=word, needsYou=false, testId=`${testId}-status`)
        children
    else if code == "" or (not wide and look().refs != "hidden")
      // A narrow window gives the reference number a line of its own above the name: a gutter would take a fifth
      // of a phone's width, and most of it at the largest text size (DESIGN.md section 3, found in the lab).
      column gap=lookTight() testId=`${testId}-record`
        if code != ""
          Ref(code=code, testId=`${testId}-ref`)
        RecordName(name=name, href=href, strong=strong, testId=testId)
        RecordMeta(span=joinDot([dates, extent]), word=word, showWord=showWord, place=place, needsYou=false, testId=testId)
        if provenance != ""
          QuietLine(text=provenance, testId=`${testId}-from`)
        children
    else
      RefRow(code=code, refId=`${testId}-ref`, testId=`${testId}-record`)
        RecordName(name=name, href=href, strong=strong, testId=testId)
        RecordMeta(span=joinDot([dates, extent]), word=word, showWord=showWord, place=place, needsYou=false, testId=testId)
        if provenance != ""
          QuietLine(text=provenance, testId=`${testId}-from`)
        children

// A list of records (jobs, found postings, companies, slow work): each record is a card of its own, so the cards
// stand a small gap apart.
component RecordList
  props
    testId: string
  slot
  view
    column gap=lookTight() testId=testId
      children

// A record's name, in the `lead` size: a link to its page, or plain text; heavy for a record that heads others.
component RecordName
  props
    name: string
    href: string
    strong: bool
    testId: string
  view
    if href != ""
      link href=href align-self="flex-start" max-width="100%" color="look.ink" testId=testId
        text name font-size=lookLead() font-weight=(strong ? look().strong : scale().medium) line-height=lookSmallLeading() color="look.ink" overflow-wrap="break-word"
    else
      text name font-size=lookLead() font-weight=(strong ? look().strong : scale().medium) line-height=lookSmallLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A record at the head of its own page: the reference number, the name as the page's title, then the record's
// second line and its provenance. testIds as Record's.
component RecordHead
  props
    code: string
    name: string
    dates: string
    extent: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    showWord: bool
    place: string
    provenance: string
    testId: string
  slot
  view
    column gap=lookTight() testId=`${testId}-record`
      if code != ""
        Ref(code=code, testId=`${testId}-ref`)
      Title(text=name, testId=testId)
      RecordMeta(span=joinDot([dates, extent]), word=word, showWord=showWord, place=place, needsYou=false, testId=testId)
      if provenance != ""
        QuietLine(text=provenance, testId=`${testId}-from`)
      children

// A label over its value: a fact's role, a source's address. The label in the `small` size and grey; the value
// carries the testId.
component Labelled
  props
    label: string
    value: string
    testId: string
  view
    column gap="0.125rem"
      text label font-size=lookSmall() font-weight=400 line-height=lookSmallLeading() color="look.grey"
      text value font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A label over a control the platform draws (a text field, a text area, a select), in the `small` size and the
// medium weight (DESIGN.md section 6). The control names itself for a screen reader by its own `aria-label`; this
// label is for the eye.
component FieldLabel
  props
    label: string
  slot
  view
    column gap=lookInner() align-items="stretch" max-width=lookMeasure()
      text label aria-hidden=true font-size=lookSmall() font-weight=scale().medium line-height=lookSmallLeading() color="look.grey"
      children

// A search field, drawn by the platform.
component SearchField
  props
    value: string
    label: string
    hint: string
    change: action
    testId: string
  view
    input type="search" value=value input=change placeholder=hint aria-label=label autocapitalize="none" autocomplete="off" max-width=lookMeasure() testId=testId

// A choice among a few words (the kind of a source, a stage of the job search): the words side by side as quiet tabs,
// the chosen one with the `hover` fill and ink text, wrapping onto a second line when the text is set large. The
// group is the app's own (`appearance="none"`), so it keeps one Tab stop and the arrow keys move between its words.
component Choices
  props
    label: string
  slot
  view
    row role="radiogroup" appearance="none" aria-label=label flex-wrap="wrap" gap="0.125rem" align-items="center" max-width="100%"
      children

// One word of a `Choices`, drawn as a place on the main line is (NavTab). The word's testId is `testId-label`.
component ChoiceWord
  props
    label: string
    chosen: bool
    press: action
    testId: string
  view
    button role="radio" aria-checked=chosen press=press appearance="none" padding=0 border-radius=scale().controlRadius
      display="flex" flex-direction="column" align-items="stretch" text-align="start" max-width="100%" testId=testId
      :hover
        background-color = "look.raised"
      row align-items="center" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" border-radius=scale().controlRadius
        background-color=(chosen ? "look.hover" : "transparent")
        text label font-size=lookText() font-weight=scale().medium line-height=lookLeading() overflow-wrap="break-word"
          color=(chosen ? "look.ink" : "look.grey") testId=`${testId}-label`

// A word that is set heavy when it is the current one keeps the heavy word's width always, so the words beside it
// do not move: an unseen heavy copy under it, of no height, holds the width. Its slot is the word as shown.
component HeavyWidth
  props
    label: string
  slot
  view
    column align-items="start"
      children
      text label aria-hidden=true font-size=lookText() font-weight=look().strong line-height=lookLeading() height=0 overflow="hidden" visibility="hidden"

// A line with a box to tick, drawn by the platform, and a grey line under it ("" for none).
component CheckLine
  props
    label: string
    detail: string
    checked: bool
    disabled: bool
    change: action
    testId: string
  view
    row align-items="baseline" gap=lookTight()
      input type="checkbox" checked=checked disabled=disabled change=change aria-label=label flex-shrink=0 testId=testId
      column flex=1 min-width=0
        text label font-size=lookText() font-weight=400 line-height=lookLeading() color=(disabled ? "look.grey" : "look.ink") overflow-wrap="break-word"
        if detail != ""
          text detail font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" overflow-wrap="break-word"

// A link that opens outside the studio (a sign-in page, a posting), in a new tab, in the link colour (L3).
component OutLink
  props
    label: string
    href: string
    testId: string
  view
    link href=href target="_blank" align-self="flex-start" max-width="100%" color="look.link" testId=testId
      text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.link" overflow-wrap="break-word"

// Slow work in one line (DESIGN.md rule 8): its status as a tag (Waiting with its place, "2 ahead"), then, a gap
// apart, what is happening and how long it usually takes.
component WorkLine
  props
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    place: string
    text: string
    testId: string
  view
    row align-items="baseline" flex-wrap="wrap" column-gap="0.5rem" row-gap=lookTight()
      row align-items="baseline" flex-wrap="wrap"
        Status(word=word, needsYou=false, testId=`${testId}-status`)
        if place != ""
          text `, ${place}` font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=`${testId}-place`
      text text flex="1 1 12rem" min-width=0 font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// The widths of an activity row's columns on a wide window: when, how long it usually takes, and its status word
// with its place ("Waiting, 12 ahead"). Each holds its longest words at text size.
fn lookWhenWidth(): string = `${look().textSize * 10 / 16}rem`
fn lookUsualWidth(): string = `${look().textSize * 11 / 16}rem`
fn lookStatusWidth(): string = `${look().textSize * 9.5 / 16}rem`

// One line of a ledger that is marked with words (the Skills list): its name, its count in grey, and in the slot the
// words that mark it. On a wide window (`wide`, 640px and more) the three stand in columns that line up down the list,
// as an Activity row's do; on a narrow one the name and the count share a line when they fit, and the words go under
// them. The slot is placed once, whatever the width. testIds: the row is `testId-row`, the name `testId-name`, the
// count `testId-facts`.
fn lookCountWidth(): string = `${look().textSize * 11 / 16}rem`
component LedgerRow
  props
    name: string
    count: string
    open: action
    wide: bool
    testId: string
  slot
  view
    column flex-direction=(wide ? "row" : "column") align-items=(wide ? "baseline" : "stretch") column-gap=lookGutter() row-gap=lookTight() min-width=0 testId=`${testId}-row`
      row flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 align-items="baseline" flex-wrap="wrap" column-gap="0.3em"
        text name flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 font-size=lookText() font-weight=look().strong line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=`${testId}-name`
        if not wide
          text "·" aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
        column width=(wide ? lookCountWidth() : "auto") flex-shrink=(wide ? 0 : 1) min-width=0
          QuietAction(label=count, press=open, disabled=false, testId=`${testId}-facts`)
      children

// Slow work as one row, drawn as a card of its own (DESIGN.md, the pattern "Activity row"): what it is, its stage, when it was asked for or
// started, how long it usually takes, and its status word (Waiting with its place). On a wide window the parts stand
// in aligned columns, in tabular figures; on a narrow one they are stacked lines. A failed row gives its reason in
// red under what it is. `href` links what it is to what it made ("" for none). Actions (Try again) go in the slot.
// testIds: what is `testId`; then `-stage`, `-when`, `-usual`, `-status`, `-place` and `-reason`.
component ActivityRow
  props
    what: string
    href: string
    stage: string
    started: string
    usual: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    place: string
    reason: string
    wide: bool
    testId: string
  slot
  view
    column min-width=0 padding-left=lookCardPad() padding-right=lookCardPad() padding-top=look().rowGap padding-bottom=look().rowGap
      background-color="look.card" border-width="1px" border-style="solid" border-color="look.line" border-radius=scale().cardRadius
      ActivityBody(what=what, href=href, stage=stage, started=started, usual=usual, word=word, place=place, reason=reason, wide=wide, testId=testId)
        children

// What an `ActivityRow` card holds. Its props and testIds are ActivityRow's.
component ActivityBody
  props
    what: string
    href: string
    stage: string
    started: string
    usual: string
    word: enum<"New", "Reading", "Read", "Writing", "Ready", "Sent", "Quiet", "Closed", "Failed", "Open", "Answered", "Snoozed", "Waiting", "Running", "Done", "Draft", "Live", "Offline">
    place: string
    reason: string
    wide: bool
    testId: string
  slot
  view
    if wide
      row align-items="baseline" gap=lookGutter() testId=`${testId}-row`
        column flex=1 min-width=0 gap=lookTight()
          RecordName(name=what, href=href, strong=false, testId=testId)
          if stage != ""
            QuietLine(text=stage, testId=`${testId}-stage`)
          if reason != ""
            FailLine(text=reason, testId=`${testId}-reason`)
          children
        text started width=lookWhenWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-when`
        text usual width=lookUsualWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-usual`
        row width=lookStatusWidth() flex-shrink=0 align-items="baseline" flex-wrap="wrap"
          Status(word=word, needsYou=false, testId=`${testId}-status`)
          if place != ""
            text `, ${place}` font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-place`
    else
      column gap=lookTight() testId=`${testId}-row`
        RecordName(name=what, href=href, strong=false, testId=testId)
        row align-items="baseline" flex-wrap="wrap" column-gap="0.5rem" row-gap=lookTight()
          row align-items="baseline" flex-wrap="wrap"
            Status(word=word, needsYou=false, testId=`${testId}-status`)
            if place != ""
              text `, ${place}` font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-place`
          if stage != ""
            text stage font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=`${testId}-stage`
        row align-items="baseline" flex-wrap="wrap" column-gap="0.3em"
          text started font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-when`
          if usual != ""
            text "·" aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
            text usual font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" testId=`${testId}-usual`
        if reason != ""
          FailLine(text=reason, testId=`${testId}-reason`)
        children

// The main line (DESIGN.md section 4, Shell): the root's tab bar drawn by the app (`appearance="none"`), so each place
// keeps its own stack. Its tabs are `NavTab`s; the last, System, is pushed to the far end. With `side` (the window is
// `scale().wideFrom` wide or more; the root reads it) it is the sidebar: `sidebar` wide, on the card's fill with a
// 1px rule on its right, the places one under another and System at its foot. Without it, it is one bar across the
// top of the window, the places side by side over a 1px rule. The tablist is the same node in both, so a place keeps
// its focus when the window crosses the width.
component MainLine
  props
    side: bool
    testId: string
  slot
  view
    column flex-shrink=0 flex-direction=(side ? "column" : "row") width=(side ? lookSidebar() : "auto") align-items="stretch"
      background-color=(side ? "look.card" : "look.paper") border-right-width=(side ? "1px" : "0px") border-right-style="solid" border-right-color="look.line"
      border-bottom-width=(side ? "0px" : "1px") border-bottom-style="solid" border-bottom-color="look.line" testId=testId
      // The tabs are the tablist's own children: the host finds each tab's panel through them.
      row role="tablist" appearance="none" aria-label="Places" aria-orientation=(side ? "vertical" : "horizontal") flex=1
        flex-direction=(side ? "column" : "row") flex-wrap="nowrap" overflow-x=(side ? "visible" : "auto") align-items=(side ? "stretch" : "center") gap="0.125rem"
        max-width=(side ? "none" : lookWideMeasure()) padding-left="0.5rem" padding-right="0.5rem" padding-top=(side ? "0.75rem" : "0.5rem") padding-bottom="0.5rem"
        // The host's tab bar paints a fill and a line above itself: this bar says its own.
        border-top-width=0 background-color=(side ? "look.card" : "look.paper")
        children

// One place on the main line: a row 2rem tall with a 6px radius. The current place has the `hover` fill and ink text;
// the others grey text, and one step lighter on hover (never the accent, never a coloured edge: DESIGN.md section 4).
// `quiet` (System) is kept for the caller; every place that is not current is grey now. `far` pushes it to the end of
// the line, or with `side` to the foot of the sidebar. Its label's testId is "nav-current" while it is the current
// place, so a test can read which one is marked. The hover is on the button and the current place's fill on the row
// inside it, which covers the button, so hovering the current place leaves it as it is.
component NavTab
  props
    label: string
    current: bool
    quiet: bool
    far: bool
    side: bool
    controls: string
    press: action
    testId: string
  view
    button role="tab" appearance="none" aria-selected=current aria-controls=controls press=press
      flex-shrink=0 margin-left=(far and not side ? "auto" : 0) margin-top=(far and side ? "auto" : 0) padding=0 border-radius=scale().controlRadius
      display="flex" flex-direction="column" align-items="stretch" text-align="start" testId=testId
      :hover
        background-color = "look.raised"
      row align-items="center" min-height="2rem" padding-left="0.5rem" padding-right="0.5rem" border-radius=scale().controlRadius
        background-color=(current ? "look.hover" : "transparent")
        text label font-size=lookText() font-weight=scale().medium line-height=lookLeading() white-space="nowrap"
          color=(current ? "look.ink" : "look.grey") testId=(current ? "nav-current" : `${testId}-label`)

// The band at the top of the page area that holds the second line (or a line about the studio), lined up with the
// page's column.
component SubBar
  props
    testId: string
  slot
  view
    column flex-shrink=0 max-width=lookMeasure() padding-left=lookInset() padding-right=lookInset() padding-top=look().rowGap testId=testId
      children

// The second line, on a place that holds several screens (Record, System): quiet tabs, a small gap apart. They hang
// out by their own padding, so their words line up with the page's text.
component SubLine
  props
    label: string
  slot
  view
    nav aria-label=label max-height="24vh" overflow-y="auto"
      row flex-wrap="wrap" gap="0.125rem" align-items="center"
        children

// One screen on the second line: as a place on the main line, a little shorter. The current one has the `hover` fill
// and ink text and is marked for a screen reader; the others are grey, one step lighter on hover. Its label's testId
// is "sub-current" while it is the current screen.
component SubLink
  props
    label: string
    current: bool
    press: action
    testId: string
  view
    button press=press aria-current=(current ? "page" : "false") appearance="none" padding=0 border-radius=scale().controlRadius
      display="flex" flex-direction="column" align-items="stretch" text-align="start" testId=testId
      :hover
        background-color = "look.raised"
      row align-items="center" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" border-radius=scale().controlRadius
        background-color=(current ? "look.hover" : "transparent")
        text label font-size=lookText() font-weight=scale().medium line-height=lookLeading() overflow-wrap="break-word"
          color=(current ? "look.ink" : "look.grey") testId=(current ? "sub-current" : `${testId}-label`)

// A numbered line (1, 2, 3 …): the number in a narrow column of its own, in tabular figures, then the line.
component Numbered
  props
    n: number
  slot
  view
    row align-items="baseline"
      text `${n}` aria-hidden=true min-width=lookNumberWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey"
      column flex=1 min-width=0 gap=lookTight()
        children

// A list item (the profile's lists): an en dash in the number's column, then the line.
component Bulleted
  props
    testId: string
  slot
  view
    row align-items="baseline" testId=testId
      text "–" aria-hidden=true width=lookNumberWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      column flex=1 min-width=0 gap=lookTight()
        children

// A label beside a control the platform draws, on one line (a job's outcome in a list): the label in grey.
component InlineField
  props
    label: string
  slot
  view
    row align-items="baseline" flex-wrap="wrap" column-gap=lookTight() row-gap=lookTight()
      text label aria-hidden=true min-width=0 font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" overflow-wrap="break-word"
      children

// A one-line text field, drawn by the platform, with its label for a screen reader and a hint while empty.
component ValueField
  props
    value: string
    label: string
    hint: string
    change: action
    submit: action
    testId: string
  view
    input value=value input=change submit=submit placeholder=hint aria-label=label autocomplete="off" max-width=lookMeasure() testId=testId

// A line of actions side by side (Save, Cancel), a small gap apart, centred on one line, wrapping on a narrow window.
component Actions
  props
    testId: string
  slot
  view
    row flex-wrap="wrap" column-gap="0.5rem" row-gap="0.5rem" align-items="center" testId=testId
      children

// An action whose label is free text and can be a sentence (an answer to choose, a question to ask): a button of the
// app's own, so its words wrap at any text size, which the platform's button does not do. It reads as a control of the
// system: the `raised` fill, one 1px outline, a 6px radius, the label in the `text` size and the medium weight; one
// step lighter on hover and while pressed; faded when disabled. It is still a button: Tab reaches it, the focus ring
// shows, Enter and Space press it. `keys` is its one-key shortcut ("" for none).
component Action
  props
    label: string
    press: action
    disabled: bool
    keys: string
    testId: string
  view
    button press=press disabled=disabled aria-keyshortcuts=keys appearance="none" align-self="flex-start" max-width="100%" min-width=0
      padding-left=scale().actionInset padding-right=scale().actionInset padding-top=6 padding-bottom=6 min-height="2.25rem"
      background-color="look.raised" border-width="1px" border-style="solid" border-color="look.line" border-radius=scale().controlRadius
      text-align="start" testId=testId
      :hover
        background-color = "look.hover"
      :active
        background-color = "look.hover"
      :disabled
        opacity = 0.5
      text label font-size=lookText() font-weight=scale().medium line-height=lookLeading() color="look.ink" overflow-wrap="break-word" min-width=0

// A quiet text button with a larger hit target on touch screens.
component QuietAction
  props
    label: string
    press: action
    disabled: bool
    testId: string
  view
    button press=press disabled=disabled appearance="none" padding=0 border-width=0 background-color="transparent"
      min-height=44 text-align="start" align-self="flex-start" max-width="100%" testId=testId
      :disabled
        opacity = 0.5
      text label font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.link" overflow-wrap="break-word"

// The main action of a screen (rule 11): the platform's filled button, in the accent, its label in the medium weight
// (white on the accent passes only at that weight, DESIGN.md section 3). A screen has one.
component MainAction
  props
    label: string
    press: action
    disabled: bool
    keys: string
    testId: string
  view
    button press=press disabled=disabled aria-keyshortcuts=keys buttonStyle="bordered-prominent" align-self="flex-start" max-width="100%" text-align="start" testId=testId
      text label font-weight=scale().medium

// A destructive action: the platform's button marked destructive, so it is drawn red. The screen asks before it does
// what it says.
component DangerAction
  props
    label: string
    press: action
    disabled: bool
    testId: string
  view
    button press=press disabled=disabled destructive=true align-self="flex-start" max-width="100%" text-align="start" testId=testId
      text label

// A link to another screen (or a file to save), in the link colour: the accent made lighter so it passes on the dark
// page (L3).
component GoTo
  props
    label: string
    href: string
    testId: string
  view
    link href=href align-self="flex-start" max-width="100%" color="look.link" testId=testId
      text label font-size=lookText() font-weight=scale().medium line-height=lookLeading() color="look.link" overflow-wrap="break-word"

// The next action (DESIGN.md section 4): the screen's one filled button (rule 11), with a count beside it as a tag
// when there is one ("5 ready"; "" for none). A screen reader hears the count as part of the button's name.
// testIds: the button is `testId`, the count `testId-count`.
component NextAction
  props
    label: string
    count: string
    press: action
    disabled: bool
    testId: string
  view
    row align-items="center" gap="0.5rem" align-self="flex-start" flex-wrap="wrap"
      button press=press disabled=disabled aria-label=(count != "" ? `${label}, ${count}` : label) buttonStyle="bordered-prominent" max-width="100%" text-align="start" testId=testId
        text label font-weight=scale().medium
      if count != ""
        row aria-hidden=true
          Tag(text=count, tone="grey", testId=`${testId}-count`)

// A row with a margin note: the main column, and beside it, `margin` wide, its notes. Under 640px the notes
// move under the main column, indented. The caller puts the note in a `Note` after the main content, and passes
// `wide` (the root reads the window: `viewport.width >= lookNarrow()`), since only the root reads the window.
component WithNote
  props
    wide: bool
    testId: string
  slot
  view
    if wide
      row align-items="start" gap=lookGutter() testId=testId
        children
    else
      column gap=lookTight() testId=testId
        children

// The parts of a `WithNote`: its main column, then its note.
component Main
  slot
  view
    column flex=1 min-width=0 max-width=lookMeasure() gap=lookTight()
      children

// A column of notes in the margin (a resume's flags): `margin` wide beside the main column on a wide window; on a
// narrow one it is drawn where the caller puts it, indented.
component Aside
  props
    wide: bool
    label: string
    testId: string
  slot
  view
    column role="complementary" aria-label=label width=(wide ? lookMargin() : "auto") flex-shrink=0 padding-left=(wide ? 0 : lookGutter()) gap=look().rowGap testId=testId
      children

component Note
  props
    wide: bool
    text: string
    testId: string
  view
    column width=(wide ? lookMargin() : "auto") flex-shrink=0 padding-left=(wide ? 0 : lookGutter())
      text text font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=testId

// ---------- The tree (Experience) ----------

// A row's content stepped in by its level of the tree (lookStep), so a project sits under its role and a fact under
// its project. The reference number stays in the gutter, outside the step.
component Step
  props
    level: number
  slot
  view
    column min-width=0 gap=lookTight() padding-left=lookStep(level)
      children

// A grey line under a record's name: when, and what it holds. `mark` follows it in ink ("Just added"); "" for none.
component TreeSub
  props
    text: string
    mark: string
    testId: string
  view
    if text != "" or mark != ""
      row align-items="baseline" flex-wrap="wrap" column-gap="0.3em"
        if text != ""
          text text font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" overflow-wrap="break-word" testId=testId
        if text != "" and mark != ""
          text "·" aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
        if mark != ""
          text mark font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" testId=`${testId}-mark`

// The closed line of any item of the tree, the same at every level: its reference in the gutter, its name (a link to
// the item opened), then when and what it holds in grey. `strong` sets the name heavy (a role, a project); `quiet`
// sets it grey (a group such as Day to day, which has no reference). `current` marks the item that is open, with an
// underline and for a screen reader. `rule` draws a 1px rule above it (between the top-level items of a list).
// On a narrow window the reference takes a line of its own above the name, as Record's does. Extra lines go in the
// slot. testIds: the name is `testId`, the reference `testId-ref`, the grey line `testId-sub`, the mark `testId-sub-mark`.
component TreeRow
  props
    code: string
    name: string
    href: string
    strong: bool
    quiet: bool
    sub: string
    mark: string
    level: number
    current: bool
    rule: bool
    wide: bool
    testId: string
  slot
  view
    column min-width=0 padding-top=(rule ? look().rowGap : 0) border-top-width=(rule ? lookRule() : "0px") border-top-style="solid" border-top-color="look.line" testId=`${testId}-row`
      if wide and look().refs == "gutter"
        row align-items="baseline"
          column width=lookRefWidth() flex-shrink=0
            if code != ""
              Ref(code=code, testId=`${testId}-ref`)
          column flex=1 min-width=0
            Step(level=level)
              TreeName(name=name, href=href, strong=strong, quiet=quiet, current=current, testId=testId)
              TreeSub(text=sub, mark=mark, testId=`${testId}-sub`)
              children
      else
        Step(level=level)
          if code != ""
            Ref(code=code, testId=`${testId}-ref`)
          TreeName(name=name, href=href, strong=strong, quiet=quiet, current=current, testId=testId)
          TreeSub(text=sub, mark=mark, testId=`${testId}-sub`)
          children

// An item's name as a link to the item opened: heavy, plain or grey; underlined while it is the open one.
component TreeName
  props
    name: string
    href: string
    strong: bool
    quiet: bool
    current: bool
    testId: string
  view
    link href=href align-self="flex-start" max-width="100%" aria-current=(current ? "page" : "false") color=(quiet ? "look.grey" : "look.ink") testId=testId
      text name font-size=lookText() font-weight=(strong ? look().strong : 400) line-height=lookLeading() color=(quiet ? "look.grey" : "look.ink") overflow-wrap="break-word"
        text-decoration-line=(current ? "underline" : "none")

// A row of the tree that is not an item: an action ("Add a project"), an empty state, "Show all 14". It lines up with
// the names at its level.
component TreeLine
  props
    level: number
    wide: bool
  slot
  view
    if wide and look().refs == "gutter"
      row align-items="baseline"
        column width=lookRefWidth() flex-shrink=0
        column flex=1 min-width=0
          Step(level=level)
            children
    else
      Step(level=level)
        children

// A list of the tree's rows, a row's space apart.
component TreeList
  props
    testId: string
  slot
  view
    column gap=look().rowGap min-width=0 testId=testId
      children

// The list and the opened item beside it (on a window `lookBeside()` wide and more): two columns that each scroll on
// their own, so the list keeps its place while an item opens and closes. The caller puts a `BesideList` then, when
// `beside`, a `BesidePane` in it. On a narrower window (`beside` false) it holds the list alone, as a page: the same
// frame for both, so what is in the list is drawn at one place in the app's code, not once for each layout.
component Beside
  props
    beside: bool
    testId: string
  slot
  view
    row flex=1 min-height=0 align-items="stretch" max-width=(beside ? `${look().measure * 2 + 6}rem` : "none") color="look.ink" font-family="'Geist', system-ui" testId=testId
      children

// The list's column: the page's title, its controls and the tree. `scrollId` names its scroller for the route. When
// not `beside`, it is as wide as a page.
component BesideList
  props
    beside: bool
    scrollId: string
    testId: string
  slot
  view
    scroll id=scrollId flex=(beside ? 5 : 1) min-width=0 min-height=0
      column max-width=(beside ? "none" : lookMeasure()) padding-left=lookGutter() padding-right=lookGutter() padding-top=lookGutter() padding-bottom=look().sectionGap gap=look().sectionGap align-items="stretch" testId=testId
        children

// The opened item's column, beside the list, with a 1px rule between them.
component BesidePane
  props
    label: string
    testId: string
  slot
  view
    scroll flex=6 min-width=0 min-height=0 border-left-width=lookRule() border-left-style="solid" border-left-color="look.line"
      column role="region" aria-label=label padding-left=(lookGutter() * 2) padding-right=lookGutter() padding-top=lookGutter() padding-bottom=look().sectionGap gap=look().rowGap max-width=lookMeasure() align-items="stretch" testId=testId
        children

// The opened item drawn under its own row, on a narrow window, with a 1px rule above. It is not stepped in with its
// row: on a phone at a large text size the steps would leave its fields no room. `level` is kept for the caller.
component UnderRow
  props
    level: number
    label: string
    testId: string
  slot
  view
    column role="region" aria-label=label padding-top=look().rowGap padding-bottom=look().rowGap gap=look().rowGap
      border-top-width=lookRule() border-top-style="solid" border-top-color="look.line" testId=testId
      children

// Where an opened item is: the list's name, then each item above it, as grey links. It ends at the item's parent.
component Crumbs
  props
    label: string
  slot
  view
    nav aria-label=label
      row flex-wrap="wrap" column-gap="0.5em" align-items="baseline"
        children

component Crumb
  props
    label: string
    href: string
    first: bool
    testId: string
  view
    row align-items="baseline" column-gap="0.5em" min-width=0
      if not first
        text "›" aria-hidden=true font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
      if href != ""
        link href=href min-width=0 color="look.grey" testId=testId
          text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" overflow-wrap="break-word"
      else
        text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" overflow-wrap="break-word" testId=testId

// One field of a record: its name in grey, then its value. On a wide window the names stand in a column of their own;
// on a narrow one each name is over its value.
component FieldRow
  props
    label: string
    value: string
    wide: bool
    testId: string
  view
    if wide
      row align-items="baseline" column-gap=lookGutter()
        text label width=lookLabelWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
        FieldValue(value=value, testId=testId)
    else
      column
        text label font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey"
        FieldValue(value=value, testId=testId)

component FieldValue
  props
    value: string
    testId: string
  view
    row flex=1 min-width=0 align-items="baseline"
      if value != ""
        text value font-size=lookText() font-weight=400 line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId
      else
        text "Not recorded" font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=testId

// Two fields side by side on a wide window, one over the other on a narrow one.
component FieldPair
  props
    wide: bool
  slot
  view
    if wide
      row align-items="end" column-gap=lookGutter() max-width=lookMeasure()
        children
    else
      column gap=look().rowGap max-width=lookMeasure()
        children

// A form drawn in place (adding or editing an item): its fields a row's space apart, as wide as the main column.
component InPlaceForm
  props
    label: string
    testId: string
  slot
  view
    column role="group" aria-label=label gap=look().rowGap max-width=lookMeasure() padding-top=lookTight() padding-bottom=lookTight() testId=testId
      children

// One field of a `FieldPair`: its label (as FieldLabel's) over the control, sharing the row's width with the other.
component PairField
  props
    label: string
  slot
  view
    column flex=1 min-width=0 gap=lookInner() align-items="stretch"
      text label aria-hidden=true font-size=lookSmall() font-weight=scale().medium line-height=lookSmallLeading() color="look.grey"
      children

// An opened item's name, as its column's heading: the larger size, heavy (the page's own title stays the one at
// level 1).
component ItemTitle
  props
    text: string
    testId: string
  view
    text text role="heading" aria-level=2 font-size=lookTitle() font-weight=look().strong line-height=lookTitleLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// A part of an opened item set apart from what is above it (its suggested projects): a row's space more above it.
component PaneSection
  props
    testId: string
  slot
  view
    column gap=look().rowGap padding-top=look().rowGap testId=testId
      children

// ---------- The resume as the screen ----------

// A reference beside a resume's line that opens what it names (a fact): grey, tabular, a button that says whether it is open.
component RefTap
  props
    code: string
    open: bool
    press: action
    testId: string
  view
    button press=press aria-expanded=open aria-label=`Fact ${code}` text-align="start" testId=testId
      text code font-size=lookText() font-weight=(open ? look().strong : 400) line-height=lookLeading() font-variant-numeric="tabular-nums" white-space="nowrap" color=(open ? "look.ink" : "look.grey")

// One run of a suggested line's words: same, gone (struck) or new (added). gap: a new run right after a gone one, set
// a space apart from it.
shape StruckPart
  id: string
  kind: string
  text: string
  gap: bool

// A line with a suggestion drawn in place (DESIGN.md, Suggestion): the words that go struck through in grey, the words
// that come after them underlined, the rest as it is. A screen reader hears "removed:" and "added:" before each.
// `heading`: set heavy and read as a heading, as a role's heading is.
component Struck
  props
    parts: StruckPart[]
    heading: bool
    testId: string
  view
    text role=(heading ? "heading" : "paragraph") aria-level=(heading ? 3 : 0) font-size=lookText() font-weight=(heading ? look().strong : 400) line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId
      for p in parts key=p.id
        if p.gap
          text " "
        if p.kind != "same"
          text (p.kind == "gone" ? "removed: " : "added: ") position="absolute" width="1px" height="1px" overflow="hidden" opacity=0 white-space="nowrap"
        text p.text color=(p.kind == "gone" ? "look.grey" : "look.ink") text-decoration=(p.kind == "gone" ? "line-through" : p.kind == "new" ? "underline" : "none") testId=`${testId}-${p.id}`

// The owner's choice on a suggestion: Keep (heavy) and Reject; then, once chosen, one grey line with Undo.
component Choose
  props
    word: string
    keep: action
    reject: action
    busy: bool
    testId: string
  view
    row flex-wrap="wrap" column-gap=lookGutter() row-gap=lookTight() align-items="baseline" testId=testId
      button press=keep disabled=busy aria-label=`Keep the suggested ${word}` text-align="start" testId=`${testId}-keep`
        text "Keep" font-size=lookText() font-weight=look().strong line-height=lookLeading()
      button press=reject disabled=busy aria-label=`Reject the suggested ${word}` text-align="start" testId=`${testId}-reject`
        text "Reject" font-size=lookText() font-weight=400 line-height=lookLeading()
component Chosen
  props
    kept: bool
    word: string
    undo: action
    busy: bool
    testId: string
  view
    row flex-wrap="wrap" column-gap=lookGutter() row-gap=lookTight() align-items="baseline" testId=testId
      text (kept ? "Kept. The suggested words are in." : "Rejected. Your words stay.") font-size=lookText() font-weight=400 line-height=lookLeading() color="look.grey" testId=`${testId}-text`
      button press=undo disabled=busy aria-label=(kept ? `Undo keeping the suggested ${word}` : `Undo rejecting the suggested ${word}`) text-align="start" testId=`${testId}-undo`
        text "Undo" font-size=lookText() font-weight=400 line-height=lookLeading()

// A note beside a resume's line: its lead word heavy ("Failed check" in red, "Flag", "Question"), then its words, as one
// paragraph. A note with no lead word (what the owner did to the line) is grey.
component NoteLine
  props
    lead: string
    text: string
    fail: bool
    testId: string
  view
    text font-size=lookText() font-weight=400 line-height=lookLeading() color=(lead == "" ? "look.grey" : "look.ink") overflow-wrap="break-word" testId=testId
      if lead != ""
        text lead font-weight=look().strong color=(fail ? "look.red" : "look.ink") testId=`${testId}-lead`
      text (lead != "" ? ` ${text}` : text) testId=`${testId}-text`

// A role's heading on the resume screen: heavy, and a heading to a screen reader.
component RoleHead
  props
    text: string
    testId: string
  view
    text text role="heading" aria-level=3 font-size=lookText() font-weight=look().strong line-height=lookLeading() color="look.ink" overflow-wrap="break-word" testId=testId

// One line of a dated list: a short mark (a version's letter) heavy, its date in grey tabular figures, then the words.
// The words go under the mark and the date when the text is set too large for one row.
component DatedLine
  props
    mark: string
    date: string
    text: string
    testId: string
  view
    row flex-wrap="wrap" column-gap=lookGutter() align-items="baseline" testId=`${testId}-row`
      text mark width=lookNumberWidth() flex-shrink=0 font-size=lookText() font-weight=look().strong line-height=lookLeading() testId=`${testId}-mark`
      text date width=lookRefWidth() flex-shrink=0 font-size=lookText() font-weight=400 line-height=lookLeading() font-variant-numeric="tabular-nums" color="look.grey" white-space="nowrap" testId=`${testId}-date`
      text text flex-grow=1 flex-basis="12rem" min-width=0 font-size=lookText() font-weight=400 line-height=lookLeading() overflow-wrap="break-word" testId=testId

// A fact opened beside a resume's line, as a card: its reference and words, its dates and number, where it sits in
// the record, and Close. Never where it was read from or how sure it is (DESIGN.md L6).
component FactCard
  props
    code: string
    text: string
    span: string
    place: string
    close: action
    testId: string
  view
    column gap=lookTight() role="group" aria-label=`Fact ${code}` padding=look().rowGap background-color="look.card" border-width="1px" border-style="solid" border-color="look.line" border-radius=scale().cardRadius testId=testId
      text font-size=lookText() font-weight=400 line-height=lookLeading() overflow-wrap="break-word" testId=`${testId}-text`
        text code font-variant-numeric="tabular-nums" color="look.grey"
        text ` ${text}`
      if span != ""
        QuietLine(text=span, testId=`${testId}-span`)
      QuietLine(text=place, testId=`${testId}-place`)
      Action(label="Close", press=close, disabled=false, keys="", testId=`${testId}-close`)
