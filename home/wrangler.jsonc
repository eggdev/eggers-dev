{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "eggers-home",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "home.eggers.dev", "custom_domain": true },
    { "pattern": "home.eggers.dev/*", "zone_name": "eggers.dev" }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eggers-home",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://billowing-band-c396.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_HOME_ACCESS_AUD",
    "ALLOWED_EMAILS": "brendan@eggers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
