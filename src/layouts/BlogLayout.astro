---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const year = new Date().getFullYear()
const path = Astro.url.pathname
const onWriting = path === '/blog' || path.startsWith('/blog/')
---

<BaseLayout title={title} description={description}>
  <header class="masthead">
    <div class="masthead__inner">
      <a class="brand" href="/" aria-label="eggers.dev home">
        <span class="brand__mark" aria-hidden="true"></span>
        <span class="brand__word">eggers<span class="brand__dot">.</span>dev</span>
      </a>
      <nav class="masthead__nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/blog" aria-current={onWriting ? 'page' : undefined}>Blog</a>
      </nav>
    </div>
  </header>

  <main id="main" class="reading">
    <slot />
  </main>

  <footer class="reading-foot">
    <div class="reading-foot__inner">
      <p>© {year} Brendan Eggers</p>
      <a class="link-arrow" href="/">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M13 8H3M7 4L3 8l4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Back to eggers.dev
      </a>
    </div>
  </footer>
</BaseLayout>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in oklch, var(--surface) 80%, transparent);
    backdrop-filter: blur(9px) saturate(1.1);
    border-bottom: 1px solid var(--hairline);
  }
  .masthead__inner {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 0.85rem var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: var(--w-semibold);
    letter-spacing: -0.01em;
  }
  .brand__mark {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 3px;
    background-image: radial-gradient(currentColor 36%, transparent 38%);
    background-size: 4.5px 4.5px;
    color: var(--accent);
  }
  .brand__dot {
    color: var(--accent);
  }
  .masthead__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    font-size: var(--text-sm);
  }
  .masthead__nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: var(--w-medium);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .masthead__nav a:hover,
  .masthead__nav a[aria-current='page'] {
    color: var(--ink);
  }

  .reading {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    min-height: 60svh;
  }

  .reading-foot {
    border-top: 1px solid var(--hairline);
    margin-top: var(--space-6);
  }
  .reading-foot__inner {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-5) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
