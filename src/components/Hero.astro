---
const roles = ['Director of SWE · LV Collective', 'Co-Founder / CTO · Bar Savvy', 'ex-NBA']
---

<section class="hero" id="top">
  <p class="hero__name">Brendan Eggers</p>
  <h1 class="hero__title">I build the systems that let agents ship real software.</h1>
  <p class="hero__lede">
    Most nights, software I didn't write opens pull requests against my codebase. A system I built
    reads each one, runs the tests, and merges the ones that earn it. I wake up to a cleaner repo
    than I left.
  </p>
  <ul class="chips hero__roles">
    {roles.map((r) => <li class="chip">{r}</li>)}
  </ul>
  <div class="hero__actions">
    <a class="btn btn--primary" href="#work">See the work</a>
    <a class="link-arrow" href="#contact">
      Get in touch
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: min(86vh, 48rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(3rem, 2rem + 6vw, 5rem);
  }
  .hero__name {
    font-size: var(--text-sm);
    font-weight: var(--w-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .hero__title {
    font-size: var(--text-display);
    font-weight: var(--w-display);
    line-height: 1.0;
    letter-spacing: -0.038em;
    max-width: 17ch;
    text-wrap: balance;
  }
  .hero__lede {
    margin-top: var(--space-4);
    max-width: 50ch;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink);
  }
  .hero__roles {
    margin-top: var(--space-5);
  }
  .hero__actions {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
</style>
