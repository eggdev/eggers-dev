---
import { Code } from 'astro:components'
import NightShift from './NightShift.astro'

const points = [
  {
    h: 'The harness',
    p: "AST-level lint rules, an auto-ratcheting merge policy, and guardrail hooks the agents can't edit. The rules hold even when I'm the one asking.",
  },
  {
    h: 'The night shift',
    p: 'An autonomous loop opens small cleanup PRs and merges the ones that pass every gate, overnight, unattended.',
  },
  {
    h: 'Cross-model review',
    p: 'Claude plans, triages, and verifies. Codex implements and plays the skeptical reviewer, then Claude re-checks those findings against the code.',
  },
  {
    h: 'The human gate',
    p: 'Nothing reaches a person until it has passed everything I would have checked myself. Commit, never push.',
  },
]

const harness = `// .harness/hooks.ts — the line agents can't cross
preToolUse((action) => {
  if (editsGuardrails(action) || usesNoVerify(action)) {
    return block("guardrails and CI bypass are off-limits")
  }
})

// quality only ratchets one direction
mergePolicy({
  required: ["typecheck", "unit", "e2e", "codex-review"],
  ratchet: "auto",          // every green PR raises the bar
  humanGate: "commit-never-push",
})`

const codeThemes = { light: 'github-light', dark: 'github-dark-default' } as const

// Set this to the cleaned public harness repo URL once it's published, and the
// excerpt links to it automatically. Empty = no link (no broken link shipped).
const harnessUrl = ''
---

<section id="ai" class="section ai">
  <div class="container">
    <header class="section-head">
      <h2 class="h-section">How I work</h2>
      <p class="lede">
        I use AI where a product needs judgment rules can't provide, where failure can be surfaced
        and recovered, and where I can observe enough of the system to improve it in production.
        The agents that build with me work the same way: inside rules they can't break.
      </p>
    </header>

    <div class="ai-system">
      <NightShift />
    </div>

    <div class="ai-grid">
      <ul class="ai-points">
        {
          points.map((pt) => (
            <li class="ai-point">
              <h3 class="ai-point__h">{pt.h}</h3>
              <p class="ai-point__p">{pt.p}</p>
            </li>
          ))
        }
      </ul>

      <figure class="ai-code">
        <Code code={harness} lang="ts" themes={codeThemes} />
        <figcaption>
          A sketch of the harness I carry between projects.
          {
            harnessUrl && (
              <a class="ai-code__link link-arrow" href={harnessUrl} target="_blank" rel="noopener">
                See the harness
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M5 11L11 5M11 5H6M11 5V10"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )
          }
        </figcaption>
      </figure>
    </div>

  </div>
</section>

<style>
  .ai-system {
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .ai-grid {
    display: grid;
    gap: clamp(1.5rem, 0.8rem + 3vw, 3rem);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .ai-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-points {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .ai-point__h {
    font-size: var(--text-lg);
    font-weight: var(--w-semibold);
    letter-spacing: -0.015em;
  }
  .ai-point__p {
    margin-top: 0.4rem;
    color: var(--muted);
    max-width: 48ch;
  }

  .ai-code {
    position: sticky;
    top: 5rem;
    min-width: 0;
  }
  .ai-code :global(.astro-code) {
    max-width: 100%;
  }
  .ai-code figcaption {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  @media (max-width: 56rem) {
    .ai-code {
      position: static;
    }
  }

</style>
