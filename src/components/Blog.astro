---
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<section id="blog" class="section">
  <div class="container">
    <header class="section-head">
      <h2 class="h-section">Blog</h2>
      <p class="lede">
        Building with AI in public — lately, local models. Honest notes, real numbers, and the
        occasional faceplant, written to be useful to the next person staring at the same problem.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a class="post" href={`/blog/${p.id}/`}>
                <div class="post__head">
                  <h3 class="post__title">{p.data.title}</h3>
                  <time class="post__date tabular" datetime={p.data.pubDate.toISOString()}>
                    {fmtDate(p.data.pubDate)}
                  </time>
                </div>
                <p class="post__desc">{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="posts-empty">First post incoming.</p>
      )
    }

    <div class="more">
      <a class="link-arrow" href="/blog">
        See all writing
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .posts {
    display: grid;
    gap: 0;
  }
  .post {
    display: grid;
    gap: 0.6rem;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-mid) var(--ease-out-quart);
  }
  .post:hover {
    border-top-color: var(--accent);
  }
  @media (min-width: 52rem) {
    .post {
      grid-template-columns: minmax(12rem, 0.34fr) 1fr;
      gap: clamp(1rem, 0.4rem + 2vw, 2.5rem);
      align-items: baseline;
    }
  }
  .post__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .post__title {
    font-size: var(--text-lg);
    font-weight: var(--w-semibold);
    letter-spacing: -0.015em;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .post:hover .post__title {
    color: var(--accent);
  }
  .post__date {
    font-size: var(--text-sm);
    color: var(--muted);
    white-space: nowrap;
  }
  .post__desc {
    color: var(--muted);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .posts-empty {
    color: var(--muted);
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .more {
    margin-top: var(--space-5);
  }
</style>
