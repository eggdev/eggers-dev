---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#ai', label: 'How I work', short: 'AI' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
]
---

<header class="nav">
  <nav class="nav__inner container" aria-label="Primary">
    <a class="nav__brand" href="#top">
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__word">eggers<span class="nav__dot">.</span>dev</span>
    </a>
    <ul class="nav__links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-navlink>
              <span class={l.short ? 'lbl-full' : ''}>{l.label}</span>
              {l.short && <span class="lbl-short">{l.short}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in oklch, var(--surface) 88%, transparent);
    backdrop-filter: saturate(1.1) blur(8px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: var(--w-semibold);
    letter-spacing: -0.01em;
    font-size: 1.02rem;
  }
  .nav__mark {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 3px;
    background-image: radial-gradient(currentColor 36%, transparent 38%);
    background-size: 4.5px 4.5px;
    color: var(--accent);
    opacity: 0.95;
  }
  .nav__word {
    letter-spacing: -0.01em;
  }
  .nav__dot {
    color: var(--accent);
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 0.2rem + 1.8vw, 2rem);
    font-size: var(--text-sm);
  }
  .nav__links a {
    white-space: nowrap;
  }
  .lbl-short {
    display: none;
  }
  @media (max-width: 30rem) {
    .lbl-full {
      display: none;
    }
    .lbl-short {
      display: inline;
    }
  }
  .nav__links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: var(--w-medium);
    padding-block: 0.4rem;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0.1rem;
    height: 1.5px;
    background: var(--accent);
    transition: right var(--dur-mid) var(--ease-out-quart);
  }
  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--ink);
  }
  .nav__links a[aria-current='true']::after {
    right: 0;
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-navlink]')]
  const map = new Map<string, HTMLAnchorElement>()
  for (const a of links) {
    const id = a.getAttribute('href')?.slice(1)
    if (id) map.set(id, a)
  }
  const sections = [...map.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el)

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          for (const a of links) a.removeAttribute('aria-current')
          map.get(e.target.id)?.setAttribute('aria-current', 'true')
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
  )
  for (const s of sections) io.observe(s)
</script>
