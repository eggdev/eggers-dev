---
const email = 'brendan@eggers.dev'
---

<header class="strip" id="top">
  <h1 class="strip__name">Brendan Eggers</h1>
  <a class="strip__email" href={`mailto:${email}`}>{email}</a>
</header>

<style>
  .strip {
    padding-block: clamp(3rem, 2rem + 5vw, 5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .strip__name {
    font-size: var(--text-2xl);
    font-weight: var(--w-display);
    letter-spacing: -0.03em;
  }
  .strip__email {
    width: fit-content;
    font-size: var(--text-base);
    font-weight: var(--w-medium);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
