---
const links = [
  { href: '#work', label: 'Work', short: 'Work' },
  { href: '#ai', label: 'How I work', short: 'AI' },
  { href: '#builds', label: 'Builds', short: 'Builds' },
  { href: '#about', label: 'About', short: 'About' },
  { href: '#contact', label: 'Contact', short: 'Contact' },
]
const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/eggdev',
    d: 'M8 .2a8 8 0 0 0-2.5 15.6c.4.07.55-.17.55-.38v-1.3c-2.2.48-2.67-1.07-2.67-1.07-.36-.92-.88-1.16-.88-1.16-.72-.49.05-.48.05-.48.8.06 1.22.82 1.22.82.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.75-.2-3.6-.88-3.6-3.9 0-.86.31-1.56.82-2.11-.08-.2-.36-1 .08-2.12 0 0 .67-.21 2.2.8a7.6 7.6 0 0 1 4 0c1.52-1.01 2.19-.8 2.19-.8.44 1.12.16 1.92.08 2.12.51.55.82 1.25.82 2.11 0 3.03-1.85 3.7-3.61 3.89.29.24.54.72.54 1.46v2.16c0 .21.15.46.55.38A8 8 0 0 0 8 .2Z',
  },
  {
    label: 'X',
    href: 'https://x.com/egggdev',
    d: 'M12.6 1.5h2.1L10.1 6.8l5.4 7.2h-4.2l-3.3-4.4-3.8 4.4H1.9l4.9-5.7L1.6 1.5h4.3l3 4 3.7-4Zm-.75 11.2h1.17L4.6 2.7H3.35l8.5 10Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/brendaneggers',
    d: 'M3.4 5.4H.7V15h2.7V5.4ZM2 1A1.55 1.55 0 1 0 2 4.1 1.55 1.55 0 0 0 2 1Zm13.3 8.5c0-2.5-1.34-3.66-3.12-3.66-1.44 0-2.08.8-2.44 1.35V5.4H5.3c.04.84 0 9.6 0 9.6h2.66v-5.4c0-.24.02-.48.09-.65.19-.48.62-.97 1.36-.97.96 0 1.34.73 1.34 1.8V15h2.66l-.01-5.5Z',
  },
]
---

<header class="rail">
  <div class="rail__head">
    <a class="rail__brand" href="#top" aria-label="eggers.dev, top">
      <span class="rail__mark" aria-hidden="true"></span>
      <span class="rail__word">eggers<span class="rail__dot">.</span>dev</span>
    </a>
    <p class="rail__title">AI-native engineer and engineering leader</p>
  </div>

  <nav class="rail__nav" aria-label="Sections">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-navlink>
              <span class="rail__line" aria-hidden="true" />
              <span class="lbl-full">{l.label}</span>
              <span class="lbl-short">{l.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="rail__foot">
    <ul class="rail__socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d={s.d} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    <button class="rail__cmdk" type="button" data-open-cmdk aria-label="Open command menu">
      <kbd>⌘</kbd><kbd>K</kbd>
      <span>menu</span>
    </button>
  </div>
</header>

<style>
  /* mobile-first: slim sticky bar */
  .rail {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    background: color-mix(in oklch, var(--surface) 80%, transparent);
    backdrop-filter: blur(9px) saturate(1.1);
    border-bottom: 1px solid var(--hairline);
  }
  .rail__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: var(--w-semibold);
    letter-spacing: -0.01em;
    flex: none;
  }
  .rail__mark {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 3px;
    background-image: radial-gradient(currentColor 36%, transparent 38%);
    background-size: 4.5px 4.5px;
    color: var(--accent);
  }
  .rail__dot {
    color: var(--accent);
  }
  .rail__title {
    display: none;
  }
  .rail__nav {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    margin-left: auto;
  }
  .rail__nav::-webkit-scrollbar {
    display: none;
  }
  .rail__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 0.2rem + 1.6vw, 1.4rem);
    font-size: var(--text-sm);
  }
  .rail__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    font-weight: var(--w-medium);
    white-space: nowrap;
    padding-block: 0.4rem;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .rail__nav a:hover,
  .rail__nav a[aria-current='true'] {
    color: var(--ink);
  }
  .rail__line {
    display: none;
  }
  .lbl-full {
    display: none;
  }
  .lbl-short {
    display: inline;
  }
  .rail__foot {
    display: none;
  }

  /* desktop: full-height column */
  @media (min-width: 64rem) {
    .rail {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: 2rem;
      margin-inline: 0;
      padding-inline: 0;
      padding-block: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
      background: transparent;
      backdrop-filter: none;
      border-bottom: 0;
    }
    .rail__mark {
      width: 1.1rem;
      height: 1.1rem;
      background-size: 5px 5px;
    }
    .rail__brand {
      font-size: 1.15rem;
    }
    .rail__title {
      display: block;
      margin-top: 1rem;
      color: var(--muted);
      font-size: var(--text-base);
      max-width: 16ch;
      line-height: 1.4;
      text-wrap: balance;
    }
    .rail__nav {
      overflow: visible;
      margin-left: 0;
    }
    .rail__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.95rem;
    }
    .rail__nav a {
      padding-block: 0.15rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: var(--text-xs);
      font-weight: var(--w-semibold);
    }
    .rail__line {
      display: block;
      width: 1.5rem;
      height: 1px;
      background: var(--muted);
      transition:
        width var(--dur-mid) var(--ease-out-expo),
        background var(--dur-fast) var(--ease-out-quart);
    }
    .rail__nav a:hover .rail__line,
    .rail__nav a[aria-current='true'] .rail__line {
      width: 3.25rem;
      background: var(--accent);
    }
    .lbl-full {
      display: inline;
    }
    .lbl-short {
      display: none;
    }
    .rail__foot {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .rail__socials {
      display: flex;
      gap: 1rem;
    }
    .rail__socials a {
      color: var(--muted);
      transition: color var(--dur-fast) var(--ease-out-quart);
    }
    .rail__socials a:hover {
      color: var(--accent);
    }
    .rail__cmdk {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--muted);
      font-size: var(--text-xs);
    }
    .rail__cmdk kbd {
      font: inherit;
      border: 1px solid var(--hairline-strong);
      border-radius: 4px;
      padding: 0.05rem 0.3rem;
      line-height: 1.3;
    }
    .rail__cmdk:hover {
      color: var(--ink);
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-navlink]')]
  const map = new Map<string, HTMLAnchorElement>()
  for (const a of links) {
    const id = a.getAttribute('href')?.slice(1)
    if (id) map.set(id, a)
  }
  const sections = [...map.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el)

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          for (const a of links) a.removeAttribute('aria-current')
          map.get(e.target.id)?.setAttribute('aria-current', 'true')
        }
      }
    },
    { rootMargin: '-30% 0px -55% 0px', threshold: 0 }
  )
  for (const s of sections) io.observe(s)
</script>
