---
/**
 * NightShift — the harness drawn as the loop it actually runs. A token traverses
 * a workflow each night: Plan → Review (loops back to improve) → Build → Test
 * (loops back to improve) → Ship, then the next night begins. Nodes pulse as the
 * token arrives; the two "improve" arcs are the review gates sending work back.
 * Canvas 2D, offscreen-paused, static (full diagram) under reduced motion.
 */
---

<figure class="nightshift">
  <div class="nightshift__frame">
    <canvas data-nightshift aria-hidden="true"></canvas>
  </div>
  <figcaption>
    Every night the harness runs the loop on its own: plan, review, build, test,
    each gate looping back to improve until the work earns the ship.
  </figcaption>
</figure>

<style>
  .nightshift__frame {
    position: relative;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--surface-raised) 55%, transparent);
    overflow: hidden;
    height: clamp(220px, 25vw, 300px);
  }
  .nightshift__frame canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .nightshift figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 60ch;
  }
</style>

<script>
  const el = document.querySelector('[data-nightshift]')
  if (el instanceof HTMLCanvasElement) {
    const canvas: HTMLCanvasElement = el
    const ctx0 = canvas.getContext('2d')
    if (ctx0) {
      const ctx: CanvasRenderingContext2D = ctx0
      const reduceMQ = window.matchMedia('(prefers-reduced-motion: reduce)')
      const darkMQ = window.matchMedia('(prefers-color-scheme: dark)')
      const TAU = Math.PI * 2
      const FONT = 'ui-sans-serif, system-ui, sans-serif'

      // workflow nodes, x as fraction of width
      const nodes = [
        { label: 'Night', x: 0.07 },
        { label: 'Plan', x: 0.25 },
        { label: 'Review', x: 0.43 },
        { label: 'Build', x: 0.61 },
        { label: 'Test', x: 0.79 },
        { label: 'Ship', x: 0.93 },
      ]
      // one full nightly cycle as a list of moves (arc = the "improve" loop-back)
      const PLAN = () => [
        { from: 0, to: 1 },
        { from: 1, to: 2 },
        { from: 2, to: 1, arc: true },
        { from: 1, to: 2 },
        { from: 2, to: 3 },
        { from: 3, to: 4 },
        { from: 4, to: 3, arc: true },
        { from: 3, to: 4 },
        { from: 4, to: 5 },
      ]

      let w = 0,
        h = 0,
        dpr = 1
      let ink = '#000',
        muted = 'gray',
        accent = 'blue',
        hair = 'gray',
        surface = '#fff'
      let raf = 0,
        visible = false,
        reduce = reduceMQ.matches,
        last = 0

      type Move = { from: number; to: number; arc?: boolean }
      let queue: Move[] = PLAN()
      let mi = 0
      let t = 0
      let phase: 'move' | 'pause' | 'ship' | 'restart' = 'move'
      let timer = 0
      let active = 0
      let tokenAlpha = 1
      const pulse = nodes.map(() => 0)

      const PAUSE = 0.22
      const ease = (x: number) => x * x * (3 - 2 * x)

      function colors() {
        const cs = getComputedStyle(document.documentElement)
        ink = cs.getPropertyValue('--ink').trim() || '#000'
        muted = cs.getPropertyValue('--muted').trim() || 'gray'
        accent = cs.getPropertyValue('--dot-accent').trim() || 'blue'
        hair = cs.getPropertyValue('--hairline-strong').trim() || 'gray'
        surface = cs.getPropertyValue('--surface-raised').trim() || '#fff'
      }
      function resize() {
        const r = canvas.getBoundingClientRect()
        w = Math.max(1, r.width)
        h = Math.max(1, r.height)
        dpr = Math.min(window.devicePixelRatio || 1, 2)
        canvas.width = Math.round(w * dpr)
        canvas.height = Math.round(h * dpr)
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }

      const baseY = () => h * 0.44
      const nodeX = (i: number) => nodes[i].x * w
      function arcPoint(a: number, b: number, tt: number) {
        const ax = nodeX(a),
          bx = nodeX(b),
          y = baseY()
        const cx = (ax + bx) / 2
        const cy = y + h * 0.32
        const u = 1 - tt
        return {
          x: u * u * ax + 2 * u * tt * cx + tt * tt * bx,
          y: u * u * y + 2 * u * tt * cy + tt * tt * y,
        }
      }
      function tokenPos() {
        if (phase === 'restart') return { x: nodeX(0), y: baseY() }
        const m = queue[mi]
        if (!m || phase === 'pause' || phase === 'ship') return { x: nodeX(active), y: baseY() }
        const e = ease(t)
        if (m.arc) return arcPoint(m.from, m.to, e)
        return { x: nodeX(m.from) + (nodeX(m.to) - nodeX(m.from)) * e, y: baseY() }
      }

      function update(dt: number) {
        for (let i = 0; i < pulse.length; i++) pulse[i] = Math.max(0, pulse[i] - dt * 2.2)
        if (phase === 'move') {
          const m = queue[mi]
          const dur = m.arc ? 0.85 : 0.7
          t += dt / dur
          if (t >= 1) {
            t = 0
            active = m.to
            pulse[m.to] = 1
            if (m.to === 5) {
              phase = 'ship'
              timer = 0
            } else {
              phase = 'pause'
              timer = PAUSE
            }
          }
        } else if (phase === 'pause') {
          timer -= dt
          if (timer <= 0) {
            mi++
            phase = 'move'
            t = 0
          }
        } else if (phase === 'ship') {
          timer += dt
          if (timer >= 0.8) {
            phase = 'restart'
            timer = 0
          }
        } else {
          timer += dt
          tokenAlpha = timer < 0.4 ? 1 - timer / 0.4 : (timer - 0.4) / 0.4
          if (timer >= 0.8) {
            queue = PLAN()
            mi = 0
            t = 0
            active = 0
            phase = 'move'
            tokenAlpha = 1
            pulse[0] = 1
          }
        }
      }

      function arrowhead(x: number, y: number, ang: number, size: number, color: string) {
        ctx.fillStyle = color
        ctx.beginPath()
        ctx.moveTo(x, y)
        ctx.lineTo(x - size * Math.cos(ang - 0.4), y - size * Math.sin(ang - 0.4))
        ctx.lineTo(x - size * Math.cos(ang + 0.4), y - size * Math.sin(ang + 0.4))
        ctx.closePath()
        ctx.fill()
      }

      function render(shipT: number) {
        ctx.clearRect(0, 0, w, h)
        const y = baseY()
        const lf = Math.max(9, Math.min(12, Math.round(w / 58)))
        const r = 5

        // forward edges
        ctx.strokeStyle = hair
        ctx.lineWidth = 1.2
        ctx.globalAlpha = 0.7
        for (let i = 0; i < nodes.length - 1; i++) {
          ctx.beginPath()
          ctx.moveTo(nodeX(i) + r, y)
          ctx.lineTo(nodeX(i + 1) - r, y)
          ctx.stroke()
          arrowhead(nodeX(i + 1) - r - 1, y, 0, 5, hair)
        }

        // improve loop arcs: review->plan, test->build
        ctx.globalAlpha = 0.6
        for (const [a, b] of [
          [2, 1],
          [4, 3],
        ]) {
          ctx.strokeStyle = accent
          ctx.lineWidth = 1.2
          ctx.beginPath()
          for (let s = 0; s <= 1.001; s += 0.05) {
            const p = arcPoint(a, b, s)
            s === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y)
          }
          ctx.stroke()
          const tip = arcPoint(a, b, 0.96)
          const pre = arcPoint(a, b, 0.9)
          arrowhead(tip.x, tip.y, Math.atan2(tip.y - pre.y, tip.x - pre.x), 5, accent)
          const mid = arcPoint(a, b, 0.5)
          ctx.globalAlpha = 0.85
          ctx.fillStyle = muted
          ctx.font = `500 ${lf}px ${FONT}`
          ctx.textAlign = 'center'
          ctx.fillText('improve', mid.x, mid.y + lf + 2)
          ctx.globalAlpha = 0.6
        }

        // nodes + labels
        ctx.globalAlpha = 1
        ctx.textAlign = 'center'
        for (let i = 0; i < nodes.length; i++) {
          const x = nodeX(i)
          const isActive = i === active
          const pr = r + pulse[i] * 4
          if (isActive || pulse[i] > 0) {
            ctx.globalAlpha = 0.18 + pulse[i] * 0.2
            ctx.fillStyle = accent
            ctx.beginPath()
            ctx.arc(x, y, pr + 5, 0, TAU)
            ctx.fill()
          }
          ctx.globalAlpha = 1
          ctx.beginPath()
          ctx.arc(x, y, r, 0, TAU)
          if (isActive) {
            ctx.fillStyle = accent
            ctx.fill()
          } else {
            ctx.fillStyle = surface
            ctx.fill()
            ctx.lineWidth = 1.4
            ctx.strokeStyle = hair
            ctx.stroke()
          }
          ctx.fillStyle = isActive ? ink : muted
          ctx.font = `${isActive ? 600 : 500} ${lf}px ${FONT}`
          ctx.fillText(nodes[i].label, x, y - r - 8)
        }

        // ship flash
        if (shipT > 0 && shipT < 1) {
          ctx.globalAlpha = (1 - shipT) * 0.6
          ctx.strokeStyle = accent
          ctx.lineWidth = 2
          ctx.beginPath()
          ctx.arc(nodeX(5), y, r + shipT * 22, 0, TAU)
          ctx.stroke()
        }

        // token
        const p = tokenPos()
        ctx.globalAlpha = tokenAlpha
        ctx.fillStyle = accent
        ctx.beginPath()
        ctx.arc(p.x, p.y, 4, 0, TAU)
        ctx.fill()
        ctx.globalAlpha = 1
      }

      function frame(now: number) {
        const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016
        last = now
        update(dt)
        render(phase === 'ship' ? timer / 0.8 : 0)
        raf = requestAnimationFrame(frame)
      }
      function staticFrame() {
        // a clear, settled diagram with the token mid-review
        active = 2
        pulse.fill(0)
        tokenAlpha = 1
        phase = 'pause'
        render(0)
      }
      function start() {
        cancelAnimationFrame(raf)
        last = 0
        if (reduce || !visible) {
          staticFrame()
          return
        }
        raf = requestAnimationFrame(frame)
      }

      colors()
      resize()
      new ResizeObserver(() => {
        resize()
        if (reduce || !visible) staticFrame()
      }).observe(canvas)
      new IntersectionObserver(
        (e) => {
          visible = e[0].isIntersecting
          start()
        },
        { rootMargin: '80px' }
      ).observe(canvas)
      reduceMQ.addEventListener('change', () => {
        reduce = reduceMQ.matches
        start()
      })
      darkMQ.addEventListener('change', () => {
        colors()
        if (reduce || !visible) staticFrame()
      })
    }
  }
</script>
