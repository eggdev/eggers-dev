---
/**
 * NightShift — the harness as a live funnel. An agent opens pull requests (dots)
 * that enter wide on the left and converge through review to the merge gate. Most
 * pass through the aperture with an "approved" pulse and stream out as merged
 * (cobalt); rejected PRs hit the gate and fall away. Inline labels anchor the
 * three moments. Canvas 2D, offscreen-paused, static under reduced motion.
 */
---

<figure class="nightshift">
  <div class="nightshift__frame">
    <canvas data-nightshift aria-hidden="true"></canvas>
    <span class="ns-label ns-label--in">Agent PRs</span>
    <span class="ns-label ns-label--gate">Merge gate</span>
    <span class="ns-label ns-label--out">Merged</span>
  </div>
  <figcaption>
    Live: an agent opens each pull request, cross-model review and the merge gate
    decide, and the ones that earn it merge. A few don't.
  </figcaption>
</figure>

<style>
  .nightshift__frame {
    position: relative;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--surface-raised) 55%, transparent);
    overflow: hidden;
    height: clamp(210px, 24vw, 290px);
  }
  .nightshift__frame canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ns-label {
    position: absolute;
    top: 0.85rem;
    font-size: var(--text-xs);
    font-weight: var(--w-semibold);
    letter-spacing: 0.02em;
    color: var(--muted);
    pointer-events: none;
  }
  .ns-label--in {
    left: 7%;
  }
  .ns-label--gate {
    left: 60%;
    transform: translateX(-50%);
    color: var(--accent);
  }
  .ns-label--out {
    right: 5%;
    color: var(--accent);
  }
  .nightshift figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 58ch;
  }
</style>

<script>
  const el = document.querySelector('[data-nightshift]')
  if (el instanceof HTMLCanvasElement) {
    const canvas: HTMLCanvasElement = el
    const ctx0 = canvas.getContext('2d')
    if (ctx0) {
      const ctx: CanvasRenderingContext2D = ctx0
      const reduceMQ = window.matchMedia('(prefers-reduced-motion: reduce)')
      const darkMQ = window.matchMedia('(prefers-color-scheme: dark)')
      const TAU = Math.PI * 2
      const X0 = 0.07,
        XG = 0.6,
        X1 = 0.95

      let w = 0,
        h = 0,
        dpr = 1
      let dot = 'gray',
        accent = 'blue',
        muted = 'gray',
        hair = 'gray'
      let raf = 0,
        visible = false,
        reduce = reduceMQ.matches,
        last = 0,
        spawnAcc = 0

      type P = {
        x: number
        ty: number
        speed: number
        pass: boolean
        decided: boolean
        fall: number
        vy: number
        alpha: number
        pop: number
      }
      let parts: P[] = []

      function band(x: number) {
        const H0 = h * 0.4
        const HG = h * 0.045
        const out = h * 0.07
        if (x <= XG * w) {
          const t = Math.min(1, Math.max(0, (x - X0 * w) / ((XG - X0) * w)))
          return H0 + (HG - H0) * t
        }
        const t = Math.min(1, (x - XG * w) / ((X1 - XG) * w))
        return HG + (out - HG) * t
      }

      function colors() {
        const cs = getComputedStyle(document.documentElement)
        dot = cs.getPropertyValue('--dot').trim() || 'gray'
        accent = cs.getPropertyValue('--dot-accent').trim() || 'blue'
        muted = cs.getPropertyValue('--muted').trim() || 'gray'
        hair = cs.getPropertyValue('--hairline-strong').trim() || 'gray'
      }

      function resize() {
        const r = canvas.getBoundingClientRect()
        w = Math.max(1, r.width)
        h = Math.max(1, r.height)
        dpr = Math.min(window.devicePixelRatio || 1, 2)
        canvas.width = Math.round(w * dpr)
        canvas.height = Math.round(h * dpr)
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }

      function make(initial = false): P {
        return {
          x: initial ? X0 * w + Math.random() * (X1 - X0) * w : X0 * w,
          ty: Math.random() * 2 - 1,
          speed: 0.1 + Math.random() * 0.06,
          pass: Math.random() > 0.22,
          decided: false,
          fall: 0,
          vy: 0,
          alpha: initial ? 1 : 0,
          pop: 0,
        }
      }

      function envelope(t: number) {
        const mid = h / 2
        const x0 = X0 * w
        const xg = XG * w
        const x1 = X1 * w
        const H0 = h * 0.4
        const HG = h * 0.045
        const out = h * 0.07
        ctx.strokeStyle = hair
        ctx.globalAlpha = 0.5
        ctx.lineWidth = 1
        ctx.beginPath()
        ctx.moveTo(x0, mid - H0)
        ctx.lineTo(xg, mid - HG)
        ctx.lineTo(x1, mid - out)
        ctx.stroke()
        ctx.beginPath()
        ctx.moveTo(x0, mid + H0)
        ctx.lineTo(xg, mid + HG)
        ctx.lineTo(x1, mid + out)
        ctx.stroke()
        // gate: a soft glow plus a crisp line, gently pulsing
        const pulse = 0.6 + 0.4 * (0.5 + 0.5 * Math.sin(t * 0.003))
        ctx.strokeStyle = accent
        ctx.globalAlpha = 0.18 * pulse
        ctx.lineWidth = 7
        ctx.beginPath()
        ctx.moveTo(xg, mid - HG * 2.6)
        ctx.lineTo(xg, mid + HG * 2.6)
        ctx.stroke()
        ctx.globalAlpha = 0.9
        ctx.lineWidth = 2
        ctx.beginPath()
        ctx.moveTo(xg, mid - HG * 2.6)
        ctx.lineTo(xg, mid + HG * 2.6)
        ctx.stroke()
        ctx.globalAlpha = 1
      }

      function drawP(p: P) {
        const passedGate = p.x > XG * w
        const y = h / 2 + p.ty * band(p.x) + p.fall
        const base = p.pass && passedGate ? 2.9 : 2.2
        ctx.globalAlpha = Math.min(1, p.alpha)
        ctx.fillStyle = p.decided ? (p.pass ? accent : muted) : dot
        ctx.beginPath()
        ctx.arc(p.x, y, base * (1 + p.pop * 0.8), 0, TAU)
        ctx.fill()
      }

      function step(dt: number) {
        spawnAcc += dt
        if (spawnAcc > 0.16 && parts.length < 44) {
          spawnAcc = 0
          parts.push(make())
        }
        const xg = XG * w
        for (const p of parts) {
          p.alpha = Math.min(1, p.alpha + dt * 3)
          p.pop = Math.max(0, p.pop - dt * 3.5)
          if (!p.decided) {
            p.x += p.speed * w * dt
            if (p.x >= xg) {
              p.decided = true
              if (p.pass) p.pop = 1 // approved pulse
            }
          } else if (p.pass) {
            p.x += p.speed * w * dt
          } else {
            // rejected: blocked at the gate, deflects down and out
            p.x = Math.min(p.x, xg) - dt * w * 0.02
            p.vy += dt * h * 2.2
            p.fall += p.vy * dt
            p.alpha -= dt * 0.9
          }
        }
        parts = parts.filter(
          (p) => p.x < X1 * w * 1.05 && p.alpha > 0.03 && p.fall < h * 0.6
        )
      }

      function frame(t: number) {
        const dt = last ? Math.min(0.05, (t - last) / 1000) : 0.016
        last = t
        ctx.clearRect(0, 0, w, h)
        envelope(t)
        step(dt)
        for (const p of parts) drawP(p)
        ctx.globalAlpha = 1
        raf = requestAnimationFrame(frame)
      }

      function staticFrame() {
        ctx.clearRect(0, 0, w, h)
        envelope(0)
        const s: P[] = [
          { x: 0.16, ty: 0.7, pass: true, decided: false, fall: 0 },
          { x: 0.24, ty: -0.5, pass: true, decided: false, fall: 0 },
          { x: 0.42, ty: 0.3, pass: true, decided: false, fall: 0 },
          { x: 0.52, ty: -0.2, pass: true, decided: false, fall: 0 },
          { x: 0.6, ty: 0.5, pass: false, decided: true, fall: h * 0.16 },
          { x: 0.76, ty: 0.2, pass: true, decided: true, fall: 0 },
          { x: 0.9, ty: -0.3, pass: true, decided: true, fall: 0 },
        ].map((o) => ({ ...o, x: o.x * w, speed: 0, vy: 0, alpha: 1, pop: 0 }))
        for (const p of s) drawP(p)
        ctx.globalAlpha = 1
      }

      function start() {
        cancelAnimationFrame(raf)
        last = 0
        if (reduce || !visible) {
          staticFrame()
          return
        }
        raf = requestAnimationFrame(frame)
      }

      colors()
      resize()
      if (!reduce) for (let i = 0; i < 22; i++) parts.push(make(true))

      new ResizeObserver(() => {
        resize()
        if (reduce || !visible) staticFrame()
      }).observe(canvas)
      new IntersectionObserver(
        (e) => {
          visible = e[0].isIntersecting
          start()
        },
        { rootMargin: '80px' }
      ).observe(canvas)
      reduceMQ.addEventListener('change', () => {
        reduce = reduceMQ.matches
        start()
      })
      darkMQ.addEventListener('change', () => {
        colors()
        if (reduce || !visible) staticFrame()
      })
    }
  }
</script>
