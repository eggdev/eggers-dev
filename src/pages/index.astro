---
import About from '../components/About.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'
import HowIWork from '../components/HowIWork.astro'
import Rail from '../components/Rail.astro'
import Strip from '../components/Strip.astro'
import Substrate from '../components/Substrate.astro'
import WorkStories from '../components/WorkStories.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <Substrate />
  <div class="shell">
    <Rail />
    <main id="main" class="content">
      <Strip />
      <WorkStories />
      <HowIWork />
      <About />
      <Contact />
      <Footer />
    </main>
  </div>
</BaseLayout>
