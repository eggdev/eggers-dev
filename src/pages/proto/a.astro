---
import About from '../../components/About.astro'
import Contact from '../../components/Contact.astro'
import Footer from '../../components/Footer.astro'
import HowIWork from '../../components/HowIWork.astro'
import Rail from '../../components/Rail.astro'
import Substrate from '../../components/Substrate.astro'
import Work from '../../components/Work.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

const roles = ['Director of SWE · LV Collective', 'Co-Founder / CTO · Bar Savvy', 'ex-NBA']
const email = 'brendan@eggers.dev'
---

<BaseLayout>
  <Substrate />
  <div class="shell">
    <Rail />
    <main id="main" class="content">
      <section class="hero" id="top">
        <p class="hero__name">Brendan Eggers</p>
        <h1 class="hero__title">Give me the hard, ambiguous product.</h1>
        <p class="hero__claim">
          I&rsquo;ll take it from the user problem through the system that runs it in production.
        </p>
        <p class="hero__proof">
          Co-founder/CTO of Bar Savvy. Director of SWE at LV Collective. Before that, the NBA&rsquo;s
          path from sign-in to game access.
        </p>
        <ul class="chips hero__roles">
          {roles.map((r) => <li class="chip">{r}</li>)}
        </ul>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#work">See the work</a>
          <a class="hero__email" href={`mailto:${email}`}>{email}</a>
        </div>
      </section>
      <Work />
      <HowIWork />
      <About />
      <Contact />
      <Footer />
    </main>
  </div>
  <nav class="proto-switch" aria-label="Prototype variants">
    <span>Variant</span>
    <a href="/proto/a" aria-current="page">A</a>
    <a href="/proto/b">B</a>
    <a href="/proto/c">C</a>
    <a href="/">live</a>
  </nav>
</BaseLayout>

<style>
  .hero {
    min-height: min(86vh, 48rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(3rem, 2rem + 6vw, 5rem);
  }
  .hero__name {
    font-size: var(--text-sm);
    font-weight: var(--w-medium);
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .hero__title {
    font-size: var(--text-display);
    font-weight: var(--w-display);
    line-height: 1;
    letter-spacing: -0.038em;
    max-width: 15ch;
    text-wrap: balance;
  }
  .hero__claim {
    margin-top: var(--space-4);
    max-width: 34ch;
    font-size: var(--text-xl);
    font-weight: var(--w-medium);
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero__proof {
    margin-top: var(--space-4);
    max-width: 52ch;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--muted);
  }
  .hero__roles {
    margin-top: var(--space-5);
  }
  .hero__actions {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .hero__email {
    font-size: var(--text-base);
    font-weight: var(--w-medium);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .proto-switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.4rem 0.7rem;
    font-size: var(--text-sm);
    color: var(--muted);
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 6px;
  }
  .proto-switch a {
    color: var(--accent);
    font-weight: var(--w-medium);
  }
  .proto-switch a[aria-current='page'] {
    color: var(--ink);
    text-decoration: none;
  }
</style>
