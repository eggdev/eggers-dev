---
import About from '../../components/About.astro'
import Contact from '../../components/Contact.astro'
import Footer from '../../components/Footer.astro'
import HowIWork from '../../components/HowIWork.astro'
import Rail from '../../components/Rail.astro'
import Substrate from '../../components/Substrate.astro'
import Work from '../../components/Work.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

const email = 'brendan@eggers.dev'
---

<BaseLayout>
  <Substrate />
  <div class="shell">
    <Rail />
    <main id="main" class="content">
      <section class="opener" id="top">
        <header class="opener__head">
          <p class="opener__name">Brendan Eggers</p>
          <p class="opener__line">
            Product engineer. Co-founder/CTO, Bar Savvy · Director of SWE, LV Collective · ex-NBA
          </p>
          <a class="opener__email" href={`mailto:${email}`}>{email}</a>
        </header>

        <article class="story">
          <h1 class="story__title">Bar Savvy</h1>
          <p class="story__kicker">From the case study</p>
          <p class="story__text">
            Bar Savvy started with a public record most people don&rsquo;t know exists: Texas
            publishes what every bar sells in alcohol, every month, by venue. In 2023 I was still
            working at the NBA, and as a side project on my own machine I started joining that
            record with public venue data and putting the result on a map. If you were thinking
            about opening a bar, you could pull up a neighborhood and see what the bars already
            there actually sold, not what they claimed. That map was the whole first product.
          </p>
          <p class="story__claim">
            That&rsquo;s the job I keep choosing: the ambiguous product, owned from the user problem
            to production.
          </p>
          <a class="btn btn--primary" href="#work">See the work</a>
        </article>
      </section>
      <Work />
      <HowIWork />
      <About />
      <Contact />
      <Footer />
    </main>
  </div>
  <nav class="proto-switch" aria-label="Prototype variants">
    <span>Variant</span>
    <a href="/proto/a">A</a>
    <a href="/proto/b" aria-current="page">B</a>
    <a href="/proto/c">C</a>
    <a href="/">live</a>
  </nav>
</BaseLayout>

<style>
  .opener {
    min-height: min(88vh, 52rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    padding-block: clamp(3rem, 2rem + 6vw, 5rem);
  }
  .opener__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
  }
  .opener__name {
    font-size: var(--text-base);
    font-weight: var(--w-bold);
    color: var(--ink);
  }
  .opener__line {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .opener__email {
    font-size: var(--text-sm);
    font-weight: var(--w-medium);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .story__title {
    font-size: var(--text-display);
    font-weight: var(--w-display);
    line-height: 1;
    letter-spacing: -0.038em;
  }
  .story__kicker {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--w-medium);
    color: var(--muted);
  }
  .story__text {
    margin-top: var(--space-4);
    max-width: 58ch;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }
  .story__claim {
    margin-top: var(--space-4);
    max-width: 44ch;
    font-size: var(--text-lg);
    font-weight: var(--w-semibold);
    line-height: 1.4;
    color: var(--ink);
    text-wrap: balance;
  }
  .story .btn {
    margin-top: var(--space-5);
    width: fit-content;
  }

  .proto-switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.4rem 0.7rem;
    font-size: var(--text-sm);
    color: var(--muted);
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 6px;
  }
  .proto-switch a {
    color: var(--accent);
    font-weight: var(--w-medium);
  }
  .proto-switch a[aria-current='page'] {
    color: var(--ink);
    text-decoration: none;
  }
</style>
