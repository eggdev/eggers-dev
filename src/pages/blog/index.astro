---
import { getCollection } from 'astro:content'
import BlogLayout from '../../layouts/BlogLayout.astro'

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<BlogLayout
  title="Blog — Brendan Eggers"
  description="A build log: building with AI and local LLMs in public. Honest notes, real numbers, the occasional faceplant."
>
  <header class="writing-head">
    <h1 class="writing-title">Blog</h1>
    <p class="writing-lede">
      A build log — building with AI, lately local models, in public. Honest notes, real numbers,
      the occasional faceplant.
    </p>
  </header>

  {
    posts.length > 0 ? (
      <ul class="posts">
        {posts.map((p) => (
          <li class="post-row">
            <a class="post-row__link" href={`/blog/${p.id}/`}>
              <h2 class="post-row__title">{p.data.title}</h2>
              <time class="post-row__date tabular" datetime={p.data.pubDate.toISOString()}>
                {fmtDate(p.data.pubDate)}
              </time>
            </a>
            <p class="post-row__desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="posts-empty">First post incoming.</p>
    )
  }
</BlogLayout>

<style>
  .writing-head {
    margin-bottom: clamp(2rem, 1.2rem + 2.4vw, 3.25rem);
  }
  .writing-title {
    font-size: var(--text-2xl);
    font-weight: var(--w-bold);
    letter-spacing: -0.025em;
  }
  .writing-lede {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .posts {
    display: grid;
  }
  .post-row {
    padding-block: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
    border-top: 1px solid var(--hairline);
    transition: border-color var(--dur-mid) var(--ease-out-quart);
  }
  .post-row:hover {
    border-top-color: var(--accent);
  }
  .post-row__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    text-decoration: none;
    color: var(--ink);
  }
  .post-row__title {
    font-size: var(--text-xl);
    font-weight: var(--w-semibold);
    letter-spacing: -0.02em;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .post-row:hover .post-row__title {
    color: var(--accent);
  }
  .post-row__date {
    color: var(--muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .post-row__desc {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .posts-empty {
    color: var(--muted);
    padding-block: var(--space-5);
  }
</style>
