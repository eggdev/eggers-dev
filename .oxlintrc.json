{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "jsPlugins": ["@nx/oxlint/boundaries-plugin"],
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "**/worker-configuration.d.ts",
    "resume/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./*", "../*"],
            "message": "Use the project alias (@web, @studio, @home, or @repo) for local imports."
          }
        ]
      }
    ],
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "allow": [],
        "allowCircularSelfDependency": true,
        "enforceBuildableLibDependency": false,
        "depConstraints": [
          {
            "sourceTag": "type:app",
            "onlyDependOnLibsWithTags": [
              "type:domain",
              "type:infrastructure",
              "type:foundation",
              "type:ui"
            ]
          },
          {
            "sourceTag": "type:domain",
            "onlyDependOnLibsWithTags": ["type:domain", "type:foundation"]
          },
          {
            "sourceTag": "type:infrastructure",
            "onlyDependOnLibsWithTags": ["type:domain", "type:infrastructure", "type:foundation"]
          },
          {
            "sourceTag": "type:ui",
            "onlyDependOnLibsWithTags": ["type:foundation", "type:ui"]
          },
          {
            "sourceTag": "type:foundation",
            "onlyDependOnLibsWithTags": ["type:foundation"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/ui/src/**/*.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/heading-has-content": "off"
      }
    }
  ]
}
