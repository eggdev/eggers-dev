// Eggdev: the career knowledge bank. Three tabs, each its own stack.
// Experience: the facts found in the sources, grouped by role. A row pushes its fact: the
//   headline, the story behind it, what supports it; Edit is a sheet. What the person supplies
//   is taken as true, so nothing waits for review.
// Profile: one document written from the whole bank (who they are, how they work, what they
//   delivered, why to hire them), and the questions whose answers would strengthen it.
// Sources: what has been added to read (pasted text, a file, a git repository) and how each
//   reading went. server.ts keeps it all; worker.ts reads and writes with Claude Code. All polled.
use Badge, EmptyState, SummaryCard from "exact:content"

// The look follows ../eggers-dev: neutral greys and Geist, with one colour, a burnt orange, kept for the
// main action of a screen or sheet (app.tamber's AccentColor). Row buttons stay the text colour.
// Controls, bars and sheets stay the platform's.
font "Geist" = "assets/fonts/Geist.ttf"

routes nav
  tab bank "/"
    role "/role/:id"
    fact "/fact/:id"
    edit "/fact/:id/edit"
  tab profile "/profile"
    direction "/profile/direction"
    details "/profile/details"
  tab talk "/talk"
    questions "/talk/questions"
  tab jobs "/jobs"
    job "/job/:id"
    resume "/job/:id/resume"
    editResume "/job/:id/resume/edit"
    addJob "/jobs/add"
    lead "/lead/:id"
    companies "/jobs/companies"
  tab sources "/sources"
    source "/source/:id"
    add "/sources/add"

shape Role
  id: string
  name: string
  period: string
  // What kind of work it was, which decides how much it counts toward a job's fit.
  // standing: employer | own | contract | personal, reach: live | retired | never; "" is not set.
  standing: string
  reach: string
  // An employer is a role with a job title. A project (a repository's work) may be part of one:
  // partOf is that employer's id, "" for none, and it then counts as that employer's work.
  employer: bool
  partOf: string
  partOfName: string

shape Fact
  id: string
  roleId: string
  kind: string
  text: string
  detail: string
  metric: string
  skills: string
  evidence: string
  source: string

shape Bank
  // False until the first answer arrives: an empty bank is not a failed read.
  loaded: bool
  roles: Role[]
  // Every role a fact can be filed under, with or without facts yet, and "General".
  places: Place[]
  facts: Fact[]

shape Place
  id: string
  name: string

shape Profile
  loaded: bool
  // none | queued | running | done | failed
  status: string
  note: string
  body: string
  gaps: string[]
  // The bank has changed since the body was written.
  stale: bool
  written: string
  facts: number

shape Source
  id: string
  kind: string
  title: string
  detail: string
  status: string
  note: string
  facts: number

shape SourceList
  loaded: bool
  items: Source[]

shape Inbox
  folder: string
  files: string[]

shape HubRepo
  full: string
  owner: string
  name: string
  detail: string
  added: bool
  // A fork or an archived repository: hidden until asked for.
  extra: bool

// A job in the list: its fit is 0 to 100 once read, -1 before.
shape JobRow
  id: string
  title: string
  company: string
  place: string
  status: string
  note: string
  fit: number
  // What became of it: "" | applied | interviewed | rejected | no-response | offer.
  outcome: string
  // Where it sits in the search: saved | active | done.
  stage: string
  // The pay the posting states, when it went up and when it was added, in words; "" when unknown.
  salary: string
  posted: string
  added: string
  contact: string

// A posting found on a watchlisted company's job board, with a quick first score.
shape Lead
  id: string
  title: string
  company: string
  place: string
  score: number
  reason: string
  salary: string
  posted: string
  // Posted within the last seven days.
  fresh: bool

shape LeadList
  loaded: bool
  // idle | queued | running | failed: the state of the watchlist check
  status: string
  note: string
  companies: number
  unscored: number
  // Lower-scored postings from before this week that the list leaves out.
  unlisted: number
  // Postings left out because their stated pay tops out under the floor in the person's notes.
  underPay: number
  checked: string
  items: Lead[]

shape LeadDetail
  loaded: bool
  id: string
  title: string
  company: string
  place: string
  url: string
  score: number
  reason: string
  posting: string

shape Company
  id: string
  name: string
  board: string
  open: number
  note: string

shape CompanyList
  loaded: bool
  items: Company[]

shape JobList
  loaded: bool
  items: JobRow[]

// One thing a posting asks for, and what in the bank supports it.
shape Need
  id: string
  text: string
  must: bool
  // strong | partial | none
  coverage: string
  evidence: string
  // The work it rests on ("Acme, employer, in production, recent") and how much it counted, 0 to 100; -1 before weighing existed.
  basis: string
  counted: number

// One finding from reading a resume's PDF back as a tracking system's parser would.
shape AtsLine
  id: string
  label: string
  ok: bool
  note: string

// One question of the person's own fit test, answered for a posting: yes | partly | no | unknown.
shape Check
  id: string
  question: string
  answer: string
  note: string

// The person's direction notes, as Markdown.
shape Direction
  loaded: bool
  body: string

// The person's own details: the name and contact line every resume opens with.
shape Person
  loaded: bool
  name: string
  location: string
  email: string
  phone: string
  website: string
  github: string
  linkedin: string

// One message of the conversation. status is done | queued | running | failed (a reply being written); added lists the facts a reply put in the bank.
shape TalkMessage
  id: string
  mine: bool
  body: string
  status: string
  note: string
  added: string[]

// An open question the person can pick: what would strengthen the bank, and where it came from.
shape TalkQuestion
  id: string
  text: string
  from: string

shape Talk
  loaded: bool
  // A reply is being written.
  busy: bool
  messages: TalkMessage[]
  questions: TalkQuestion[]

// One drafted message to open a door at a company: who it is for, how to find them, why this way in, and the words.
shape Door
  id: string
  to: string
  find: string
  why: string
  message: string

// One reader on the council that reviews a resume, with their score out of 10 as text ("8.5").
shape Seat
  id: string
  seat: string
  // The model in this seat ("Claude Haiku"), "" for a review from before seats had their own.
  model: string
  // Each round's score in order ("6 → 7 → 8"), or "no score".
  score: string
  note: string

// A yes-or-no question the application form is likely to ask.
shape Knockout
  id: string
  question: string
  // yes | no | unknown
  answer: string
  note: string

// A job read against the bank: the fit, why, and the resume written for it.
shape Job
  loaded: bool
  id: string
  url: string
  title: string
  company: string
  place: string
  status: string
  note: string
  fit: number
  outcome: string
  outcomeNote: string
  // Who the person knows at the company, in their words.
  contact: string
  // The address of the resume's PDF on the server, "" before there is one.
  pdf: string
  // The length the resume is written to: 1 or 2 pages.
  pages: number
  atsOk: bool
  // The rule-based score of the PDF out of 100, and the four parts it is weighed from. -1 before one was made.
  atsScore: number
  // The score a resume needs before it is ready to send.
  atsRequired: number
  atsParts: string
  ats: AtsLine[]
  covered: number
  asked: number
  verdict: string
  strengths: string[]
  risks: string[]
  changes: string[]
  gaps: string[]
  resume: string
  requirements: Need[]
  weighed: bool
  // The posting's own keywords: in the resume, in the bank but not the resume, and in neither.
  termsIn: string[]
  termsBank: string[]
  termsMissing: string[]
  knockouts: Knockout[]
  checks: Check[]
  // The council's review of the resume: "" before one has run. reviewPassed is 8 of 10 or better.
  // Drafted messages for reaching someone at the company. doorsStatus is "" | queued | running | done | failed.
  // The resume being written after the first reading: "" | queued | running | done | failed.
  resumeStatus: string
  resumeNote: string
  // The bank changed after this unsent resume was written.
  resumeStale: bool
  doors: Door[]
  doorsStatus: string
  doorsNote: string
  // The person has edited this resume by hand, so writing it again would replace their work.
  edited: bool
  reviewScore: string
  reviewPassed: bool
  reviewRounds: number
  seats: Seat[]
  reviewChanges: string[]

// GitHub as the server's own sign-in sees it.
shape Hub
  loaded: bool
  connected: bool
  login: string
  error: string
  // The accounts the repositories belong to: the person's own first.
  owners: string[]
  repos: HubRepo[]

// The window, from the platform: only its size is read here.
shape Viewport
  width: number
  height: number

shape Reply
  ok: bool
  error: string

fn kindLabel(k: string): string = k == "accomplishment" ? "Accomplishment" : k == "project" ? "Project" : k == "responsibility" ? "Responsibility" : k == "skill" ? "Skill" : k == "education" ? "Education" : "Other"
// The row's second line: the measured result when there is one, since that is what a resume wants; else what kind of fact it is.
fn factMatches(f: Fact, q: string): bool = q.trim() == "" or `${f.text} ${f.skills} ${f.metric}`.toLowerCase().includes(q.trim().toLowerCase())
fn factMeta(f: Fact): string = f.metric != "" ? f.metric : kindLabel(f.kind)
fn roleName(roles: Role[], id: string): string = match first(roles.filter(r => r.id == id)) { case some(r) => r.name, case none => "General" }
fn factCount(n: number): string = `${n} ${n == 1 ? "fact" : "facts"}`
fn statusText(s: Source): string = s.status == "queued" ? "Waiting to be read." : s.status == "running" ? "Claude is reading it now. A repository can take several minutes." : s.status == "failed" ? `Reading failed. ${s.note}` : s.note != "" ? s.note : `Read. ${factCount(s.facts)} came from it.`
fn jobWhere(j: JobRow): string = j.company == "" ? (j.status == "queued" ? "Waiting to be read" : j.status == "running" ? "Being read now" : j.status == "failed" ? "Couldn’t be read" : j.place) : j.place == "" ? j.company : `${j.company}, ${j.place}`
fn standingLabel(v: string): string = v == "employer" ? "Employer" : v == "own" ? "Own company" : v == "contract" ? "Contract" : v == "personal" ? "Personal project" : "Not set"
fn reachLabel(v: string): string = v == "live" ? "In production" : v == "retired" ? "Was in production" : v == "never" ? "Never reached users" : "Not set"
fn roleKind(r: Role): string = r.partOf != "" ? (r.reach == "" ? `Part of ${r.partOfName}, Reached users not set` : `Part of ${r.partOfName}, ${reachLabel(r.reach).toLowerCase()}`) : r.standing == "" and r.reach == "" ? "Kind of work not set" : r.reach == "" ? `${standingLabel(r.standing)}, Reached users not set` : r.standing == "" ? `${reachLabel(r.reach)}, Type of work not set` : `${standingLabel(r.standing)}, ${reachLabel(r.reach).toLowerCase()}`
fn outcomeLabel(o: string): string = o == "applied" ? "Applied" : o == "interviewed" ? "Interviewed" : o == "rejected" ? "Rejected" : o == "no-response" ? "No response" : o == "offer" ? "Offer" : ""
fn companyCount(n: number): string = `${n} ${n == 1 ? "company" : "companies"}`
fn jobMeta(j: JobRow): string = [j.salary, (j.posted != "" ? `posted ${j.posted}` : j.added != "" ? `added ${j.added}` : ""), (j.contact != "" ? "you know someone there" : "")].filter(x => x != "").join(", ")
fn leadMeta(l: Lead): string = [l.salary, (l.posted != "" ? `posted ${l.posted}` : "")].filter(x => x != "").join(", ")
fn leadWhere(l: Lead): string = l.place == "" ? l.company : `${l.company}, ${l.place}`
fn coverageLabel(c: string): string = c == "strong" ? "Strong" : c == "partial" ? "Partial" : "Missing"
fn loadError(code: string): string = code == "offline" ? "Can’t reach the server. Check that it’s running, then try again." : "The server couldn’t answer. Try again."

component App
  state kind = "text"
  state draftTitle = ""
  state draftText = ""
  state draftFile = ""
  state draftRepo = ""
  // A file chosen with the picker: its copy's path, and the name it had.
  state pickedPath = ""
  state pickedName = ""
  state author = "" persist
  // The GitHub repositories ticked in the sheet, by full name, and the search over them.
  state chosen: string[] = []
  state hubQuery = ""
  state showExtra = false
  // The last Add's refusal, in red in the sheet until an Add succeeds.
  state refusal = ""
  state jobUrl = ""
  state jobText = ""
  state jobRefusal = ""
  state companyLink = ""
  // The Jobs list: which stage is shown (saved, active, done, or found), the search, and whether Found shows only this week's postings.
  state stageTab = "saved" persist
  state jobQuery = ""
  state freshOnly = false
  state bankQuery = ""
  // Which record the last action was on, and which action: its error shows on that record only, and one action's old error never stands in for another's.
  state actedJob = ""
  state lastJobAct = ""
  state actedLead = ""
  state lastLeadAct = ""
  state actedFact = ""
  state lastFactAct = ""
  state actedSource = ""
  state lastSourceAct = ""
  // The last thing tried on the Jobs list, in Talk and on the watchlist: an error shows only for that, and is put away when the person moves on.
  state rowTried = false
  // The drafted message last copied, as "job:door".
  state copied = ""
  state rowJob = ""
  state talkAct = ""
  state watchAct = ""
  // The resume length asked for while the person is asked about replacing their edits; "" when it is a re-read.
  state wantPages = ""
  // The company the remove alert is asking about.
  state aimedCompany = ""
  state aimedCompanyName = ""
  resource bank = loadBank() as shape Bank else empty()
  resource lib = loadSources() as shape SourceList else empty()
  resource inbox = loadInbox() as shape Inbox else empty()
  resource profile = loadProfile() as shape Profile else empty()
  resource notes = loadDirection() as shape Direction else empty()
  resource me = loadPerson() as shape Person else empty()
  resource talk = loadTalk() as shape Talk else empty()
  state talkDraft = "" persist
  // What was sent, so the reply clears the composer only if nothing new was typed meanwhile.
  state talkSending = ""
  resource hub = loadGithub() as shape Hub else empty()
  resource jobs = loadJobs() as shape JobList else empty()
  resource job = loadJob(selectedJob) as shape Job else empty()
  resource leads = loadLeads() as shape LeadList else empty()
  resource lead = loadLead(selectedLead) as shape LeadDetail else empty()
  resource companies = loadCompanies() as shape CompanyList else empty()
  resource viewport = exactViewport() as shape Viewport else empty()
  // On a wide window a sheet is a dialog as tall as its content, so a long list is given a height to scroll in.
  // A phone's sheet fills the screen and its list already scrolls.
  // A sidebar's labels (a wide window) are the platform's reading size; a tab bar's are small and stop growing where four still fit a phone.
  // The size is written out in each branch: a size worked out from state is not read as a capped text style.
  derive wideWindow = viewport.width >= 900
  // A sheet whose content changes with a choice (the kind of source) keeps a floor on a wide window, so the dialog does not jump in size.
  derive sheetFloor = viewport.width >= 900 ? 340 : 0
  derive sheetList = viewport.width >= 900 ? max(240, viewport.height - 340) : 100000
  mutation asked as shape Reply refreshes profile
  mutation notesSaved as shape Reply refreshes notes then afterNotes
  mutation personSaved as shape Reply refreshes me, job then afterPerson
  mutation talkSent as shape Reply refreshes talk then afterTalk
  mutation talkAsked as shape Reply refreshes talk then afterAsk
  mutation talkCleared as shape Reply refreshes talk
  mutation savedFact as shape Reply refreshes bank, profile then afterSaveFact
  mutation removedFact as shape Reply refreshes bank, profile then afterRemoveFact
  mutation roleSaved as shape Reply refreshes bank then afterRoleSave
  mutation added as shape Reply refreshes lib, inbox, hub then afterAdd
  mutation reread as shape Reply refreshes lib
  mutation jobAdded as shape Reply refreshes jobs then afterJobAdd
  mutation jobReread as shape Reply refreshes jobs, job
  mutation doorsAsked as shape Reply refreshes job
  mutation jobRemoved as shape Reply refreshes jobs then afterRemoveJob
  mutation outcomeSaved as shape Reply refreshes job, jobs
  mutation rowOutcome as shape Reply refreshes jobs, job
  mutation contactSaved as shape Reply refreshes job
  mutation lengthSet as shape Reply refreshes job, jobs
  mutation resumeAsked as shape Reply refreshes job, jobs
  mutation resumeSaved as shape Reply refreshes job then afterResume
  mutation leadTaken as shape Reply refreshes leads, jobs then afterTakeLead
  mutation leadDismissed as shape Reply refreshes leads then afterDismissLead
  mutation companyAdded as shape Reply refreshes companies then afterCompany
  mutation companyRemoved as shape Reply refreshes companies, leads
  mutation checkAsked as shape Reply refreshes leads
  mutation removedSource as shape Reply refreshes lib, bank, profile then afterRemoveSource
  derive selectedFact = match stack(nav).filter(e => e.name == "fact").at(-1) { case some(e) => e.params.id, case none => "" }
  derive selectedJob = match stack(nav).filter(e => e.name == "job" or e.name == "resume" or e.name == "editResume").at(-1) { case some(e) => e.params.id, case none => "" }
  derive jobsError = match failure(jobs) { case some(f) => loadError(f.code), case none => "" }
  derive jobAddError = match jobAdded { case some(r) => r.error, case none => "" }
  derive rereadJobError = pending(jobReread) ? "" : match jobReread { case some(r) => r.error, case none => "" }
  derive removeJobError = pending(jobRemoved) ? "" : match jobRemoved { case some(r) => r.error, case none => "" }
  derive jobActionError = actedJob != selectedJob ? "" : lastJobAct == "remove" ? removeJobError : lastJobAct == "read" ? rereadJobError : ""
  // A change to a job's record that the server did not take: said where the change was made.
  derive outcomeError = pending(outcomeSaved) ? "" : match outcomeSaved { case some(r) => r.error, case none => "" }
  derive contactError = pending(contactSaved) ? "" : match contactSaved { case some(r) => r.error, case none => "" }
  derive lengthError = pending(lengthSet) ? "" : match lengthSet { case some(r) => r.error, case none => "" }
  derive jobSaveError = actedJob != selectedJob ? "" : lastJobAct == "outcome" ? outcomeError : lastJobAct == "contact" ? contactError : ""
  derive doorsError = actedJob != selectedJob or lastJobAct != "doors" or pending(doorsAsked) ? "" : match doorsAsked { case some(r) => r.error, case none => "" }
  derive jobLengthError = actedJob == selectedJob and lastJobAct == "length" ? lengthError : ""
  derive writeError = actedJob != selectedJob or lastJobAct != "write" or pending(resumeAsked) ? "" : match resumeAsked { case some(r) => r.error, case none => "" }
  derive rowError = not rowTried or pending(rowOutcome) ? "" : match rowOutcome { case some(r) => r.error, case none => "" }
  derive takeError = pending(leadTaken) ? "" : match leadTaken { case some(r) => r.error, case none => "" }
  derive dismissError = pending(leadDismissed) ? "" : match leadDismissed { case some(r) => r.error, case none => "" }
  derive leadError = actedLead != selectedLead ? "" : lastLeadAct == "dismiss" ? dismissError : takeError
  derive talkLoadError = match failure(talk) { case some(f) => loadError(f.code), case none => "Can’t reach the server. Check that it’s running, then try again." }
  derive resumeError = pending(resumeSaved) ? "" : match resumeSaved { case some(r) => r.error, case none => "" }
  derive jobHint = pending(jobAdded) ? "Adding…" : jobUrl.trim() == "" and jobText.trim() == "" ? "Paste the posting or its link to add it." : ""
  derive savedJobs = jobs.items.filter(j => j.stage == "saved").length
  derive activeJobs = jobs.items.filter(j => j.stage == "active").length
  derive doneJobs = jobs.items.filter(j => j.stage == "done").length
  derive shownJobs = jobs.items.filter(j => j.stage == stageTab and `${j.title} ${j.company}`.toLowerCase().includes(jobQuery.trim().toLowerCase()))
  derive shownLeads = leads.items.filter(l => (not freshOnly or l.fresh) and `${l.title} ${l.company}`.toLowerCase().includes(jobQuery.trim().toLowerCase()))
  derive selectedLead = match stack(nav).filter(e => e.name == "lead").at(-1) { case some(e) => e.params.id, case none => "" }
  derive companyError = pending(companyAdded) ? "" : match companyAdded { case some(r) => r.error, case none => "" }
  derive checking = leads.status == "queued" or leads.status == "running"
  derive checkError = pending(checkAsked) ? "" : match checkAsked { case some(r) => r.error, case none => "" }
  derive companiesError = match failure(companies) { case some(f) => loadError(f.code), case none => "" }
  derive leadsError = match failure(leads) { case some(f) => loadError(f.code), case none => "" }
  derive removeCompanyError = pending(companyRemoved) ? "" : match companyRemoved { case some(r) => r.error, case none => "" }
  derive leadsNote = leadsError != "" ? `Found postings couldn’t be loaded. ${leadsError}` : leads.companies == 0 ? "Add companies to your watchlist and their open jobs are found and scored for you." : checking ? `Checking ${companyCount(leads.companies)} now. This takes a few minutes.` : leads.status == "failed" ? `The last check failed. ${leads.note}` : leads.checked == "" ? `${companyCount(leads.companies)} on your watchlist, not checked yet.` : `Checked ${leads.checked}. ${leads.note} Quick scores are a first sort; read a job fully for its real fit.`
  derive selectedSource = match stack(nav).filter(e => e.name == "source").at(-1) { case some(e) => e.params.id, case none => "" }
  derive readCount = lib.items.filter(s => s.status == "done").length
  derive writing = profile.status == "queued" or profile.status == "running"
  derive profileError = match failure(profile) { case some(f) => loadError(f.code), case none => "" }
  derive notesError = pending(notesSaved) ? "" : match notesSaved { case some(r) => r.error, case none => "" }
  derive talkError = pending(talkSent) ? "" : match talkSent { case some(r) => r.error, case none => "" }
  derive clearTalkError = pending(talkCleared) ? "" : match talkCleared { case some(r) => r.error, case none => "" }
  derive askTalkError = pending(talkAsked) ? "" : match talkAsked { case some(r) => r.error, case none => "" }
  derive lastTalk = match talk.messages.at(-1) { case some(m) => m.id, case none => "" }
  derive personError = pending(personSaved) ? "" : match personSaved { case some(r) => r.error, case none => "" }
  derive askError = pending(asked) ? "" : match asked { case some(r) => r.error, case none => "" }
  derive bankError = match failure(bank) { case some(f) => loadError(f.code), case none => "" }
  derive libError = match failure(lib) { case some(f) => loadError(f.code), case none => "" }
  derive removeFactError = pending(removedFact) ? "" : match removedFact { case some(r) => r.error, case none => "" }
  derive roleError = pending(roleSaved) ? "" : match roleSaved { case some(r) => r.error, case none => "" }
  derive unclassed = bank.roles.filter(r => r.id != "0" and r.partOf == "" and (r.standing == "" or r.reach == "")).length
  derive saveFactError = pending(savedFact) ? "" : match savedFact { case some(r) => r.error, case none => "" }
  derive addError = match added { case some(r) => r.error, case none => "" }
  derive rereadError = pending(reread) ? "" : match reread { case some(r) => r.error, case none => "" }
  derive removeSourceError = pending(removedSource) ? "" : match removedSource { case some(r) => r.error, case none => "" }
  derive addBody = kind == "text" ? draftText.trim() : kind == "file" ? (pickedPath != "" ? pickedName : draftFile) : kind == "github" ? chosen.join("\n") : draftRepo.trim()
  // What the picker lists: matches of the search, without forks and archived ones unless asked for or already ticked.
  derive hubShown = hub.repos.filter(r => r.full.toLowerCase().includes(hubQuery.trim().toLowerCase()) and (showExtra or not r.extra or chosen.includes(r.full)))
  derive hubExtras = hub.repos.filter(r => r.extra).length
  // Why Add is disabled, under the form (not red: nothing has been refused).
  derive addHint = pending(added) ? "Adding…" : kind == "text" and addBody == "" ? "Paste some text to add it." : kind == "file" and addBody == "" ? "Choose a file to add it." : kind == "github" and addBody == "" ? "Tick the repositories worth reading." : kind == "repo" and addBody == "" ? "Enter the repository’s path to add it." : kind == "repo" and author.trim() == "" ? "Enter the name or email your commits use." : ""

  task poll mount
    every(5000, pull)
  // A reply takes a few seconds: look for it more often than the rest while one is being written.
  task talkPoll mount
    every(1500, pullTalk)
  action pullTalk
    if talk.busy
      talkAct = ""
      refresh talk

  action pull
    refresh bank
    refresh lib
    refresh profile
    refresh jobs
    refresh job
    refresh leads
    refresh talk
  // Moving to another tab or record puts away the errors of what was tried before.
  action pick(name: string)
    rowTried = false
    talkAct = ""
    nav = select(nav, name)
  action back
    nav = back(nav)
  // A row is a link; Back, Forward and a deep link arrive here too. A phone pushes the
  // detail; a wide window replaces the one beside the list.
  action follow(url: string)
    rowTried = false
    nav = (top(nav).name == "fact" and url.startsWith("/fact/") and not url.endsWith("/edit")) or (top(nav).name == "source" and url.startsWith("/source/")) or (top(nav).name == "job" and url.startsWith("/job/") and not url.endsWith("/resume") and not url.endsWith("/edit")) or (top(nav).name == "lead" and url.startsWith("/lead/")) ? replace(nav, url) : go(nav, url)
  action searchBank(v: string)
    bankQuery = v
  action setStage(v: string)
    rowTried = false
    stageTab = v
  action searchJobs(v: string)
    jobQuery = v
  action toggleFresh
    freshOnly = not freshOnly
  // The list's picker hands its job first, then the outcome chosen.
  action pickRowOutcome(id: string, outcome: string)
    rowTried = true
    rowJob = id
    send rowOutcome = setOutcome(id, outcome)
  action openAddJob
    jobUrl = ""
    jobText = ""
    jobRefusal = ""
    stageTab = "saved"
    nav = push(select(nav, "jobs"), "/jobs/add")
  // A sheet with something typed or pasted asks before it is thrown away.
  action leaveAddJob
    if jobUrl.trim() != "" or jobText.trim() != ""
      showModal("discard-edits")
    else
      nav = back(nav)
  action leaveAdd
    if draftText.trim() != "" or draftTitle.trim() != "" or draftRepo.trim() != "" or chosen.length > 0 or pickedPath != "" or draftFile != ""
      showModal("discard-edits")
    else
      nav = back(nav)
  action editJobUrl(v: string)
    jobUrl = v
  action editJobText(v: string)
    jobText = v
  action addJob
    if jobHint == ""
      send jobAdded = addJob(jobUrl.trim(), jobText.trim())
  action afterJobAdd
    jobRefusal = jobAddError
    if jobAddError == "" and top(nav).name == "addJob"
      nav = back(nav)
  // Writing a resume again replaces what the person edited by hand, so it asks first.
  action rereadJob
    actedJob = selectedJob
    lastJobAct = "read"
    if job.edited
      wantPages = ""
      showModal("replace-edits")
    else
      send jobReread = readJob(selectedJob)
  // Only the resume is written again, from the bank as it is now. The reading of the posting stays.
  action writeAgain
    actedJob = selectedJob
    lastJobAct = "write"
    if job.edited
      wantPages = "again"
      showModal("replace-edits")
    else
      send resumeAsked = rewriteResume(selectedJob)
  action replaceEdits
    if wantPages == ""
      send jobReread = readJob(selectedJob)
    else if wantPages == "again"
      send resumeAsked = rewriteResume(selectedJob)
    else
      send lengthSet = setLength(selectedJob, wantPages)
    wantPages = ""
  // Cancelled: the Length picker goes back to the length the resume has.
  action keepEdits
    wantPages = ""
  action askRemoveJob
    showModal("remove-job")
  action draftDoors
    if not pending(doorsAsked)
      actedJob = selectedJob
      lastJobAct = "doors"
      copied = ""
      send doorsAsked = draftOutreach(selectedJob)
  // Copies a drafted message, and says which one was copied until another is.
  action copyDoor(id: string, message: string)
    copyText(message)
    copied = `${selectedJob}:${id}`
  action removeJob
    actedJob = selectedJob
    lastJobAct = "remove"
    send jobRemoved = removeJob(selectedJob)
  // A delete leaves its page only once the server has done it. A refusal is said on the page.
  action afterRemoveJob
    if removeJobError == "" and top(nav).name == "job"
      nav = back(nav)
  // An event hands its action the captured arguments first, then its own value: the picker's value
  // is the outcome and the field's is the note, so each has its own action.
  action pickOutcome(note: string, outcome: string)
    actedJob = selectedJob
    lastJobAct = "outcome"
    send outcomeSaved = saveOutcome(selectedJob, outcome, note.trim(), "picked")
  action saveOutcomeNote(outcome: string, note: string)
    actedJob = selectedJob
    lastJobAct = "outcome"
    send outcomeSaved = saveOutcome(selectedJob, outcome, note.trim(), "note")
  action saveContact(who: string)
    actedJob = selectedJob
    lastJobAct = "contact"
    send contactSaved = saveContact(selectedJob, who.trim())
  action setLength(pages: string)
    actedJob = selectedJob
    lastJobAct = "length"
    if job.edited
      wantPages = pages
      showModal("replace-edits")
    else
      send lengthSet = setLength(selectedJob, pages)
  action openEditResume
    nav = push(nav, path("editResume", selectedJob))
  action saveResume(body: string)
    if body.trim() != "" and not pending(resumeSaved)
      send resumeSaved = saveResume(selectedJob, body)
  action afterResume
    if resumeError == "" and top(nav).name == "editResume"
      nav = back(nav)
  action takeLead
    if not pending(leadTaken)
      actedLead = selectedLead
      lastLeadAct = "take"
      send leadTaken = readLead(selectedLead)
  // A posting taken up is now one of the person's jobs: show them where it went.
  action afterTakeLead
    if takeError == "" and top(nav).name == "lead"
      stageTab = "saved"
      nav = back(nav)
  action askDismissLead
    showModal("dismiss-lead")
  action dismissLead
    actedLead = selectedLead
    lastLeadAct = "dismiss"
    send leadDismissed = dismissLead(selectedLead)
  action afterDismissLead
    if dismissError == "" and top(nav).name == "lead"
      nav = back(nav)
  action openCompanies
    watchAct = ""
    companyLink = ""
    refresh companies
    nav = push(select(nav, "jobs"), "/jobs/companies")
  action editCompanyLink(v: string)
    companyLink = v
  action addCompany
    if companyLink.trim() != "" and not pending(companyAdded)
      watchAct = "add"
      send companyAdded = addCompany(companyLink.trim())
  action afterCompany
    companyLink = companyError == "" ? "" : companyLink
  action askRemoveCompany(id: string, name: string)
    aimedCompany = id
    aimedCompanyName = name
    showModal("remove-company")
  action removeCompany
    watchAct = "remove"
    send companyRemoved = removeCompany(aimedCompany)
  action checkNow
    watchAct = "check"
    send checkAsked = checkWatchlist()
  action openDirection
    refresh notes
    nav = push(select(nav, "profile"), "/profile/direction")
  action saveNotes(body: string)
    send notesSaved = saveDirection(body)
  action afterNotes
    if notesError == "" and top(nav).name == "direction"
      nav = back(nav)
  action editTalk(v: string)
    talkDraft = v
  action sendTalk
    if talkDraft.trim() != "" and not talk.busy and not pending(talkSent)
      talkAct = "send"
      talkSending = talkDraft.trim()
      send talkSent = sendTalk(talkDraft.trim())
  action afterTalk
    if talkError == "" and talkDraft.trim() == talkSending
      talkDraft = ""
    if lastTalk != ""
      scrollIntoView("transcript", lastTalk, block="end")
  action openQuestions
    refresh talk
    nav = push(select(nav, "talk"), "/talk/questions")
  action askQuestion(q: string)
    if not pending(talkAsked)
      talkAct = "ask"
      send talkAsked = askTalk(q)
  // From the questions sheet it closes the sheet. From a gap on the profile or a job it goes to Talk, where the question now stands.
  action afterAsk
    if askTalkError == "" and top(nav).name == "questions"
      nav = back(nav)
    else if top(nav).name != "questions"
      nav = select(nav, "talk")
    if lastTalk != ""
      scrollIntoView("transcript", lastTalk, block="end")
  action askClearTalk
    showModal("clear-talk")
  action clearTalk
    talkAct = "clear"
    send talkCleared = clearTalk()
  action openDetails
    refresh me
    nav = push(select(nav, "profile"), "/profile/details")
  action savePerson(name: string, location: string, email: string, phone: string, website: string, github: string, linkedin: string)
    if not pending(personSaved)
      send personSaved = savePerson(name.trim(), location.trim(), email.trim(), phone.trim(), website.trim(), github.trim(), linkedin.trim())
  action afterPerson
    if personError == "" and top(nav).name == "details"
      nav = back(nav)
  action writeProfile
    send asked = askProfile()
  action openEdit
    nav = push(nav, path("edit", selectedFact))
  action saveFact(id: string, text: string, detail: string, metric: string, roleId: string, kind: string)
    if text.trim() != "" and not pending(savedFact)
      actedFact = id
      lastFactAct = "save"
      send savedFact = saveFact(id, text.trim(), detail.trim(), metric.trim(), roleId, kind)
  // The sheet closes only on an ok reply; a refusal keeps it open, saying why.
  action afterSaveFact
    if saveFactError == "" and top(nav).name == "edit"
      nav = back(nav)
  action saveRole(id: string, standing: string, reach: string, partOf: string)
    send roleSaved = saveRole(id, standing, reach, partOf)
  action afterRoleSave
    if roleError == "" and top(nav).name == "role"
      nav = back(nav)
  action removeFact
    actedFact = selectedFact
    lastFactAct = "remove"
    send removedFact = removeFact(selectedFact)
  action afterRemoveFact
    if removeFactError == "" and top(nav).name == "fact"
      nav = back(nav)
  action askRemoveFact
    showModal("remove-fact")
  action openAdd
    draftTitle = ""
    draftText = ""
    draftFile = ""
    draftRepo = ""
    pickedPath = ""
    pickedName = ""
    chosen = []
    hubQuery = ""
    showExtra = false
    refusal = ""
    refresh inbox
    refresh hub
    nav = push(select(nav, "sources"), "/sources/add")
  action setKind(v: string)
    kind = v
    refusal = ""
  action editTitle(v: string)
    draftTitle = v
  action editText(v: string)
    draftText = v
  action choosePicked
    showPicker("add-pick")
  // Choosing a file drops a choice from the server's folder, and the other way round.
  action filePicked(files: Picked[])
    pickedPath = match first(files) { case some(f) => f.path, case none => pickedPath }
    pickedName = match first(files) { case some(f) => f.name, case none => pickedName }
    draftFile = files.length > 0 ? "" : draftFile
    refusal = ""
  action pickFile(v: string)
    draftFile = v
    pickedPath = v == "" ? pickedPath : ""
    pickedName = v == "" ? pickedName : ""
  action editRepo(v: string)
    draftRepo = v
  action searchHub(v: string)
    hubQuery = v
  action toggleRepo(full: string)
    chosen = chosen.includes(full) ? chosen.filter(c => c != full) : chosen.concat([full])
  action toggleExtra
    showExtra = not showExtra
  action reloadHub
    refresh hub
  action editAuthor(v: string)
    author = v
  action add
    if addHint == "" and kind == "file" and pickedPath != ""
      send added = uploadSource(pickedPath, pickedName)
    else if addHint == "" and kind == "github"
      send added = addGithub(chosen)
    else if addHint == ""
      send added = addSource(kind, draftTitle.trim(), addBody, kind == "repo" ? author.trim() : "")
  action afterAdd
    refusal = addError
    if addError == "" and top(nav).name == "add"
      nav = back(nav)
  action readAgain
    actedSource = selectedSource
    lastSourceAct = "read"
    send reread = readSource(selectedSource)
  action askRemoveSource
    showModal("remove-source")
  action removeSource
    actedSource = selectedSource
    lastSourceAct = "remove"
    send removedSource = removeSource(selectedSource)
  action afterRemoveSource
    if removeSourceError == "" and top(nav).name == "source"
      nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app"
      width="100%" height="100%" display="flex" flex-direction="column" font-family="'Geist', system-ui"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "bank"
                column navigationKey=`${e.id}` navigationScroll="bank-list" position="absolute" inset=0
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Experience" role="heading" aria-level=1 flex=1
                  if not bank.loaded
                    if pending(bank)
                      column flex=1 justify-content="center" align-items="center"
                        progress aria-label="Loading" testId="bank-loading"
                    else
                      EmptyState(symbol="symbol:alert", title="Can’t Load Experience", message=bankError)
                        button press=pull testId="bank-retry"
                          text "Try Again"
                  else if bank.facts.length == 0
                    EmptyState(symbol="symbol:document", title="No Experience Yet", message="Add a resume, a LinkedIn export or a repository. What Claude finds in it appears here, by role.")
                      button press=openAdd testId="bank-add"
                        text "Add a Source"
                  else
                    column padding="12px 16px"
                      input type="search" value=bankQuery input=searchBank placeholder="Search facts and skills" aria-label="Search facts"
                        autocapitalize="none" autocomplete="off" testId="bank-search"
                    list id="bank-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      if bankQuery.trim() != "" and bank.facts.filter(f => factMatches(f, bankQuery)).length == 0
                        section
                          row
                            text `No fact matches “${bankQuery.trim()}”.` color="-exact-secondary-label" flex=1 min-width=0 testId="bank-none"
                      if unclassed > 0 and bankQuery.trim() == ""
                        section
                          row
                            text `Kind of work isn’t set for ${unclassed} ${unclassed == 1 ? "role" : "roles"}, so that work counts as middling evidence for a job. Set it on each one’s Kind of Work row.` flex=1 min-width=0 color="-exact-secondary-label" testId="bank-unclassed"
                      for r in bank.roles.filter(r => bankQuery.trim() == "" or bank.facts.filter(f => f.roleId == r.id and factMatches(f, bankQuery)).length > 0) key=r.id
                        section
                          header
                            text (r.period == "" ? r.name : `${r.name}, ${r.period}`)
                          if r.id != "0" and bankQuery.trim() == ""
                            link href=path("role", r.id) testId=`role-${r.id}`
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text "Kind of work" font="-exact-footnote" color="-exact-secondary-label"
                                text roleKind(r) testId=`role-kind-${r.id}`
                              image "symbol:forward-chevron"
                          for f in bank.facts.filter(f => f.roleId == r.id and factMatches(f, bankQuery)) key=f.id
                            link href=path("fact", f.id) testId=`fact-${f.id}`
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text f.text
                                text factMeta(f) font="-exact-subheadline" color="-exact-secondary-label"
                              image "symbol:forward-chevron"
                    // A wide window shows this beside the list while no fact is selected.
                    column navigationSplit="placeholder" flex=1 justify-content="center" align-items="center" padding=24
                      column gap=16 width="100%" max-width="26.25rem"
                        SummaryCard(label="In your bank", value=`${bank.facts.length}`, detail=`${bank.facts.length == 1 ? "fact" : "facts"} across ${bank.roles.length} ${bank.roles.length == 1 ? "role" : "roles"}`, progress=none, symbol=some("symbol:person"))
                        text "Select a fact to read its story and what supports it, or to edit it." color="-exact-secondary-label" text-align="center" testId="bank-overview"
              if e.name == "fact"
                column navigationKey=`${e.id}` navigationScroll="fact-detail" position="absolute" inset=0
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Fact" role="heading" aria-level=2
                  if not bank.loaded
                    column flex=1 justify-content="center" align-items="center" padding=24
                      if bankError != ""
                        text bankError color="-exact-secondary-label" text-align="center"
                      else
                        progress aria-label="Loading"
                  else if bank.facts.filter(x => x.id == e.params.id).length == 0
                    EmptyState(symbol="symbol:document", title="Fact Not Found", message="It was deleted, or replaced when its source was read again.")
                      button press=back testId="fact-gone-back"
                        text "Back to Experience"
                  else
                    list id="fact-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      for f in bank.facts.filter(x => x.id == e.params.id) key=f.id
                        FactSections(fact=f, role=roleName(bank.roles, f.roleId), error=(actedFact == f.id and lastFactAct == "remove" ? removeFactError : ""), edit=openEdit, askRemove=askRemoveFact)
              if e.name == "role" and bank.roles.filter(x => x.id == e.params.id).length == 0
                SheetWait(route=e.id, title="Kind of Work", waiting=(not bank.loaded and bankError == ""), message=(bank.loaded ? "This role is no longer in your bank." : bankError), close=back)
              if e.name == "edit" and bank.facts.filter(x => x.id == e.params.id).length == 0
                SheetWait(route=e.id, title="Edit Fact", waiting=(not bank.loaded and bankError == ""), message=(bank.loaded ? "This fact is no longer in your bank." : bankError), close=back)
              if e.name == "editResume" and not (job.loaded and job.id == e.params.id)
                SheetWait(route=e.id, title="Edit Resume", waiting=(not failed(job)), message="Couldn’t load this job. It may have been deleted.", close=back)
              if e.name == "role"
                for r in bank.roles.filter(x => x.id == e.params.id) key=r.id
                  EditRole(route=e.id, role=r, employers=bank.roles.filter(x => x.employer), error=roleError, busy=pending(roleSaved), save=saveRole, cancel=back)
              if e.name == "edit"
                for f in bank.facts.filter(x => x.id == e.params.id) key=f.id
                  EditFact(route=e.id, fact=f, roles=bank.places, error=(actedFact == f.id and lastFactAct == "save" ? saveFactError : ""), busy=pending(savedFact), save=saveFact, cancel=back)
              if e.name == "profile"
                column navigationKey=`${e.id}` navigationScroll="profile-scroll" position="absolute" inset=0
                  header display="flex" flex-wrap="wrap" align-items="center" padding="8px 16px"
                    text "Profile" role="heading" aria-level=1 flex=1
                    button press=openDetails testId="open-details"
                      text "Details"
                    button press=openDirection testId="open-direction"
                      text "Direction"
                  if not profile.loaded
                    if pending(profile)
                      column flex=1 justify-content="center" align-items="center"
                        progress aria-label="Loading" testId="profile-loading"
                    else
                      EmptyState(symbol="symbol:alert", title="Can’t Load Profile", message=profileError)
                        button press=pull testId="profile-retry"
                          text "Try Again"
                  else if profile.body == "" and writing
                    column flex=1 justify-content="center" align-items="center" gap=12 padding=24
                      progress aria-label="Writing"
                      text `Claude is writing your profile from ${factCount(profile.facts)}. This takes a few minutes.` color="-exact-secondary-label" text-align="center" max-width="26.25rem" testId="profile-writing"
                  else if profile.body == "" and profile.facts == 0
                    EmptyState(symbol="symbol:person", title="No Profile Yet", message="Your profile is written from the facts in your bank. Add a source to start.")
                      button press=openAdd testId="profile-add"
                        text "Add a Source"
                  else if profile.body == ""
                    EmptyState(symbol="symbol:person", title="No Profile Yet", message=(profile.status == "failed" ? `Writing failed. ${profile.note}` : askError != "" ? askError : `Claude can write it from the ${factCount(profile.facts)} in your bank: who you are, how you work, what you delivered and why to hire you.`))
                      button press=writeProfile disabled=pending(asked) buttonStyle="filled" testId="profile-write"
                        text "Write Profile"
                  else
                    scroll id="profile-scroll" flex=1 min-height=0
                      column gap=24 padding=16 max-width="45rem" width="100%" box-sizing="border-box" margin-left="auto" margin-right="auto"
                        row gap=12 align-items="center" flex-wrap="wrap"
                          text (writing ? "Claude is rewriting this from your bank now." : profile.status == "failed" ? `Rewriting failed. ${profile.note}` : askError != "" ? askError : profile.stale ? `Written by Claude on ${profile.written}. Your bank has changed since. Rewrite to include it.` : `Written by Claude on ${profile.written}, from your bank.`) flex="1 1 12rem" min-width=0 font="-exact-footnote" color=(profile.status == "failed" or askError != "" ? "-exact-system-red" : "-exact-secondary-label") testId="profile-state"
                          button press=writeProfile disabled=(writing or pending(asked)) buttonStyle="bordered" testId="profile-rewrite"
                            text "Rewrite"
                        text profile.body markup="markdown" testId="profile-body"
                        if profile.gaps.length > 0
                          column gap=8 padding=16 border-radius=12 background-color="surface.note"
                            text "Worth adding" role="heading" aria-level=2 font="-exact-headline"
                            text "Answers to these would strengthen it. Pick one to answer it in Talk." font="-exact-footnote" color="text.muted"
                            for g, i in profile.gaps key=g
                              button press=askQuestion(g) accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start" testId=`gap-${i}`
                                text g flex=1 min-width=0
                                image "symbol:forward-chevron" aria-hidden=true
              if e.name == "talk"
                column navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0
                  header display="flex" flex-wrap="wrap" align-items="center" padding="8px 16px"
                    text "Talk" role="heading" aria-level=1 flex=1
                    if talk.messages.length > 0
                      button press=openQuestions testId="open-questions"
                        text (talk.questions.length == 0 ? "Questions" : talk.questions.length >= 30 ? "Questions 30+" : `Questions ${talk.questions.length}`)
                      button press=askClearTalk disabled=pending(talkCleared) testId="talk-clear"
                        text "Start Over"
                  if not talk.loaded
                    if pending(talk)
                      column flex=1 justify-content="center" align-items="center"
                        progress aria-label="Loading" testId="talk-loading"
                    else
                      EmptyState(symbol="symbol:alert", title="Can’t Load Talk", message=talkLoadError)
                        button press=pull testId="talk-retry"
                          text "Try Again"
                  else if talk.messages.length == 0
                    EmptyState(symbol="symbol:messages", title="Talk Through Your Work", message="Answer an open question, or tell Claude about your work. What you say is added to your bank.")
                      button press=openQuestions testId="talk-questions"
                        text "Questions"
                  else
                    // A wide window keeps the conversation to a readable column.
                    list id="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1 min-height=0 width="100%" max-width="46rem" align-self="center"
                      for m in talk.messages key=m.id
                        row justify-content=(m.mine ? "flex-end" : "flex-start") padding="6px 16px"
                          if m.mine
                            text m.body padding="10px 14px" border-radius=18 max-width="85%" overflow-wrap="break-word" white-space="pre-wrap"
                              background-color="AccentColor" color="AccentColorText" testId=`talk-${m.id}`
                          else
                            column gap=6 max-width="85%" min-width=0
                              text "Claude" font="-exact-footnote" color="-exact-secondary-label"
                              if m.status == "queued" or m.status == "running"
                                row gap=8 align-items="center" testId=`talk-${m.id}`
                                  progress aria-label="Writing a reply"
                                  text "Writing a reply…" color="-exact-secondary-label"
                              else if m.status == "failed"
                                text `Couldn’t write a reply. ${m.note}` color="-exact-system-red" overflow-wrap="break-word" testId=`talk-${m.id}`
                              else
                                text m.body overflow-wrap="break-word" white-space="pre-wrap" testId=`talk-${m.id}`
                              if m.added.length > 0
                                column gap=4 padding="10px 14px" border-radius=12 background-color="surface.note"
                                  text (m.added.length == 1 ? "Saved to your bank" : `Saved to your bank (${m.added.length})`) font="-exact-footnote" color="text.muted"
                                  for a, i in m.added key=a
                                    text a font="-exact-subheadline" overflow-wrap="break-word" testId=`talk-${m.id}-added-${i}`
                  if (talkAct == "send" and talkError != "") or (talkAct == "ask" and askTalkError != "") or (talkAct == "clear" and clearTalkError != "")
                    text (talkAct == "send" ? talkError : talkAct == "ask" ? askTalkError : `The conversation wasn’t cleared. ${clearTalkError}`) color="-exact-system-red" padding="0 16px" testId="talk-error"
                  if talk.loaded
                    row align-self="center" width="100%" max-width="46rem" box-sizing="border-box" padding="6px 12px"
                      row flex=1 min-width=0 align-items="flex-end" padding="0 4px 0 12px" border-radius=20 border="1px solid -exact-separator"
                        textarea id="composer" value=talkDraft input=editTalk rows=1 field-sizing="content" max-height=140
                          placeholder=(talk.busy ? "Claude is writing a reply" : "What you did, or what’s on your mind") aria-label="Message" testId="talk-composer" flex=1 min-width=0 padding="12px 0"
                          border="none" background-color="transparent"
                        button press=sendTalk disabled=(talkDraft.trim() == "" or talk.busy or pending(talkSent)) buttonStyle="filled" margin="4px 0"
                          retainFocus=true aria-label="Send" testId="talk-send"
                          image "symbol:send"
              if e.name == "questions"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="question-list" position="absolute" inset=0
                  header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                    button id="back" press=back aria-label="Close" testId="questions-close"
                      image "symbol:close"
                    text "Questions" role="heading"
                  list id="question-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-height=sheetList
                    if talk.questions.length == 0
                      section
                        row
                          text "Nothing open right now. Questions come from your profile and from the jobs you read." color="-exact-secondary-label" flex=1 min-width=0 testId="questions-none"
                    else
                      section
                        for q in talk.questions key=q.id
                          button press=askQuestion(q.text) disabled=pending(talkAsked) accent-color="-exact-label" text-align="start" testId=`question-${q.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text q.text
                              text q.from font="-exact-footnote" color="-exact-secondary-label"
                        if askTalkError != ""
                          row
                            text askTalkError color="-exact-system-red" flex=1 min-width=0 testId="questions-error"
                        footer
                          text "Pick one and Claude asks it. Your answer goes into your bank."
              if e.name == "details" and not me.loaded
                SheetWait(route=e.id, title="Your Details", waiting=pending(me), message="Can’t reach the server. Check that it’s running, then open this again.", close=back)
              if e.name == "direction" and not notes.loaded
                SheetWait(route=e.id, title="Direction", waiting=pending(notes), message="Can’t reach the server. Check that it’s running, then open this again.", close=back)
              if e.name == "details"
                if me.loaded
                  EditDetails(route=e.id, me=me, height=sheetList, error=personError, busy=pending(personSaved), save=savePerson, cancel=back)
              if e.name == "direction"
                if notes.loaded
                  EditDirection(route=e.id, body=notes.body, height=sheetList, error=notesError, busy=pending(notesSaved), save=saveNotes, cancel=back)
              if e.name == "jobs"
                // Beside a detail on a wide window the list is 400 wide, so its four stages fit on one line.
                column navigationKey=`${e.id}` navigationScroll="job-list" navigationSplit=400 position="absolute" inset=0
                  header display="flex" flex-wrap="wrap" align-items="center" padding="8px 16px"
                    text "Jobs" role="heading" aria-level=1 flex=1
                    button press=openCompanies testId="open-companies"
                      text "Watchlist"
                    button press=openAddJob aria-label="Add Job" testId="add-job"
                      image "symbol:add"
                  if not jobs.loaded
                    if pending(jobs)
                      column flex=1 justify-content="center" align-items="center"
                        progress aria-label="Loading" testId="jobs-loading"
                    else
                      EmptyState(symbol="symbol:alert", title="Can’t Load Jobs", message=jobsError)
                        button press=pull testId="jobs-retry"
                          text "Try Again"
                  else if jobs.items.length == 0 and leads.items.length == 0 and leads.companies == 0
                    EmptyState(symbol="symbol:search", title="No Jobs Yet", message="Add a posting to see how well you fit it and get a resume written for it from your bank.")
                      button press=openAddJob testId="jobs-add"
                        text "Add a Job"
                  else
                    // Pinned above the list: which stage is shown, with its count, and a search across both jobs and found postings.
                    column gap=12 padding="12px 16px"
                      row role="radiogroup" aria-label="Stage" align-self="stretch"
                        button role="radio" aria-checked=(stageTab == "saved") press=setStage("saved") testId="stage-saved" flex="1 1 0" min-width=0
                          text `Saved ${savedJobs}`
                        button role="radio" aria-checked=(stageTab == "active") press=setStage("active") testId="stage-active" flex="1 1 0" min-width=0
                          text `Active ${activeJobs}`
                        button role="radio" aria-checked=(stageTab == "done") press=setStage("done") testId="stage-done" flex="1 1 0" min-width=0
                          text `Done ${doneJobs}`
                        button role="radio" aria-checked=(stageTab == "found") press=setStage("found") testId="stage-found" flex="1 1 0" min-width=0
                          text `Found ${leads.items.length}`
                      input type="search" value=jobQuery input=searchJobs placeholder="Search title or company" aria-label="Search jobs"
                        autocapitalize="none" autocomplete="off" testId="job-search"
                    list id="job-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      if stageTab != "found"
                        // Each job is its own card: what it is and how it fits, then its status, changed in place.
                        for j in shownJobs key=j.id
                          section
                            link href=path("job", j.id) testId=`job-${j.id}`
                              row flex=1 min-width=0 gap=12 align-items="center"
                                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                  text j.title
                                  text jobWhere(j) font="-exact-subheadline" color="-exact-secondary-label" testId=`job-line-${j.id}`
                                  if jobMeta(j) != ""
                                    text jobMeta(j) font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                                if j.status == "done"
                                  text `${j.fit}%` font="-exact-title3" font-variant-numeric="tabular-nums" flex="0 0 auto" testId=`fit-${j.id}`
                                if j.status == "queued"
                                  Badge(label="Waiting", tint=none)
                                if j.status == "running"
                                  Badge(label="Reading", tint=none)
                                if j.status == "failed"
                                  Badge(label="Failed", tint=some("-exact-system-red"))
                              image "symbol:forward-chevron"
                            row
                              text "Outcome"
                              select value=j.outcome change=pickRowOutcome(j.id) aria-label=`Outcome of ${j.title}` testId=`status-${j.id}`
                                option "Not applied" value=""
                                option "Applied" value="applied"
                                option "Interviewed" value="interviewed"
                                option "Rejected" value="rejected"
                                option "No response" value="no-response"
                                option "Offer" value="offer"
                            if rowError != "" and rowJob == j.id
                              row
                                text `That outcome wasn’t saved. ${rowError}` color="-exact-system-red" flex=1 min-width=0 testId="row-error"
                        section
                          if shownJobs.length == 0
                            row
                              text (jobQuery.trim() != "" ? `No job here matches “${jobQuery.trim()}”.` : stageTab == "saved" ? "Nothing saved. Add a posting, or read one from Found." : stageTab == "active" ? "Nothing in progress. A job moves here when you mark it Applied." : "Nothing finished yet.") color="-exact-secondary-label" flex=1 min-width=0 testId="jobs-none"
                          footer
                            text (stageTab == "saved" ? "Jobs still being read come first, then best fit. Mark a job Applied and it moves to Active." : stageTab == "active" ? "Applied and interviewing. After fourteen days with nothing heard, a job moves to Done as No response." : "Rejected, no response, or an offer.") testId="stage-note"
                      else
                        section
                          button role="checkbox" aria-checked=freshOnly press=toggleFresh testId="found-fresh"
                            display="flex" align-items="center" gap=8 text-align="start" accent-color="-exact-label"
                            text "Posted this week only" flex=1 min-width=0
                            image "symbol:checkmark" aria-hidden=true visibility=(freshOnly ? "visible" : "hidden")
                        section
                          for l in shownLeads key=l.id
                            link href=path("lead", l.id) testId=`lead-${l.id}`
                              row flex=1 min-width=0 gap=12 align-items="center"
                                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                  text l.title
                                  text leadWhere(l) font="-exact-subheadline" color="-exact-secondary-label"
                                  if leadMeta(l) != ""
                                    text leadMeta(l) font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                                text `${l.score}%` font="-exact-title3" font-variant-numeric="tabular-nums" flex="0 0 auto"
                              image "symbol:forward-chevron"
                          if shownLeads.length == 0
                            row
                              text (checking ? "Looking…" : jobQuery.trim() != "" ? `No found posting matches “${jobQuery.trim()}”.` : freshOnly ? "Nothing found was posted this week." : "Nothing found yet.") color="-exact-secondary-label" flex=1 min-width=0 testId="leads-none"
                          footer
                            text `${leadsNote}${leads.unlisted > 0 ? ` Listed: the best 80 and everything posted this week. ${leads.unlisted} older, lower-scored postings are left out.` : ""}${leads.underPay > 0 ? ` ${leads.underPay} more are left out because their pay tops out under the floor in your direction notes.` : ""}` testId="leads-note"
                    column navigationSplit="placeholder" flex=1 justify-content="center" align-items="center" padding=24
                      text "Select a job to see how you fit it, requirement by requirement, and the resume written for it." color="-exact-secondary-label" text-align="center" max-width="26.25rem"
              if e.name == "job"
                column navigationKey=`${e.id}` navigationScroll="job-detail" position="absolute" inset=0
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Job" role="heading" aria-level=2
                  if not job.loaded or job.id != e.params.id
                    column flex=1 justify-content="center" align-items="center"
                      if failed(job)
                        text "Couldn’t load this job. It may have been deleted." color="-exact-secondary-label" text-align="center" padding=24
                      else
                        progress aria-label="Loading" testId="job-loading"
                  else
                    list id="job-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      JobSections(job=job, doorsError=doorsError, doorsBusy=pending(doorsAsked), copied=copied, draftDoors=draftDoors, copyDoor=copyDoor, lengthError=jobLengthError, writeError=writeError, writeBusy=pending(resumeAsked), writeAgain=writeAgain, pages=(wantPages != "" and wantPages != "again" ? wantPages : `${job.pages}`), busy=pending(jobReread), error=jobActionError, saveError=jobSaveError, askGap=askQuestion, saveContact=saveContact, editResume=openEditResume, setLength=setLength, reread=rereadJob, askRemove=askRemoveJob, pickOutcome=pickOutcome, saveNote=saveOutcomeNote)
              if e.name == "lead"
                column navigationKey=`${e.id}` navigationScroll="lead-detail" position="absolute" inset=0
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Found Job" role="heading" aria-level=2
                  if not lead.loaded or lead.id != e.params.id
                    column flex=1 justify-content="center" align-items="center"
                      if failed(lead)
                        text "Couldn’t load this posting. It may have closed." color="-exact-secondary-label" text-align="center" padding=24
                      else
                        progress aria-label="Loading" testId="lead-loading"
                  else
                    list id="lead-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        row padding-top=10 padding-bottom=10
                          text lead.title flex=1 min-width=0 font="-exact-title3" hyphens="manual" testId="lead-title"
                        Field(label="Company", value=lead.company, testId="lead-company")
                        if lead.place != ""
                          Field(label="Location", value=lead.place, testId="lead-place")
                      section
                        row gap=12 align-items="center" padding-top=8 padding-bottom=8
                          text `${lead.score}%` font="-exact-large-title" font-variant-numeric="tabular-nums" flex="0 0 auto" white-space="nowrap" testId="lead-score"
                          column flex=1 min-width=0 gap=2
                            text "Quick score"
                            text lead.reason font="-exact-subheadline" color="-exact-secondary-label" testId="lead-reason"
                        if leadError != ""
                          row
                            text leadError color="-exact-system-red" flex=1 min-width=0 testId="lead-error"
                        button press=takeLead disabled=pending(leadTaken) testId="lead-read" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
                          image "symbol:book" aria-hidden=true
                          text "Read Fully"
                        button press=askDismissLead destructive=true testId="lead-dismiss"
                          text "Not for Me"
                        footer
                          text "Claude’s first sort, from your profile and the posting’s opening. Read Fully moves it to Saved, checks every requirement against your bank and writes its resume."
                      section
                        header
                          text "Posting"
                        row padding-top=10 padding-bottom=10
                          text lead.posting flex=1 min-width=0 white-space="pre-wrap" hyphens="manual" testId="lead-posting"
                        if lead.url != ""
                          link href=lead.url target="_blank" testId="lead-url"
                            text "Open the Posting" flex=1
                            image "symbol:forward-chevron"
              if e.name == "companies"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="company-list" position="absolute" inset=0
                  header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                    button id="back" press=back aria-label="Done" testId="companies-done"
                      image "symbol:close"
                    text "Watchlist" role="heading"
                    button press=checkNow disabled=(checking or pending(checkAsked) or companies.items.length == 0) testId="companies-check"
                      text "Check Now"
                  list id="company-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-height=sheetList
                    section
                      row gap=8 align-items="center"
                        input value=companyLink input=editCompanyLink submit=addCompany placeholder="Link to a company’s job board" aria-label="Link to a company’s job board" type="url"
                          autocapitalize="none" autocomplete="off" enterkeyhint="done" aria-invalid=(watchAct == "add" and companyError != "") testId="company-link" flex=1 min-width=0
                        button press=addCompany disabled=(companyLink.trim() == "" or pending(companyAdded)) buttonStyle="bordered" testId="company-add"
                          text "Add"
                      if watchAct == "add" and companyError != ""
                        row
                          text companyError color="-exact-system-red" flex=1 min-width=0 testId="company-error"
                      if watchAct == "check" and checkError != ""
                        row
                          text checkError color="-exact-system-red" flex=1 min-width=0 testId="check-error"
                      if watchAct == "remove" and removeCompanyError != ""
                        row
                          text `That company wasn’t removed. ${removeCompanyError}` color="-exact-system-red" flex=1 min-width=0 testId="company-remove-error"
                      footer
                        text (checking ? "Checking now. Found jobs appear on the Jobs list." : "Boards on Greenhouse, Lever and Ashby can be read. They are checked once a day.") testId="companies-hint"
                    if not companies.loaded
                      section
                        row
                          text (companiesError != "" ? `Your watchlist couldn’t be loaded. ${companiesError}` : "Loading your watchlist…") color=(companiesError != "" ? "-exact-system-red" : "-exact-secondary-label") flex=1 min-width=0 testId="companies-state"
                    section
                      for c in companies.items key=c.id
                        row
                          row flex=1 min-width=0 gap=12 align-items="center"
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text c.name
                              text (c.note != "" ? c.note : `${c.board}. ${c.open} ${c.open == 1 ? "job" : "jobs"} found`) font="-exact-subheadline" color=(c.note != "" ? "-exact-system-red" : "-exact-secondary-label")
                            button press=askRemoveCompany(c.id, c.name) aria-label=`Remove ${c.name}` testId=`company-remove-${c.id}`
                              image "symbol:delete"
              if e.name == "editResume"
                if job.loaded and job.id == e.params.id
                  EditResume(route=e.id, body=job.resume, height=sheetList, error=resumeError, busy=pending(resumeSaved), save=saveResume, cancel=back)
              if e.name == "resume"
                column navigationKey=`${e.id}` navigationScroll="resume-scroll" position="absolute" inset=0
                  header display="flex" flex-wrap="wrap" align-items="center" padding="8px 16px"
                    text "Resume" role="heading" aria-level=2 flex=1
                    if job.loaded and job.id == e.params.id
                      button press=openEditResume disabled=(job.status == "queued" or job.status == "running" or job.resumeStatus == "queued" or job.resumeStatus == "running") testId="resume-edit"
                        text "Edit"
                  scroll id="resume-scroll" flex=1 min-height=0
                    column gap=24 padding=16 max-width="45rem" width="100%" box-sizing="border-box" margin-left="auto" margin-right="auto"
                      if not (job.loaded and job.id == e.params.id)
                        column align-items="center" padding=24
                          if failed(job)
                            text "Couldn’t load this job. It may have been deleted." color="-exact-secondary-label" text-align="center"
                          else
                            progress aria-label="Loading"
                      if job.loaded and job.id == e.params.id
                        text `Written by Claude for ${job.title}${job.company == "" ? "" : ` at ${job.company}`}, from your bank.` font="-exact-footnote" color="-exact-secondary-label" testId="resume-for"
                        text job.resume markup="markdown" testId="resume-body"
                        if job.changes.length > 0
                          column gap=8 padding=16 border-radius=12 background-color="surface.note"
                            text "What changed from your resume" role="heading" aria-level=2 font="-exact-headline"
                            for c, i in job.changes key=c
                              text c testId=`change-${i}`
              if e.name == "addJob"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="job-form" position="absolute" inset=0
                  header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                    button id="back" press=leaveAddJob aria-label="Cancel" testId="job-cancel"
                      image "symbol:close"
                    text "New Job" role="heading"
                    button press=addJob buttonStyle="bordered-prominent" aria-label="Add" testId="job-save"
                      disabled=(jobHint != "")
                      image "symbol:checkmark"
                  list id="job-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-height=sheetList
                    section
                      row
                        input value=jobUrl input=editJobUrl submit=addJob placeholder="Link to the posting" aria-label="Link to the posting" type="url"
                          autofocus=true autocapitalize="none" autocomplete="off" enterkeyhint="done" aria-invalid=(jobRefusal != "" and jobUrl.trim() != "") testId="job-url" flex=1 min-width=0
                      if jobRefusal != "" and jobUrl.trim() != "" and not pending(jobAdded)
                        row
                          text jobRefusal color="-exact-system-red" flex=1 min-width=0 testId="job-error"
                      footer
                        text "Some job sites block reading by link. If it fails, paste the text below."
                    section
                      header
                        text "Or paste the posting"
                      row padding-top=8 padding-bottom=8
                        textarea value=jobText input=editJobText placeholder="The whole posting, including requirements" aria-label="Posting text"
                          rows=10 testId="job-text" flex=1 min-width=0
                      if jobRefusal != "" and jobUrl.trim() == "" and not pending(jobAdded)
                        row
                          text jobRefusal color="-exact-system-red" flex=1 min-width=0 testId="job-error"
                      footer
                        text (jobHint != "" ? jobHint : "Claude Code on the server reads it against your bank.") testId="job-hint"
              if e.name == "sources"
                column navigationKey=`${e.id}` navigationScroll="source-list" position="absolute" inset=0
                  // The Add button drops under the title when the title alone fills the bar (the largest text sizes).
                  header display="flex" flex-wrap="wrap" align-items="center" padding="8px 16px"
                    text "Sources" role="heading" aria-level=1 flex=1
                    button press=openAdd aria-label="Add Source" testId="add-source"
                      image "symbol:add"
                  if not lib.loaded
                    if pending(lib)
                      column flex=1 justify-content="center" align-items="center"
                        progress aria-label="Loading" testId="sources-loading"
                    else
                      EmptyState(symbol="symbol:alert", title="Can’t Load Sources", message=libError)
                        button press=pull testId="sources-retry"
                          text "Try Again"
                  else if lib.items.length == 0
                    EmptyState(symbol="symbol:document", title="No Sources", message="A source is something Claude reads for facts about your work: pasted text, a file or a git repository.")
                      button press=openAdd testId="sources-add"
                        text "Add a Source"
                  else
                    list id="source-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for s in lib.items key=s.id
                          link href=path("source", s.id) testId=`source-${s.id}`
                            row flex=1 min-width=0 gap=12 align-items="center"
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text s.title
                                text (s.status == "done" ? factCount(s.facts) : s.kind == "github" ? "Repository" : s.kind == "repo" ? "Folder" : s.kind == "file" ? "File" : "Pasted text") font="-exact-subheadline" color="-exact-secondary-label"
                              if s.status == "queued"
                                Badge(label="Waiting", tint=none)
                              if s.status == "running"
                                Badge(label="Reading", tint=none)
                              if s.status == "failed"
                                Badge(label="Failed", tint=some("-exact-system-red"))
                            image "symbol:forward-chevron"
                    column navigationSplit="placeholder" flex=1 justify-content="center" align-items="center" padding=24
                      column gap=16 width="100%" max-width="26.25rem"
                        SummaryCard(label="Read", value=`${readCount}`, detail=`of ${lib.items.length} ${lib.items.length == 1 ? "source" : "sources"}`, progress=some(readCount / lib.items.length), symbol=some("symbol:document"))
                        text "Select a source to see how its reading went, read it again or delete it." color="-exact-secondary-label" text-align="center" testId="sources-overview"
              if e.name == "source"
                column navigationKey=`${e.id}` navigationScroll="source-detail" position="absolute" inset=0
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Source" role="heading" aria-level=2
                  if not lib.loaded
                    column flex=1 justify-content="center" align-items="center" padding=24
                      if libError != ""
                        text libError color="-exact-secondary-label" text-align="center"
                      else
                        progress aria-label="Loading"
                  else if lib.items.filter(x => x.id == e.params.id).length == 0
                    EmptyState(symbol="symbol:document", title="Source Not Found", message="It was deleted.")
                      button press=back testId="source-gone-back"
                        text "Back to Sources"
                  else
                    list id="source-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      for s in lib.items.filter(x => x.id == e.params.id) key=s.id
                        SourceSections(source=s, busy=pending(reread), error=(actedSource != s.id ? "" : lastSourceAct == "remove" ? removeSourceError : rereadError), readAgain=readAgain, askRemove=askRemoveSource)
              if e.name == "add"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="add-form" position="absolute" inset=0
                  header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                    button id="back" press=leaveAdd aria-label="Cancel" testId="add-cancel"
                      image "symbol:close"
                    text "New Source" role="heading"
                    button press=add buttonStyle="bordered-prominent" aria-label="Add" testId="add-save"
                      disabled=(addHint != "")
                      image "symbol:checkmark"
                  // Pinned above the list: what kind of source, and for GitHub the search, so both stay in reach while the list scrolls.
                  column gap=12 padding="12px 16px"
                    row role="radiogroup" aria-label="Kind of source" flex-wrap="wrap" align-self="stretch"
                      button role="radio" aria-checked=(kind == "text") press=setKind("text") testId="kind-text" flex="1 1 0" min-width=0
                        text "Text"
                      button role="radio" aria-checked=(kind == "file") press=setKind("file") testId="kind-file" flex="1 1 0" min-width=0
                        text "File"
                      button role="radio" aria-checked=(kind == "repo") press=setKind("repo") testId="kind-repo" flex="1 1 0" min-width=0
                        text "Folder"
                      button role="radio" aria-checked=(kind == "github") press=setKind("github") testId="kind-github" flex="1 1 0" min-width=0
                        text "GitHub"
                    if kind == "github" and hub.loaded and hub.connected and hub.error == ""
                      input type="search" value=hubQuery input=searchHub placeholder="Search repositories" aria-label="Search repositories"
                        autocapitalize="none" autocomplete="off" testId="hub-search"
                  list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=sheetFloor max-height=sheetList
                    if kind == "text"
                      section
                        row
                          input value=draftTitle input=editTitle submit=add placeholder="Title, such as Resume 2024" aria-label="Title"
                            autofocus=true enterkeyhint="next" testId="add-title" flex=1 min-width=0
                        row padding-top=8 padding-bottom=8
                          textarea value=draftText input=editText placeholder="Paste a resume, a LinkedIn profile or a review" aria-label="Text to read"
                            rows=8 aria-invalid=(refusal != "") testId="add-text" flex=1 min-width=0
                        if refusal != "" and not pending(added)
                          row
                            text refusal color="-exact-system-red" flex=1 min-width=0 testId="add-error"
                    if kind == "file"
                      section
                        if pickedName != ""
                          Field(label="Chosen file", value=pickedName, testId="add-picked")
                        button press=choosePicked testId="add-choose" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
                          image "symbol:document" aria-hidden=true
                          text (pickedName == "" ? "Choose File" : "Choose Another File")
                        input type="file" id="add-pick" display="none" change=filePicked aria-label="File to add" testId="add-pick"
                        if refusal != "" and not pending(added)
                          row
                            text refusal color="-exact-system-red" flex=1 min-width=0 testId="add-error"
                        footer
                          text "PDF, Word or text, or a LinkedIn export zip. Up to 25 MB."
                      if inbox.files.length > 0
                        section
                          header
                            text "Already on the server"
                          row
                            text "File"
                            select value=draftFile change=pickFile aria-label="File already on the server" testId="add-file"
                              option "None" value=""
                              for name in inbox.files key=name
                                option name value=name
                    if kind == "github"
                      if not hub.loaded
                        section
                          row
                            if pending(hub)
                              progress aria-label="Loading repositories" testId="hub-loading"
                            else
                              text "Couldn’t reach the server to ask about GitHub." color="-exact-secondary-label" flex=1 min-width=0
                      else if not hub.connected or hub.error != ""
                        section
                          row
                            text hub.error flex=1 min-width=0 testId="hub-error"
                          button press=reloadHub testId="hub-retry" accent-color="-exact-label"
                            text "Try Again"
                      else
                        section
                          if hubExtras > 0
                            // The whole row is the control, as the repository rows are: a small box alone is easy to miss.
                            button role="checkbox" aria-checked=showExtra press=toggleExtra testId="hub-extra"
                              display="flex" align-items="center" gap=8 text-align="start" accent-color="-exact-label"
                              text "Show forks and archived" flex=1 min-width=0
                              image "symbol:checkmark" aria-hidden=true visibility=(showExtra ? "visible" : "hidden")
                          footer
                            text (chosen.length == 0 ? `Signed in to GitHub as ${hub.login}. Only your own commits are read.` : `${chosen.length} ${chosen.length == 1 ? "repository" : "repositories"} chosen.`) font-variant-numeric="tabular-nums" testId="hub-who"
                        for o in hub.owners.filter(o => hubShown.filter(r => r.owner == o).length > 0) key=o
                          section
                            header
                              text o
                            for r in hubShown.filter(r => r.owner == o) key=r.full
                              button role="checkbox" aria-checked=(chosen.includes(r.full)) press=toggleRepo(r.full) disabled=r.added testId=`repo-${r.full}`
                                display="flex" align-items="center" gap=8 text-align="start" accent-color="-exact-label"
                                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                  // The whole name: deep in a long group its header has scrolled away.
                                  text r.full
                                  text (r.added ? "Already a source" : r.detail) font="-exact-subheadline" color="-exact-secondary-label"
                                // The mark keeps its place whether ticked or not, so ticking a row never moves its text.
                                image "symbol:checkmark" aria-hidden=true visibility=(chosen.includes(r.full) ? "visible" : "hidden")
                        if refusal != "" and not pending(added)
                          section
                            row
                              text refusal color="-exact-system-red" flex=1 min-width=0 testId="add-error"
                        if hubShown.length == 0
                          section
                            row
                              text (hub.repos.length == 0 ? "No repositories found." : hubQuery.trim() == "" ? "Only forks and archived repositories here. Turn them on above." : `No repository matches “${hubQuery.trim()}”.`) color="-exact-secondary-label" flex=1 min-width=0 testId="hub-none"
                    if kind == "repo"
                      section
                        row
                          text "Folder"
                          input value=draftRepo input=editRepo submit=add placeholder="/srv/code/app" aria-label="Repository folder"
                            autofocus=true autocapitalize="none" autocomplete="off" enterkeyhint="next" aria-invalid=(refusal != "") testId="add-repo" flex=1 min-width=0
                        row
                          text "Author"
                          input value=author input=editAuthor submit=add placeholder="Name or email" aria-label="Commit author"
                            autocapitalize="none" autocomplete="off" enterkeyhint="done" testId="add-author" flex=1 min-width=0
                        if refusal != "" and not pending(added)
                          row
                            text refusal color="-exact-system-red" flex=1 min-width=0 testId="add-error"
                        footer
                          text "A folder on the server. Only commits by this author count as yours. Claude reads the history and the code, and can’t change the repository."
                    section
                      footer
                        text (addHint != "" ? addHint : "Claude Code on the server reads what you add and puts what it finds in your bank.") testId="add-hint"
      // Five tabs stay on one line: their labels stop growing at a size that still fits a phone's width, as a platform tab bar's do.
      row role="tablist"
        button role="tab" aria-controls="panel-bank" aria-selected=(nav.tab == "bank") press=pick("bank") testId="tab-bank" flex=1 min-width=0
          image "symbol:person"
          if wideWindow
            text "Experience" font-size="min(-exact-subheadline, 17px)"
          else
            text "Experience" font-size="min(-exact-caption2, 13px)"
        button role="tab" aria-controls="panel-profile" aria-selected=(nav.tab == "profile") press=pick("profile") testId="tab-profile" flex=1 min-width=0
          image "symbol:book"
          if wideWindow
            text "Profile" font-size="min(-exact-subheadline, 17px)"
          else
            text "Profile" font-size="min(-exact-caption2, 13px)"
        button role="tab" aria-controls="panel-talk" aria-selected=(nav.tab == "talk") press=pick("talk") testId="tab-talk" flex=1 min-width=0
          image "symbol:messages"
          if wideWindow
            text "Talk" font-size="min(-exact-subheadline, 17px)"
          else
            text "Talk" font-size="min(-exact-caption2, 13px)"
        button role="tab" aria-controls="panel-jobs" aria-selected=(nav.tab == "jobs") press=pick("jobs") testId="tab-jobs" flex=1 min-width=0
          image "symbol:search"
          if wideWindow
            text "Jobs" font-size="min(-exact-subheadline, 17px)"
          else
            text "Jobs" font-size="min(-exact-caption2, 13px)"
        button role="tab" aria-controls="panel-sources" aria-selected=(nav.tab == "sources") press=pick("sources") testId="tab-sources" flex=1 min-width=0
          image "symbol:document"
          if wideWindow
            text "Sources" font-size="min(-exact-subheadline, 17px)"
          else
            text "Sources" font-size="min(-exact-caption2, 13px)"
      dialog id="remove-fact" role="alertdialog" aria-label="Delete this fact?"
        text "It’s removed from the bank and from future profiles and resumes, and stays out when its source is read again. This can’t be undone."
        button press=removeFact destructive=true commandfor="remove-fact" command="close" testId="remove-fact-confirm"
          text "Delete"
        button commandfor="remove-fact" command="close" testId="remove-fact-cancel"
          text "Cancel"
      dialog id="clear-talk" role="alertdialog" aria-label="Start the conversation over?"
        text "The messages are cleared. Facts already added to your bank stay."
        button press=clearTalk destructive=true commandfor="clear-talk" command="close" testId="clear-talk-confirm"
          text "Start Over"
        button commandfor="clear-talk" command="close" testId="clear-talk-cancel"
          text "Cancel"
      dialog id="replace-edits" role="alertdialog" aria-label="Replace your edits?"
        text "You edited this resume by hand. Writing it again replaces your edits."
        button press=replaceEdits destructive=true commandfor="replace-edits" command="close" testId="replace-edits-confirm"
          text "Replace My Edits"
        button press=keepEdits commandfor="replace-edits" command="close" testId="replace-edits-cancel"
          text "Cancel"
      dialog id="dismiss-lead" role="alertdialog" aria-label="Not for you?"
        text "This posting leaves Found and won’t be shown again."
        button press=dismissLead destructive=true commandfor="dismiss-lead" command="close" testId="dismiss-lead-confirm"
          text "Not for Me"
        button commandfor="dismiss-lead" command="close" testId="dismiss-lead-cancel"
          text "Cancel"
      dialog id="discard-edits" role="alertdialog" aria-label="Discard your changes?"
        text "What you changed here hasn’t been saved."
        button press=back destructive=true commandfor="discard-edits" command="close" testId="discard-edits-confirm"
          text "Discard"
        button commandfor="discard-edits" command="close" testId="discard-edits-cancel"
          text "Keep Editing"
      dialog id="remove-job" role="alertdialog" aria-label="Delete this job?"
        text "Its fit and the resume written for it are deleted. This can’t be undone."
        button press=removeJob destructive=true commandfor="remove-job" command="close" testId="remove-job-confirm"
          text "Delete"
        button commandfor="remove-job" command="close" testId="remove-job-cancel"
          text "Cancel"
      dialog id="remove-company" role="alertdialog" aria-label=`Remove ${aimedCompanyName}?`
        text "The jobs found there, and their quick scores, are removed too. Jobs you read fully stay."
        button press=removeCompany destructive=true commandfor="remove-company" command="close" testId="remove-company-confirm"
          text "Remove"
        button commandfor="remove-company" command="close" testId="remove-company-cancel"
          text "Cancel"
      dialog id="remove-source" role="alertdialog" aria-label="Delete this source?"
        text "Its facts are deleted too, except ones you edited."
        button press=removeSource destructive=true commandfor="remove-source" command="close" testId="remove-source-confirm"
          text "Delete"
        button commandfor="remove-source" command="close" testId="remove-source-cancel"
          text "Cancel"

// A sheet whose content has not arrived: it says so, or that it could not, and can always be closed.
component SheetWait
  props
    route: number
    title: string
    waiting: bool
    // What to say when it is not coming.
    message: string
    close: action
  view
    column navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=close aria-label="Close" testId="sheet-close"
          image "symbol:close"
        text title role="heading"
      column flex=1 justify-content="center" align-items="center" padding=24 gap=12
        if waiting
          progress aria-label="Loading"
        else
          text message color="-exact-secondary-label" text-align="center" max-width="26.25rem"

// A label over its value, as a grouped row.
component Field
  props
    label: string
    value: string
    testId: string
  view
    row
      column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
        text label font="-exact-footnote" color="-exact-secondary-label"
        text value hyphens="manual" testId=testId

// One fact: its headline, the story behind it, where it belongs, what supports it.
component FactSections
  props
    fact: Fact
    role: string
    error: string
    edit: action
    askRemove: action
  view
    section
      row padding-top=10 padding-bottom=10
        text fact.text flex=1 min-width=0 font="-exact-title3" hyphens="manual" testId="fact-text"
      if fact.detail != ""
        row padding-top=10 padding-bottom=10
          text fact.detail flex=1 min-width=0 hyphens="manual" testId="fact-detail-text"
    section
      Field(label="Role", value=role, testId="fact-role")
      Field(label="Category", value=kindLabel(fact.kind), testId="fact-kind")
      if fact.metric != ""
        Field(label="Measured result", value=fact.metric, testId="fact-metric")
      if fact.skills != ""
        Field(label="Skills", value=fact.skills, testId="fact-skills")
    section
      header
        text "Evidence"
      row padding-top=10 padding-bottom=10
        text (fact.evidence == "" ? "None recorded." : fact.evidence) flex=1 min-width=0 testId="fact-evidence"
      footer
        text (fact.source == "Added by hand" ? "Added by hand." : `From ${fact.source}.`) testId="fact-source"
    section
      if error != ""
        row
          text error color="-exact-system-red" flex=1 min-width=0 testId="fact-error"
      button press=edit testId="fact-edit" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
        image "symbol:pencil" aria-hidden=true
        text "Edit"
      button press=askRemove destructive=true testId="fact-delete"
        text "Delete Fact"

// The edit sheet: its drafts start from the fact when its route shows it.
component EditFact
  props
    route: number
    fact: Fact
    roles: Place[]
    error: string
    busy: bool
    save: action
    cancel: action
  state body = fact.text
  state story = fact.detail
  state metric = fact.metric
  state roleId = fact.roleId
  state kind = fact.kind
  derive dirty = body != fact.text or story != fact.detail or metric != fact.metric or roleId != fact.roleId or kind != fact.kind
  action pickRole(v: string)
    roleId = v
  action pickKind(v: string)
    kind = v
  action leave
    if dirty
      showModal("discard-edits")
    else
      cancel()
  action editBody(v: string)
    body = v
  action editStory(v: string)
    story = v
  action editMetric(v: string)
    metric = v
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll="edit-form" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=leave aria-label="Cancel" testId="edit-cancel"
          image "symbol:close"
        text "Edit Fact" role="heading"
        button press=save(fact.id, body, story, metric, roleId, kind) disabled=(body.trim() == "" or busy) buttonStyle="bordered-prominent" aria-label="Save" testId="edit-save"
          image "symbol:checkmark"
      list id="edit-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          header
            text "Fact"
          row padding-top=8 padding-bottom=8
            textarea value=body input=editBody placeholder="What you did, in one sentence" aria-label="Fact"
              rows=4 aria-invalid=(error != "") testId="edit-text" flex=1 min-width=0
          if error != ""
            row
              text error color="-exact-system-red" flex=1 min-width=0 testId="edit-error"
        section
          header
            text "Story"
          row padding-top=8 padding-bottom=8
            textarea value=story input=editStory placeholder="The situation, what you did and decided, what was hard, what came of it" aria-label="Story"
              rows=6 testId="edit-story" flex=1 min-width=0
        section
          header
            text "Measured result"
          row
            input value=metric input=editMetric placeholder="Such as 40% fewer support tickets" aria-label="Measured result"
              enterkeyhint="done" testId="edit-metric" flex=1 min-width=0
          footer
            text (body.trim() == "" ? "Enter the fact to save it." : "Leave the result empty if nothing was measured.") testId="edit-hint"
        section
          header
            text "Filed under"
          row
            select value=roleId change=pickRole aria-label="Role" testId="edit-role" flex=1 min-width=0
              for r in roles key=r.id
                option r.name value=r.id
          row
            text "Category"
            select value=kind change=pickKind aria-label="Category" testId="edit-kind"
              option "Accomplishment" value="accomplishment"
              option "Project" value="project"
              option "Responsibility" value="responsibility"
              option "Skill" value="skill"
              option "Education" value="education"
              option "Other" value="other"

// One source: how its reading went, what it is, and reading it again or deleting it.
component SourceSections
  props
    source: Source
    busy: bool
    error: string
    readAgain: action
    askRemove: action
  view
    section
      row padding-top=10 padding-bottom=10
        text source.title flex=1 min-width=0 font="-exact-title3" hyphens="manual" testId="source-title"
      Field(label="Reading", value=statusText(source), testId="source-status")
      Field(label=(source.kind == "github" ? "Repository" : source.kind == "repo" ? "Folder" : source.kind == "file" ? "File" : "Text"), value=source.detail, testId="source-what")
    section
      if error != ""
        row
          text error color="-exact-system-red" flex=1 min-width=0 testId="source-error"
      button press=readAgain disabled=(busy or source.status == "queued" or source.status == "running") testId="source-read" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
        image "symbol:refresh" aria-hidden=true
        text "Read Again"
      button press=askRemove destructive=true testId="source-delete"
        text "Delete Source"
      footer
        text (source.status == "queued" or source.status == "running" ? "It can be read again once this reading finishes." : "Reading again replaces its facts, except ones you edited.") testId="source-hint"

// One job: what it is, how well the bank fits it and why, the resume for it, each requirement with its support.
component JobSections
  props
    job: Job
    // The length the picker shows: the one being asked about while a confirm is open, else the resume's.
    pages: string
    lengthError: string
    doorsError: string
    writeError: string
    writeBusy: bool
    writeAgain: action
    doorsBusy: bool
    copied: string
    draftDoors: action
    copyDoor: action
    busy: bool
    error: string
    saveError: string
    askGap: action
    reread: action
    askRemove: action
    pickOutcome: action
    saveNote: action
    saveContact: action
    editResume: action
    setLength: action
  state note = job.outcomeNote
  state who = job.contact
  action editWho(v: string)
    who = v
  action editNote(v: string)
    note = v
  view
    section
      row padding-top=10 padding-bottom=10
        text job.title flex=1 min-width=0 font="-exact-title3" hyphens="manual" testId="job-title"
      if job.company != ""
        Field(label="Company", value=job.company, testId="job-company")
      if job.place != ""
        Field(label="Location", value=job.place, testId="job-place")
      if job.url != ""
        link href=job.url target="_blank" testId="job-posting"
          text "Open the Posting" flex=1
          image "symbol:forward-chevron"
      if job.status != "done"
        Field(label="Reading", value=(job.status == "queued" ? "Waiting to be read." : job.status == "running" ? "Claude is reading it against your bank. This takes a few minutes." : `Reading failed. ${job.note}`), testId="job-status")
    if job.status == "done" or job.verdict != ""
      section
        row gap=12 align-items="center" padding-top=8 padding-bottom=8
          text `${job.fit}%` font="-exact-large-title" font-variant-numeric="tabular-nums" flex="0 0 auto" white-space="nowrap" testId="job-fit"
          column flex=1 min-width=0 gap=2
            text "Fit"
            text `${job.covered} of ${job.asked} requirements supported by your bank` font="-exact-subheadline" color="-exact-secondary-label" testId="job-covered"
        if job.resumeStatus == "queued" or job.resumeStatus == "running"
          row gap=12 align-items="center"
            progress aria-label="Writing the resume"
            text (job.resume == "" ? "Claude is writing your resume for this job and having it reviewed. This takes several minutes." : "Claude is writing this resume again and having it reviewed. The one below is the last version.") color="-exact-secondary-label" flex=1 min-width=0 testId="job-resume-writing"
        if job.resumeStatus == "failed"
          row
            text `The resume couldn’t be written. ${job.resumeNote} Write it again to retry.` color="-exact-system-red" flex=1 min-width=0 testId="job-resume-failed"
        if job.resumeStale and job.resumeStatus != "queued" and job.resumeStatus != "running"
          row
            text (job.edited ? "Your bank changed after you edited this resume. Write it again to bring it up to date." : "Your bank changed after this resume was written. It’s written again by itself a few minutes after your last change.") color="-exact-secondary-label" flex=1 min-width=0 testId="job-resume-stale"
        if job.atsScore >= 0
          row
            row flex=1 min-width=0 gap=12 align-items="center"
              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                text `Parser score ${job.atsScore} of 100` font-variant-numeric="tabular-nums" testId="job-parser"
                text (job.atsScore >= job.atsRequired ? `At or above the ${job.atsRequired} required. Ready to send.` : `Below the ${job.atsRequired} required. Write the resume again, or see what holds it down under “How a tracking system reads the PDF”.`) font="-exact-subheadline" color="-exact-secondary-label" hyphens="manual"
              Badge(label=(job.atsScore >= job.atsRequired ? "Ready" : "Not ready"), tint=(job.atsScore >= job.atsRequired ? some("-exact-system-green") : some("-exact-system-orange")))
        if job.resume != ""
          link href=path("resume", job.id) testId="job-resume"
            text "Resume for This Job" flex=1
            image "symbol:forward-chevron"
        if job.pdf != ""
          link href=job.pdf testId="job-pdf"
            image "symbol:download" aria-hidden=true
            text "Download the PDF to Send" flex=1
        row
          text "Length"
          select value=pages change=setLength disabled=(busy or job.status == "queued" or job.status == "running" or job.resumeStatus == "queued" or job.resumeStatus == "running") aria-label="Resume length" testId="job-pages"
            option "Two pages" value="2"
            option "One page" value="1"
        if lengthError != ""
          row
            text `The length wasn’t changed. ${lengthError}` color="-exact-system-red" flex=1 min-width=0 testId="job-length-error"
        button press=editResume disabled=(job.resume == "" or busy or job.status == "queued" or job.status == "running" or job.resumeStatus == "queued" or job.resumeStatus == "running") testId="job-edit-resume" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
          image "symbol:pencil" aria-hidden=true
          text "Edit Resume"
        button press=writeAgain disabled=(writeBusy or busy or job.status != "done" or job.resumeStatus == "queued" or job.resumeStatus == "running") testId="job-write-again" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
          image "symbol:refresh" aria-hidden=true
          text "Write Resume Again"
        if writeError != ""
          row
            text `The resume wasn’t queued. ${writeError}` color="-exact-system-red" flex=1 min-width=0 testId="job-write-error"
        footer
          text (job.weighed ? "Claude’s reading of the posting against your bank. Production work and recent work count for more; set each role’s kind of work under Experience. A change to your bank writes every unsent resume again by itself, except one you edited. Writing it again takes several minutes and replaces your edits." : "Read before evidence was weighed, so personal and production work count alike. Read it again for a weighted fit.") testId="job-weighed"
    section
      header
        text "What happened"
      row
        text "Outcome"
        select value=job.outcome change=pickOutcome(note) aria-label="Outcome" testId="job-outcome"
          option "Not applied" value=""
          option "Applied" value="applied"
          option "Interviewed" value="interviewed"
          option "Rejected" value="rejected"
          option "No response" value="no-response"
          option "Offer" value="offer"
      row
        input value=note input=editNote change=saveNote(job.outcome) placeholder="Note, such as how far it got" aria-label="Outcome note" testId="job-outcome-note" flex=1 min-width=0
      row
        input value=who input=editWho change=saveContact placeholder="Who you know there, and how" aria-label="Who you know there" testId="job-contact" flex=1 min-width=0
      if saveError != ""
        row
          text `That change wasn’t saved. ${saveError}` color="-exact-system-red" flex=1 min-width=0 testId="job-save-error"
      footer
        text "Your record of what became of it, and anyone who could vouch for you. New jobs are scored with the outcomes in view."
    if job.status == "done" or job.verdict != ""
      section
        header
          text "Reach out"
        for d in job.doors key=d.id
          row
            column flex=1 min-width=0 gap=6 padding-top=8 padding-bottom=8
              text d.to font="-exact-headline" testId=`door-to-${d.id}`
              text `${d.why} ${d.find}` font="-exact-subheadline" color="-exact-secondary-label" hyphens="manual"
              text d.message hyphens="manual" white-space="pre-wrap" overflow-wrap="break-word" testId=`door-message-${d.id}`
              button press=copyDoor(d.id, d.message) buttonStyle="bordered" align-self="flex-start" testId=`door-copy-${d.id}`
                text (copied == `${job.id}:${d.id}` ? "Copied" : "Copy Message")
        if job.doorsStatus == "queued" or job.doorsStatus == "running"
          row gap=12 align-items="center"
            progress aria-label="Writing"
            text "Claude is drafting messages. This takes a minute or two." color="-exact-secondary-label" flex=1 min-width=0 testId="doors-writing"
        if job.doorsStatus == "failed" or doorsError != ""
          row
            text (doorsError != "" ? doorsError : `Drafting failed. ${job.doorsNote}`) color="-exact-system-red" flex=1 min-width=0 testId="doors-error"
        button press=draftDoors disabled=(doorsBusy or job.doorsStatus == "queued" or job.doorsStatus == "running") testId="doors-draft" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
          image "symbol:compose" aria-hidden=true
          text (job.doors.length > 0 ? "Draft Again" : "Draft Messages")
        footer
          text (job.doors.length > 0 ? "Drafts to personalise before you send. Fill in anything in [brackets]. Drafting again replaces these." : "Short messages to reach a person at the company, each by a different way in. If you noted who you know there, the first is written to them.")
    if job.status == "done" or job.verdict != ""
      section
        header
          text "Claude’s read"
        row padding-top=10 padding-bottom=10
          text job.verdict flex=1 min-width=0 hyphens="manual" testId="job-verdict"
      section
        header
          text "Requirements"
        for n in job.requirements key=n.id
          row
            row flex=1 min-width=0 gap=12 align-items="center"
              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                text n.text hyphens="manual"
                text (n.must ? n.evidence : `Preferred. ${n.evidence}`) font="-exact-subheadline" color="-exact-secondary-label" hyphens="manual"
                if n.basis != ""
                  text `Rests on ${n.basis}. Counts ${n.counted}%.` font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
              Badge(label=coverageLabel(n.coverage), tint=(n.coverage == "strong" ? some("-exact-system-green") : n.coverage == "partial" ? some("-exact-system-orange") : none))
      if job.reviewScore != ""
        section
          header
            text "Resume review"
          row
            row flex=1 min-width=0 gap=12 align-items="center"
              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                text (job.reviewPassed ? "Passed" : "Short of 8") testId="review-result"
                text (job.reviewRounds == 0 ? "Scored as first written." : job.reviewRounds == 1 ? "Rewritten once to get here." : `Rewritten ${job.reviewRounds} times to get here.`) font="-exact-subheadline" color="-exact-secondary-label"
              Badge(label=`${job.reviewScore} of 10`, tint=(job.reviewPassed ? some("-exact-system-green") : some("-exact-system-orange")))
          for r in job.seats key=r.id
            row
              row flex=1 min-width=0 gap=12 align-items="center"
                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                  text (r.model == "" ? r.seat : `${r.seat} · ${r.model}`)
                  text `Scores by round: ${r.score}` font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId=`seat-scores-${r.id}`
                  text r.note font="-exact-subheadline" color="-exact-secondary-label" hyphens="manual"
          footer
            text "Three readers, each a different model, score it every round. It is rewritten from your bank until they average 8 of 10, up to three times."
      if job.reviewChanges.length > 0
        section
          header
            text "What the review changed"
          for c, i in job.reviewChanges key=c
            row
              text c flex=1 min-width=0 padding-top=4 padding-bottom=4 hyphens="manual" testId=`review-change-${i}`
      if job.ats.length > 0
        section
          header
            text "How a tracking system reads the PDF"
          if job.atsScore >= 0
            row gap=12 align-items="center" padding-top=8 padding-bottom=8
              text `${job.atsScore}` font="-exact-title1" font-variant-numeric="tabular-nums" flex="0 0 auto" white-space="nowrap" testId="ats-score"
              column flex=1 min-width=0 gap=2
                text `Parser score, of 100. ${job.atsRequired} is required.`
                text job.atsParts font="-exact-subheadline" color="-exact-secondary-label" font-variant-numeric="tabular-nums" hyphens="manual" testId="ats-parts"
          for a in job.ats key=a.id
            row
              row flex=1 min-width=0 gap=12 align-items="center"
                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                  text a.label
                  text a.note font="-exact-subheadline" color="-exact-secondary-label" font-variant-numeric="tabular-nums" hyphens="manual"
                Badge(label=(a.ok ? "Good" : "Fix"), tint=(a.ok ? some("-exact-system-green") : some("-exact-system-orange")))
          footer
            text "The PDF’s text is read back the way a parser reads it. One column, plain text and standard section names are what parsers handle; this checks the file has them. The score is counted by fixed rules, with no model, and a resume needs 85 to be ready. Its terms part counts the posting’s terms your bank supports; a term your bank can’t support lowers Fit, not this score. A bullet without a number scores lower, and that is allowed: a number is only shown when your bank has one worth showing."
      if job.checks.length > 0
        section
          header
            text "Your fit test"
          for c in job.checks key=c.id
            row
              row flex=1 min-width=0 gap=12 align-items="center"
                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                  text c.question hyphens="manual"
                  if c.note != ""
                    text c.note font="-exact-subheadline" color="-exact-secondary-label" hyphens="manual"
                Badge(label=(c.answer == "yes" ? "Yes" : c.answer == "partly" ? "Partly" : c.answer == "no" ? "No" : "Unknown"), tint=(c.answer == "yes" ? some("-exact-system-green") : c.answer == "partly" ? some("-exact-system-orange") : c.answer == "no" ? some("-exact-system-red") : none))
          footer
            text "The questions from your direction notes, answered from the posting. They don’t change the fit number."
      if job.termsIn.length + job.termsBank.length + job.termsMissing.length > 0
        section
          header
            text "Keyword match"
          Field(label=`In the resume, ${job.termsIn.length} of ${job.termsIn.length + job.termsBank.length + job.termsMissing.length}`, value=(job.termsIn.length == 0 ? "None" : job.termsIn.join(", ")), testId="job-terms-in")
          if job.termsBank.length > 0
            Field(label="In your bank, missing from the resume", value=job.termsBank.join(", "), testId="job-terms-bank")
          if job.termsMissing.length > 0
            Field(label="Not in your bank", value=job.termsMissing.join(", "), testId="job-terms-missing")
          footer
            text "The posting’s own terms, which recruiters search for and tracking systems match. Terms your bank doesn’t support are never added."
      if job.knockouts.length > 0
        section
          header
            text "Screening questions to expect"
          for k in job.knockouts key=k.id
            row
              row flex=1 min-width=0 gap=12 align-items="center"
                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                  text k.question hyphens="manual"
                  if k.note != ""
                    text k.note font="-exact-subheadline" color="-exact-secondary-label" hyphens="manual"
                Badge(label=(k.answer == "yes" ? "Yes" : k.answer == "no" ? "No" : "Unknown"), tint=(k.answer == "yes" ? some("-exact-system-green") : k.answer == "no" ? some("-exact-system-red") : none))
      if job.strengths.length > 0
        section
          header
            text "What carries it"
          for t in job.strengths key=t
            row padding-top=6 padding-bottom=6
              text t flex=1 min-width=0 hyphens="manual"
      if job.risks.length > 0
        section
          header
            text "What may screen you out"
          for t in job.risks key=t
            row padding-top=6 padding-bottom=6
              text t flex=1 min-width=0 hyphens="manual"
      if job.gaps.length > 0
        section
          header
            text "Worth adding"
          for t in job.gaps key=t
            button press=askGap(t) accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
              text t flex=1 min-width=0 padding-top=6 padding-bottom=6 hyphens="manual"
              image "symbol:forward-chevron" aria-hidden=true
          footer
            text "Pick one to answer it in Talk, then read the job again."
    section
      if error != ""
        row
          text error color="-exact-system-red" flex=1 min-width=0 testId="job-action-error"
      button press=reread disabled=(busy or job.status == "queued" or job.status == "running") testId="job-read" accent-color="-exact-label" display="flex" align-items="center" gap=8 text-align="start"
        image "symbol:refresh" aria-hidden=true
        text "Read Again"
      button press=askRemove destructive=true testId="job-delete"
        text "Delete Job"
      footer
        text (job.status == "queued" or job.status == "running" ? "It can be read again once this reading finishes." : "Reading again scores the job against your bank as it is now and writes its resume again.") testId="job-read-hint"

// What kind of work a role or project was. Two choices; saving returns to the list.
component EditRole
  props
    route: number
    role: Role
    employers: Role[]
    error: string
    busy: bool
    save: action
    cancel: action
  state standing = role.standing
  state reach = role.reach
  state partOf = role.partOf
  action leave
    if standing != role.standing or reach != role.reach or partOf != role.partOf
      showModal("discard-edits")
    else
      cancel()
  action pickPartOf(v: string)
    partOf = v
  action pickStanding(v: string)
    standing = v
  action pickReach(v: string)
    reach = v
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll="role-form" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=leave aria-label="Cancel" testId="role-cancel"
          image "symbol:close"
        text "Kind of Work" role="heading"
        button press=save(role.id, (partOf == "" ? standing : ""), reach, partOf) disabled=busy buttonStyle="bordered-prominent" aria-label="Save" testId="role-save"
          image "symbol:checkmark"
      list id="role-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          header
            text role.name
          if not role.employer
            row
              text "Done for"
              select value=partOf change=pickPartOf aria-label="The employer it was done for" testId="role-part-of"
                option "No employer" value=""
                for e in employers key=e.id
                  option e.name value=e.id
          if partOf == ""
            row
              text "Type of work"
              select value=standing change=pickStanding aria-label="Type of work" testId="role-standing"
                option "Not set" value=""
                option "Employer" value="employer"
                option "Own company" value="own"
                option "Contract" value="contract"
                option "Personal project" value="personal"
          row
            text "Reached users"
            select value=reach change=pickReach aria-label="Reached users" testId="role-reach"
              option "Not set" value=""
              option "In production" value="live"
              option "Was in production" value="retired"
              option "Never reached users" value="never"
          if error != ""
            row
              text error color="-exact-system-red" flex=1 min-width=0 testId="role-error"
          footer
            text (partOf == "" ? "Used to weigh this work when a job is read: paid, production and recent work count for more than a personal project that never shipped." : "It counts as that employer’s work, and is written up under that job in your profile and resumes.") testId="role-hint"

// The direction notes, edited as Markdown. They steer what the profile argues for, how jobs are judged and how resumes are shaped.
component EditDirection
  props
    route: number
    body: string
    height: number
    error: string
    busy: bool
    save: action
    cancel: action
  state draft = body
  action edit(v: string)
    draft = v
  action leave
    if draft != body
      showModal("discard-edits")
    else
      cancel()
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll="direction-form" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=leave aria-label="Cancel" testId="direction-cancel"
          image "symbol:close"
        text "Direction" role="heading"
        button press=save(draft) disabled=busy buttonStyle="bordered-prominent" aria-label="Save" testId="direction-save"
          image "symbol:checkmark"
      list id="direction-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-height=height
        section
          row padding-top=8 padding-bottom=8
            textarea value=draft input=edit placeholder="Where you are heading: the tracks you want, your constraints, a fit test for a listing, how your resume should lead" aria-label="Direction notes"
              rows=22 testId="direction-text" flex=1 min-width=0
          if error != ""
            row
              text error color="-exact-system-red" flex=1 min-width=0 testId="direction-error"
          footer
            text "Your own notes, in Markdown. A “Target tracks” list sets the roles your profile argues for, and a “Fit test” list of questions is answered on every job. A section you mark as a personal lens, such as numerology, is used to judge fit and is kept out of resumes and the profile."

// The person's own details. They open every resume, so saving rewrites the first lines of the resumes not yet sent.
component EditDetails
  props
    route: number
    me: Person
    height: number
    error: string
    busy: bool
    save: action
    cancel: action
  state name = me.name
  state location = me.location
  state email = me.email
  state phone = me.phone
  state website = me.website
  state github = me.github
  state linkedin = me.linkedin
  action editName(v: string)
    name = v
  action editLocation(v: string)
    location = v
  action editEmail(v: string)
    email = v
  action editPhone(v: string)
    phone = v
  action editWebsite(v: string)
    website = v
  action editGithub(v: string)
    github = v
  action editLinkedin(v: string)
    linkedin = v
  action submit
    save(name, location, email, phone, website, github, linkedin)
  action leave
    if name != me.name or location != me.location or email != me.email or phone != me.phone or website != me.website or github != me.github or linkedin != me.linkedin
      showModal("discard-edits")
    else
      cancel()
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll="details-form" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=leave aria-label="Cancel" testId="details-cancel"
          image "symbol:close"
        text "Your Details" role="heading"
        button press=submit disabled=busy buttonStyle="bordered-prominent" aria-label="Save" testId="details-save"
          image "symbol:checkmark"
      list id="details-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-height=height
        section
          header
            text "Name"
          row
            input value=name input=editName submit=submit placeholder="Your full name" aria-label="Name"
              autocomplete="name" enterkeyhint="next" aria-invalid=(error != "" and name.trim() == "") testId="details-name" flex=1 min-width=0
        section
          header
            text "Where you live"
          row
            input value=location input=editLocation submit=submit placeholder="Such as Brooklyn, NY" aria-label="Where you live"
              autocomplete="address-level2" enterkeyhint="next" testId="details-location" flex=1 min-width=0
          footer
            text "Shown on your resume and used for a posting’s location questions."
        section
          header
            text "Contact"
          row
            text "Email" width=84 flex-shrink=0 color="-exact-secondary-label"
            input value=email input=editEmail submit=submit placeholder="you@example.com" aria-label="Email" type="email"
              autocapitalize="none" autocomplete="email" spellcheck=false enterkeyhint="next" testId="details-email" flex=1 min-width=0
          row
            text "Phone" width=84 flex-shrink=0 color="-exact-secondary-label"
            input value=phone input=editPhone submit=submit placeholder="(212) 555-0142" aria-label="Phone" type="tel"
              autocomplete="tel" enterkeyhint="next" testId="details-phone" flex=1 min-width=0
          row
            text "Website" width=84 flex-shrink=0 color="-exact-secondary-label"
            input value=website input=editWebsite submit=submit placeholder="example.com" aria-label="Website" type="url"
              autocapitalize="none" autocomplete="off" spellcheck=false enterkeyhint="next" testId="details-website" flex=1 min-width=0
          row
            text "GitHub" width=84 flex-shrink=0 color="-exact-secondary-label"
            input value=github input=editGithub submit=submit placeholder="github.com/you" aria-label="GitHub" type="url"
              autocapitalize="none" autocomplete="off" spellcheck=false enterkeyhint="next" testId="details-github" flex=1 min-width=0
          row
            text "LinkedIn" width=84 flex-shrink=0 color="-exact-secondary-label"
            input value=linkedin input=editLinkedin submit=submit placeholder="linkedin.com/in/you" aria-label="LinkedIn" type="url"
              autocapitalize="none" autocomplete="off" spellcheck=false enterkeyhint="done" testId="details-linkedin" flex=1 min-width=0
          if error != ""
            row
              text error color="-exact-system-red" flex=1 min-width=0 testId="details-error"
          footer
            text "Anything left empty stays off your resume. Saving updates the resume of every job still marked Not applied."

// The resume for one job, edited as Markdown before it is sent. Saving prints the PDF again.
component EditResume
  props
    route: number
    body: string
    height: number
    error: string
    busy: bool
    save: action
    cancel: action
  state draft = body
  action edit(v: string)
    draft = v
  action leave
    if draft != body
      showModal("discard-edits")
    else
      cancel()
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll="resume-form" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=leave aria-label="Cancel" testId="resume-cancel"
          image "symbol:close"
        text "Edit Resume" role="heading"
        button press=save(draft) disabled=(busy or draft.trim() == "") buttonStyle="bordered-prominent" aria-label="Save" testId="resume-save"
          image "symbol:checkmark"
      list id="resume-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-height=height
        section
          row padding-top=8 padding-bottom=8
            textarea value=draft input=edit aria-label="Resume" placeholder="The resume, in Markdown"
              rows=26 testId="resume-text" flex=1 min-width=0
          if error != ""
            row
              text error color="-exact-system-red" flex=1 min-width=0 testId="resume-error"
          footer
            text (busy ? "Saving and printing the PDF…" : "Markdown: # your name, ## a section, ### a role, - a bullet. Saving prints the PDF again.") testId="resume-hint"

