// Eggdev: the career studio. Five places on one main line (look.contract's MainLine), each its own stack.
// Home: the things that need the person, one in focus (home.contract).
// Record (record.contract and the Sources screens here): Experience, the roles and facts as records; Profile, one
//   document written from the whole record, and the questions whose answers would strengthen it; Direction and
//   Details, the person's own notes and contact line; Sources, what has been added to read and how each reading
//   went. What the person supplies is taken as true, so nothing waits for review.
// Jobs (jobs.contract): the job list, one job as a record with its posting map, its resume as a document, adding a
//   job, a posting found on the watchlist, and the watchlist. Talk (talk.contract): the conversation and its questions.
// System: the Public page and the machine (backups and sign-in).
// server.ts keeps it all; worker.ts does the slow reading and writing. All polled.
use Viewport, Page, Section, Title, SectionHead, Line, StrongLine, QuietLine, FailLine, Indented, Action, MainAction, DangerAction, Record, Labelled, FieldLabel, SearchField, Choices, ChoiceWord, CheckLine, OutLink, WorkLine, MainLine, NavTab, SubBar, SubLine, SubLink, Actions, statusWord, lookNarrow, lookTight from "./look.contract"
use HomeScreen, Queue, QueueItem, Sent from "./home.contract"
use JobRow, JobList, Lead, LeadList, LeadDetail, Company, CompanyList, Job, JobsScreen, JobScreen, ResumeScreen, EditResumeScreen, AddJobScreen, LeadScreen, CompaniesScreen from "./jobs.contract"
use Talk, TalkScreen, QuestionsScreen from "./talk.contract"
use Bank, Overlap, Profile, Direction, Person, ExperienceScreen, RoleScreen, FactScreen, EditFactScreen, ProfileScreen, DirectionScreen, DetailsScreen, RecordNav, RecordWait, roleName, factCount, plainLoadError from "./record.contract"

// The look is DESIGN.md's on every screen: Geist, one ink, one paper, two greys, hairline rules (look.contract).
font "Geist" = "assets/fonts/Geist.ttf"

routes nav
  tab home "/"
  // Record: Experience at its root; Profile and Sources open over it from Record's second line, each with its own
  // screens over it in turn.
  tab bank "/record"
    role "/record/role/:id"
    fact "/record/fact/:id"
    edit "/record/fact/:id/edit"
    profile "/profile"
      direction "/profile/direction"
      details "/profile/details"
    sources "/sources"
      source "/source/:id"
      add "/sources/add"
  tab jobs "/jobs"
    job "/job/:id"
    resume "/job/:id/resume"
    editResume "/job/:id/resume/edit"
    addJob "/jobs/add"
    lead "/lead/:id"
    companies "/jobs/companies"
  tab talk "/talk"
    questions "/talk/questions"
  // System: the Public page at its root, the machine over it.
  tab publicPage "/system"
    system "/system/backups"

shape Source
  id: string
  kind: string
  title: string
  detail: string
  status: string
  note: string
  facts: number
  // How many readings are ahead of it while it waits; -1 when it is not waiting.
  ahead: number

shape SourceList
  loaded: bool
  items: Source[]

shape Inbox
  folder: string
  files: string[]

shape HubRepo
  full: string
  owner: string
  name: string
  detail: string
  added: bool
  // A fork or an archived repository: hidden until asked for.
  extra: bool

// GitHub as the server's own sign-in sees it.
shape Hub
  loaded: bool
  connected: bool
  login: string
  error: string
  // The accounts the repositories belong to: the person's own first.
  owners: string[]
  repos: HubRepo[]

// The public collection: the one text the public page's chat answers from. Only the person decides what is in it.
shape PublicNote
  line: number
  kind: string
  text: string

shape PublicText
  loaded: bool
  text: string
  // When it was saved, in milliseconds and in words: 0 and "" before the first save.
  savedAt: number
  savedWhen: string
  // Its fingerprint, "" before the first save. Publishing names the saved text by it.
  sha256: string
  notes: PublicNote[]

// A draft from the bank, or the notes for a text. Neither saves anything.
shape PublicDraft
  ok: bool
  error: string
  text: string
  notes: PublicNote[]

// What the public page answers from now. where: here | absent (no studio Worker, as in local work) | starting.
shape PublicLive
  loaded: bool
  where: string
  live: bool
  sha256: string
  publishedAt: number
  publishedWhen: string

// A write to the machine; note says what happened when it went well.
shape Outcome
  ok: bool
  error: string
  note: string

// The model's sign-in. state: "" (the status leaves it out) | idle | waiting | done | failed.
shape CodexLogin
  state: string
  url: string
  code: string
  detail: string

shape ProgramCheck
  name: string
  ok: bool
  detail: string

// The cloud machine, as the studio's Worker reports it. Times are milliseconds (0: unknown) and words.
shape SystemStatus
  loaded: bool
  where: string
  // running | starting | stopping | stopped | failed, "" when not here
  machine: string
  // False while the machine starts and cannot report yet.
  keeper: bool
  note: string
  startedAt: number
  startedWhen: string
  lastUsedAt: number
  lastUsedWhen: string
  backupAt: number
  backupWhen: string
  backupError: string
  unsaved: bool
  unsavedSince: number
  unsavedWhen: string
  startedFrom: string
  // ok | failed | "" (not checked); the sandbox also unknown
  llm: string
  llmDetail: string
  signedIn: string
  signedInDetail: string
  sandbox: string
  sandboxDetail: string
  login: CodexLogin
  programs: ProgramCheck[]

shape Clock
  epochAtZero: number

shape Reply
  ok: bool
  error: string

// A source's reading in one line, and where it waits (the data module counts what is ahead of it).
fn sourceLine(s: Source): string = s.status == "queued" ? "Read in turn, one source at a time. Usually a few minutes each." : s.status == "running" ? "Being read now. Usually a few minutes; a repository can take longer." : s.status == "failed" ? `Reading failed. ${s.note}` : s.note != "" ? s.note : `Read. ${factCount(s.facts)} came from it.`
fn sourceKind(k: string): string = k == "github" ? "Repository" : k == "repo" ? "Folder" : k == "file" ? "File" : "Pasted text"
fn sourcePlace(s: Source): string = s.ahead < 0 ? "" : s.ahead == 0 ? "next" : `${s.ahead} ahead`
fn companyCount(n: number): string = `${n} ${n == 1 ? "company" : "companies"}`
fn loadError(code: string): string = code == "offline" ? "Can’t reach the server. Check that it’s running, then try again." : "The server couldn’t answer. Try again."
// A failed read of the machine: the data module's own sentence, or the usual words for a lost connection.
fn failText(code: string): string = code.includes(" ") ? code : loadError(code)
fn plural(n: number, word: string): string = `${n} ${word}${n == 1 ? "" : "s"}`
// How long ago, in words, from the ticked time; "" when unknown.
fn ago(at: number, now: number): string = at <= 0 ? "" : now - at < 60000 ? "less than a minute ago" : now - at < 3600000 ? `${plural(floor((now - at) / 60000), "minute")} ago` : now - at < 86400000 ? `${plural(floor((now - at) / 3600000), "hour")} ago` : `${plural(floor((now - at) / 86400000), "day")} ago`
// The relative time, then the exact one: "5 minutes ago (Nov 16, 2026, 3:04 PM)".
fn agoAndWhen(at: number, words: string, now: number): string = at <= 0 ? "" : `${ago(at, now)} (${words})`
fn pad3(n: number): string = n < 10 ? `00${n}` : n < 100 ? `0${n}` : `${n}`
fn thousands(n: number): string = n < 1000 ? `${n}` : `${floor(n / 1000)},${pad3(n % 1000)}`
fn noteLabel(n: PublicNote): string = `Line ${n.line} may mention ${n.kind}`
// Whether the app can call the model, in one line: the sign-in first, then the sandbox, then the last call.
fn modelLine(s: SystemStatus): string = s.signedIn == "failed" ? "Not signed in to ChatGPT, so the app can’t call the model. Sign in again." : s.sandbox == "failed" ? "Signed in to ChatGPT, but the model can’t run its tools on the machine." : s.llm == "failed" ? "Signed in to ChatGPT, but the last call to the model failed." : s.llm == "ok" ? "Signed in to ChatGPT. The app can call the model." : s.signedIn == "ok" ? "Signed in to ChatGPT. The model hasn’t been called yet." : "Not checked yet. The machine checks when it starts."
fn modelDetail(s: SystemStatus): string = s.signedIn == "failed" ? s.signedInDetail : s.sandbox == "failed" ? s.sandboxDetail : s.llm == "failed" ? s.llmDetail : ""
fn machineLine(s: SystemStatus): string = s.machine == "running" ? "Running" : s.machine == "starting" ? "Starting" : s.machine == "stopping" ? "Stopping" : s.machine == "stopped" ? "Stopped. It starts when the studio is next used." : s.machine == "failed" ? "Failed to start" : "Not known"

component App
  members "./home.contract"
  state kind = "text"
  state draftTitle = ""
  state draftText = ""
  state draftFile = ""
  state draftRepo = ""
  // A file chosen with the picker: its copy's path, and the name it had.
  state pickedPath = ""
  state pickedName = ""
  state author = "" persist
  // The GitHub repositories ticked in the sheet, by full name, and the search over them.
  state chosen: string[] = []
  state hubQuery = ""
  state showExtra = false
  // The last Add's refusal, in red in the sheet until an Add succeeds.
  state refusal = ""
  state jobUrl = ""
  state jobText = ""
  state jobRefusal = ""
  state companyLink = ""
  // The Jobs list: which stage is shown (saved, active, done, or found), the search, and whether Found shows only this week's postings.
  state stageTab = "saved" persist
  state jobQuery = ""
  state freshOnly = false
  state bankQuery = ""
  // Which record the last action was on, and which action: its error shows on that record only, and one action's old error never stands in for another's.
  state actedJob = ""
  state lastJobAct = ""
  state actedLead = ""
  state lastLeadAct = ""
  state actedFact = ""
  state lastFactAct = ""
  state actedSource = ""
  state lastSourceAct = ""
  // The last thing tried on the Jobs list, in Talk and on the watchlist: an error shows only for that, and is put away when the person moves on.
  state rowTried = false
  // The drafted message last copied, as "job:door".
  state copied = ""
  state rowJob = ""
  state talkAct = ""
  state watchAct = ""
  // The resume length asked for while the person is asked about replacing their edits; "" when it is a re-read.
  state wantPages = ""
  // The company the remove alert is asking about.
  state aimedCompany = ""
  state aimedCompanyName = ""
  resource bank = loadBank() as shape Bank else empty()
  resource lib = loadSources() as shape SourceList else empty()
  resource inbox = loadInbox() as shape Inbox else empty()
  resource profile = loadProfile() as shape Profile else empty()
  resource notes = loadDirection() as shape Direction else empty()
  resource me = loadPerson() as shape Person else empty()
  resource talk = loadTalk() as shape Talk else empty()
  state talkDraft = "" persist
  // What was sent, so the reply clears the composer only if nothing new was typed meanwhile.
  state talkSending = ""
  resource hub = loadGithub() as shape Hub else empty()
  resource jobs = loadJobs() as shape JobList else empty()
  resource job = loadJob(selectedJob) as shape Job else empty()
  resource leads = loadLeads() as shape LeadList else empty()
  resource lead = loadLead(selectedLead) as shape LeadDetail else empty()
  resource companies = loadCompanies() as shape CompanyList else empty()
  resource viewport = exactViewport() as shape Viewport else empty()
  // Only the root reads the window; the new-look screens are told whether it is wide (two columns, a ledger).
  derive wide = viewport.width >= lookNarrow()
  // Which place of the main line is shown, and which screen of Record's second line: Sources marks its own
  // screens too, and Profile marks the profile's (Direction and Details mark themselves).
  derive inRecord = nav.tab == "bank"
  derive inSystem = nav.tab == "publicPage"
  derive recordAt = stack(nav).filter(e => e.name == "sources").length > 0 ? "sources" : top(nav).name == "direction" ? "direction" : top(nav).name == "details" ? "details" : stack(nav).filter(e => e.name == "profile").length > 0 ? "profile" : "bank"
  // The open questions about two roles that both say Present, read while Experience or a role is shown.
  derive onExperience = top(nav).name == "bank" or top(nav).name == "role"
  resource overlaps = loadOverlaps() when onExperience as shape Overlap[] else empty()
  // What the worker reads before it writes the profile: every source waiting or being read, and a job being read.
  derive profileAhead = lib.items.filter(x => x.status == "queued" or x.status == "running").length + jobs.items.filter(j => j.status == "running").length
  mutation asked as shape Reply refreshes profile
  mutation notesSaved as shape Reply refreshes notes then afterNotes
  mutation personSaved as shape Reply refreshes me, job then afterPerson
  mutation talkSent as shape Reply refreshes talk then afterTalk
  mutation talkAsked as shape Reply refreshes talk then afterAsk
  mutation talkCleared as shape Reply refreshes talk
  mutation savedFact as shape Reply refreshes bank, profile then afterSaveFact
  mutation removedFact as shape Reply refreshes bank, profile then afterRemoveFact
  mutation roleSaved as shape Reply refreshes bank, overlaps then afterRoleSave
  mutation added as shape Reply refreshes lib, inbox, hub then afterAdd
  mutation reread as shape Reply refreshes lib
  mutation jobAdded as shape Reply refreshes jobs then afterJobAdd
  mutation jobReread as shape Reply refreshes jobs, job
  mutation doorsAsked as shape Reply refreshes job
  mutation jobRemoved as shape Reply refreshes jobs then afterRemoveJob
  mutation outcomeSaved as shape Reply refreshes job, jobs
  mutation rowOutcome as shape Reply refreshes jobs, job
  mutation contactSaved as shape Reply refreshes job
  mutation lengthSet as shape Reply refreshes job, jobs
  mutation resumeAsked as shape Reply refreshes job, jobs
  mutation resumeSaved as shape Reply refreshes job then afterResume
  mutation leadTaken as shape Reply refreshes leads, jobs then afterTakeLead
  mutation leadDismissed as shape Reply refreshes leads then afterDismissLead
  mutation companyAdded as shape Reply refreshes companies then afterCompany
  mutation companyRemoved as shape Reply refreshes companies, leads
  mutation checkAsked as shape Reply refreshes leads
  mutation removedSource as shape Reply refreshes lib, bank, profile then afterRemoveSource
  derive selectedFact = match stack(nav).filter(e => e.name == "fact").at(-1) { case some(e) => e.params.id, case none => "" }
  derive selectedJob = match stack(nav).filter(e => e.name == "job" or e.name == "resume" or e.name == "editResume").at(-1) { case some(e) => e.params.id, case none => "" }
  derive jobsError = match failure(jobs) { case some(f) => plainLoadError(f.code), case none => "" }
  derive jobAddError = match jobAdded { case some(r) => r.error, case none => "" }
  derive rereadJobError = pending(jobReread) ? "" : match jobReread { case some(r) => r.error, case none => "" }
  derive removeJobError = pending(jobRemoved) ? "" : match jobRemoved { case some(r) => r.error, case none => "" }
  derive jobActionError = actedJob != selectedJob ? "" : lastJobAct == "remove" ? removeJobError : lastJobAct == "read" ? rereadJobError : ""
  // A change to a job's record that the server did not take: said where the change was made.
  derive outcomeError = pending(outcomeSaved) ? "" : match outcomeSaved { case some(r) => r.error, case none => "" }
  derive contactError = pending(contactSaved) ? "" : match contactSaved { case some(r) => r.error, case none => "" }
  derive lengthError = pending(lengthSet) ? "" : match lengthSet { case some(r) => r.error, case none => "" }
  derive jobSaveError = actedJob != selectedJob ? "" : lastJobAct == "outcome" ? outcomeError : lastJobAct == "contact" ? contactError : ""
  derive doorsError = actedJob != selectedJob or lastJobAct != "doors" or pending(doorsAsked) ? "" : match doorsAsked { case some(r) => r.error, case none => "" }
  derive jobLengthError = actedJob == selectedJob and lastJobAct == "length" ? lengthError : ""
  derive writeError = actedJob != selectedJob or lastJobAct != "write" or pending(resumeAsked) ? "" : match resumeAsked { case some(r) => r.error, case none => "" }
  derive rowError = not rowTried or pending(rowOutcome) ? "" : match rowOutcome { case some(r) => r.error, case none => "" }
  derive takeError = pending(leadTaken) ? "" : match leadTaken { case some(r) => r.error, case none => "" }
  derive dismissError = pending(leadDismissed) ? "" : match leadDismissed { case some(r) => r.error, case none => "" }
  derive leadError = actedLead != selectedLead ? "" : lastLeadAct == "dismiss" ? dismissError : takeError
  derive talkLoadError = match failure(talk) { case some(f) => plainLoadError(f.code), case none => plainLoadError("offline") }
  derive resumeError = pending(resumeSaved) ? "" : match resumeSaved { case some(r) => r.error, case none => "" }
  derive jobHint = pending(jobAdded) ? "Adding it." : jobUrl.trim() == "" and jobText.trim() == "" ? "Paste the posting or its link to add it." : ""
  derive savedJobs = jobs.items.filter(j => j.stage == "saved").length
  derive activeJobs = jobs.items.filter(j => j.stage == "active").length
  derive doneJobs = jobs.items.filter(j => j.stage == "done").length
  derive shownJobs = jobs.items.filter(j => j.stage == stageTab and `${j.title} ${j.company}`.toLowerCase().includes(jobQuery.trim().toLowerCase()))
  derive shownLeads = leads.items.filter(l => (not freshOnly or l.fresh) and `${l.title} ${l.company}`.toLowerCase().includes(jobQuery.trim().toLowerCase()))
  derive selectedLead = match stack(nav).filter(e => e.name == "lead").at(-1) { case some(e) => e.params.id, case none => "" }
  derive companyError = pending(companyAdded) ? "" : match companyAdded { case some(r) => r.error, case none => "" }
  derive checking = leads.status == "queued" or leads.status == "running"
  derive checkError = pending(checkAsked) ? "" : match checkAsked { case some(r) => r.error, case none => "" }
  derive companiesError = match failure(companies) { case some(f) => plainLoadError(f.code), case none => "" }
  derive leadsError = match failure(leads) { case some(f) => plainLoadError(f.code), case none => "" }
  derive removeCompanyError = pending(companyRemoved) ? "" : match companyRemoved { case some(r) => r.error, case none => "" }
  derive leadsNote = leadsError != "" ? `Found postings couldn’t be loaded. ${leadsError}` : leads.companies == 0 ? "Add companies to your watchlist and their open jobs are found and scored for you." : checking ? `Checking ${companyCount(leads.companies)} now. This takes a few minutes.` : leads.status == "failed" ? `The last check failed. ${leads.note}` : leads.checked == "" ? `${companyCount(leads.companies)} on your watchlist, not checked yet.` : `Checked ${leads.checked}. ${leads.note} A quick fit is a first sort; read a job fully for its real fit.`
  derive selectedSource = match stack(nav).filter(e => e.name == "source").at(-1) { case some(e) => e.params.id, case none => "" }
  derive readCount = lib.items.filter(s => s.status == "done").length
  derive writing = profile.status == "queued" or profile.status == "running"
  derive profileError = match failure(profile) { case some(f) => plainLoadError(f.code), case none => "" }
  derive notesError = pending(notesSaved) ? "" : match notesSaved { case some(r) => r.error, case none => "" }
  derive talkError = pending(talkSent) ? "" : match talkSent { case some(r) => r.error, case none => "" }
  derive clearTalkError = pending(talkCleared) ? "" : match talkCleared { case some(r) => r.error, case none => "" }
  derive askTalkError = pending(talkAsked) ? "" : match talkAsked { case some(r) => r.error, case none => "" }
  // What was last tried in Talk and refused: said once, over the entry field.
  derive talkTried = talkAct == "send" ? talkError : talkAct == "ask" ? askTalkError : talkAct == "clear" and clearTalkError != "" ? `The conversation wasn’t cleared. ${clearTalkError}` : ""
  derive lastTalk = match talk.messages.at(-1) { case some(m) => m.id, case none => "" }
  derive personError = pending(personSaved) ? "" : match personSaved { case some(r) => r.error, case none => "" }
  derive askError = pending(asked) ? "" : match asked { case some(r) => r.error, case none => "" }
  derive bankError = match failure(bank) { case some(f) => plainLoadError(f.code), case none => "" }
  derive libError = match failure(lib) { case some(f) => plainLoadError(f.code), case none => "" }
  derive removeFactError = pending(removedFact) ? "" : match removedFact { case some(r) => r.error, case none => "" }
  derive roleError = pending(roleSaved) ? "" : match roleSaved { case some(r) => r.error, case none => "" }
  derive saveFactError = pending(savedFact) ? "" : match savedFact { case some(r) => r.error, case none => "" }
  derive addError = match added { case some(r) => r.error, case none => "" }
  derive rereadError = pending(reread) ? "" : match reread { case some(r) => r.error, case none => "" }
  derive removeSourceError = pending(removedSource) ? "" : match removedSource { case some(r) => r.error, case none => "" }
  derive addBody = kind == "text" ? draftText.trim() : kind == "file" ? (pickedPath != "" ? pickedName : draftFile) : kind == "github" ? chosen.join("\n") : draftRepo.trim()
  // What the picker lists: matches of the search, without forks and archived ones unless asked for or already ticked.
  derive hubShown = hub.repos.filter(r => r.full.toLowerCase().includes(hubQuery.trim().toLowerCase()) and (showExtra or not r.extra or chosen.includes(r.full)))
  derive hubExtras = hub.repos.filter(r => r.extra).length
  // Why Add is disabled, under the form (not red: nothing has been refused).
  derive addHint = pending(added) ? "Adding it." : kind == "text" and addBody == "" ? "Paste some text to add it." : kind == "file" and addBody == "" ? "Choose a file to add it." : kind == "github" and addBody == "" ? "Tick the repositories worth reading." : kind == "repo" and addBody == "" ? "Enter the repository’s path to add it." : kind == "repo" and author.trim() == "" ? "Enter the name or email your commits use." : ""

  // The Public page. The field shows the saved text until the person edits it or loads a draft; the edit is kept
  // across a reload, and is unsaved while it differs from the saved text (the server trims space at the end; space at the start is left to Save).
  state pubDraft = "" persist
  state pubEdited = false persist
  state pubAct = ""
  // The notes for a text other than the saved one (a draft, or the field checked again), and that text.
  state noteText = ""
  state noteList: PublicNote[] = []
  state sysAct = ""
  // What "5 minutes ago" counts from on the Public and System pages, ticked while one is open.
  state ticked = 0
  resource time = exactTime() as shape Clock else empty()
  derive onPublic = top(nav).name == "publicPage"
  derive onSystem = top(nav).name == "system"
  // Neither page is in the main poll: each loads when it opens, and System polls on its own while open.
  resource pub = loadPublic() when onPublic as shape PublicText else empty()
  resource live = loadLive() when onPublic as shape PublicLive else empty()
  resource sys = loadSystem() when onSystem as shape SystemStatus else empty()
  mutation drafted as shape PublicDraft then afterDraft
  mutation checked as shape PublicDraft then afterCheck
  mutation pubSaved as shape Reply refreshes pub
  mutation published as shape Outcome refreshes live
  mutation unpublished as shape Outcome refreshes live
  mutation backedUp as shape Outcome refreshes sys
  mutation loginAsked as shape Outcome refreshes sys
  mutation loginCancelled as shape Outcome refreshes sys
  derive nowMs = time.epochAtZero + ticked
  derive pubField = pubEdited ? pubDraft : pub.text
  derive pubDirty = pub.loaded and pubEdited and pubDraft.trim() != pub.text.trim()
  derive pubTooLong = pubField.length > 120000
  derive pubLoadError = match failure(pub) { case some(f) => plainLoadError(f.code), case none => "" }
  derive liveError = match failure(live) { case some(f) => failText(f.code), case none => "" }
  derive draftOk = match drafted { case some(r) => r.ok, case none => false }
  derive draftReply = match drafted { case some(r) => r.text, case none => "" }
  derive draftNotes = match drafted { case some(r) => r.notes, case none => noteList }
  derive draftError = pending(drafted) ? "" : match drafted { case some(r) => r.error, case none => "" }
  derive checkOk = match checked { case some(r) => r.ok, case none => false }
  derive checkReply = match checked { case some(r) => r.text, case none => "" }
  derive checkNotes = match checked { case some(r) => r.notes, case none => noteList }
  derive noteCheckError = pending(checked) ? "" : match checked { case some(r) => r.error, case none => "" }
  derive pubSaveError = pending(pubSaved) ? "" : match pubSaved { case some(r) => r.error, case none => "" }
  derive publishError = pending(published) ? "" : match published { case some(r) => r.error, case none => "" }
  derive unpublishError = pending(unpublished) ? "" : match unpublished { case some(r) => r.error, case none => "" }
  // The notes the list shows: the saved text's; else the field's own (its draft, or a check); else none fit the field.
  derive notesStale = pubDirty and noteText != pubField
  derive shownNotes = not pubDirty ? pub.notes : noteText == pubField ? noteList : []
  derive liveHere = live.loaded and live.where == "here"
  derive isLive = liveHere and live.live
  derive liveDiffers = liveHere and pub.sha256 != "" and pub.sha256 != live.sha256
  derive canPublish = liveDiffers and not pubDirty and not pending(pubSaved) and not pending(published) and not pending(unpublished)
  derive liveLine = not live.loaded ? (liveError != "" ? `Couldn’t check what is published. ${liveError}` : "Checking what is published…") : live.where == "absent" ? "Publishing works only in the deployed studio. Here you can write and save the text." : live.where == "starting" ? "The machine is starting, so what is published can’t be checked yet. Try again in a moment." : not live.live ? "Nothing is published. The chat on the public page is off." : `Published ${agoAndWhen(live.publishedAt, live.publishedWhen, nowMs)}. The public chat answers from it.`
  derive liveNote = not liveHere or pub.sha256 == "" ? "" : liveDiffers ? (live.live ? "Your saved text is different and is not published yet." : "Your saved text is not published yet.") : "What is published is your saved text."
  derive pubState = pubTooLong ? `${thousands(pubField.length)} of 120,000 characters. Shorten it to save.` : pubDirty ? "Changes not saved" : pub.savedAt > 0 ? `Saved ${agoAndWhen(pub.savedAt, pub.savedWhen, nowMs)}` : "Nothing saved yet"
  derive sysLoadError = match failure(sys) { case some(f) => failText(f.code), case none => "" }
  // The sign-in in progress, only ever from the latest status: its one-time code is kept nowhere else.
  derive loginNow = sys.login
  derive loginWaiting = loginNow.state == "waiting"
  derive loginError = pending(loginAsked) ? "" : match loginAsked { case some(r) => r.error, case none => "" }
  derive cancelError = pending(loginCancelled) ? "" : match loginCancelled { case some(r) => r.error, case none => "" }
  derive backupReply = pending(backedUp) ? "" : match backedUp { case some(r) => (r.ok ? r.note : r.error), case none => "" }
  derive backupFailed = match backedUp { case some(r) => not r.ok, case none => false }

  task poll mount
    every(5000, pull)
  // A reply takes a few seconds: look for it more often than the rest while one is being written.
  task talkPoll mount
    every(1500, pullTalk)
  // System: its status every 15 seconds while it is open, every 3 while a sign-in waits for the person.
  task systemPoll when onSystem
    every(15000, pullSystem)
  task loginPoll when onSystem and loginWaiting
    every(3000, pullSystem)
  task publicTick when onPublic
    every(30000, tickClock)
  action tickClock
    ticked = performanceNow()
  action pullSystem
    ticked = performanceNow()
    refresh sys
  action pullTalk
    if talk.busy
      talkAct = ""
      refresh talk

  action pull
    refresh bank
    refresh lib
    refresh profile
    refresh jobs
    refresh job
    refresh leads
    refresh talk
  // Moving to another tab or record puts away the errors of what was tried before.
  // Leaving Home sends what is held there.
  action pick(name: string)
    rowTried = false
    talkAct = ""
    if name != "home"
      sendHeld()
    nav = select(nav, name)
  action back
    nav = back(nav)
  // Record's second line. Each screen opens over Experience; Direction and Details open over the profile, as they
  // always have, so saving them returns there.
  action goRecord(name: string)
    if name == "direction"
      openDirection()
    else if name == "details"
      openDetails()
    else if name == "profile"
      nav = push(select(nav, "bank"), "/profile")
    else if name == "sources"
      nav = push(select(nav, "bank"), "/sources")
    else
      pick("bank")
  // System's second line: the Public page and the machine.
  action goSystem(name: string)
    if name == "system"
      openSystem()
    else
      openPublic()
  // A row is a link; Back, Forward and a deep link arrive here too. Every screen is a page of its own, pushed over
  // the one it was opened from; a fact or source opened from another of its kind takes its place.
  action follow(url: string)
    rowTried = false
    if url != "/"
      sendHeld()
    nav = (top(nav).name == "fact" and url.startsWith("/record/fact/") and not url.endsWith("/edit")) or (top(nav).name == "source" and url.startsWith("/source/")) ? replace(nav, url) : go(nav, url)
  // The resume's page goes back to its job: the page under it, or (after a reload or a link straight to the resume)
  // the job's page in its place.
  action backToJob(id: string)
    nav = stack(nav).filter(e => e.name == "job").length > 0 ? back(nav) : replace(nav, path("job", id))
  action searchBank(v: string)
    bankQuery = v
  action setStage(v: string)
    rowTried = false
    stageTab = v
  action searchJobs(v: string)
    jobQuery = v
  action setFresh(on: bool)
    freshOnly = on
  // The list's picker hands its job first, then the outcome chosen.
  action pickRowOutcome(id: string, outcome: string)
    rowTried = true
    rowJob = id
    send rowOutcome = setOutcome(id, outcome)
  action openAddJob
    jobUrl = ""
    jobText = ""
    jobRefusal = ""
    stageTab = "saved"
    nav = push(select(nav, "jobs"), "/jobs/add")
  // A sheet with something typed or pasted asks before it is thrown away.
  action leaveAddJob
    if jobUrl.trim() != "" or jobText.trim() != ""
      showModal("discard-edits")
    else
      nav = back(nav)
  action leaveAdd
    if draftText.trim() != "" or draftTitle.trim() != "" or draftRepo.trim() != "" or chosen.length > 0 or pickedPath != "" or draftFile != ""
      showModal("discard-edits")
    else
      nav = back(nav)
  action editJobUrl(v: string)
    jobUrl = v
  action editJobText(v: string)
    jobText = v
  action addJob
    if jobHint == ""
      send jobAdded = addJob(jobUrl.trim(), jobText.trim())
  action afterJobAdd
    jobRefusal = jobAddError
    if jobAddError == "" and top(nav).name == "addJob"
      nav = back(nav)
  // Writing a resume again replaces what the person edited by hand, so it asks first.
  action rereadJob
    actedJob = selectedJob
    lastJobAct = "read"
    if job.edited
      wantPages = ""
      showModal("replace-edits")
    else
      send jobReread = readJob(selectedJob)
  // Only the resume is written again, from the bank as it is now. The reading of the posting stays.
  action writeAgain
    actedJob = selectedJob
    lastJobAct = "write"
    if job.edited
      wantPages = "again"
      showModal("replace-edits")
    else
      send resumeAsked = rewriteResume(selectedJob)
  action replaceEdits
    if wantPages == ""
      send jobReread = readJob(selectedJob)
    else if wantPages == "again"
      send resumeAsked = rewriteResume(selectedJob)
    else
      send lengthSet = setLength(selectedJob, wantPages)
    wantPages = ""
  // Cancelled: the Length picker goes back to the length the resume has.
  action keepEdits
    wantPages = ""
  action askRemoveJob
    showModal("remove-job")
  action draftDoors
    if not pending(doorsAsked)
      actedJob = selectedJob
      lastJobAct = "doors"
      copied = ""
      send doorsAsked = draftOutreach(selectedJob)
  // Copies a drafted message, and says which one was copied until another is.
  action copyDoor(id: string, message: string)
    copyText(message)
    copied = `${selectedJob}:${id}`
  action removeJob
    actedJob = selectedJob
    lastJobAct = "remove"
    send jobRemoved = removeJob(selectedJob)
  // A delete leaves its page only once the server has done it. A refusal is said on the page.
  action afterRemoveJob
    if removeJobError == "" and top(nav).name == "job"
      nav = back(nav)
  // An event hands its action the captured arguments first, then its own value: the picker's value
  // is the outcome and the field's is the note, so each has its own action.
  action pickOutcome(note: string, outcome: string)
    actedJob = selectedJob
    lastJobAct = "outcome"
    send outcomeSaved = saveOutcome(selectedJob, outcome, note.trim(), "picked")
  action saveOutcomeNote(outcome: string, note: string)
    actedJob = selectedJob
    lastJobAct = "outcome"
    send outcomeSaved = saveOutcome(selectedJob, outcome, note.trim(), "note")
  action saveContact(who: string)
    actedJob = selectedJob
    lastJobAct = "contact"
    send contactSaved = saveContact(selectedJob, who.trim())
  action setLength(pages: string)
    actedJob = selectedJob
    lastJobAct = "length"
    if job.edited
      wantPages = pages
      showModal("replace-edits")
    else
      send lengthSet = setLength(selectedJob, pages)
  action openEditResume
    nav = push(nav, path("editResume", selectedJob))
  action saveResume(body: string)
    if body.trim() != "" and not pending(resumeSaved)
      send resumeSaved = saveResume(selectedJob, body)
  action afterResume
    if resumeError == "" and top(nav).name == "editResume"
      nav = back(nav)
  action takeLead
    if not pending(leadTaken)
      actedLead = selectedLead
      lastLeadAct = "take"
      send leadTaken = readLead(selectedLead)
  // A posting taken up is now one of the person's jobs: show them where it went.
  action afterTakeLead
    if takeError == "" and top(nav).name == "lead"
      stageTab = "saved"
      nav = back(nav)
  action askDismissLead
    showModal("dismiss-lead")
  action dismissLead
    actedLead = selectedLead
    lastLeadAct = "dismiss"
    send leadDismissed = dismissLead(selectedLead)
  action afterDismissLead
    if dismissError == "" and top(nav).name == "lead"
      nav = back(nav)
  action openCompanies
    watchAct = ""
    companyLink = ""
    refresh companies
    nav = push(select(nav, "jobs"), "/jobs/companies")
  action editCompanyLink(v: string)
    companyLink = v
  action addCompany
    if companyLink.trim() != "" and not pending(companyAdded)
      watchAct = "add"
      send companyAdded = addCompany(companyLink.trim())
  action afterCompany
    companyLink = companyError == "" ? "" : companyLink
  action askRemoveCompany(id: string, name: string)
    aimedCompany = id
    aimedCompanyName = name
    showModal("remove-company")
  action removeCompany
    watchAct = "remove"
    send companyRemoved = removeCompany(aimedCompany)
  action checkNow
    watchAct = "check"
    send checkAsked = checkWatchlist()
  action openDirection
    refresh notes
    nav = push(push(select(nav, "bank"), "/profile"), "/profile/direction")
  action saveNotes(body: string)
    send notesSaved = saveDirection(body)
  action afterNotes
    if notesError == "" and top(nav).name == "direction"
      nav = back(nav)
  action editTalk(v: string)
    talkDraft = v
  action sendTalk
    if talkDraft.trim() != "" and not talk.busy and not pending(talkSent)
      talkAct = "send"
      talkSending = talkDraft.trim()
      send talkSent = sendTalk(talkDraft.trim())
  action afterTalk
    if talkError == "" and talkDraft.trim() == talkSending
      talkDraft = ""
    if lastTalk != ""
      scrollIntoView("transcript", lastTalk, block="end")
  action openQuestions
    refresh talk
    nav = push(select(nav, "talk"), "/talk/questions")
  action askQuestion(q: string)
    if not pending(talkAsked)
      talkAct = "ask"
      send talkAsked = askTalk(q)
  // From the questions sheet it closes the sheet. From a gap on the profile or a job it goes to Talk, where the question now stands.
  action afterAsk
    if askTalkError == "" and top(nav).name == "questions"
      nav = back(nav)
    else if top(nav).name != "questions"
      nav = select(nav, "talk")
    if lastTalk != ""
      scrollIntoView("transcript", lastTalk, block="end")
  action askClearTalk
    showModal("clear-talk")
  action clearTalk
    talkAct = "clear"
    send talkCleared = clearTalk()
  action openDetails
    refresh me
    nav = push(push(select(nav, "bank"), "/profile"), "/profile/details")
  action openPublic
    sendHeld()
    rowTried = false
    talkAct = ""
    ticked = performanceNow()
    pubAct = ""
    if not pubDirty
      pubEdited = false
    nav = select(nav, "publicPage")
  action openSystem
    sendHeld()
    ticked = performanceNow()
    sysAct = ""
    nav = push(select(nav, "publicPage"), "/system/backups")
  action editPublic(v: string)
    pubDraft = v
    pubEdited = true
  // A draft replaces the field, so a field with text asks first.
  action askDraft
    if pubField.trim() != ""
      showModal("replace-public")
    else
      pubAct = "draft"
      send drafted = draftPublic()
  action draftFromBank
    pubAct = "draft"
    send drafted = draftPublic()
  action afterDraft
    if draftOk
      pubDraft = draftReply
      pubEdited = true
      noteText = draftReply
      noteList = draftNotes
  action checkAgain
    pubAct = "check"
    send checked = checkPublic(pubField)
  action afterCheck
    if checkOk
      noteText = checkReply
      noteList = checkNotes
  action saveCollection
    if pubDirty and not pubTooLong and pubField.trim() != "" and not pending(pubSaved)
      pubAct = "save"
      ticked = performanceNow()
      send pubSaved = savePublic(pubField)
  action askPublish
    if canPublish
      showModal("publish-public")
  action publishNow
    if canPublish
      pubAct = "publish"
      ticked = performanceNow()
      send published = publishPublic(pub.sha256)
  action askUnpublish
    showModal("unpublish-public")
  action unpublishNow
    pubAct = "unpublish"
    send unpublished = unpublishPublic()
  action recheckLive
    pubAct = ""
    refresh live
  action backUp
    if not pending(backedUp)
      sysAct = "backup"
      send backedUp = backupNow()
  action signIn
    if not pending(loginAsked)
      sysAct = "login"
      send loginAsked = codexLogin()
  action cancelSignIn
    sysAct = "cancel"
    send loginCancelled = codexCancel()
  action savePerson(name: string, location: string, email: string, phone: string, website: string, github: string, linkedin: string)
    if not pending(personSaved)
      send personSaved = savePerson(name.trim(), location.trim(), email.trim(), phone.trim(), website.trim(), github.trim(), linkedin.trim())
  action afterPerson
    if personError == "" and top(nav).name == "details"
      nav = back(nav)
  action writeProfile
    send asked = askProfile()
  action openEdit
    nav = push(nav, path("edit", selectedFact))
  action saveFact(id: string, text: string, detail: string, metric: string, roleId: string, kind: string)
    if text.trim() != "" and not pending(savedFact)
      actedFact = id
      lastFactAct = "save"
      send savedFact = saveFact(id, text.trim(), detail.trim(), metric.trim(), roleId, kind)
  // The sheet closes only on an ok reply; a refusal keeps it open, saying why.
  action afterSaveFact
    if saveFactError == "" and top(nav).name == "edit"
      nav = back(nav)
  action saveRole(id: string, standing: string, reach: string, partOf: string)
    send roleSaved = saveRole(id, standing, reach, partOf)
  action afterRoleSave
    if roleError == "" and top(nav).name == "role"
      nav = back(nav)
  action removeFact
    actedFact = selectedFact
    lastFactAct = "remove"
    send removedFact = removeFact(selectedFact)
  action afterRemoveFact
    if removeFactError == "" and top(nav).name == "fact"
      nav = back(nav)
  action askRemoveFact
    showModal("remove-fact")
  action openAdd
    draftTitle = ""
    draftText = ""
    draftFile = ""
    draftRepo = ""
    pickedPath = ""
    pickedName = ""
    chosen = []
    hubQuery = ""
    showExtra = false
    refusal = ""
    refresh inbox
    refresh hub
    nav = push(push(select(nav, "bank"), "/sources"), "/sources/add")
  action setKind(v: string)
    kind = v
    refusal = ""
  action editTitle(v: string)
    draftTitle = v
  action editText(v: string)
    draftText = v
  action choosePicked
    showPicker("add-pick")
  // Choosing a file drops a choice from the server's folder, and the other way round.
  action filePicked(files: Picked[])
    pickedPath = match first(files) { case some(f) => f.path, case none => pickedPath }
    pickedName = match first(files) { case some(f) => f.name, case none => pickedName }
    draftFile = files.length > 0 ? "" : draftFile
    refusal = ""
  action pickFile(v: string)
    draftFile = v
    pickedPath = v == "" ? pickedPath : ""
    pickedName = v == "" ? pickedName : ""
  action editRepo(v: string)
    draftRepo = v
  action searchHub(v: string)
    hubQuery = v
  // A repository's box: the event hands the repository first, then whether it is now ticked.
  action tickRepo(full: string, on: bool)
    chosen = on ? (chosen.includes(full) ? chosen : chosen.concat([full])) : chosen.filter(c => c != full)
  action tickExtra(on: bool)
    showExtra = on
  action reloadHub
    refresh hub
  action editAuthor(v: string)
    author = v
  action add
    if addHint == "" and kind == "file" and pickedPath != ""
      send added = uploadSource(pickedPath, pickedName)
    else if addHint == "" and kind == "github"
      send added = addGithub(chosen)
    else if addHint == ""
      send added = addSource(kind, draftTitle.trim(), addBody, kind == "repo" ? author.trim() : "")
  action afterAdd
    refusal = addError
    if addError == "" and top(nav).name == "add"
      nav = back(nav)
  action readAgain
    actedSource = selectedSource
    lastSourceAct = "read"
    send reread = readSource(selectedSource)
  action askRemoveSource
    showModal("remove-source")
  action removeSource
    actedSource = selectedSource
    lastSourceAct = "remove"
    send removedSource = removeSource(selectedSource)
  action afterRemoveSource
    if removeSourceError == "" and top(nav).name == "source"
      nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app"
      width="100%" height="100%" display="flex" flex-direction="column" font-family="'Geist', system-ui" background-color="look.paper"
      // The main line (DESIGN.md): the places as plain words. Record holds Experience, Profile, Direction, Details and
      // Sources; System holds the Public page and the machine. Each drawn screen has its second line itself.
      MainLine(testId="nav")
        NavTab(label="Home", current=(nav.tab == "home"), quiet=false, far=false, controls="panel-home", press=pick("home"), testId="nav-home")
        NavTab(label="Record", current=inRecord, quiet=false, far=false, controls="panel-bank", press=pick("bank"), testId="nav-record")
        NavTab(label="Jobs", current=(nav.tab == "jobs"), quiet=false, far=false, controls="panel-jobs", press=pick("jobs"), testId="nav-jobs")
        NavTab(label="Talk", current=(nav.tab == "talk"), quiet=false, far=false, controls="panel-talk", press=pick("talk"), testId="nav-talk")
        NavTab(label="System", current=inSystem, quiet=true, far=true, controls="panel-publicPage", press=openPublic, testId="nav-system")
      // The second line of a place that holds several screens, drawn once, under the main line.
      if inRecord
        SubBar(testId="subnav")
          RecordNav(at=recordAt, go=goRecord)
      if inSystem
        SubBar(testId="subnav")
          SystemNav(at=top(nav).name, go=goSystem)
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          // The bar is the app's own (appearance="none"), so the app hides the tabs not shown (DESIGN.md; docs/recipes/tabs.md).
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0 display=(nav.tab == t.name ? "flex" : "none")
            for e in t.stack key=e.id
              if e.name == "home"
                column navigationKey=`${e.id}` navigationScroll="home-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="home-scroll" flex=1 min-height=0
                    HomeScreen(list=homeList, failedToLoad=failed(homeList), items=homeItems, focus=homeFocusList, rest=homeRest, picked=homePicked, draft=homeDraft, heldLine=heldLine, refusedKey=refusedKey, refusedError=refusedError, keys=homeKeys, wide=(viewport.width >= lookNarrow()), focusItem=focusItem, choose=chooseItem, type=typeAnswer, save=saveAnswer, snooze=snoozeItem, undo=undoHeld, retry=retryHome)
              if e.name == "bank"
                column navigationKey=`${e.id}` navigationScroll="bank-scroll" navigationSplit="none" position="absolute" inset=0 background-color="look.paper"
                  scroll id="bank-scroll" flex=1 min-height=0
                    ExperienceScreen(bank=bank, failed=failed(bank), error=bankError, query=bankQuery, overlaps=overlaps, wide=wide, search=searchBank, add=openAdd, retry=pull, home=pick("home"))
              if e.name == "fact"
                column navigationKey=`${e.id}` navigationScroll="fact-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="fact-scroll" flex=1 min-height=0
                    if bank.facts.filter(x => x.id == e.params.id).length == 0
                      RecordWait(title="Fact", waiting=(not bank.loaded and bankError == ""), message=(bank.loaded ? "This fact is no longer in your record. It was deleted, or replaced when its source was read again." : bankError), backLabel="Back to Experience", back=back, testId="fact-gone")
                    for f in bank.facts.filter(x => x.id == e.params.id) key=f.id
                      FactScreen(fact=f, role=roleName(bank.roles, f.roleId), error=(actedFact == f.id and lastFactAct == "remove" ? removeFactError : ""), edit=openEdit, askRemove=askRemoveFact, back=back)
              if e.name == "role"
                column navigationKey=`${e.id}` navigationScroll="role-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="role-scroll" flex=1 min-height=0
                    if bank.roles.filter(x => x.id == e.params.id).length == 0
                      RecordWait(title="Role", waiting=(not bank.loaded and bankError == ""), message=(bank.loaded ? "This role is no longer in your record." : bankError), backLabel="Back to Experience", back=back, testId="role-gone")
                    for r in bank.roles.filter(x => x.id == e.params.id) key=r.id
                      RoleScreen(role=r, facts=bank.facts.filter(f => f.roleId == r.id), employers=bank.roles.filter(x => x.employer), places=bank.places, overlaps=overlaps, error=roleError, busy=pending(roleSaved), wide=wide, save=saveRole, back=back, home=pick("home"))
              if e.name == "edit"
                column navigationKey=`${e.id}` navigationScroll="edit-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="edit-scroll" flex=1 min-height=0
                    if bank.facts.filter(x => x.id == e.params.id).length == 0
                      RecordWait(title="Edit fact", waiting=(not bank.loaded and bankError == ""), message=(bank.loaded ? "This fact is no longer in your record." : bankError), backLabel="Back to Experience", back=back, testId="edit-gone")
                    for f in bank.facts.filter(x => x.id == e.params.id) key=f.id
                      EditFactScreen(fact=f, places=bank.places, error=(actedFact == f.id and lastFactAct == "save" ? saveFactError : ""), busy=pending(savedFact), save=saveFact, cancel=back)
              if e.name == "profile"
                column navigationKey=`${e.id}` navigationScroll="profile-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="profile-scroll" flex=1 min-height=0
                    ProfileScreen(profile=profile, failed=failed(profile), error=profileError, askError=askError, asking=pending(asked), ahead=profileAhead, write=writeProfile, ask=askQuestion, add=openAdd, retry=pull)
              if e.name == "talk"
                column navigationKey=`${e.id}` navigationScroll=(talk.loaded and talk.messages.length > 0 ? "transcript" : "talk-scroll") navigationSplit="none" position="absolute" inset=0 background-color="look.paper"
                  TalkScreen(talk=talk, failed=failed(talk), loadError=talkLoadError, draft=talkDraft, sending=pending(talkSent), clearing=pending(talkCleared), error=talkTried, edit=editTalk, send=sendTalk, questions=openQuestions, askClear=askClearTalk, retry=pull)
              if e.name == "questions"
                column navigationKey=`${e.id}` navigationScroll="questions-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="questions-scroll" flex=1 min-height=0
                    QuestionsScreen(talk=talk, error=askTalkError, asking=pending(talkAsked), back=back, ask=askQuestion)
              if e.name == "details"
                column navigationKey=`${e.id}` navigationScroll="details-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="details-scroll" flex=1 min-height=0
                    if me.loaded
                      DetailsScreen(me=me, error=personError, busy=pending(personSaved), save=savePerson, cancel=back)
                    else
                      RecordWait(title="Details", waiting=(not failed(me)), message="Your details couldn’t be loaded. Open them again in a moment.", backLabel="", back=back, testId="details-wait")
              if e.name == "direction"
                column navigationKey=`${e.id}` navigationScroll="direction-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="direction-scroll" flex=1 min-height=0
                    if notes.loaded
                      DirectionScreen(body=notes.body, error=notesError, busy=pending(notesSaved), save=saveNotes, cancel=back)
                    else
                      RecordWait(title="Direction", waiting=(not failed(notes)), message="Your direction notes couldn’t be loaded. Open them again in a moment.", backLabel="", back=back, testId="direction-wait")
              // The public collection: written, saved and published here, each only by the person's own press.
              if e.name == "publicPage"
                column navigationKey=`${e.id}` navigationScroll="public-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="public-scroll" flex=1 min-height=0
                    Page(testId="public")
                      Section(testId="public-top")
                        Title(text="Public page", testId="public-title")
                      if not pub.loaded
                        Section(testId="public-wait")
                          if pubLoadError != ""
                            FailLine(text=pubLoadError, testId="public-load-error")
                          else
                            QuietLine(text="Loading…", testId="public-loading")
                      else
                        Section(testId="public-live-section")
                          SectionHead(text="On the public page", testId="public-live-head")
                          if liveHere
                            WorkLine(word=statusWord("public", (isLive ? "live" : "offline")), place="", text=liveLine, testId="public-live")
                          else
                            Line(text=liveLine, testId="public-live")
                          if liveNote != ""
                            QuietLine(text=liveNote, testId="public-live-note")
                          if (pubAct == "publish" and publishError != "") or (pubAct == "unpublish" and unpublishError != "")
                            FailLine(text=(pubAct == "publish" ? `Not published. ${publishError}` : `The chat is still on. ${unpublishError}`), testId="public-live-error")
                          if liveHere
                            MainAction(label=(pending(published) ? "Publishing…" : "Publish saved text"), press=askPublish, disabled=(not canPublish), keys="", testId="public-publish")
                          if isLive
                            DangerAction(label=(pending(unpublished) ? "Taking the chat offline…" : "Take the chat offline"), press=askUnpublish, disabled=(pending(unpublished) or pending(published)), testId="public-unpublish")
                          if (live.loaded and live.where == "starting") or liveError != ""
                            Action(label="Check again", press=recheckLive, disabled=pending(live), keys="", testId="public-recheck")
                          QuietLine(text=(not liveHere ? "The public chat answers only from text you publish." : pubDirty ? "Save your changes first. Only the saved text can be published." : "Publishing puts your saved text on the public page."), testId="public-live-hint")
                        Section(testId="public-collection")
                          SectionHead(text="Public collection", testId="public-collection-head")
                          textarea value=pubField input=editPublic rows=16 aria-label="Public collection" testId="public-text"
                            placeholder="What anyone may ask the public chat about: your work, your projects and your interests, in your words."
                          if pubTooLong
                            FailLine(text=pubState, testId=(pubDirty ? "public-unsaved" : "public-saved"))
                          else if pubDirty
                            StrongLine(text=pubState, testId="public-unsaved")
                          else
                            QuietLine(text=pubState, testId="public-saved")
                          if pubField.length > 96000 and not pubTooLong
                            QuietLine(text=`${thousands(pubField.length)} of 120,000 characters`, testId="public-count")
                          if pubAct == "save" and pubSaveError != ""
                            FailLine(text=`Not saved. ${pubSaveError}`, testId="public-save-error")
                          MainAction(label=(pending(pubSaved) ? "Saving…" : "Save"), press=saveCollection, disabled=(not pubDirty or pubTooLong or pubField.trim() == "" or pending(pubSaved)), keys="", testId="public-save")
                        Section(testId="public-drafting")
                          Action(label=(pending(drafted) ? "Making a draft…" : "Start from my record"), press=askDraft, disabled=pending(drafted), keys="", testId="public-draft")
                          if pubAct == "draft" and draftError != ""
                            FailLine(text=`No draft was made. ${draftError}`, testId="public-draft-error")
                          QuietLine(text="Puts a draft made from the facts in your record into the field. Nothing is saved until you press Save.", testId="public-draft-hint")
                        Section(testId="public-notes")
                          SectionHead(text="Lines to check before you publish", testId="public-notes-head")
                          if notesStale
                            QuietLine(text="These notes were for the text before your latest edits.", testId="public-notes-stale")
                            Action(label=(pending(checked) ? "Checking…" : "Check the field again"), press=checkAgain, disabled=pending(checked), keys="", testId="public-check")
                            if pubAct == "check" and noteCheckError != ""
                              FailLine(text=noteCheckError, testId="public-check-error")
                          else if shownNotes.length == 0
                            QuietLine(text="No lines to check.", testId="public-notes-none")
                          else
                            for n, i in shownNotes key=`${n.line} ${n.kind}`
                              column
                                QuietLine(text=noteLabel(n), testId=`public-note-${i}`)
                                Line(text=n.text, testId=`public-note-text-${i}`)
                          QuietLine(text="Advice only: these lines may hold money, a person or client, a link, or inside knowledge. You decide what is public.", testId="public-notes-hint")
              // The cloud machine, from the studio's Worker: backups first, then the model's sign-in, then the machine itself.
              if e.name == "system"
                column navigationKey=`${e.id}` navigationScroll="system-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="system-scroll" flex=1 min-height=0
                    Page(testId="system")
                      Section(testId="system-top")
                        Title(text="Backups and sign-in", testId="system-title")
                      if not sys.loaded or sys.where != "here"
                        Section(testId="system-wait")
                          if sys.loaded and sys.where == "absent"
                            Line(text="This screen works only in the deployed studio.", testId="system-absent")
                          else if sys.loaded and sys.where == "starting"
                            Line(text="The machine is starting. Try again in a moment.", testId="system-starting")
                            Action(label="Try again", press=pullSystem, disabled=pending(sys), keys="", testId="system-retry")
                          else if sysLoadError != ""
                            FailLine(text=`Couldn’t check the machine. ${sysLoadError}`, testId="system-error")
                            Action(label="Try again", press=pullSystem, disabled=pending(sys), keys="", testId="system-retry")
                          else
                            QuietLine(text="Checking the machine…", testId="system-loading")
                      else
                        if sys.backupError != ""
                          Section(testId="system-backup-failed")
                            FailLine(text="The last backup failed.", testId="system-backup-failed-head")
                            Line(text=sys.backupError, testId="system-backup-error")
                            QuietLine(text="Changes since the last good backup are only on the machine.", testId="system-backup-failed-hint")
                        Section(testId="system-safety")
                          SectionHead(text="Data safety", testId="system-safety-head")
                          Labelled(label="Last backup", value=(sys.backupAt > 0 ? agoAndWhen(sys.backupAt, sys.backupWhen, nowMs) : "None since the machine started"), testId="system-last-backup")
                          Labelled(label="Changes not backed up", value=(not sys.unsaved ? "None" : sys.unsavedSince > 0 ? `Yes, since ${agoAndWhen(sys.unsavedSince, sys.unsavedWhen, nowMs)}` : "Yes"), testId="system-unsaved")
                          if sys.startedFrom != ""
                            Labelled(label="Started from", value=sys.startedFrom, testId="system-started-from")
                          if pending(backedUp)
                            WorkLine(word="Running", place="", text="Backing up. Usually a few minutes.", testId="system-backup-work")
                          Action(label="Back up now", press=backUp, disabled=pending(backedUp), keys="", testId="system-backup")
                          if sysAct == "backup" and backupReply != ""
                            if backupFailed
                              FailLine(text=backupReply, testId="system-backup-result")
                            else
                              QuietLine(text=backupReply, testId="system-backup-result")
                        Section(testId="system-login")
                          SectionHead(text="ChatGPT sign-in", testId="system-login-head")
                          Line(text=modelLine(sys), testId="system-model")
                          if modelDetail(sys) != ""
                            QuietLine(text=modelDetail(sys), testId="system-model-detail")
                          if loginWaiting
                            Line(text="Open the address, sign in to ChatGPT, and type this code.", testId="system-login-steps")
                            StrongLine(text=loginNow.code, testId="system-login-code")
                            OutLink(label=loginNow.url, href=loginNow.url, testId="system-login-url")
                            Action(label="Cancel", press=cancelSignIn, disabled=pending(loginCancelled), keys="", testId="system-login-cancel")
                          else
                            if loginNow.state == "done"
                              QuietLine(text="Signed in to ChatGPT.", testId="system-login-result")
                            if loginNow.state == "failed"
                              FailLine(text=`Sign-in failed. ${loginNow.detail}`, testId="system-login-result")
                            if pending(loginAsked)
                              WorkLine(word="Running", place="", text="Starting the sign-in. Usually a minute or two.", testId="system-sign-in-work")
                            Action(label="Sign in again", press=signIn, disabled=pending(loginAsked), keys="", testId="system-sign-in")
                          if (sysAct == "login" and loginError != "") or (sysAct == "cancel" and cancelError != "")
                            FailLine(text=(sysAct == "login" ? loginError : cancelError), testId="system-login-error")
                        Section(testId="system-machine-section")
                          SectionHead(text="Machine", testId="system-machine-head")
                          Labelled(label="State", value=(sys.note != "" and sys.machine != "running" ? `${machineLine(sys)}. ${sys.note}` : machineLine(sys)), testId="system-machine")
                          if not sys.keeper
                            QuietLine(text="Its details appear once it is up.", testId="system-machine-wait")
                          if sys.startedAt > 0
                            Labelled(label="Started", value=agoAndWhen(sys.startedAt, sys.startedWhen, nowMs), testId="system-started")
                          for p in sys.programs key=p.name
                            if p.ok
                              Line(text=`${p.name} works.`, testId=`system-program-${p.name}`)
                            else
                              FailLine(text=(p.detail != "" ? `${p.name} failed: ${p.detail}` : `${p.name} failed.`), testId=`system-program-${p.name}`)
              if e.name == "jobs"
                column navigationKey=`${e.id}` navigationScroll="jobs-scroll" navigationSplit="none" position="absolute" inset=0 background-color="look.paper"
                  scroll id="jobs-scroll" flex=1 min-height=0
                    JobsScreen(jobs=jobs, leads=leads, failed=failed(jobs), error=jobsError, stage=stageTab, query=jobQuery, freshOnly=freshOnly, shown=shownJobs, shownLeads=shownLeads, saved=savedJobs, active=activeJobs, done=doneJobs, checking=checking, leadsNote=leadsNote, rowError=rowError, rowJob=rowJob, wide=wide, setStage=setStage, search=searchJobs, setFresh=setFresh, pickOutcome=pickRowOutcome, add=openAddJob, watchlist=openCompanies, retry=pull)
              if e.name == "job"
                column navigationKey=`${e.id}` navigationScroll="job-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="job-scroll" flex=1 min-height=0
                    if not job.loaded or job.id != e.params.id
                      RecordWait(title="Job", waiting=(not failed(job)), message="This job couldn’t be loaded. It may have been deleted.", backLabel="Back to jobs", back=back, testId="job-wait")
                    else
                      JobScreen(job=job, wide=wide, pages=(wantPages != "" and wantPages != "again" ? wantPages : `${job.pages}`), lengthError=jobLengthError, doorsError=doorsError, writeError=writeError, writeBusy=pending(resumeAsked), doorsBusy=pending(doorsAsked), copied=copied, busy=pending(jobReread), error=jobActionError, saveError=jobSaveError, back=back, writeAgain=writeAgain, draftDoors=draftDoors, copyDoor=copyDoor, askGap=askQuestion, reread=rereadJob, askRemove=askRemoveJob, pickOutcome=pickOutcome, saveNote=saveOutcomeNote, saveContact=saveContact, editResume=openEditResume, setLength=setLength)
              if e.name == "resume"
                column navigationKey=`${e.id}` navigationScroll="resume-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="resume-scroll" flex=1 min-height=0
                    if not job.loaded or job.id != e.params.id
                      RecordWait(title="Resume", waiting=(not failed(job)), message="This job couldn’t be loaded. It may have been deleted.", backLabel="Back to jobs", back=pick("jobs"), testId="resume-wait")
                    else
                      ResumeScreen(job=job, wide=wide, back=backToJob(e.params.id), edit=openEditResume)
              if e.name == "editResume"
                column navigationKey=`${e.id}` navigationScroll="resume-editor-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="resume-editor-scroll" flex=1 min-height=0
                    if not job.loaded or job.id != e.params.id
                      RecordWait(title="Edit the resume", waiting=(not failed(job)), message="This job couldn’t be loaded. It may have been deleted.", backLabel="Back", back=back, testId="resume-editor-wait")
                    else
                      EditResumeScreen(body=job.resume, error=resumeError, busy=pending(resumeSaved), save=saveResume, cancel=back)
              if e.name == "lead"
                column navigationKey=`${e.id}` navigationScroll="lead-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="lead-scroll" flex=1 min-height=0
                    if not lead.loaded or lead.id != e.params.id
                      RecordWait(title="Found job", waiting=(not failed(lead)), message="This posting couldn’t be loaded. It may have closed.", backLabel="Back to jobs", back=back, testId="lead-wait")
                    else
                      LeadScreen(lead=lead, error=leadError, taking=pending(leadTaken), back=back, take=takeLead, askDismiss=askDismissLead)
              if e.name == "companies"
                column navigationKey=`${e.id}` navigationScroll="companies-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="companies-scroll" flex=1 min-height=0
                    CompaniesScreen(companies=companies, loadError=companiesError, link=companyLink, act=watchAct, addError=companyError, checkError=checkError, removeError=removeCompanyError, adding=pending(companyAdded), checking=checking, checkBusy=pending(checkAsked), wide=wide, back=back, editLink=editCompanyLink, add=addCompany, check=checkNow, askRemove=askRemoveCompany)
              if e.name == "addJob"
                column navigationKey=`${e.id}` navigationScroll="add-job-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="add-job-scroll" flex=1 min-height=0
                    AddJobScreen(url=jobUrl, posting=jobText, refusal=jobRefusal, sending=pending(jobAdded), hint=jobHint, editUrl=editJobUrl, editText=editJobText, add=addJob, cancel=leaveAddJob)
              if e.name == "sources"
                column navigationKey=`${e.id}` navigationScroll="sources-scroll" navigationSplit="none" position="absolute" inset=0 background-color="look.paper"
                  scroll id="sources-scroll" flex=1 min-height=0
                    Page(testId="sources")
                      Section(testId="sources-top")
                        Title(text="Sources", testId="sources-title")
                        if lib.loaded and lib.items.length > 0
                          QuietLine(text=`${readCount} of ${lib.items.length} read. Each source is read for facts about your work, one at a time.`, testId="sources-count")
                          MainAction(label="Add a source", press=openAdd, disabled=false, keys="", testId="add-source")
                      if not lib.loaded
                        Section(testId="sources-wait")
                          if failed(lib)
                            FailLine(text=libError, testId="sources-error")
                            Action(label="Try again", press=pull, disabled=false, keys="", testId="sources-retry")
                          else
                            QuietLine(text="Loading your sources…", testId="sources-loading")
                      else if lib.items.length == 0
                        Section(testId="sources-empty")
                          Line(text="A source is something the studio reads for facts about your work: pasted text, a file or a git repository.", testId="sources-empty-text")
                          MainAction(label="Add a source", press=openAdd, disabled=false, keys="", testId="sources-add")
                      else
                        Section(testId="sources-list")
                          for s in lib.items key=s.id
                            Record(code="", name=s.title, href=`/source/${s.id}`, strong=false, dates="", extent=(s.status == "done" ? factCount(s.facts) : sourceKind(s.kind)), word=statusWord("work", s.status), showWord=(s.status != "done"), place=sourcePlace(s), provenance="", wide=wide, testId=`source-${s.id}`)
              if e.name == "source"
                column navigationKey=`${e.id}` navigationScroll="source-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="source-scroll" flex=1 min-height=0
                    if lib.items.filter(x => x.id == e.params.id).length == 0
                      RecordWait(title="Source", waiting=(not lib.loaded and libError == ""), message=(lib.loaded ? "This source was deleted." : libError), backLabel="Back to Sources", back=back, testId="source-gone")
                    for s in lib.items.filter(x => x.id == e.params.id) key=s.id
                      Page(testId="source")
                        Section(testId="source-top")
                          Action(label="Back to Sources", press=back, disabled=false, keys="", testId="source-back")
                        Section(testId="source-head")
                          Title(text=s.title, testId="source-title")
                          if s.status == "failed"
                            FailLine(text=sourceLine(s), testId="source-status")
                          else if s.status == "queued" or s.status == "running"
                            WorkLine(word=statusWord("work", s.status), place=sourcePlace(s), text=sourceLine(s), testId="source-status")
                          else
                            Line(text=sourceLine(s), testId="source-status")
                          Labelled(label=sourceKind(s.kind), value=s.detail, testId="source-what")
                        Section(testId="source-actions")
                          if actedSource == s.id and (lastSourceAct == "remove" ? removeSourceError : rereadError) != ""
                            FailLine(text=(lastSourceAct == "remove" ? removeSourceError : rereadError), testId="source-error")
                          Action(label="Read again", press=readAgain, disabled=(pending(reread) or s.status == "queued" or s.status == "running"), keys="", testId="source-read")
                          DangerAction(label="Delete source", press=askRemoveSource, disabled=false, testId="source-delete")
                          QuietLine(text=(s.status == "queued" or s.status == "running" ? "It can be read again once this reading finishes." : "Reading again replaces its facts, except ones you edited."), testId="source-hint")
              if e.name == "add"
                column navigationKey=`${e.id}` navigationScroll="add-scroll" position="absolute" inset=0 background-color="look.paper"
                  scroll id="add-scroll" flex=1 min-height=0
                    Page(testId="add")
                      Section(testId="add-top")
                        Title(text="Add a source", testId="add-heading")
                        Choices(label="Kind of source")
                          ChoiceWord(label="Text", chosen=(kind == "text"), press=setKind("text"), testId="kind-text")
                          ChoiceWord(label="File", chosen=(kind == "file"), press=setKind("file"), testId="kind-file")
                          ChoiceWord(label="Folder", chosen=(kind == "repo"), press=setKind("repo"), testId="kind-repo")
                          ChoiceWord(label="GitHub", chosen=(kind == "github"), press=setKind("github"), testId="kind-github")
                      if kind == "text"
                        Section(testId="add-text-form")
                          FieldLabel(label="Title")
                            input value=draftTitle input=editTitle submit=add placeholder="Such as Resume 2024" aria-label="Title" autofocus=true enterkeyhint="next" testId="add-title"
                          FieldLabel(label="Text to read")
                            textarea value=draftText input=editText placeholder="Paste a resume, a LinkedIn profile or a review" aria-label="Text to read" rows=8 aria-invalid=(refusal != "") testId="add-text"
                          if refusal != "" and not pending(added)
                            FailLine(text=refusal, testId="add-error")
                      if kind == "file"
                        Section(testId="add-file-form")
                          if pickedName != ""
                            Labelled(label="Chosen file", value=pickedName, testId="add-picked")
                          Action(label=(pickedName == "" ? "Choose a file" : "Choose another file"), press=choosePicked, disabled=false, keys="", testId="add-choose")
                          input type="file" id="add-pick" display="none" change=filePicked aria-label="File to add" testId="add-pick"
                          if refusal != "" and not pending(added)
                            FailLine(text=refusal, testId="add-error")
                          QuietLine(text="PDF, Word or text, or a LinkedIn export zip. Up to 25 MB.", testId="add-file-hint")
                        if inbox.files.length > 0
                          Section(testId="add-inbox")
                            SectionHead(text="Already in the studio’s inbox", testId="add-inbox-head")
                            FieldLabel(label="File")
                              select value=draftFile change=pickFile aria-label="File already in the studio’s inbox" align-self="flex-start" max-width="100%" testId="add-file"
                                option "None" value=""
                                for name in inbox.files key=name
                                  option name value=name
                      if kind == "github"
                        if not hub.loaded
                          Section(testId="add-hub-wait")
                            if failed(hub)
                              FailLine(text="GitHub couldn’t be asked just now. Try again in a moment.", testId="hub-error")
                              Action(label="Try again", press=reloadHub, disabled=false, keys="", testId="hub-retry")
                            else
                              QuietLine(text="Loading your repositories…", testId="hub-loading")
                        else if not hub.connected or hub.error != ""
                          Section(testId="add-hub-wait")
                            Line(text=hub.error, testId="hub-error")
                            Action(label="Try again", press=reloadHub, disabled=false, keys="", testId="hub-retry")
                        else
                          Section(testId="add-hub")
                            SearchField(value=hubQuery, label="Search repositories", hint="Search repositories", change=searchHub, testId="hub-search")
                            QuietLine(text=(chosen.length == 0 ? `Signed in to GitHub as ${hub.login}. Only your own commits are read.` : `${chosen.length} ${chosen.length == 1 ? "repository" : "repositories"} chosen.`), testId="hub-who")
                            if hubExtras > 0
                              CheckLine(label="Show forks and archived", detail="", checked=showExtra, disabled=false, change=tickExtra, testId="hub-extra")
                          for o in hub.owners.filter(o => hubShown.filter(r => r.owner == o).length > 0) key=o
                            Section(testId=`add-owner-${o}`)
                              SectionHead(text=o, testId=`add-owner-${o}-head`)
                              for r in hubShown.filter(r => r.owner == o) key=r.full
                                CheckLine(label=r.full, detail=(r.added ? "Already a source" : r.detail), checked=(chosen.includes(r.full)), disabled=r.added, change=tickRepo(r.full), testId=`repo-${r.full}`)
                          if (refusal != "" and not pending(added)) or hubShown.length == 0
                            Section(testId="add-hub-end")
                              if refusal != "" and not pending(added)
                                FailLine(text=refusal, testId="add-error")
                              if hubShown.length == 0
                                QuietLine(text=(hub.repos.length == 0 ? "No repositories found." : hubQuery.trim() == "" ? "Only forks and archived repositories here. Turn them on above." : `No repository matches “${hubQuery.trim()}”.`), testId="hub-none")
                      if kind == "repo"
                        Section(testId="add-repo-form")
                          FieldLabel(label="Folder")
                            input value=draftRepo input=editRepo submit=add placeholder="/srv/code/app" aria-label="Repository folder"
                              autofocus=true autocapitalize="none" autocomplete="off" enterkeyhint="next" aria-invalid=(refusal != "") testId="add-repo"
                          FieldLabel(label="Author")
                            input value=author input=editAuthor submit=add placeholder="Name or email" aria-label="Commit author"
                              autocapitalize="none" autocomplete="off" enterkeyhint="done" testId="add-author"
                          if refusal != "" and not pending(added)
                            FailLine(text=refusal, testId="add-error")
                          QuietLine(text="A repository folder on the studio’s computer. Only commits by this author count as yours. The history and the code are read, and the repository is never changed.", testId="add-repo-hint")
                      Section(testId="add-actions")
                        QuietLine(text=(addHint != "" ? addHint : "What you add is read, and what is found in it goes into your record."), testId="add-hint")
                        Actions(testId="add-actions-row")
                          MainAction(label="Add", press=add, disabled=(addHint != ""), keys="", testId="add-save")
                          Action(label="Cancel", press=leaveAdd, disabled=false, keys="", testId="add-cancel")
      dialog id="remove-fact" role="alertdialog" aria-label="Delete this fact?"
        text "It’s removed from your record and from future profiles and resumes, and stays out when its source is read again. This can’t be undone."
        button press=removeFact destructive=true commandfor="remove-fact" command="close" testId="remove-fact-confirm"
          text "Delete"
        button commandfor="remove-fact" command="close" testId="remove-fact-cancel"
          text "Cancel"
      dialog id="clear-talk" role="alertdialog" aria-label="Start the conversation over?"
        text "The messages are cleared. Facts already added to your record stay."
        button press=clearTalk destructive=true commandfor="clear-talk" command="close" testId="clear-talk-confirm"
          text "Start over"
        button commandfor="clear-talk" command="close" testId="clear-talk-cancel"
          text "Cancel"
      dialog id="replace-edits" role="alertdialog" aria-label="Replace your edits?"
        text "You edited this resume by hand. Writing it again replaces your edits."
        button press=replaceEdits destructive=true commandfor="replace-edits" command="close" testId="replace-edits-confirm"
          text "Replace my edits"
        button press=keepEdits commandfor="replace-edits" command="close" testId="replace-edits-cancel"
          text "Cancel"
      dialog id="dismiss-lead" role="alertdialog" aria-label="Not for you?"
        text "This posting leaves Found and won’t be shown again."
        button press=dismissLead destructive=true commandfor="dismiss-lead" command="close" testId="dismiss-lead-confirm"
          text "Not for me"
        button commandfor="dismiss-lead" command="close" testId="dismiss-lead-cancel"
          text "Cancel"
      dialog id="replace-public" role="alertdialog" aria-label="Replace the text in the field?"
        text "A fresh draft from your record replaces what is in the field. Your saved text stays as it is until you press Save."
        button press=draftFromBank destructive=true commandfor="replace-public" command="close" testId="replace-public-confirm"
          text "Replace"
        button commandfor="replace-public" command="close" testId="replace-public-cancel"
          text "Cancel"
      dialog id="publish-public" role="alertdialog" aria-label="Publish your saved text?"
        text "Anyone can then ask the public chat about everything in this text, and it may quote any line of it."
        button press=publishNow commandfor="publish-public" command="close" testId="publish-public-confirm"
          text "Publish"
        button commandfor="publish-public" command="close" testId="publish-public-cancel"
          text "Cancel"
      dialog id="unpublish-public" role="alertdialog" aria-label="Take the chat offline?"
        text "The public chat stops answering within a minute and stays off until you publish again. Your saved text stays here."
        button press=unpublishNow destructive=true commandfor="unpublish-public" command="close" testId="unpublish-public-confirm"
          text "Take offline"
        button commandfor="unpublish-public" command="close" testId="unpublish-public-cancel"
          text "Cancel"
      dialog id="discard-edits" role="alertdialog" aria-label="Discard your changes?"
        text "What you changed here hasn’t been saved."
        button press=back destructive=true commandfor="discard-edits" command="close" testId="discard-edits-confirm"
          text "Discard"
        button commandfor="discard-edits" command="close" testId="discard-edits-cancel"
          text "Keep editing"
      dialog id="remove-job" role="alertdialog" aria-label="Delete this job?"
        text "Its reading and the resume written for it are deleted. This can’t be undone."
        button press=removeJob destructive=true commandfor="remove-job" command="close" testId="remove-job-confirm"
          text "Delete"
        button commandfor="remove-job" command="close" testId="remove-job-cancel"
          text "Cancel"
      dialog id="remove-company" role="alertdialog" aria-label=`Remove ${aimedCompanyName}?`
        text "The jobs found there, and their quick scores, are removed too. Jobs you read fully stay."
        button press=removeCompany destructive=true commandfor="remove-company" command="close" testId="remove-company-confirm"
          text "Remove"
        button commandfor="remove-company" command="close" testId="remove-company-cancel"
          text "Cancel"
      dialog id="remove-source" role="alertdialog" aria-label="Delete this source?"
        text "Its facts are deleted too, except ones you edited."
        button press=removeSource destructive=true commandfor="remove-source" command="close" testId="remove-source-confirm"
          text "Delete"
        button commandfor="remove-source" command="close" testId="remove-source-cancel"
          text "Cancel"

// System's second line. `at` is the screen shown: publicPage | system.
component SystemNav
  props
    at: string
    go: action
  view
    SubLine(label="System")
      SubLink(label="Public page", current=(at == "publicPage"), press=go("publicPage"), testId="sub-public")
      SubLink(label="Backups and sign-in", current=(at == "system"), press=go("system"), testId="sub-backups")
