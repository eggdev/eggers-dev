tamber brand

theme
  AccentColor = light-dark(#bf5700, #cc5f0a)
  surface.note = light-dark(#f5f5f5, #1c1c1c)
  text.muted = light-dark(#5c5c5c, #b0b0b0)  pair=surface.note
  // The new look (DESIGN.md section 3): one ink, one paper (the white tone), a grey for secondary text, a line for rules.
  look.ink = light-dark(#111111, #ededed)  pair=look.paper
  look.paper = light-dark(#ffffff, #111111)
  look.grey = light-dark(#5c5c5c, #a6a6a6)  pair=look.paper
  look.line = light-dark(#d9d9d9, #333333)
