// The public page of eggers.dev: one page where a visitor asks questions about Brendan's work and career,
// and the answer streams in below the question. The host is static (no render server), so both routes
// render at build (`render=build`): the page is sent whole, then its script runs the chat in the browser.
// The answer comes from an endpoint at API_BASE_URL (app.ts's `ask`, a stream of server-sent events);
// server.ts is a stand-in for it that `test` and `verify` start themselves.
// Each page is its `header` (the `banner` landmark), its `main` and its `footer` (`contentinfo`): the root is
// a `view`, since a `main` around them would make them neither.
// The look follows ../DESIGN.md: neutral greys and Geist, one colour (app.tamber's AccentColor) kept for the
// one main action, Send. Light and dark follow the system. Nothing moves, so no reduced-motion path is needed.
font "Geist" = "assets/fonts/Geist.ttf"

routes nav
  home "/" render=build
  notfound render=build

// One turn of the conversation, as the endpoint takes it: `role` is "user" or "assistant".
shape Turn
  role: string
  content: string

// The answer to the newest question so far: all of its text, whether it has ended, and why it failed ("" when
// it did not). A failure is part of the answer, not a failed resource, so the page says it as it says the text.
shape Reply
  text: string
  done: bool
  error: string

fn isBlank(s: string): bool = s.trim() == ""

component App
  state draft = ""
  // The conversation sent to the endpoint: every finished turn, then the question being answered.
  state turns = []
  // Asked only once there is a question, so the build asks nothing.
  resource reply = ask(turns) when turns.length > 0 as shape Reply else empty()
  // `pending(reply)` is true from a question (or Try Again) until the answer's first piece lands.
  derive answered = turns.length > 0 and not pending(reply) and current(reply) and reply.done and reply.error == ""
  derive failedNow = turns.length > 0 and not pending(reply) and (failed(reply) or (current(reply) and reply.error != ""))
  derive busy = turns.length > 0 and not answered and not failedNow
  derive canSend = not busy and not isBlank(draft)
  // What the next question builds on: a finished answer joins the conversation; a question that failed
  // leaves it, so the conversation the endpoint gets always alternates.
  derive settled = answered ? turns.concat([Turn(role="assistant", content=reply.text)]) : (failedNow ? turns.slice(0, turns.length - 1) : turns)

  action edit(v: string)
    draft = v
  action send
    if canSend
      turns = settled.concat([Turn(role="user", content=draft.trim())])
      draft = ""
  action starter(q: string)
    if not busy
      turns = settled.concat([Turn(role="user", content=q)])
      draft = ""
  action retry
    refresh reply
  action follow(url: string)
    nav = go(nav, url)

  view
    view navigationKey=`${top(nav).id}` navigate=follow testId="app" width="100%" height="100%"
      font-family="'Geist', system-ui" background-color="-exact-background"
      head description="Ask questions about Brendan Eggers's work and career."
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="home-page" position="absolute" inset=0
            display="flex" flex-direction="column"
            SiteHeader()
            scroll document id="home-page" flex=1 min-height=0
              head title="Brendan Eggers"
              main display="flex" flex-direction="column" gap="2rem" padding="32px 16px 48px" max-width="calc(40rem + 32px)"
                margin-left="auto" margin-right="auto" width="100%" box-sizing="border-box"
                column gap="0.75rem"
                  text "Ask about my work" role="heading" aria-level=1 font-size="2rem" font-weight=600
                    line-height=1.3 letter-spacing="-0.02em" testId="title"
                  text "Ask a question about my work and career, and get an answer right here."
                    color="-exact-secondary-label" line-height=1.5 font-size="1.0625rem"
                column display="flex" flex-direction="column" gap="1rem"
                  text "Your question" id="ask-heading" font-size="0.9375rem" font-weight=600
                  row flex-wrap="wrap" gap="0.5rem" align-items="stretch"
                    input type="text" value=draft input=edit submit=send aria-labelledby="ask-heading"
                      placeholder="What would you like to know?" maxlength=500 autocomplete="off" flex="1 1 12rem"
                      min-width=0 font-size="1rem" testId="question"
                    button press=send disabled=(not canSend) buttonStyle="filled" testId="send"
                      text "Send"
                  if turns.length == 0
                    column gap="0.5rem"
                      text "Or try one of these:" font-size="0.875rem" color="-exact-secondary-label" id="starters-label"
                      row flex-wrap="wrap" gap="0.5rem" role="group" aria-labelledby="starters-label"
                        for q, i in starters() key=q
                          button press=starter(q) buttonStyle="bordered" testId=`starter-${i}`
                            text q font-size="0.875rem"
                  text "Answers come from an AI that works from material I prepared. It can be wrong."
                    font-size="0.8125rem" color="-exact-secondary-label" line-height=1.4 testId="ai-note"
                if turns.length > 0
                  section aria-labelledby="conversation-heading" display="flex" flex-direction="column" gap="1.25rem"
                    text "Chat" id="conversation-heading" role="heading" aria-level=2 font-size="1.25rem" font-weight=600
                    column role="log" aria-busy=busy gap="1.25rem" testId="conversation"
                      for t, i in turns key=`${i}`
                        Message(turn=t, n=i)
                      if busy and (pending(reply) or not current(reply))
                        text "Writing an answer…" color="-exact-secondary-label" testId="waiting"
                      if current(reply) and not pending(reply) and reply.text != ""
                        Message(turn=Turn(role="assistant", content=reply.text), n=turns.length)
                    if failedNow
                      column gap="0.75rem" padding=16 border-radius="0.75rem" background-color="surface.note" role="alert" testId="error"
                        text "The answer didn’t come through. Try again, or ask something else." line-height=1.5
                        row
                          button press=retry buttonStyle="bordered" testId="retry"
                            text "Try Again"
              SiteFooter()
        if e.name == "notfound"
          column navigationKey=`${e.id}` navigationScroll="missing-page" position="absolute" inset=0
            display="flex" flex-direction="column"
            SiteHeader()
            scroll document id="missing-page" flex=1 min-height=0
              head title="Not Found" status=404
              main display="flex" flex-direction="column" gap="0.75rem" padding="48px 16px" max-width="calc(40rem + 32px)"
                margin-left="auto" margin-right="auto" width="100%" box-sizing="border-box"
                text "Page not found" role="heading" aria-level=1 font-size="2rem" font-weight=600 letter-spacing="-0.02em"
                text "This link may be out of date." color="-exact-secondary-label"
                link href="/" testId="notfound-home"
                  text "Go to the home page"
              SiteFooter()

fn starters(): string[] = ["What kind of work do you do?", "What are you working on now?", "How do you like to work?"]

// One turn: who said it, then what was said. The visitor's turns sit on a light grey; the answers on the page.
component Message
  props
    turn: Turn
    n: number
  view
    column gap="0.375rem" testId=`turn-${n}`
      text (turn.role == "user" ? "You" : "Assistant") font-size="0.8125rem" font-weight=600 color="-exact-secondary-label"
      if turn.role == "user"
        text turn.content line-height=1.5 padding="10px 14px" border-radius="0.75rem" background-color="surface.note"
          white-space="pre-line" testId=`text-${n}`
      else
        text turn.content line-height=1.6 white-space="pre-line" testId=`text-${n}`

// The header on every page: the name, which goes home, and a way to write.
component SiteHeader
  view
    header appearance="none" padding="12px 16px" border-bottom="1px solid -exact-separator"
      row flex-wrap="wrap" align-items="center" justify-content="space-between" gap="1rem" max-width="40rem"
        margin-left="auto" margin-right="auto" width="100%" box-sizing="border-box"
        link href="/" testId="home"
          text "Brendan Eggers" font-weight=600 font-size="1.0625rem" color="-exact-label"
        link href="mailto:brendan@eggers.dev" testId="contact"
          text "Get in touch"

// The footer on every page, its `contentinfo` landmark.
component SiteFooter
  view
    footer padding="24px 16px 32px" border-top="1px solid -exact-separator"
      row flex-wrap="wrap" gap="1rem" justify-content="space-between" max-width="40rem" margin-left="auto"
        margin-right="auto" width="100%" box-sizing="border-box"
        text "Brendan Eggers" font-size="0.875rem" color="-exact-secondary-label"
        link href="mailto:brendan@eggers.dev" testId="footer-contact"
          text "Email" font-size="0.875rem"
