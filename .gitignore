# Exact build output and local state
/target/
/dist/
/dist.*
/dist-windows/
/node_modules/
/app.contract.d.ts
/.exact/

# The public site (site/), a second Exact project with the same build output. Its API address has a
# default in site/app.ts, so no site/.env is tracked; `.env*` below keeps any local one out of git.
/site/target/
/site/dist/
/site/dist.*
/site/node_modules/
/site/app.contract.d.ts
/site/.exact/
# The site's Worker: the approved collection copied in at deploy time (private), wrangler's local state, and
# local secrets for `wrangler dev`.
/site/worker/private/
/site/.wrangler/
/site/.dev.vars*

# The studio's Worker (studio/): the built screens copied in at deploy time, its wrangler install, wrangler's local
# state (the dry-run bundle goes in studio/.wrangler/dry-run/) and local secrets for `wrangler dev`.
/studio/dist/
/studio/node_modules/
/studio/.wrangler/
/studio/.dev.vars*

# Private data: the bank, the inbox, cloned repositories and resumes. This repository is public.
/.data/
# The studio's backups on this machine: the first backup cloud/tools/seed.ts makes, and the copies of the cloud's
# data cloud/tools/pull.ts downloads.
/.data.seed/
/.data.cloud/
/data/
/resume/
/_source/
/content/
.env*

# Machine and tool files
.DS_Store
*.log
/.claude/
/.agents/
/.cursor/
/.opencode/
/.impeccable/
/.gstack/
